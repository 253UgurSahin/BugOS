#!/usr/bin/bash
# bugos-install - start het installatieprogramma van BugOS (alleen op de stick).
#
# Waarom een eigen startertje in plaats van meteen "liveinst":
# vóórdat er iets met de schijven gebeurt, kijken we of er een met BitLocker
# versleutelde Windows-schijf is. Zo ja, dan eerst een duidelijke waarschuwing:
# zonder herstelsleutel kom je na het verkleinen misschien niet meer in Windows.
# Dit draait als de live-gebruiker, dus het venster komt gewoon op het scherm
# (in de kickstart lukte dat niet).
# Daarna: een melding "Het installatieprogramma start" zolang Anaconda opstart
# (bugos-live start), en na een gelukte installatie "Nu opnieuw opstarten".

# Teksten in de taal van de stick (standaard Engels): t "Nederlands" "English".
# shellcheck source=system_files/usr/share/bugos/lib.sh
. /usr/share/bugos/lib.sh

# lsblk --list: elke schijf én partitie op een eigen regel. (Met --json staan
# partities "onder" de schijf, en dan zag de oude controle ze niet.)
# De vraag is een BugOS-venster (bugos-live bitlocker; Enter = Stoppen): 0 = doorgaan, 10 = stoppen.
# Elke andere uitkomst betekent dat het venster het niet kon vragen (een fout, geen scherm). Dan niet stilletjes
# niets doen (dan gebeurt er niets als je op "BugOS installeren" drukt), maar dezelfde vraag in een eenvoudig
# venster (zenity, dat het installatieprogramma zelf ook gebruikt). Kan ook dat niet, dan gaat het installeren door:
# het installatieprogramma laat de schijven zelf ook nog zien voordat er iets gebeurt.
if lsblk --list --noheadings -o FSTYPE 2>/dev/null | grep -qx BitLocker; then
    bugos-live bitlocker
    antwoord=$?
    if [ "$antwoord" = 10 ]; then
        exit 0
    elif [ "$antwoord" != 0 ]; then
        echo "bugos-install: bugos-live bitlocker gaf $antwoord; de vraag komt nu via zenity" >&2
        zenity --question --no-markup --title=BugOS --width=480 \
            --ok-label="$(t "Ja, doorgaan" "Yes, continue")" --cancel-label="$(t "Stoppen" "Stop")" \
            --text="$(t "Er staat een versleutelde Windows-schijf (BitLocker) op deze computer. Wil je BugOS naast Windows zetten? Schrijf dan eerst je BitLocker-herstelsleutel op (account.microsoft.com/devices/recoverykey). Doorgaan met installeren?" \
                "This computer has an encrypted Windows drive (BitLocker). Do you want to put BugOS next to Windows? Then first write down your BitLocker recovery key (account.microsoft.com/devices/recoverykey). Continue installing?")" 2>/dev/null
        antwoord=$?
        if [ "$antwoord" = 1 ]; then
            exit 0
        fi
    fi
fi

# Het echte installatieprogramma (Anaconda). Niet met exec: daarna kijken we of het gelukt is. (Wat liveinst
# teruggeeft zegt daar niets over: het laatste wat het doet is setenforce.)
# Merkteken van de kickstart (build.sh, %post --nochroot, als laatste stap): regel 1 = seconden sinds het
# opstarten, regel 2 = de gekozen taal (LANG="nl_NL.UTF-8", zoals Anaconda het in locale.conf zet).
MERKTEKEN="${BUGOS_INSTALL_MERKTEKEN:-/run/bugos-install/gelukt}"
begin="$(cut -d. -f1 /proc/uptime 2>/dev/null)"
case "$begin" in '' | *[!0-9]*) begin=0 ;; esac

# Een rustige melding zolang het installatieprogramma opstart. Dat duurt even (in een VM ruim anderhalve minuut,
# gemeten op 2026-11-11), en tot nu toe zag je al die tijd niets: het welkomstscherm ging dicht en dan leek er niets
# te gebeuren (en klik je nog een keer). 'bugos-live start' sluit zichzelf zodra het installatieprogramma klaar is
# (zie Start in bugos-live). Pas hier, ná de BitLocker-vraag: wie daar 'Stoppen' kiest, krijgt geen melding.
# Op de achtergrond (&): liveinst moet meteen beginnen, de melding wacht nergens op.
bugos-live start &
melding=$!
liveinst "$@"
# Ging liveinst weg voordat het installatieprogramma er was (gestopt, een fout, of 'draait al'), dan staat de melding
# er misschien nog: weg ermee, vóór het venster 'Nu opnieuw opstarten'. Op nummer ($!), dus ook als hij nog maar net
# gestart is. Alleen als het nog een kind van DIT script is: sloot de melding zichzelf al lang geleden, dan kan dat
# nummer nu van een ander programma zijn, en dat laten we met rust.
if [ "$(ps -o ppid= -p "$melding" 2>/dev/null | tr -d ' ')" = "$$" ]; then
    kill "$melding" 2>/dev/null || true
fi

# Gelukt in DEZE ronde (niet een merkteken van een eerdere poging)? Dan het BugOS-venster "Nu opnieuw opstarten",
# in de taal die je in het installatieprogramma koos. Gestopt of mislukt: niets (Anaconda zei het al).
klaar="$(sed -n 1p "$MERKTEKEN" 2>/dev/null)"
case "$klaar" in '' | *[!0-9]*) klaar=0 ;; esac
if [ "$klaar" -gt 0 ] && [ "$klaar" -ge "$begin" ]; then
    taal="$(sed -n 2p "$MERKTEKEN" 2>/dev/null)"
    taal="${taal#LANG=}"
    taal="${taal//\"/}"   # Anaconda schrijft LANG="nl_NL.UTF-8", met aanhalingstekens (review I1)
    taal="${taal%%[._@]*}"
    # Alleen een gewone taalcode (nl, en, fy, ast) gaat naar LANGUAGE; de rest: de taal van de stick.
    case "$taal" in [a-z][a-z] | [a-z][a-z][a-z]) ;; *) taal="" ;; esac
    if [ -n "$taal" ]; then
        LANGUAGE="$taal" exec bugos-live klaar
    fi
    exec bugos-live klaar
fi
