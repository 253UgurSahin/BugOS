def geheugen_gb() -> float:
    """Totale werkgeheugen in GB (uit /proc/meminfo); 99 als het niet lukt."""
    try:
        with open("/proc/meminfo", encoding="utf-8") as f:
            for regel in f:
                if regel.startswith("MemTotal:"):
                    return int(regel.split()[1]) / 1024 / 1024
    except (OSError, ValueError, IndexError):
        pass
    # Weten we het niet, dan liever geen onnodige waarschuwing.
    return 99.0


# Hoe vaak we opnieuw vragen of er een wifi-kaart is (een USB-wifistokje kan er later in).
WIFI_OPNIEUW = 30.0


def net_toestand(vraag_wifi: bool) -> tuple[bool, bool | None]:
    """(online, heeft_wifi). Draait op de achtergrond: nmcli kan blijven hangen, en dan mag het venster niet vastlopen.

    heeft_wifi is None als we het niet gevraagd hebben (online, of kort geleden al gevraagd). Zelfde regel als
    bi.heeft_wifi() (U111): 'nmcli radio' zegt ook 'enabled' zonder wifi-kaart, dus we kijken naar de apparaten.
    Lukt nmcli niet, dan nemen we aan dat er wifi is: dan staat de knop er, en Instellingen legt het verder uit."""
    code, uit = draai("nmcli", "-t", "-f", "CONNECTIVITY", "general", timeout=5)
    # draai() geeft ook wat nmcli op stderr zegt (bijv. een waarschuwing over versies): kijk per regel.
    online = code == 0 and any(r.strip() == "full" for r in uit.splitlines())
    if online or not vraag_wifi:
        return online, None
    code, uit = draai("nmcli", "-t", "-f", "TYPE", "device", timeout=5)
    return online, code != 0 or any(r.strip() == "wifi" for r in uit.splitlines())


# Knoppen op de donkere achtergrond: wit randje, zodat alleen de hoofdknop rood is.
WIT_RAND = ("QPushButton{color:#FFFFFF;border:1px solid rgba(255,255,255,0.35);background:rgba(255,255,255,0.06);}"
