class Achtergrond(QWidget):
    """Een venster met de donkere BugOS-achtergrond (het lieveheersbeestje rechtsonder), zoals het welkomstscherm."""

    def __init__(self):
        super().__init__()
        self.setWindowTitle("BugOS")
        self.beeld = QPixmap(achtergrond_pad(donker=True))

    def paintEvent(self, _e):  # noqa: N802
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform)
        r = QRectF(self.rect())
        p.fillRect(r, QColor("#0E0F13"))
        if not self.beeld.isNull():
            bw, bh = self.beeld.width(), self.beeld.height()
            schaal = max(r.width() / bw, r.height() / bh)
            dw, dh = bw * schaal, bh * schaal
            p.drawPixmap(QRectF(r.right() - dw, r.bottom() - dh, dw, dh), self.beeld, QRectF(0, 0, bw, bh))
        g = QLinearGradient(0, 0, r.width(), 0)
        g.setColorAt(0, QColor(14, 15, 19, 245))
        g.setColorAt(0.5, QColor(14, 15, 19, 200))
        g.setColorAt(1, QColor(14, 15, 19, 20))
        p.fillRect(r, g)


class Live(Achtergrond):
    def __init__(self):
        super().__init__()
        self.resize(960, 600)
        lay = QVBoxLayout(self)
        lay.setContentsMargins(56, 52, 56, 44)
        lay.setSpacing(18)

        logo = QLabel()
        # Dit scherm is altijd donker: het logo met de lichte kop.
        logo.setPixmap(QIcon("/usr/share/bugos/logo-dark.svg").pixmap(76, 76))
        lay.addWidget(logo)
        kop = label(t("Welkom bij BugOS", "Welcome to BugOS"), "groot")
        kop.setStyleSheet("color:#FFFFFF;")
        lay.addWidget(kop)
        tekst = label(t("BugOS draait nu vanaf de USB-stick. Er is nog niets aan je computer veranderd.\n"
                        "Kijk gerust rond. Bevalt het? Druk dan op \"BugOS installeren\".",
                        "BugOS is now running from the USB stick. Nothing on your computer has changed yet.\n"
                        "Feel free to look around. Like it? Then press \"Install BugOS\"."), "sub")
        tekst.setStyleSheet("color:rgba(255,255,255,0.78);font-size:16px;")
        tekst.setMaximumWidth(560)
        lay.addWidget(tekst)

        net_rij = QHBoxLayout()
        net_rij.setSpacing(12)
        self.chip = Chip("", "grijs")
        net_rij.addWidget(self.chip)
        self.wifi = Knop(t("Wifi kiezen", "Choose Wi-Fi"), "rand", "network-wireless")
        self.wifi.setStyleSheet("QPushButton{color:#FFFFFF;border:1px solid rgba(255,255,255,0.35);background:transparent;}"
                                "QPushButton:hover{background:rgba(255,255,255,0.10);}")
        # Naar de wifi-pagina van BugOS Instellingen (niet naar KDE). Op de stick mag de live-gebruiker zonder
        # wachtwoord verbinden (hij zit in 'wheel'; regel van NetworkManager).
        self.wifi.clicked.connect(self.kies_wifi)
        self.wifi.hide()   # pas tonen als we weten dat er wifi is
        net_rij.addWidget(self.wifi)
        net_rij.addStretch(1)
        lay.addLayout(net_rij)
        # Gaat Instellingen niet open, dan staat hier hoe het anders kan. Een eigen regel, niet in de chip: die krijgt
        # elke 3 s een nieuwe tekst, en dan zou de uitleg meteen weer weg zijn.
        self.wifi_fout = label(t("Instellingen gaan niet open. Kies wifi met het netwerk-icoon rechtsonder.",
                                 "Settings did not open. Choose Wi-Fi with the network icon at the bottom right."), "sub")
        self.wifi_fout.setStyleSheet("color:rgba(255,255,255,0.78);font-size:14px;")
        self.wifi_fout.setWordWrap(True)
        self.wifi_fout.setMaximumWidth(560)
        self.wifi_fout.hide()
        lay.addWidget(self.wifi_fout)

        # Weinig geheugen? Dan eerlijk zeggen dat installeren kan mislukken.
        # Het installatieprogramma zet elk onderdeel van BugOS eerst in het
        # geheugen (de stick zelf kan niet beschreven worden), en het grootste
        # onderdeel is een paar GB.
        if geheugen_gb() < 6:
            waarschuwing = Chip(t("!  Deze computer heeft weinig geheugen. Installeren kan dan mislukken.",
                                  "!  This computer has little memory. Installing may fail."), "let_op")
            lay.addWidget(waarschuwing)
        lay.addStretch(1)

        rij = QHBoxLayout()
        rij.setSpacing(14)
        proberen = Knop(t("Eerst proberen", "Try first"), "rand", groot=True)
        proberen.setStyleSheet(WIT_RAND)
        self.installeren = Knop(t("BugOS installeren", "Install BugOS"), "hoofd", groot=True)
        self.installeren.setMinimumWidth(220)
        proberen.clicked.connect(self.close)
        self.installeren.clicked.connect(self.installeer)
        rij.addWidget(proberen)
        rij.addWidget(self.installeren)
        rij.addStretch(1)
        lay.addLayout(rij)

        self._heeft_wifi: bool | None = None
        self._wifi_gevraagd = float("-inf")
        self._bezig = False
        # Tot nmcli het eerste antwoord geeft: niets beweren (geen 'geen internet', geen wifi-knop).
        self.chip.setText(t("Internet nakijken…", "Checking the internet…"))
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.kijk_internet)
        self.timer.start(3000)
        self.kijk_internet()

    def kijk_internet(self) -> None:
        """Laat zien of er internet is. Installeren kan altijd.

        BugOS zit zelf op de stick, dus voor het installeren is geen internet
        nodig. Internet is alleen handig om alvast rond te kijken (websites,
        apps uit de Winkel). Daarom blijft de knop "BugOS installeren" altijd
        aan, en is "Wifi kiezen" er alleen voor het gemak.
        nmcli draait op de achtergrond; de wifi-kaart vragen we hooguit elke 30 s.
        """
        if self._bezig:
            return
        self._bezig = True
        vraag_wifi = time.monotonic() - self._wifi_gevraagd >= WIFI_OPNIEUW
        op_achtergrond(self, lambda: net_toestand(vraag_wifi), self._net_bekend)

    def _net_bekend(self, uitkomst) -> None:
        self._bezig = False
        # Ging het vragen zelf mis, dan zelfde regel als bij een nmcli die faalt: aannemen dat er wifi is.
        online, wifi = uitkomst if uitkomst else (False, True)
        if wifi is not None:
            self._heeft_wifi = wifi
            self._wifi_gevraagd = time.monotonic()
        self.toon_net(online)

    def toon_net(self, online: bool) -> None:
        # Alleen met een wifi-kaart (True; ook als nmcli faalt). Geen kaart (een pc met een kabel) of nog niet bekend
        # (None): geen knop die nergens heen leidt.
        self.wifi.setVisible(not online and self._heeft_wifi is True)
        if online:
            self.wifi_fout.hide()
        self.chip.setText(t("✓  Je hebt internet", "✓  You are online") if online
                          else t("Geen internet? Geen probleem: BugOS installeert vanaf de stick",
                                 "No internet? No problem: BugOS installs from the stick"))
        # Allebei "goed": zonder internet is er niets mis.
        self.chip.setStyleSheet(Chip("", "goed").styleSheet())

    def kies_wifi(self) -> None:
        try:
            subprocess.Popen(["bugos-settings", "wifi"], start_new_session=True)
        except OSError:
            self.wifi_fout.show()

    def installeer(self) -> None:
        # Via ons startertje: dat waarschuwt eerst bij een BitLocker-schijf.
        subprocess.Popen(["bugos-install"], start_new_session=True)
        self.close()


class Klaar(Achtergrond):
    """Na het installeren (bugos-install start dit als het gelukt is): opnieuw opstarten, of later.

    In de taal die je in het installatieprogramma koos (bugos-install zet LANGUAGE). Opnieuw opstarten mag zonder
    wachtwoord (polkit: org.freedesktop.login1.reboot, actieve sessie). systemctl draait los (QProcess), dus het venster
    blijft altijd reageren. Lukt het niet, dan zegt het venster hoe het anders kan (het startmenu)."""

    def __init__(self):
        super().__init__()
        self.resize(720, 440)
        lay = QVBoxLayout(self)
        lay.setContentsMargins(48, 44, 48, 36)
        lay.setSpacing(14)
        logo = QLabel()
        logo.setPixmap(QIcon("/usr/share/bugos/logo-dark.svg").pixmap(64, 64))
        lay.addWidget(logo)
        self.kop = label("", "groot")
        self.kop.setStyleSheet("color:#FFFFFF;")
        lay.addWidget(self.kop)
        self.tekst = label("", "sub")
        self.tekst.setStyleSheet("color:rgba(255,255,255,0.78);font-size:15px;")
        self.tekst.setMaximumWidth(520)
        lay.addWidget(self.tekst)
        self.fout = Chip(t("!  Opnieuw opstarten lukte niet. Gebruik Opnieuw opstarten in het startmenu.",
                           "!  Restarting did not work. Use Restart in the Start menu."), "let_op")
        self.fout.setWordWrap(True)
        self.fout.hide()
        lay.addWidget(self.fout)
        lay.addStretch(1)

        rij = QHBoxLayout()
        rij.setSpacing(12)
        self.later = Knop(t("Later", "Later"), "rand", groot=True)
        self.later.setStyleSheet(WIT_RAND)
        self.later.clicked.connect(self.close)
        self.nu = Knop(t("Nu opnieuw opstarten", "Restart now"), "hoofd", groot=True)
        self.nu.setMinimumWidth(200)
        self.nu.setStyleSheet(ROOD_UIT)
        self.nu.setDefault(True)
        self.nu.clicked.connect(self.herstart)
        rij.addWidget(self.later)
        rij.addWidget(self.nu)
        rij.addStretch(1)
        lay.addLayout(rij)
        self.proces: QProcess | None = None
        self.toon("begin")
        self.nu.setFocus()

    def toon(self, stand: str) -> None:
        """begin, bezig (na 'Nu opnieuw opstarten') of mislukt (dan staat er ook hoe het via het startmenu kan)."""
        if stand == "bezig":
            self.kop.setText(t("Opnieuw opstarten…", "Restarting…"))
            self.tekst.setText(t("Haal de USB-stick eruit zodra het scherm zwart wordt.",
                                 "Take out the USB stick as soon as the screen goes black."))
        else:
            self.kop.setText(t("BugOS staat op je computer", "BugOS is on your computer"))
            self.tekst.setText(t("Start de computer opnieuw om BugOS te gebruiken.\n"
                                 "Haal de USB-stick eruit zodra het scherm zwart wordt.",
                                 "Restart the computer to start using BugOS.\n"
                                 "Take out the USB stick as soon as the screen goes black."))
        self.fout.setVisible(stand == "mislukt")
        self.later.setEnabled(stand != "bezig")
        self.nu.setEnabled(stand != "bezig")

    def herstart(self) -> None:
        self.toon("bezig")
        if os.environ.get("BUGOS_INSTELLINGEN_VOORBEELD"):   # voorbeeldstand (foto's, tests): niets echt doen
            return
        self.proces = QProcess(self)
        self.proces.errorOccurred.connect(self._fout)
        self.proces.finished.connect(lambda code, _status: self.toon("mislukt") if code != 0 else None)
        self.proces.start("systemctl", ["reboot"])

    def _fout(self, fout) -> None:
        if fout == QProcess.ProcessError.FailedToStart:
            self.toon("mislukt")


# ===================================================================================== bugos-live start ===
# Waaraan we zien dat het installatieprogramma klaar is (zie Start). Namen uit Anaconda 44 (pyanaconda/core/constants.py
# BACKEND_READY_FLAG_FILE, liveinst en /usr/libexec/anaconda/webui-desktop). Module-variabelen, zodat de test ze naar
# een eigen map kan zetten.
ANACONDA_KLAAR = "/run/anaconda/backend_ready"
PROC = "/proc"
# webui-desktop start het venster (slitherer, of Firefox) met de pagina van het installatieprogramma als argument:
# http://127.0.0.1/cockpit/@localhost/anaconda-webui/index.html. Geen ander programma heeft dat op zijn opdrachtregel.
PAGINA = b"/anaconda-webui/index.html"


def installatie_venster(proc: str | None = None) -> bool:
    """Draait het venster van het installatieprogramma? Kijkt in /proc of een programma de pagina van Anaconda als
    argument heeft. Een proces dat net weg is of dat we niet mogen lezen, slaan we over (nooit een fout)."""
    proc = proc or PROC
    try:
        namen = os.listdir(proc)
    except OSError:
        return False
    for naam in namen:
        if not naam.isdigit():
            continue
        try:
            with open(os.path.join(proc, naam, "cmdline"), "rb") as f:
                if PAGINA in f.read():
                    return True
        except OSError:
            continue
    return False


def installatie_klaar(klaar: str | None = None, proc: str | None = None) -> bool:
    """Kun je het installatieprogramma nu gebruiken? Twee dingen samen:
    - Anaconda heeft backend_ready gemaakt (alles gestart; tot dan toont de pagina zelf alleen 'Initializing...');
    - het venster met de pagina draait.
    Alleen de vlag is niet genoeg (het venster kan dan nog komen), alleen het venster ook niet (dat toont eerst lang
    'Initializing...', en dan zou de melding al weg zijn terwijl er nog niets te doen is)."""
    return os.path.exists(klaar or ANACONDA_KLAAR) and installatie_venster(proc)


class Start(Achtergrond):
    """'Het installatieprogramma start': bugos-install toont dit vlak voordat het liveinst start.

    Waarom: Anaconda heeft even nodig voordat je iets kunt doen (in een VM ruim anderhalve minuut, gemeten op
    2026-11-11). Zonder dit ging het welkomstscherm dicht en zag je al die tijd niets, en dan klik je nog een keer.
    Het venster sluit zichzelf zodra het installatieprogramma klaar is (installatie_klaar), en anders uiterlijk als
    zijn venster al VENSTER_S seconden draait; stopt liveinst eerder, dan sluit bugos-install het. Geen knoppen: er
    valt niets te kiezen (het kruisje sluit alleen deze melding).
    Duurt het erg lang (trage computer of stick), dan zegt het dat eerlijk, in plaats van te blijven beloven."""

    KIJK_MS = 1000       # elke seconde kijken (goedkoop: één rondje door /proc)
    NA_KLAAR_MS = 1500   # nog heel even blijven staan, zodat de eerste pagina getekend is als dit weggaat
    LANG_S = 240         # na 4 minuten: zeggen dat het langer duurt dan normaal
    # Vangnet: draait het venster van het installatieprogramma al 2 minuten, dan staat het zeker op het scherm (met
    # zijn eigen 'Initializing...'), ook als we backend_ready om wat voor reden ook niet zien. Dan toch weg, zodat er
    # nooit een melding 'het start nog' achter het installatieprogramma blijft hangen.
    VENSTER_S = 120

    def __init__(self):
        super().__init__()
        # Kleiner en rustiger dan het welkomstscherm: het is een melding, geen keuze. Past bij 150 % op 1280x800.
        self.resize(620, 320)
        lay = QVBoxLayout(self)
        lay.setContentsMargins(44, 40, 44, 36)
        lay.setSpacing(14)
        logo = QLabel()
        logo.setPixmap(QIcon("/usr/share/bugos/logo-dark.svg").pixmap(56, 56))
        lay.addWidget(logo)
        # 'titel' (28 px) in plaats van 'groot' (40 px): de Nederlandse kop past dan op één regel.
        self.kop = label(t("Het installatieprogramma start", "The installer is starting"), "titel")
        self.kop.setStyleSheet("color:#FFFFFF;")
        lay.addWidget(self.kop)
        self.tekst = label("", "sub")
        self.tekst.setStyleSheet("color:rgba(255,255,255,0.78);font-size:15px;")
        self.tekst.setWordWrap(True)
        self.tekst.setMaximumWidth(510)
        lay.addWidget(self.tekst)
        lay.addStretch(1)
        # Een dun, rustig balkje dat heen en weer loopt: geen percentage, want hoe ver Anaconda is weten we niet.
        # Wit op de donkere achtergrond (rood is in BugOS alleen voor de hoofdknop).
        self.balk = QProgressBar()
        self.balk.setRange(0, 0)
        self.balk.setTextVisible(False)
        self.balk.setFixedHeight(4)
        self.balk.setStyleSheet("QProgressBar{background:rgba(255,255,255,0.12);border:none;border-radius:2px;"
                                "min-height:4px;max-height:4px;}"
                                "QProgressBar::chunk{background:rgba(255,255,255,0.70);border-radius:2px;}")
        lay.addWidget(self.balk)
        self.begin = time.monotonic()
        self.venster_sinds: float | None = None   # sinds wanneer het venster van het installatieprogramma draait
        self.klaar_gezien = False
        self.toon(lang=False)
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.kijk)
        self.timer.start(self.KIJK_MS)

    def toon(self, lang: bool) -> None:
        """De uitleg: eerst hoe lang het ongeveer duurt; na LANG_S seconden dat het langer duurt dan normaal.
        'Een minuut of twee' en niet 'een minuut': gemeten was het ruim anderhalve minuut."""
        if lang:
            self.tekst.setText(t("Het duurt langer dan normaal, maar het installatieprogramma start nog. Op een trage "
                                 "computer of USB-stick kan dat een aantal minuten duren.",
                                 "This is taking longer than usual, but the installer is still starting. On a slow "
                                 "computer or USB stick that can take several minutes."))
        else:
            self.tekst.setText(t("Dit duurt een minuut of twee. Het gaat vanzelf open, dus je hoeft niet nog een keer "
                                 "te klikken.",
                                 "This takes a minute or two. It opens by itself, so there is no need to click "
                                 "again."))

    def kijk(self) -> None:
        """Elke seconde: is het installatieprogramma klaar (zie installatie_klaar), of draait zijn venster al
        VENSTER_S seconden? Dan nog even blijven staan en dicht."""
        if self.klaar_gezien:
            return
        nu = time.monotonic()
        venster = installatie_venster()
        if not venster:
            self.venster_sinds = None
        elif self.venster_sinds is None:
            self.venster_sinds = nu
        # Zelfde regel als installatie_klaar(), plus het vangnet. ANACONDA_KLAAR pas hier lezen (de test zet hem om).
        if venster and (os.path.exists(ANACONDA_KLAAR) or nu - self.venster_sinds >= self.VENSTER_S):
            self.klaar_gezien = True
            self.timer.stop()
            QTimer.singleShot(self.NA_KLAAR_MS, self.close)
            return
        self.toon(lang=nu - self.begin >= self.LANG_S)


# bugos-live bitlocker: 0 = doorgaan, STOPPEN = niet installeren. Elke andere code (Python-fout, geen scherm) betekent
# voor bugos-install 'kon het niet vragen', en dan vraagt het op een andere manier (review I10).
STOPPEN = 10


def vraag_bitlocker() -> bool:
    """Voor het installeren, als er een BitLocker-schijf is: eerst de herstelsleutel opschrijven. Enter = Stoppen."""
    return vraag_ja(None, t("Er staat een versleutelde Windows-schijf (BitLocker) op deze computer",
                            "This computer has an encrypted Windows drive (BitLocker)"),
                    t("Wil je BugOS naast Windows zetten? Schrijf dan eerst je BitLocker-herstelsleutel op "
                      "(account.microsoft.com/devices/recoverykey). Zonder die sleutel kom je daarna misschien niet "
                      "meer in Windows.\n\nDoorgaan met installeren?",
                      "Do you want to put BugOS next to Windows? Then first write down your BitLocker recovery key "
                      "(account.microsoft.com/devices/recoverykey). Without that key you may not get back into "
                      "Windows afterwards.\n\nContinue installing?"),
                    t("Ja, doorgaan", "Yes, continue"), t("Stoppen", "Stop"), enter_is_nee=True)


def venster(args: list[str]) -> QWidget:
    """Welk venster: 'start' terwijl het installatieprogramma opstart, 'klaar' na het installeren, anders het
    welkomstscherm."""
    if args[:1] == ["start"]:
        return Start()
    if args[:1] == ["klaar"]:
        return Klaar()
    return Live()


def main() -> int:
    app = maak_app("bugos-live", "bugos-live", sys.argv)
    if sys.argv[1:2] == ["bitlocker"]:
        return 0 if vraag_bitlocker() else STOPPEN
    return uitvoeren(app, venster(sys.argv[1:]))


if __name__ == "__main__":
    sys.exit(main())
