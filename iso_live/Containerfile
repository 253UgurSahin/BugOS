# BugOS "Probeer eerst"-USB-stick (live ISO)
# ===========================================
# Jip-en-Janneke: we nemen de gewone BugOS en doen er een installatie-
# programma bij. Van de USB-stick start je BugOS meteen op om te proberen.
# Bevalt het? Dan druk je op "BugOS installeren". BugOS zelf zit ook op de
# stick, dus installeren kan zonder internet.
#
# Gebouwd door .github/workflows/iso.yml; daarna maakt Titanoboa er een ISO van.
# Bouwen kan alleen met:  --cap-add sys_admin --security-opt label=disable

ARG BASE_IMAGE=ghcr.io/253ugursahin/bugos:latest
FROM ${BASE_IMAGE}

# Welke BugOS op de computer komt na het installeren.
ARG IMAGE_REF=ghcr.io/253ugursahin/bugos:latest
ARG BUGOS_VARIANT=main
# De precieze versie (sha256:...) van IMAGE_REF, zodat de BugOS op de stick
# exact dezelfde is als de live-omgeving. Leeg = gewoon de nieuwste van de tag.
ARG IMAGE_DIGEST=
# Alleen voor lokaal testen (tools/iso-lokaal.sh): waar de BugOS voor op de
# stick vandaan komt, als dat niet IMAGE_REF zelf is.
ARG IMAGE_SOURCE=
ARG IMAGE_SOURCE_TLS=true

COPY src /src
# Het secret "ghcr" is het inlogbestand voor GitHub Packages (nodig zolang het
# pakket privé is). Het is er alleen tijdens deze stap en komt niet in de ISO.
# Bouwen:  podman build --secret id=ghcr,src=<auth.json> ...
# (bij een openbaar pakket mag het bestand leeg zijn)
RUN --mount=type=secret,id=ghcr,target=/run/secrets/ghcr \
    IMAGE_REF="${IMAGE_REF}" IMAGE_DIGEST="${IMAGE_DIGEST}" BUGOS_VARIANT="${BUGOS_VARIANT}" \
    IMAGE_SOURCE="${IMAGE_SOURCE}" IMAGE_SOURCE_TLS="${IMAGE_SOURCE_TLS}" \
    /src/build.sh && rm -rf /src
