[Desktop Entry]
Type=Application
Name=Schijven openen
Name[en]=Open drives
Comment=Opent de schijven die in de computer zitten, zodat ze er altijd zijn
Comment[en]=Opens the drives inside the computer, so they are always there
Exec=/usr/bin/bugos-schijven-openen
NoDisplay=true
OnlyShowIn=KDE;
X-KDE-autostart-phase=2
