[Desktop Entry]
Type=Application
Name=Open drives
Name[nl]=Schijven openen
Comment=Opens the drives inside the computer, so they are always there
Comment[nl]=Opent de schijven die in de computer zitten, zodat ze er altijd zijn
Exec=/usr/bin/bugos-open-drives
NoDisplay=true
OnlyShowIn=KDE;
X-KDE-autostart-phase=2
