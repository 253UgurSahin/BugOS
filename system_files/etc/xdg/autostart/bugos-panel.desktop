[Desktop Entry]
Type=Application
Name=BugOS Taskbar
Name[nl]=BugOS Taakbalk
Comment=Puts the BugOS start menu and quick menu on the taskbar (once), and locks the taskbar and desktop at every sign-in
Comment[nl]=Zet het BugOS-startmenu en het snelmenu op de taakbalk (één keer), en zet taakbalk en bureaublad bij elk inloggen op slot
Exec=bugos-panel standaard
Icon=bugos-logo
OnlyShowIn=KDE;
X-KDE-autostart-phase=2
NoDisplay=true
