[Desktop Entry]
Type=Application
Name=BugOS Taskbar
Name[nl]=BugOS Taakbalk
Comment=Puts the BugOS start menu and quick menu on the taskbar (once)
Comment[nl]=Zet het BugOS-startmenu en het snelmenu op de taakbalk (één keer)
Exec=bugos-panel standaard
Icon=bugos-logo
OnlyShowIn=KDE;
X-KDE-autostart-phase=2
NoDisplay=true
