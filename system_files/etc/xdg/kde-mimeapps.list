[Default Applications]
application/x-ms-dos-executable=bugos-exe.desktop
application/x-msdownload=bugos-exe.desktop
application/x-msi=bugos-exe.desktop
application/vnd.microsoft.portable-executable=bugos-exe.desktop
application/x-rpm=bugos-package.desktop
application/x-redhat-package-manager=bugos-package.desktop
application/vnd.debian.binary-package=bugos-package.desktop
application/x-deb=bugos-package.desktop
inode/directory=bugos-files.desktop
# Een "Installeren"-link of -bestand van Flathub opent de BugOS Winkel, die de app zelf laat zien (U326; geen KDE Discover meer).
x-scheme-handler/appstream=bugos-store.desktop
x-scheme-handler/flatpak+https=bugos-store.desktop
application/vnd.flatpak.ref=bugos-store.desktop
application/vnd.flatpak.repo=bugos-store.desktop
application/vnd.flatpak=bugos-store.desktop
image/jpeg=org.kde.gwenview.desktop
image/png=org.kde.gwenview.desktop
image/gif=org.kde.gwenview.desktop
image/webp=org.kde.gwenview.desktop
image/heif=org.kde.gwenview.desktop
image/heic=org.kde.gwenview.desktop
image/bmp=org.kde.gwenview.desktop
image/tiff=org.kde.gwenview.desktop
image/avif=org.kde.gwenview.desktop
application/pdf=org.kde.okular.desktop
# Internet: Firefox, de Flatpak van Flathub (die bugos-first-boot klaarzet). Vroeger koos de Fedora-instelling de
# Firefox die als pakket in BugOS zat (firefox.desktop); die is er niet meer. Is Firefox (nog) niet geïnstalleerd of
# heb je hem verwijderd, dan slaat KDE deze regel over en kiest het een andere browser.
x-scheme-handler/http=org.mozilla.firefox.desktop
x-scheme-handler/https=org.mozilla.firefox.desktop
text/html=org.mozilla.firefox.desktop
application/xhtml+xml=org.mozilla.firefox.desktop
# Een .txt opent in de eenvoudige Teksteditor (KWrite), niet in Kate voor programmeurs (A-14).
text/plain=org.kde.kwrite.desktop

[Added Associations]
inode/directory=bugos-files.desktop;org.kde.dolphin.desktop;
