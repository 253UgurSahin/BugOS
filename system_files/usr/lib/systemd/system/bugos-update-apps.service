[Unit]
Description=Update BugOS apps (Flatpak)
Documentation=https://github.com/253UgurSahin/BugOS
Wants=network-online.target
After=network-online.target
ConditionPathExists=/usr/bin/flatpak

[Service]
Type=oneshot
# Low priority: never slow down what the user is doing.
Nice=19
IOSchedulingClass=idle
ExecStart=/usr/bin/flatpak update --system --noninteractive --assumeyes
ExecStartPost=-/usr/bin/flatpak uninstall --system --unused --noninteractive --assumeyes
# Nieuwe apps (of een nieuwe KDE-versie) krijgen ook de BugOS-stijl.
ExecStartPost=-/usr/bin/bugos-flatpak-style
