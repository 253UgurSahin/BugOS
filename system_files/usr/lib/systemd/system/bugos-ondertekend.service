[Unit]
Description=BugOS: switch to signed updates (once)
Documentation=https://github.com/253UgurSahin/BugOS/blob/main/docs/ONDERTEKENEN.md
# Geen Wants/After network-online: dan wachtte elke keer opstarten (ook lang na de eerste keer) op het
# netwerk. Het script wacht zelf even op internet (U312).
After=rpm-ostreed.service
ConditionPathExists=/etc/pki/containers/bugos.pub
ConditionKernelCommandLine=!rd.live.image

[Service]
# exec, niet oneshot: het opstarten wacht niet op het downloaden (zoals bugos-first-boot) (U236).
Type=exec
# Niet over een verbinding met een databundel (telefoon-hotspot): dan de volgende keer opstarten (U236).
# Lukt overstappen niet (geen internet), dan over een half uur opnieuw.
ExecCondition=/bin/bash -c 'm="$(busctl get-property org.freedesktop.NetworkManager /org/freedesktop/NetworkManager org.freedesktop.NetworkManager Metered 2>/dev/null | cut -c 3-)"; [ "$$m" != 1 ] && [ "$$m" != 3 ]'
ExecStart=/usr/bin/bugos-ondertekend
Restart=on-failure
RestartSec=30min
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
