[Unit]
Description=BugOS: check for an update every day

[Timer]
# Elke dag op de klok (niet "een dag na de vorige keer": die tijd telt niet door als een laptop slaapt).
# Was je niet ingelogd of sliep de computer, dan gebeurt het zodra je er weer bent (Persistent).
OnCalendar=daily
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
