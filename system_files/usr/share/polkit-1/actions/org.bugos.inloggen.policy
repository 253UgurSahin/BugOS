<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>BugOS</vendor>
  <action id="org.bugos.inloggen">
    <description>Log in without a password (on or off)</description>
    <description xml:lang="nl">Inloggen zonder wachtwoord aan- of uitzetten</description>
    <message>Enter your password to change how you log in</message>
    <message xml:lang="nl">Typ je wachtwoord om te veranderen hoe je inlogt</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/bugos-inloggen</annotate>
  </action>
</policyconfig>
