// BugOS: wie de computer beheert (de groep wheel) mag schijven die in de computer zitten
// openen zonder wachtwoord, net als in Windows. Indelen en formatteren vraagt wel het wachtwoord.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.udisks2.filesystem-mount-system" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
