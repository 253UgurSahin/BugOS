# BugOS-programmastijl voor Kvantum (donker).
# Gemaakt door tools/kvantum/make.py uit tools/design/tokens.py; niet met de hand bewerken.

[%General]
author=BugOS
comment=The BugOS style for KDE and Qt apps (dark)
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
respect_DE=true
click_behavior=0
composite=true
translucent_windows=false
blurring=false
popup_blurring=false
reduce_window_opacity=0
reduce_menu_opacity=0
no_window_pattern=false
no_inactiveness=true
menu_shadow_depth=8
tooltip_shadow_depth=6
menu_blur_radius=0
tooltip_blur_radius=0
shadowless_popup=false
animate_states=true
layout_spacing=6
layout_margin=12
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=22
toolbutton_style=0
scroll_width=12
scroll_min_extent=36
scroll_arrows=false
transient_scrollbar=true
transient_groove=false
scrollbar_in_view=true
slider_width=8
slider_handle_width=22
slider_handle_length=22
tickless_slider_handle_size=22
check_size=18
progressbar_thickness=8
textless_progressbar=false
spread_progressbar=true
combo_as_lineedit=false
square_combo_button=false
combo_menu=true
hide_combo_checkboxes=true
combo_focus_rect=false
inline_spin_indicators=true
vertical_spin_indicators=false
inline_spin_separator=false
spin_button_width=24
groupbox_top_label=true
spread_menuitems=true
spread_header=true
menu_separator_height=9
scrollable_menu=true
submenu_overlap=0
submenu_delay=250
tooltip_delay=-1
merge_menubar_with_toolbar=true
menubar_mouse_tracking=true
left_tabs=false
attach_active_tab=false
embedded_tabs=false
mirror_doc_tabs=true
joined_inactive_tabs=false
bold_active_tab=false
no_active_tab_separator=true
group_toolbar_buttons=false
toolbar_item_spacing=2
toolbar_interior_spacing=4
center_toolbar_handle=true
slim_toolbars=false
fill_rubberband=false
tree_branch_line=false
splitter_width=7
drag_from_buttons=false
contrast=1.00
intensity=1.00
saturation=1.00

[GeneralColors]
window.color=#111216
inactive.window.color=#111216
base.color=#1C1E24
inactive.base.color=#1C1E24
alt.base.color=#22252C
inactive.alt.base.color=#22252C
button.color=#262930
light.color=#3A3E48
mid.light.color=#2F333B
mid.color=#2B2E36
dark.color=#0B0C0F
highlight.color=#3A1C22
inactive.highlight.color=#3A1C22
text.color=#EDEEF1
inactive.text.color=#EDEEF1
window.text.color=#EDEEF1
inactive.window.text.color=#EDEEF1
button.text.color=#EDEEF1
inactive.button.text.color=#EDEEF1
disabled.text.color=#7C828E
tooltip.base.color=#EDEEF1
tooltip.text.color=#16171C
highlight.text.color=#EF6E7A
inactive.highlight.text.color=#EF6E7A
link.color=#EC4F5D
link.visited.color=#C08CE0
progress.indicator.text.color=#EDEEF1
progress.inactive.indicator.text.color=#EDEEF1

[Hacks]
transparent_ktitle_label=true
transparent_dolphin_view=false
transparent_pcmanfm_sidepane=true
transparent_pcmanfm_view=false
blur_translucent=false
transparent_menutitle=true
respect_darkness=false
force_size_grip=false
iconless_pushbutton=false
iconless_menu=false
disabled_icon_opacity=50
normal_default_pushbutton=true
single_top_toolbar=true
tint_on_mouseover=0
no_selection_tint=true
transparent_arrow_button=true
middle_click_scroll=false
kinetic_scrolling=false
centered_forms=false
lxqtmainmenu_iconsize=0
style_vertical_toolbars=false

[PanelButtonCommand]
frame=true
frame.element=btn
frame.expandedElement=button
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
frame.expansion=24
interior=true
interior.element=button
focusFrame=true
indicator.element=arrow
indicator.size=12
text.margin=1
text.iconspacing=6
text.margin.top=5
text.margin.bottom=5
text.margin.left=9
text.margin.right=9
min_width=+0.3font
text.normal.color=#EDEEF1
text.focus.color=#EDEEF1
text.press.color=#EDEEF1
text.toggle.color=#EF6E7A
text.shadow=false
text.bold=true
text.boldness=2

