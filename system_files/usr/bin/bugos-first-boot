#!/usr/bin/bash
# bugos-first-boot - draait één keer na installatie (als systeemdienst).
#
# Zet de standaard-apps uit de Winkel klaar: Steam (als die er nog niet is),
# LibreOffice (kantoor), VLC (films en muziek), Gwenview (foto's) en Okular (PDF's).
# Lukt het niet (bijv. geen internet)? Dan probeert hij het de volgende keer
# opnieuw bij het opstarten.

set -u
KLAAR=/var/lib/bugos/eerste-start-klaar
# Later bijgekomen standaard-apps (Gwenview, Okular: U224) krijgen ook computers die de eerste start al deden,
# één keer (U239). Haal je ze daarna weg, dan blijven ze weg.
KLAAR2=/var/lib/bugos/standaard-apps-2
mkdir -p /var/lib/bugos

APPS=(
    org.libreoffice.LibreOffice
    org.videolan.VLC
    # Foto's en PDF's openen met dubbelklik: de fundering heeft er geen programma voor (U224).
    org.kde.gwenview
    org.kde.okular
)
# Steam als Flatpak alleen als de systeemversie ontbreekt.
command -v steam >/dev/null 2>&1 || APPS+=(com.valvesoftware.Steam)
# Al eens klaargezet: alleen wat er later bij kwam. Doe je updates zelf, dan ook dit niet vanzelf (U308).
if [ -f "$KLAAR" ]; then
    if ! /usr/bin/bugos-updates mag-vanzelf 2>/dev/null; then
        touch "$KLAAR2"
        exit 0
    fi
    APPS=(org.kde.gwenview org.kde.okular)
fi

# Even wachten op internet (de dienst wacht er niet meer op bij het opstarten) (U312).
nm-online -q -t 120 >/dev/null 2>&1 || true

# Niet over een verbinding met een databundel (telefoon-hotspot): dat is al gauw een paar gigabyte. Dan over
# vijf minuten opnieuw kijken (Restart=on-failure), zoals de dagelijkse app-updates (U180).
gemeten="$(busctl get-property org.freedesktop.NetworkManager /org/freedesktop/NetworkManager \
    org.freedesktop.NetworkManager Metered 2>/dev/null | cut -c 3-)"
if [ "$gemeten" = 1 ] || [ "$gemeten" = 3 ]; then
    echo "BugOS: verbinding met een databundel, de apps komen later." >&2
    exit 1
fi

flatpak remote-add --if-not-exists --system flathub https://dl.flathub.org/repo/flathub.flatpakrepo

if flatpak install --system --noninteractive --or-update flathub "${APPS[@]}"; then
    # De BugOS-stijl ook voor deze apps (Kvantum en Breeze-GTK in de Flatpak-doos).
    /usr/bin/bugos-flatpak-style || true
    touch "$KLAAR" "$KLAAR2"
else
    echo "BugOS: apps installeren lukte nog niet, volgende keer opnieuw." >&2
    exit 1
fi
