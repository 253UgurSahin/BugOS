#!/usr/bin/python3
"""BugOS Taakbeheer: zien wat je computer doet, en een programma sluiten dat vastzit.

Zoals Taakbeheer in Windows (Ctrl+Shift+Esc), maar simpeler:
- Programma's: wat er openstaat, hoeveel kracht en geheugen het gebruikt, en een knop
  'Sluiten' (netjes, net als op het kruisje klikken; reageert het niet, dan geforceerd).
- Prestaties: processor, geheugen, schijf, internet (en de videokaart) met grafiekjes.
- Opstarten: programma's die vanzelf meestarten aan- of uitzetten.
Bovenaan staat in gewone woorden hoe het gaat, met een tip als het druk is.
"""

from __future__ import annotations

import collections
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

sys.path.insert(0, "/usr/lib/bugos/python")

import bugos_taken as bt  # noqa: E402
from bugos_ui import (  # noqa: E402
    K, Kaart, Knop, Schuif, Zijbalk, label, lijn, lijn_icoon, maak_app, merk_label, sectie, t, uitvoeren,
)
from PySide6.QtCore import QRectF, QSize, Qt, QThread, QTimer, Signal  # noqa: E402
from PySide6.QtGui import QColor, QIcon, QKeySequence, QLinearGradient, QPainter, QPainterPath, QPen, QShortcut  # noqa: E402
from PySide6.QtWidgets import (  # noqa: E402
    QApplication, QFrame, QGridLayout, QHBoxLayout, QLabel, QMenu, QPushButton, QScrollArea, QStackedWidget,
    QVBoxLayout, QWidget,
)

GESCHIEDENIS = 60      # hoeveel metingen de grafiekjes laten zien (2 minuten)
TUSSENPOOS_MS = 2000   # elke 2 seconden meten


# =============================================================== metingen ===

class Meetdraad(QThread):
    """Meet op de achtergrond, zodat het venster nooit hapert."""

    meting = Signal(object)

    def __init__(self):
        super().__init__()
        self.meter = bt.Meter()
        self.stoppen = False
        self.voorbeeld = bool(os.environ.get("BUGOS_TAKEN_VOORBEELD"))
        self.stap = 0

    def run(self) -> None:
        while not self.stoppen:
            try:
                data = voorbeeld_meting(self.stap) if self.voorbeeld else self.meter.meet()
            except Exception:  # noqa: BLE001  een rare meting mag het venster nooit laten vallen
                data = None
            self.stap += 1
            if data is not None and not self.stoppen:
                self.meting.emit(data)
            for _ in range(TUSSENPOOS_MS // 100):
                if self.stoppen:
                    return
                self.msleep(100)


def voorbeeld_meting(stap: int) -> dict:
    """Voorbeeldgetallen voor foto's en demo's (BUGOS_TAKEN_VOORBEELD=1)."""
    import math
    import random

    def golf(basis: float, slag: float, snel: float = 0.35) -> float:
        """Een beetje grillig, zoals echte metingen: twee golfjes en wat ruis, af en toe een piekje."""
        r = random.Random(stap * 7919 + int(basis * 1000) + int(snel * 100))
        piek = slag * 1.6 if r.random() < 0.08 else 0.0
        waarde = basis + slag * (0.55 * math.sin(stap * snel) + 0.3 * math.sin(stap * snel * 2.7 + 1.3)
                                 + 0.35 * (r.random() - 0.5)) + piek
        return max(0.0, waarde)

    gb = 10**9
    taken = [
        bt.Taak("org.mozilla.firefox", "Firefox", "firefox", "app", "app-org.mozilla.firefox-1.scope",
                [101, 102, 103], golf(9, 4), int(2.1 * gb), True),
        bt.Taak("libreoffice-writer", "LibreOffice Writer", "libreoffice-writer", "app", "app-libreoffice-2.scope",
                [201], golf(1.2, 0.8), int(0.38 * gb), True),
        bt.Taak("com.spotify.Client", "Spotify", "com.spotify.Client", "app", "app-flatpak-com.spotify.Client-3.scope",
                [301, 302], golf(2.5, 1), int(0.46 * gb), True),
        bt.Taak("steam", "Steam", "steam", "app", "app-steam-4.scope", [401, 402], golf(1.5, 1, 0.5),
                int(0.61 * gb), True),
        bt.Taak("bugos-bestanden", "Bestanden", "system-file-manager", "app", "app-bugos\\x2dbestanden-5.scope",
                [501], golf(0.3, 0.3), int(0.09 * gb), True),
        bt.Taak("achtergrond:plasma-plasmashell.service:plasmashell", "Bureaublad (Plasma)", "", "achtergrond",
                "plasma-plasmashell.service", [601], golf(1.0, 0.6), int(0.31 * gb), True, True),
        bt.Taak("achtergrond:plasma-kwin_wayland.service:kwin_wayland", "Vensters (KWin)", "", "achtergrond",
                "plasma-kwin_wayland.service", [602], golf(1.4, 0.8), int(0.18 * gb), True, True),
        bt.Taak("achtergrond:baloo.service:baloo_file", "Zoeken in je bestanden", "", "achtergrond",
                "plasma-baloorunner.service", [603], golf(0.6, 0.4), int(0.12 * gb), True),
        bt.Taak("systeem:NetworkManager.service", "Netwerk", "", "systeem", "NetworkManager.service", [701],
                0.1, int(0.02 * gb), False, True),
    ]
    return {
        "processor": sum(x.processor for x in taken) + golf(3, 2, 0.9), "geheugen_totaal": 16 * gb,
        "geheugen_gebruikt": int(golf(5.4, 0.15, 0.2) * gb), "schijf": golf(2.2e6, 2.0e6, 0.8),
        "schijf_bezig": golf(4, 3, 0.8), "binnen": golf(1.4e6, 1.2e6, 0.6), "buiten": golf(1.2e5, 0.8e5, 0.7),
        "temperatuur": golf(52, 3, 0.25), "videokaart": golf(8, 6, 0.4), "taken": taken,
    }


# ============================================================== onderdelen ===

def stijl() -> str:
    return f"""
QFrame#rij {{ background: transparent; border-radius: 12px; }}
QFrame#rij:hover {{ background: {K['knop']}; }}
QPushButton#rond_klein {{ min-width: 36px; max-width: 36px; min-height: 36px; max-height: 36px; border-radius: 18px;
    background: transparent; border: none; padding: 0; }}
QPushButton#rond_klein:hover {{ background: {K['knop_hover']}; }}
QLabel#stip {{ border-radius: 6px; min-width: 12px; max-width: 12px; min-height: 12px; max-height: 12px; }}
QLabel#stip[soort="goed"] {{ background: {K['goed']}; }}
QLabel#stip[soort="let_op"] {{ background: {K['let_op']}; }}
QFrame#melding {{ background: {K['knop']}; border-radius: 14px; }}
QFrame#melding[soort="goed"] {{ background: {K['goed_zacht']}; }}
QFrame#melding[soort="fout"] {{ background: {K['fout_zacht']}; }}
"""


def app_icoon(naam: str) -> QIcon:
    if naam and Path(naam).is_absolute():
        return QIcon(naam)
    return QIcon.fromTheme(naam) if naam else QIcon()


class Grafiek(QWidget):
    """Een rustig lijntje met een zachte kleur eronder: hoe het de laatste twee minuten ging."""

    def __init__(self, maximum: float | None = 100.0):
        super().__init__()
        self.maximum = maximum  # None = past zich aan (voor schijf en internet)
        self.waarden: collections.deque[float] = collections.deque(maxlen=GESCHIEDENIS)
        self.setMinimumHeight(84)

    def voeg_toe(self, waarde: float) -> None:
        self.waarden.append(max(0.0, waarde))
        self.update()

    def paintEvent(self, _e) -> None:  # noqa: N802
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        r = QRectF(self.rect()).adjusted(1, 4, -1, -2)
        p.setPen(QPen(QColor(K["rand"]), 1))
        for i in range(1, 4):  # drie dunne hulplijntjes
            y = r.top() + r.height() * i / 4
            p.drawLine(r.left(), y, r.right(), y)
        if len(self.waarden) < 2:
            return
        hoogste = self.maximum or max(max(self.waarden) * 1.25, 1.0)
        stap = r.width() / (GESCHIEDENIS - 1)
        start = r.right() - stap * (len(self.waarden) - 1)
        punten = [(start + i * stap, r.bottom() - min(w / hoogste, 1.0) * r.height())
                  for i, w in enumerate(self.waarden)]
        lijn_ = QPainterPath()
        lijn_.moveTo(*punten[0])
        for (x0, y0), (x1, y1) in zip(punten, punten[1:]):
            midden = (x0 + x1) / 2
            lijn_.cubicTo(midden, y0, midden, y1, x1, y1)
        vlak = QPainterPath(lijn_)
        vlak.lineTo(punten[-1][0], r.bottom())
        vlak.lineTo(punten[0][0], r.bottom())
        vlak.closeSubpath()
        kleur_ = QColor(K["accent"])
        verloop = QLinearGradient(0, r.top(), 0, r.bottom())
        boven = QColor(kleur_)
        boven.setAlphaF(0.22)
        onder = QColor(kleur_)
        onder.setAlphaF(0.0)
        verloop.setColorAt(0, boven)
        verloop.setColorAt(1, onder)
        p.fillPath(vlak, verloop)
        p.setPen(QPen(kleur_, 2.2))
        p.drawPath(lijn_)


class MeetKaart(Kaart):
    """Een kaart op 'Prestaties': naam, groot getal, uitleg en een grafiekje."""

    def __init__(self, naam: str, maximum: float | None = 100.0):
        super().__init__(marge=22, ruimte=4)
        self.lay.addWidget(label(naam, "kop3", wrap=False))
        self.waarde = label("–", "kop2", wrap=False)
        self.uitleg = label("", "klein", wrap=False)
        self.lay.addWidget(self.waarde)
        self.lay.addWidget(self.uitleg)
        self.lay.addSpacing(8)
        self.grafiek = Grafiek(maximum)
        self.lay.addWidget(self.grafiek)

    def zet(self, waarde: str, uitleg: str, punt: float) -> None:
        self.waarde.setText(waarde)
        self.uitleg.setText(uitleg)
        self.grafiek.voeg_toe(punt)


class Melding(QFrame):
    """Een korte melding bovenaan, eventueel met een knop (bijvoorbeeld 'Geforceerd sluiten')."""

    def __init__(self):
        super().__init__()
        self.setObjectName("melding")
        lay = QHBoxLayout(self)
        lay.setContentsMargins(16, 8, 8, 8)
        lay.setSpacing(12)
        self.tekst = label("", wrap=True)
        self.knop = Knop("", "gewoon")
        self.knop.setMinimumHeight(36)
        lay.addWidget(self.tekst, 1)
        lay.addWidget(self.knop)
        self.actie = None
        self.knop.clicked.connect(self._klik)
        self.klok = QTimer(self)
        self.klok.setSingleShot(True)
        self.klok.timeout.connect(self.hide)
        self.hide()

    def toon(self, tekst: str, soort: str = "info", knop: str = "", actie=None, seconden: int = 8) -> None:
        self.setProperty("soort", soort)
        self.style().unpolish(self)
        self.style().polish(self)
        self.tekst.setText(tekst)
        self.knop.setText(knop)
        self.knop.setVisible(bool(knop))
        self.actie = actie
        self.show()
        if seconden:
            self.klok.start(seconden * 1000)
        else:
            self.klok.stop()

    def _klik(self) -> None:
        actie, self.actie = self.actie, None
        self.hide()
        if actie:
            actie()


class TaakRij(QFrame):
    """Eén programma (of achtergrondtaak): icoon, naam, kracht, geheugen en 'Sluiten'."""

    def __init__(self, taak: bt.Taak, sluiten, forceren):
        super().__init__()
        self.setObjectName("rij")
        self.sleutel = taak.sleutel
        self.setMinimumHeight(56)
        lay = QHBoxLayout(self)
        lay.setContentsMargins(12, 6, 8, 6)
        lay.setSpacing(14)
        ic = QLabel()
        icoon = app_icoon(taak.icoon)
        if icoon.isNull():
            icoon = lijn_icoon("apps" if taak.soort == "app" else "schakelaar", "tekst3", 26, gekozen=None)
        ic.setPixmap(icoon.pixmap(QSize(26, 26)))
        ic.setFixedSize(28, 28)
        lay.addWidget(ic)
        self.naam = label(taak.naam, "kop3" if taak.soort == "app" else "", wrap=False)
        lay.addWidget(self.naam, 1)
        self.processor = label("", "klein", wrap=False)
        self.processor.setFixedWidth(84)
        self.processor.setAlignment(Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter)
        self.geheugen = label("", "klein", wrap=False)
        self.geheugen.setFixedWidth(92)
        self.geheugen.setAlignment(Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter)
        lay.addWidget(self.processor)
        lay.addWidget(self.geheugen)
        self.knop = None
        self.meer = None
        if taak.beschermd or not taak.eigen:
            vast = label(t("Hoort bij BugOS", "Part of BugOS"), "klein", wrap=False)
            vast.setFixedWidth(160)
            vast.setAlignment(Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter)
            lay.addWidget(vast)
        else:
            self.knop = Knop(t("Sluiten", "Close") if taak.soort == "app" else t("Beëindigen", "End"), "gewoon")
            self.knop.setMinimumHeight(36)
            self.knop.setFixedWidth(116)
            self.knop.clicked.connect(lambda _c=False: sluiten(self.taak))
            lay.addWidget(self.knop)
            self.meer = QPushButton()
            self.meer.setObjectName("rond_klein")
            self.meer.setIcon(lijn_icoon("meer", "tekst2", 20, gekozen=None))
            self.meer.setIconSize(QSize(20, 20))
            self.meer.setToolTip(t("Meer", "More"))
            self.meer.setCursor(Qt.CursorShape.PointingHandCursor)
            self.meer.clicked.connect(lambda _c=False: self._menu(forceren))
            lay.addWidget(self.meer)
        self.zet(taak)

    def _menu(self, forceren) -> None:
        m = QMenu(self)
        a = m.addAction(lijn_icoon("kruis", "fout", 18, gekozen=None),
                        t("Geforceerd sluiten (als hij niet reageert)", "Force close (if it does not respond)"))
        a.triggered.connect(lambda _c=False: forceren(self.taak))
        m.exec(self.meer.mapToGlobal(self.meer.rect().bottomLeft()))

    def zet(self, taak: bt.Taak) -> None:
        self.taak = taak
        self.naam.setText(taak.naam)
        procent = taak.processor
        self.processor.setText(f"{procent:.0f}%" if procent >= 0.5 else "0%")
        kleur_ = K["fout"] if procent >= 50 else K["let_op"] if procent >= 20 else K["tekst2"]
        self.processor.setStyleSheet(f"color: {kleur_};" + (" font-weight: 600;" if procent >= 20 else ""))
        self.geheugen.setText(bt.maat(taak.geheugen))


class OpstartRij(QFrame):
    """Een programma dat vanzelf meestart, met een schuifje."""

    def __init__(self, item: bt.Opstart, omzetten):
        super().__init__()
        self.setObjectName("rij")
        self.setMinimumHeight(60)
        lay = QHBoxLayout(self)
        lay.setContentsMargins(14, 8, 14, 8)
        lay.setSpacing(14)
        ic = QLabel()
        icoon = app_icoon(item.icoon)
        if icoon.isNull():
            icoon = lijn_icoon("apps", "tekst3", 26, gekozen=None)
        ic.setPixmap(icoon.pixmap(QSize(26, 26)))
        ic.setFixedSize(28, 28)
        lay.addWidget(ic)
        lay.addWidget(label(item.naam, "kop3", wrap=False), 1)
        self.stand = label("", "klein", wrap=False)
        lay.addWidget(self.stand)
        self.schuif = Schuif(item.aan)
        self.schuif.setAccessibleName(item.naam)
        self.schuif.toggled.connect(lambda aan: (omzetten(item, aan), self._tekst(aan)))
        lay.addWidget(self.schuif)
        self._tekst(item.aan)

    def _tekst(self, aan: bool) -> None:
        self.stand.setText(t("Start mee", "Starts") if aan else t("Start niet mee", "Does not start"))


def lijst_kaart() -> tuple[QFrame, QVBoxLayout]:
    kaart = Kaart(marge=6, ruimte=0)
    return kaart, kaart.lay


# ================================================================= venster ===

class Taakbeheer(QWidget):
    def __init__(self):
        super().__init__()
        self.setObjectName("venster")
        self.setWindowTitle(t("Taakbeheer", "Task Manager"))
        self.setStyleSheet(stijl())
        self.resize(1080, 720)
        self.setMinimumSize(900, 560)
        self.processor_geschiedenis: list[float] = []
        self.rijen: dict[str, TaakRij] = {}
        self.achter_rijen: dict[str, TaakRij] = {}
        self.laatste: dict | None = None

        hoofd = QHBoxLayout(self)
        hoofd.setContentsMargins(0, 0, 0, 0)
        hoofd.setSpacing(0)

        # --- links: drie plekken
        zij = QWidget()
        zij.setObjectName("zijkant")
        zij.setFixedWidth(232)
        zl = QVBoxLayout(zij)
        zl.setContentsMargins(14, 22, 14, 14)
        zl.setSpacing(12)
        merk = merk_label(26)
        merk.setContentsMargins(8, 0, 0, 8)
        zl.addWidget(merk)
        self.zijbalk = Zijbalk()
        self.zijbalk.voeg_toe("lijn:apps", t("Programma's", "Programs"), "programmas")
        self.zijbalk.voeg_toe("lijn:grafiek", t("Prestaties", "Performance"), "prestaties")
        self.zijbalk.voeg_toe("lijn:aan", t("Opstarten", "Startup"), "opstarten")
        self.zijbalk.currentRowChanged.connect(self.kies_pagina)
        zl.addWidget(self.zijbalk, 1)
        if shutil.which("plasma-systemmonitor"):
            gevorderd = Knop(t("Systeemmonitor", "System Monitor"), "stil", "lijn:code")
            gevorderd.setToolTip(t("Alles tot in detail (voor gevorderden)", "Everything in detail (advanced)"))
            gevorderd.clicked.connect(lambda _c=False: subprocess.Popen(["plasma-systemmonitor"],
                                                                        start_new_session=True))
            zl.addWidget(gevorderd)
        hoofd.addWidget(zij)

        # --- rechts: titel, melding, pagina's
        rechts = QVBoxLayout()
        rechts.setContentsMargins(34, 28, 34, 18)
        rechts.setSpacing(10)
        self.titel = label(t("Programma's", "Programs"), "titel", wrap=False)
        rechts.addWidget(self.titel)
        regel = QHBoxLayout()
        regel.setSpacing(10)
        self.stip = QLabel()
        self.stip.setObjectName("stip")
        self.stip.setProperty("soort", "goed")
        regel.addWidget(self.stip, 0, Qt.AlignmentFlag.AlignVCenter)
        self.status = label(t("Even kijken…", "Taking a look…"), "sub", wrap=False)
        regel.addWidget(self.status, 1)
        rechts.addLayout(regel)
        self.melding = Melding()
        rechts.addWidget(self.melding)
        rechts.addSpacing(6)
        self.paginas = QStackedWidget()
        self.paginas.addWidget(self.maak_programmas())
        self.paginas.addWidget(self.maak_prestaties())
        self.paginas.addWidget(self.maak_opstarten())
        rechts.addWidget(self.paginas, 1)
        hoofd.addLayout(rechts, 1)

        sluit = QShortcut(QKeySequence("Escape"), self)
        sluit.activated.connect(self.close)
        self.zijbalk.setCurrentRow(0)

        self.draad = Meetdraad()
        self.draad.meting.connect(self.nieuwe_meting)
        self.draad.start()
        QApplication.instance().aboutToQuit.connect(self.stop_meten)

    def stop_meten(self) -> None:
        self.draad.stoppen = True
        self.draad.wait(3000)

    # ------------------------------------------------------------ pagina's
    @staticmethod
    def scroll(binnen: QWidget) -> QScrollArea:
        vlak = QScrollArea()
        vlak.setFrameShape(QFrame.Shape.NoFrame)
        vlak.setWidgetResizable(True)
        vlak.viewport().setAutoFillBackground(False)
        binnen.setObjectName("pagina")
        vlak.setWidget(binnen)
        return vlak

    def maak_programmas(self) -> QWidget:
        w = QWidget()
        lay = QVBoxLayout(w)
        lay.setContentsMargins(0, 0, 6, 0)
        lay.setSpacing(10)
        # samenvatting: vier getallen op een rij
        samen = Kaart(marge=20, ruimte=0, richting="h")
        self.kort: dict[str, QLabel] = {}
        for i, (sleutel, naam) in enumerate((("processor", t("Processor", "Processor")),
                                             ("geheugen", t("Geheugen", "Memory")),
                                             ("schijf", t("Schijf", "Disk")),
                                             ("internet", t("Internet", "Internet")))):
            if i:
                streep = QFrame()
                streep.setFixedWidth(1)
                streep.setStyleSheet(f"background: {K['rand']};")
                samen.lay.addWidget(streep)
            blok = QVBoxLayout()
            blok.setContentsMargins(14 if i else 4, 0, 4, 0)
            blok.setSpacing(2)
            blok.addWidget(label(naam, "klein", wrap=False))
            self.kort[sleutel] = label("–", "kop2", wrap=False)
            blok.addWidget(self.kort[sleutel])
            samen.lay.addLayout(blok, 1)
        lay.addWidget(samen)
        lay.addSpacing(8)
        kop = QHBoxLayout()
        kop.setContentsMargins(6 + 12, 0, 6 + 8, 0)  # dezelfde marges als de regels in de kaart
        kop.setSpacing(14)
        kop.addWidget(sectie(t("Open programma's", "Open programs")), 1)
        for tekst, breedte in ((t("Processor", "Processor"), 84), (t("Geheugen", "Memory"), 92)):
            k = sectie(tekst)
            k.setFixedWidth(breedte)
            k.setAlignment(Qt.AlignmentFlag.AlignRight)
            kop.addWidget(k)
        kop.addSpacing(116 + 14 + 36)
        lay.addLayout(kop)
        self.apps_kaart, self.apps_lay = lijst_kaart()
        lay.addWidget(self.apps_kaart)
        self.geen_apps = label(t("Er staan geen programma's open.", "No programs are open."), "sub")
        self.geen_apps.setContentsMargins(14, 10, 14, 10)
        self.apps_lay.addWidget(self.geen_apps)
        lay.addSpacing(6)
        self.achter_knop = Knop(t("Achtergrond tonen (voor gevorderden)", "Show background (advanced)"), "stil",
                                "lijn:rechts")
        self.achter_knop.clicked.connect(self.wissel_achtergrond)
        lay.addWidget(self.achter_knop, 0, Qt.AlignmentFlag.AlignLeft)
        self.achter_kaart, self.achter_lay = lijst_kaart()
        self.achter_kaart.hide()
        lay.addWidget(self.achter_kaart)
        lay.addStretch(1)
        return self.scroll(w)

    def maak_prestaties(self) -> QWidget:
        w = QWidget()
        rooster = QGridLayout(w)
        rooster.setContentsMargins(0, 0, 6, 0)
        rooster.setSpacing(14)
        self.kaart_processor = MeetKaart(t("Processor", "Processor"))
        self.kaart_geheugen = MeetKaart(t("Geheugen", "Memory"))
        self.kaart_schijf = MeetKaart(t("Schijf", "Disk"), None)
        self.kaart_internet = MeetKaart(t("Internet", "Internet"), None)
        self.kaart_video = MeetKaart(t("Videokaart", "Graphics card"))
        self.kaart_video.hide()
        for i, k in enumerate((self.kaart_processor, self.kaart_geheugen, self.kaart_schijf, self.kaart_internet,
                               self.kaart_video)):
            rooster.addWidget(k, i // 3, i % 3)
        for kolom in range(3):
            rooster.setColumnStretch(kolom, 1)
        rooster.setRowStretch(2, 1)
        return self.scroll(w)

    def maak_opstarten(self) -> QWidget:
        w = QWidget()
        self.opstart_lay = QVBoxLayout(w)
        self.opstart_lay.setContentsMargins(0, 0, 6, 0)
        self.opstart_lay.setSpacing(10)
        return self.scroll(w)

    def vul_opstarten(self) -> None:
        lay = self.opstart_lay
        while lay.count():
            item = lay.takeAt(0)
            if item.widget():
                item.widget().deleteLater()
        lay.addWidget(label(t("Deze programma's starten vanzelf als je inlogt. Zet uit wat je niet elke dag nodig "
                              "hebt: dan is je computer sneller klaar.",
                              "These programs start by themselves when you log in. Turn off what you do not need "
                              "every day: then your computer is ready sooner."), "sub"))
        lay.addSpacing(4)
        lijst = bt.opstart_lijst()
        kaart, rijen = lijst_kaart()
        for i, item in enumerate(lijst):
            if i:
                rijen.addWidget(lijn())
            rijen.addWidget(OpstartRij(item, self.zet_opstart))
        if not lijst:
            leeg = label(t("Er start niets extra mee. Mooi zo: zo is je computer snel klaar.",
                           "Nothing extra starts. Good: your computer is ready quickly."), "sub")
            leeg.setContentsMargins(14, 12, 14, 12)
            rijen.addWidget(leeg)
        lay.addWidget(kaart)
        lay.addStretch(1)

    def zet_opstart(self, item: bt.Opstart, aan: bool) -> None:
        try:
            bt.zet_opstart(item, aan)
            item.aan = aan
            self.melding.toon(t(f"{item.naam} start voortaan mee.", f"{item.naam} will start from now on.") if aan
                              else t(f"{item.naam} start voortaan niet meer mee.", f"{item.naam} will no longer start."),
                              "goed", seconden=5)
        except OSError as e:
            self.melding.toon(t(f"Dat lukte niet: {e.strerror}", f"That did not work: {e.strerror}"), "fout")

    def kies_pagina(self, rij: int) -> None:
        if rij < 0:
            return
        self.paginas.setCurrentIndex(rij)
        self.titel.setText((t("Programma's", "Programs"), t("Prestaties", "Performance"),
                            t("Opstarten", "Startup"))[rij])
        if rij == 2:
            self.vul_opstarten()

    def wissel_achtergrond(self) -> None:
        zichtbaar = not self.achter_kaart.isVisible()
        self.achter_kaart.setVisible(zichtbaar)
        self.achter_knop.setIcon(lijn_icoon("onder" if zichtbaar else "rechts", "tekst", 18, gekozen=None))
        self.achter_knop.setText(t("Achtergrond verbergen", "Hide background") if zichtbaar
                                 else t("Achtergrond tonen (voor gevorderden)", "Show background (advanced)"))

    # ------------------------------------------------------------ metingen
    def nieuwe_meting(self, m: dict) -> None:
        self.laatste = m
        self.processor_geschiedenis = (self.processor_geschiedenis + [m["processor"]])[-GESCHIEDENIS:]
        taken = m["taken"]
        soort, zin = bt.advies(self.processor_geschiedenis, m["geheugen_gebruikt"], m["geheugen_totaal"], taken)
        self.status.setText(zin)
        if self.stip.property("soort") != soort:
            self.stip.setProperty("soort", soort)
            self.stip.style().unpolish(self.stip)
            self.stip.style().polish(self.stip)
        gebruikt, totaal = m["geheugen_gebruikt"], m["geheugen_totaal"]
        self.kort["processor"].setText(f"{m['processor']:.0f}%")
        self.kort["geheugen"].setText(t(f"{bt.maat(gebruikt)} van {bt.maat(totaal)}", f"{bt.maat(gebruikt)} of "
                                        f"{bt.maat(totaal)}"))
        self.kort["schijf"].setText(bt.snelheid(m["schijf"]))
        self.kort["internet"].setText(bt.snelheid(m["binnen"] + m["buiten"]))
        # prestaties
        temp = m.get("temperatuur")
        kernen = bt.aantal_kernen()
        self.kaart_processor.zet(f"{m['processor']:.0f}%",
                                 (t(f"{temp:.0f} °C · ", f"{temp:.0f} °C · ") if temp else "")
                                 + t(f"{kernen} kernen", f"{kernen} cores"), m["processor"])
        self.kaart_geheugen.zet(bt.maat(gebruikt), t(f"in gebruik, van de {bt.maat(totaal)}",
                                                     f"in use, of {bt.maat(totaal)}"),
                                gebruikt / totaal * 100 if totaal else 0)
        self.kaart_schijf.zet(bt.snelheid(m["schijf"]), t(f"{m['schijf_bezig']:.0f}% van de tijd bezig",
                                                          f"busy {m['schijf_bezig']:.0f}% of the time"), m["schijf"])
        self.kaart_internet.zet(t(f"↓ {bt.snelheid(m['binnen'])}", f"↓ {bt.snelheid(m['binnen'])}"),
                                t(f"↑ {bt.snelheid(m['buiten'])} verstuurd", f"↑ {bt.snelheid(m['buiten'])} sent"),
                                m["binnen"] + m["buiten"])
        if m.get("videokaart") is not None:
            self.kaart_video.show()
            self.kaart_video.zet(f"{m['videokaart']:.0f}%", t("bezig", "busy"), m["videokaart"])
        # programma's
        self.werk_lijst_bij(self.apps_lay, self.rijen, [x for x in taken if x.soort == "app"], self.geen_apps)
        achter = sorted([x for x in taken if x.soort != "app"],
                        key=lambda x: (x.soort == "systeem", -x.processor, -x.geheugen))[:60]
        self.werk_lijst_bij(self.achter_lay, self.achter_rijen, achter, None)
        n = len([x for x in taken if x.soort != "app"])
        if not self.achter_kaart.isVisible():
            self.achter_knop.setText(t(f"Achtergrond tonen ({n}, voor gevorderden)",
                                       f"Show background ({n}, advanced)"))

    def werk_lijst_bij(self, lay: QVBoxLayout, rijen: dict[str, TaakRij], taken: list[bt.Taak],
                       leeg: QLabel | None) -> None:
        """Bestaande regels bijwerken; alleen als er iets bij komt of weggaat, de lijst opnieuw opbouwen."""
        sleutels = [x.sleutel for x in taken]
        if sleutels == list(rijen):
            for x in taken:
                rijen[x.sleutel].zet(x)
            return
        oud = dict(rijen)
        rijen.clear()
        while lay.count():
            item = lay.takeAt(0)
            w = item.widget()
            if w is not None and w is not leeg:
                w.setParent(None)
        for x in taken:
            rij = oud.pop(x.sleutel, None)
            if rij is None:
                rij = TaakRij(x, self.sluiten, self.forceren)
            else:
                rij.zet(x)
            if rijen:
                lay.addWidget(lijn())
            lay.addWidget(rij)
            rijen[x.sleutel] = rij
        for rij in oud.values():
            rij.deleteLater()
        if leeg is not None:
            lay.addWidget(leeg)
            leeg.setVisible(not taken)

    # ------------------------------------------------------------- sluiten
    def sluiten(self, taak: bt.Taak) -> None:
        """Netjes sluiten: de vensters dicht, zoals op het kruisje klikken (het programma kan nog vragen
        of je wilt opslaan). Achtergrondtaken krijgen een vriendelijk stopverzoek."""
        if taak.soort == "app" and self.sluit_vensters(taak.pids):
            self.melding.toon(t(f"{taak.naam} wordt gesloten…", f"Closing {taak.naam}…"), seconden=6)
        else:
            bt.stop(taak.pids)
            self.melding.toon(t(f"{taak.naam} wordt gestopt…", f"Stopping {taak.naam}…"), seconden=6)
        QTimer.singleShot(6000, lambda: self.nog_open(taak))

    def nog_open(self, taak: bt.Taak) -> None:
        if not bt.leeft(taak.pids):
            self.melding.toon(t(f"{taak.naam} is gesloten.", f"{taak.naam} is closed."), "goed", seconden=5)
            return
        self.melding.toon(
            t(f"{taak.naam} is nog open. Vraagt het iets, bijvoorbeeld of je wilt opslaan? Kijk dan even in dat "
              "venster. Reageert het niet? Sluit het dan geforceerd.",
              f"{taak.naam} is still open. Is it asking something, for example whether to save? Then look at that "
              "window. Not responding? Then force it to close."),
            "fout", knop=t("Geforceerd sluiten", "Force close"), actie=lambda: self.forceren(taak), seconden=0)

    def forceren(self, taak: bt.Taak) -> None:
        if taak.beschermd:
            return
        bt.stop(taak.pids, hard=True)
        if taak.soort == "app" and taak.eenheid and shutil.which("systemctl"):
            subprocess.run(["systemctl", "--user", "kill", "--signal=SIGKILL", taak.eenheid],
                           capture_output=True, timeout=10)
        self.melding.toon(t(f"{taak.naam} is geforceerd gesloten.", f"{taak.naam} was force closed."), "goed",
                          seconden=5)

    @staticmethod
    def sluit_vensters(pids: list[int]) -> bool:
        """Vraag KWin (die de vensters beheert) om de vensters van deze programma's te sluiten."""
        if not shutil.which("gdbus"):
            return False
        map_ = Path(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir())
        naam = f"bugos-sluit-{os.getpid()}-{int(time.time() * 1000)}"
        script = map_ / f"{naam}.js"
        bus = ["gdbus", "call", "--session", "--dest", "org.kde.KWin"]
        try:
            script.write_text(bt.sluit_script(pids), encoding="utf-8")
            uit = subprocess.run(bus + ["--object-path", "/Scripting", "--method",
                                        "org.kde.kwin.Scripting.loadScript", str(script), naam],
                                 capture_output=True, text=True, timeout=5).stdout
            nummer = uit.strip("()\n ,").split(",")[0].strip()
            if not nummer.lstrip("-").isdigit() or int(nummer) < 0:
                return False
            subprocess.run(bus + ["--object-path", f"/Scripting/Script{nummer}", "--method", "org.kde.kwin.Script.run"],
                           capture_output=True, timeout=5)
            subprocess.run(bus + ["--object-path", "/Scripting", "--method", "org.kde.kwin.Scripting.unloadScript",
                                  naam], capture_output=True, timeout=5)
            return True
        except (OSError, subprocess.SubprocessError):
            return False
        finally:
            try:
                script.unlink()
            except OSError:
                pass

    def closeEvent(self, e) -> None:  # noqa: N802
        self.stop_meten()
        super().closeEvent(e)


def main() -> int:
    app = maak_app("bugos-taakbeheer", "bugos-taakbeheer", sys.argv)
    venster = Taakbeheer()
    if "--prestaties" in sys.argv:
        venster.zijbalk.setCurrentRow(1)
    elif "--opstarten" in sys.argv:
        venster.zijbalk.setCurrentRow(2)
    return uitvoeren(app, venster)


if __name__ == "__main__":
    sys.exit(main())
