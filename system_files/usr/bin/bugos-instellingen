QListWidget#keuzelijst::item:selected {{ background: {K['accent_zacht']}; color: {K['accent']}; font-weight: 600; }}
"""


class Keuzes(QFrame):
    """Een paar knoppen naast elkaar waarvan er één gekozen is (zoals 100% · 125% · 150%)."""

    gekozen = Signal(object)

    def __init__(self, opties: list[tuple[object, str]]):
        super().__init__()
        self.setObjectName("keuzes")
        lay = QHBoxLayout(self)
        lay.setContentsMargins(3, 3, 3, 3)
        lay.setSpacing(2)
        self.groep = QButtonGroup(self)
        self.knoppen: dict[object, QPushButton] = {}
        for waarde, tekst in opties:
            k = QPushButton(tekst)
            k.setObjectName("keus")
            k.setCheckable(True)
            k.setCursor(Qt.CursorShape.PointingHandCursor)
            k.clicked.connect(lambda _c=False, w=waarde: self.gekozen.emit(w))
            self.groep.addButton(k)
            self.knoppen[waarde] = k
            lay.addWidget(k)

    def zet(self, waarde: object) -> None:
        k = self.knoppen.get(waarde)
        if k is not None:
            k.setChecked(True)


class Regelaar(QWidget):
    """Een schuifbalk met het getal ernaast (volume, helderheid)."""

    veranderd = Signal(int)

    def __init__(self, waarde: int = 50):
        super().__init__()
        lay = QHBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(12)
        self.balk = QSlider(Qt.Orientation.Horizontal)
        self.balk.setRange(0, 100)
        self.balk.setValue(waarde)
        self.balk.setMinimumWidth(220)
        self.balk.setCursor(Qt.CursorShape.PointingHandCursor)
        lay.addWidget(self.balk, 1)
        self.getal = label(f"{waarde}%", "kop3", wrap=False)
        self.getal.setFixedWidth(48)
        self.getal.setAlignment(Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter)
        lay.addWidget(self.getal)
        self.wacht = QTimer(self)
        self.wacht.setSingleShot(True)
        self.wacht.setInterval(120)  # niet bij elke pixel iets aan de computer veranderen
        self.wacht.timeout.connect(lambda: self.veranderd.emit(self.balk.value()))
        self.balk.valueChanged.connect(lambda w: (self.getal.setText(f"{w}%"), self.wacht.start()))

    def zet(self, waarde: int) -> None:
        self.balk.blockSignals(True)
        self.balk.setValue(waarde)
        self.balk.blockSignals(False)
        self.getal.setText(f"{waarde}%")


def schuifje(aan: bool, omgezet) -> Schuif:
    s = Schuif(aan)
    s.toggled.connect(omgezet)
    return s


def menu_bij(knop: QWidget, items: list[tuple[str, str, object]]) -> None:
    """Een klein menu onder een knop: [(icoon, tekst, actie), ...]."""
    m = QMenu(knop)
    for ic, tekst, actie in items:
        a = m.addAction(lijn_icoon(ic, "tekst", 18, gekozen=None), tekst)
        a.triggered.connect(lambda _c=False, f=actie: f())
    m.exec(knop.mapToGlobal(knop.rect().bottomLeft()))


def meer_knop(items_maker) -> QPushButton:
    """Een '…'-knopje dat een menu opent (items_maker geeft de lijst voor menu_bij)."""
    k = ronde_knop("meer", t("Meer", "More"), klein=True)
    k.clicked.connect(lambda _c=False: menu_bij(k, items_maker()))
    return k


class Blad(Pagina):
    """Een pagina van Instellingen: titel, uitleg, kaarten, en onderaan de weg naar KDE voor gevorderden."""

    sleutel = ""
    icoon = ""
    titel_nl = titel_en = ""
    uitleg_nl = uitleg_en = ""
    zoekwoorden = ""
    kde = ""  # het KDE-onderdeel achter 'Meer instellingen (voor gevorderden)'

    def __init__(self, venster: Instellingen):
        super().__init__(self.naam(), t(self.uitleg_nl, self.uitleg_en) if self.uitleg_nl else "")
        self.venster = venster
        self.bouw()
        if self.kde:
            meer = Knop(t("Meer instellingen (voor gevorderden)", "More settings (advanced)"), "stil", "lijn:code")
            meer.clicked.connect(lambda _c=False: kde_instelling(self.kde))
            self.lay.addWidget(meer, 0, Qt.AlignmentFlag.AlignLeft)
        self.klaar()

    @classmethod
    def naam(cls) -> str:
        return t(cls.titel_nl, cls.titel_en)

    def bouw(self) -> None:
        pass


# ================================================================== wifi ===

def sterkte_woord(n: int) -> str:
    return t("Sterk", "Strong") if n >= 70 else t("Goed", "Good") if n >= 45 else t("Zwak", "Weak")


class WifiPagina(Blad):
    sleutel, icoon = "wifi", "wifi"
    titel_nl, titel_en = "Wifi en internet", "Wi-Fi and internet"
    uitleg_nl = "Klik op een netwerk om te verbinden. BugOS onthoudt het wachtwoord."
    uitleg_en = "Click a network to connect. BugOS remembers the password."
    zoekwoorden = "wifi wlan internet netwerk draadloos wachtwoord kabel ethernet verbinding"
    kde = "kcm_networkmanagement"

    def bouw(self) -> None:
        g = self.kaart()
        self.schakel = schuifje(True, self.zet_wifi)
        self.hoofd = Rij("wifi", t("Wifi", "Wi-Fi"), "", self.schakel)
        g.voeg(self.hoofd)
        self.kabel = Rij("computer", t("Kabel", "Cable"), t("Verbonden met een netwerkkabel", "Connected by cable"))
        self.kabel.hide()
        g.voeg(self.kabel)
        kop = QHBoxLayout()
        kop.addWidget(sectie(t("Netwerken in de buurt", "Networks nearby")), 1)
        self.zoek_knop = Knop(t("Opnieuw zoeken", "Search again"), "stil", "lijn:verversen")
        self.zoek_knop.clicked.connect(lambda _c=False: self.ververs(True))
        kop.addWidget(self.zoek_knop)
        self.lay.addLayout(kop)
        self.lijst = self.kaart()

    def ververs(self, opnieuw: bool = False) -> None:
        self.hoofd.zet_uitleg(t("Even zoeken…", "Searching…"))
        op_achtergrond(self, lambda: (bi.wifi_aan(), bi.netwerken(opnieuw), bi.kabel_verbonden()), self.toon)

    def toon(self, uitkomst) -> None:
        if not uitkomst:
            return
        aan, netwerken, kabel = uitkomst
        self.schakel.zet_stil(aan)
        self.kabel.setVisible(kabel)
        nu = next((n for n in netwerken if n.verbonden), None)
        self.hoofd.zet_uitleg(t(f"Verbonden met {nu.naam}", f"Connected to {nu.naam}") if nu else
                              (t("Niet verbonden", "Not connected") if aan else t("Uit", "Off")))
        leeg_groep(self.lijst)
        for n in netwerken:
            slot = t(" · met wachtwoord", " · with password") if n.beveiligd else t(" · open netwerk", " · open network")
            if n.verbonden:
                meer = meer_knop(lambda x=n: [("kruis", t("Verbreken", "Disconnect"), lambda: self.verbreek(x))])
                self.lijst.voeg(Rij("vink", n.naam, t("Verbonden · ", "Connected · ") + sterkte_woord(n.sterkte) + slot,
                                    meer))
            else:
                rij = Rij("slot" if n.beveiligd else "wifi", n.naam, sterkte_woord(n.sterkte) + slot, klikbaar=True,
                          pijl=False)
                rij.geklikt.connect(lambda x=n: self.verbind(x))
                self.lijst.voeg(rij)
        if not netwerken:
            self.lijst.voeg(Rij("wifi", t("Geen netwerken gevonden", "No networks found") if aan else
                                t("Wifi staat uit", "Wi-Fi is off"),
                                t("Zet wifi aan of zoek opnieuw.", "Turn on Wi-Fi or search again.")))

    def zet_wifi(self, aan: bool) -> None:
        op_achtergrond(self, lambda: bi.zet_wifi(aan), lambda _u: QTimer.singleShot(1500, self.ververs))

    def verbind(self, n: bi.Netwerk) -> None:
        wachtwoord = ""
        if n.beveiligd and not bi.bekend_netwerk(n.naam):
            d = QInputDialog(self)
            d.setWindowTitle(t("Wachtwoord", "Password"))
            d.setLabelText(t(f"Wat is het wachtwoord van '{n.naam}'?\n(Het staat vaak op de onderkant van het modem.)",
                             f"What is the password of '{n.naam}'?\n(It is often on the bottom of the router.)"))
            d.setTextEchoMode(QLineEdit.EchoMode.Password)
            d.setOkButtonText(t("Verbinden", "Connect"))
            d.setCancelButtonText(t("Annuleren", "Cancel"))
            if not d.exec() or not d.textValue():
                return
            wachtwoord = d.textValue()
        self.melding.toon(t(f"Verbinden met {n.naam}…", f"Connecting to {n.naam}…"), seconden=30)

        def klaar(uitkomst) -> None:
            gelukt = bool(uitkomst and uitkomst[0])
            self.melding.toon(t(f"Verbonden met {n.naam}.", f"Connected to {n.naam}.") if gelukt else
                              t("Verbinden lukte niet. Klopt het wachtwoord? Probeer het nog eens.",
                                "Connecting did not work. Is the password right? Try again."),
                              "goed" if gelukt else "fout")
            self.ververs()

        op_achtergrond(self, lambda: bi.verbind(n.naam, wachtwoord), klaar)

    def verbreek(self, n: bi.Netwerk) -> None:
        op_achtergrond(self, lambda: bi.verbreek(n.naam), lambda _u: self.ververs())


# ============================================================= bluetooth ===

def apparaat_icoon(soort: str) -> str:
    if soort.startswith("audio"):
        return "geluid"
    if soort.startswith("input-gaming"):
        return "spel"
    if soort == "phone":
        return "praten"
    return "bluetooth"


class BluetoothPagina(Blad):
    sleutel, icoon = "bluetooth", "bluetooth"
    titel_nl, titel_en = "Bluetooth", "Bluetooth"
    uitleg_nl = "Koptelefoons, muizen, toetsenborden en telefoons zonder draad. Klik op een apparaat om te verbinden."
    uitleg_en = "Headphones, mice, keyboards and phones without a cable. Click a device to connect."
    zoekwoorden = "bluetooth koptelefoon oortjes muis toetsenbord telefoon koppelen draadloos"
    kde = "kcm_bluetooth"

    def bouw(self) -> None:
        g = self.kaart()
        self.schakel = schuifje(True, self.zet_bt)
        self.hoofd = Rij("bluetooth", "Bluetooth", "", self.schakel)
        g.voeg(self.hoofd)
        kop = QHBoxLayout()
        kop.addWidget(sectie(t("Jouw apparaten", "Your devices")), 1)
        nieuw = Knop(t("Nieuw apparaat koppelen", "Pair a new device"), "stil", "lijn:map-plus")
        nieuw.clicked.connect(lambda _c=False: start("bluedevil-wizard") if bestaat("bluedevil-wizard")
                              else kde_instelling("kcm_bluetooth"))
        kop.addWidget(nieuw)
        self.lay.addLayout(kop)
        self.lijst = self.kaart()

    def ververs(self) -> None:
        op_achtergrond(self, lambda: (bi.bt_aan(), bi.bt_apparaten()), self.toon)

    def toon(self, uitkomst) -> None:
        if not uitkomst:
            return
        aan, apparaten = uitkomst
        self.schakel.zet_stil(aan)
        verbonden = sum(1 for a in apparaten if a.verbonden)
        self.hoofd.zet_uitleg((t(f"Aan · {verbonden} verbonden", f"On · {verbonden} connected") if verbonden
                               else t("Aan", "On")) if aan else t("Uit", "Off"))
        leeg_groep(self.lijst)
        for a in apparaten:
            batterij = t(f" · batterij {a.batterij}%", f" · battery {a.batterij}%") if a.batterij is not None else ""
            if a.verbonden:
                meer = meer_knop(lambda x=a: [("kruis", t("Verbreken", "Disconnect"), lambda: self.verbind(x)),
                                              ("prullenbak", t("Vergeten", "Forget"), lambda: self.vergeet(x))])
                self.lijst.voeg(Rij("vink", a.naam, t("Verbonden", "Connected") + batterij, meer))
            else:
                rij = Rij(apparaat_icoon(a.soort), a.naam, t("Niet verbonden", "Not connected") + batterij,
                          klikbaar=aan, pijl=False)
                rij.geklikt.connect(lambda x=a: self.verbind(x))
                self.lijst.voeg(rij)
        if not apparaten:
            self.lijst.voeg(Rij("bluetooth", t("Nog niets gekoppeld", "Nothing paired yet"),
                                t("Kies 'Nieuw apparaat koppelen' en zet je apparaat in koppelstand.",
                                  "Choose 'Pair a new device' and put your device in pairing mode.")))

    def zet_bt(self, aan: bool) -> None:
        op_achtergrond(self, lambda: bi.zet_bt(aan), lambda _u: QTimer.singleShot(800, self.ververs))

    def verbind(self, a: bi.Apparaat) -> None:
        self.melding.toon(t(f"{a.naam}: even geduld…", f"{a.naam}: one moment…"), seconden=20)

        def klaar(gelukt) -> None:
            if gelukt:
                self.melding.toon(t(f"{a.naam} is verbroken.", f"{a.naam} is disconnected.") if a.verbonden else
                                  t(f"{a.naam} is verbonden.", f"{a.naam} is connected."), "goed")
            else:
                self.melding.toon(t(f"Dat lukte niet. Staat {a.naam} aan en dichtbij?",
                                    f"That did not work. Is {a.naam} on and nearby?"), "fout")
            self.ververs()

        op_achtergrond(self, lambda: bi.bt_verbind(a.adres, not a.verbonden), klaar)

    def vergeet(self, a: bi.Apparaat) -> None:
        op_achtergrond(self, lambda: bi.bt_vergeet(a.adres), lambda _u: self.ververs())


# ================================================================ geluid ===

class GeluidPagina(Blad):
    sleutel, icoon = "geluid", "geluid"
    titel_nl, titel_en = "Geluid", "Sound"
    uitleg_nl = "Hoe hard, en waar het geluid uit komt."
    uitleg_en = "How loud, and where the sound comes from."
    zoekwoorden = "geluid volume luidspreker speaker koptelefoon hdmi tv stil dempen microfoon"
    kde = "kcm_pulseaudio"

    def bouw(self) -> None:
        g = self.kaart()
        self.regelaar = Regelaar(50)
        self.regelaar.veranderd.connect(lambda w: op_achtergrond(self, lambda: bi.zet_volume(w), lambda _u: None))
        g.voeg(Rij("geluid", t("Volume", "Volume"), "", self.regelaar))
        self.stil = schuifje(False, lambda aan: op_achtergrond(self, lambda: bi.zet_stil(aan), lambda _u: None))
        g.voeg(Rij("kruis", t("Geluid uit", "Mute"), t("Alles even stil", "Everything quiet for a moment"),
                   self.stil))
        self.lijst = self.kaart(t("Waar komt het geluid uit? Klik om te kiezen.",
                                  "Where does the sound come from? Click to choose."))

    def ververs(self) -> None:
        op_achtergrond(self, bi.geluid, self.toon)

    def toon(self, uitkomst) -> None:
        if not uitkomst:
            return
        volume, stil, uitgangen = uitkomst
        self.regelaar.zet(volume)
        self.stil.zet_stil(stil)
        leeg_groep(self.lijst)
        for u in uitgangen:
            if u.standaard:
                self.lijst.voeg(Rij("vink", u.omschrijving, "", Chip(t("In gebruik", "In use"), "goed")))
            else:
                rij = Rij("geluid", u.omschrijving, "", klikbaar=True, pijl=False)
                rij.geklikt.connect(lambda x=u: op_achtergrond(self, lambda: bi.kies_uitgang(x.naam),
                                                               lambda _u: self.ververs()))
                self.lijst.voeg(rij)
        if not uitgangen:
            self.lijst.voeg(Rij("geluid", t("Geen luidsprekers gevonden", "No speakers found"),
                                t("Sluit een koptelefoon of luidspreker aan.", "Connect headphones or a speaker.")))


# ================================================================ scherm ===

class SchermPagina(Blad):
    sleutel, icoon = "scherm", "computer"
    titel_nl, titel_en = "Scherm", "Display"
    uitleg_nl = "Helderheid, warm licht voor de avond, en hoe groot alles is."
    uitleg_en = "Brightness, warm light for the evening, and how big everything is."
    zoekwoorden = "scherm beeldscherm monitor helderheid nachtlicht nachtlampje groot groter klein schaal tekst"
    kde = "kcm_kscreen"

    def bouw(self) -> None:
        g = self.kaart()
        self.helder = Regelaar(70)
        self.helder.veranderd.connect(lambda w: op_achtergrond(self, lambda: bi.zet_helderheid(w), lambda _u: None))
        self.helder_rij = Rij("zon", t("Helderheid", "Brightness"), "", self.helder)
        g.voeg(self.helder_rij)
        self.nacht = schuifje(False, lambda aan: op_achtergrond(self, lambda: bi.zet_nachtlicht(aan), lambda _u: None))
        g.voeg(Rij("maan", t("Nachtlicht", "Night light"),
                   t("'s Avonds warmer licht, prettiger voor je ogen", "Warmer light in the evening, easier on your eyes"),
                   self.nacht))
        g2 = self.kaart(t("Grootte", "Size"))
        self.grootte = Keuzes([(1.0, "100%"), (1.25, "125%"), (1.5, "150%"), (1.75, "175%"), (2.0, "200%")])
        self.grootte.gekozen.connect(self.zet_grootte)
        g2.voeg(Rij("computer", t("Alles groter of kleiner", "Make everything bigger or smaller"),
                    t("Tekst, knoppen en vensters", "Text, buttons and windows"), self.grootte))

    def ververs(self) -> None:
        op_achtergrond(self, lambda: (bi.helderheid(), bi.nachtlicht(), bi.schaal()), self.toon)

    def toon(self, uitkomst) -> None:
        if not uitkomst:
            return
        helder, nacht, schaal = uitkomst
        self.helder_rij.setVisible(helder is not None)
        if helder is not None:
            self.helder.zet(helder)
        self.nacht.zet_stil(nacht)
        self.grootte.zet(min((1.0, 1.25, 1.5, 1.75, 2.0), key=lambda w: abs(w - schaal)))

    def zet_grootte(self, waarde: float) -> None:
        self.melding.toon(t(f"Grootte {waarde:.0%} wordt ingesteld…", f"Setting size to {waarde:.0%}…"))
        op_achtergrond(self, lambda: bi.zet_schaal(waarde), lambda ok: self.melding.toon(
            t("Klaar. Sommige programma's worden pas groter als je ze opnieuw opent.",
              "Done. Some programs only change after you open them again.") if ok else
            t("Dat lukte niet. Probeer het bij 'Meer instellingen'.", "That did not work. Try 'More settings'."),
            "goed" if ok else "fout"))


# =============================================================== energie ===

PROFIEL_TEKST = {
    "power-saver": (("Zuinig", "Saver"), ("Batterij gaat langer mee", "Battery lasts longer"), "batterij"),
    "balanced": (("Gebalanceerd", "Balanced"), ("Aanbevolen", "Recommended"), "vink"),
    "performance": (("Snel", "Fast"), ("Volle kracht, voor games", "Full power, for games"), "spel"),
}


def keuze_kaart(icoon_naam: str, naam: str, uitleg_tekst: str) -> KeuzeKaart:
    inhoud = QWidget()
    il = QVBoxLayout(inhoud)
    il.setContentsMargins(4, 4, 4, 4)
    il.setSpacing(6)
    plaatje = QLabel()
    plaatje.setPixmap(lijn_icoon(icoon_naam, "tekst", 24, gekozen=None).pixmap(24, 24))
    il.addWidget(plaatje)
    il.addWidget(label(naam, "kop3", wrap=False))
    il.addWidget(label(uitleg_tekst, "klein"))
    kaart = KeuzeKaart(inhoud)
    kaart.setMinimumHeight(112)
    return kaart


class EnergiePagina(Blad):
    sleutel, icoon = "energie", "batterij"
    titel_nl, titel_en = "Energie", "Power"
    uitleg_nl = "Zuinig of snel, en hoe het met de batterij gaat."
    uitleg_en = "Saving or fast, and how the battery is doing."
    zoekwoorden = "energie batterij accu stroom zuinig snel prestaties slaapstand opladen"
    kde = "kcm_powerdevilprofilesconfig"

    def bouw(self) -> None:
        self.batterij_kaart = self.kaart()
        self.batterij = Rij("batterij", t("Batterij", "Battery"), "")
        self.batterij_kaart.voeg(self.batterij)
        self.lay.addWidget(sectie(t("Hoe moet je computer werken?", "How should your computer work?")))
        rij = QHBoxLayout()
        rij.setSpacing(12)
        self.profielen: dict[str, KeuzeKaart] = {}
        groep = QButtonGroup(self)
        for profiel in bi.PROFIELEN:
            (nl, en), (unl, uen), ic = PROFIEL_TEKST[profiel]
            kaart = keuze_kaart(ic, t(nl, en), t(unl, uen))
            kaart.clicked.connect(lambda _c=False, p=profiel: self.zet_profiel(p))
            groep.addButton(kaart)
            self.profielen[profiel] = kaart
            rij.addWidget(kaart, 1)
        self.profiel_rij = QWidget()
        self.profiel_rij.setLayout(rij)
        self.lay.addWidget(self.profiel_rij)
        self.geen_profiel = label(t("Deze computer kan niet wisselen tussen zuinig en snel.",
                                    "This computer cannot switch between saving and fast."), "sub")
        self.geen_profiel.hide()
        self.lay.addWidget(self.geen_profiel)
        g = self.kaart(t("Scherm uit en slapen", "Screen off and sleep"))
        self.scherm_uit = Keuzes([(300, t("5 min", "5 min")), (600, t("10 min", "10 min")), (1800, t("30 min", "30 min")),
                                  (0, t("Nooit", "Never"))])
        self.scherm_uit.gekozen.connect(lambda s: op_achtergrond(self, lambda: bi.zet_scherm_uit_na(s), lambda _u: None))
        g.voeg(Rij("computer", t("Scherm uit als je niets doet", "Screen off when you do nothing"),
                   t("Even met de muis bewegen en het is terug", "Move the mouse and it is back"), self.scherm_uit))
        self.slaap = Keuzes([(900, t("15 min", "15 min")), (1800, t("30 min", "30 min")), (3600, t("1 uur", "1 hour")),
                             (0, t("Nooit", "Never"))])
        self.slaap.gekozen.connect(lambda s: op_achtergrond(self, lambda: bi.zet_slaap_na(s), lambda _u: None))
        g.voeg(Rij("maan", t("Slaapstand als je niets doet", "Sleep when you do nothing"),
                   t("Zuinig; alles staat er weer zodra je een toets indrukt",
                     "Saves power; everything is back as soon as you press a key"), self.slaap))
        self.aanuit = Keuzes([(bi.KNOP_VRAGEN, t("Vragen", "Ask")), (bi.KNOP_SLAPEN, t("Slapen", "Sleep")),
                              (bi.KNOP_UIT, t("Uitzetten", "Shut down"))])
        self.aanuit.gekozen.connect(lambda w: op_achtergrond(self, lambda: bi.zet_aanuit_knop(w), lambda _u: None))
        g.voeg(Rij("aan", t("Als je op de aan/uit-knop drukt", "When you press the power button"), "", self.aanuit))
        self.deksel = Keuzes([(bi.KNOP_SLAPEN, t("Slapen", "Sleep")), (bi.KNOP_SCHERM_UIT, t("Scherm uit", "Screen off")),
                              (bi.KNOP_NIETS, t("Niets", "Nothing"))])
        self.deksel.gekozen.connect(lambda w: op_achtergrond(self, lambda: bi.zet_deksel(w), lambda _u: None))
        self.deksel_rij = Rij("laptop", t("Als je de laptop dichtklapt", "When you close the laptop"), "", self.deksel)
        g.voeg(self.deksel_rij)

    def ververs(self) -> None:
        op_achtergrond(self, lambda: (bi.batterij(), bi.energieprofiel(), bi.scherm_uit_na(), bi.slaap_na(),
                                      bi.aanuit_knop(), bi.deksel()), self.toon)

    def toon(self, uitkomst) -> None:
        if not uitkomst:
            return
        bat, profiel, scherm_uit, slaap, aanuit, deksel = uitkomst
        self.scherm_uit.zet(dichtstbij(bi.SCHERM_UIT_KEUZES, scherm_uit))
        self.slaap.zet(dichtstbij(bi.SLAAP_KEUZES, slaap))
        self.aanuit.zet(aanuit if aanuit in (bi.KNOP_VRAGEN, bi.KNOP_SLAPEN, bi.KNOP_UIT) else bi.KNOP_VRAGEN)
        self.deksel.zet(deksel if deksel in (bi.KNOP_SLAPEN, bi.KNOP_SCHERM_UIT, bi.KNOP_NIETS) else bi.KNOP_SLAPEN)
        self.deksel_rij.setVisible(bat is not None)
        self.batterij_kaart.setVisible(bat is not None)
        if bat is not None:
            staat = t("vol", "full") if bat.vol else t("wordt opgeladen", "charging") if bat.laadt else \
                t("op batterij", "on battery")
            self.batterij.zet_uitleg(f"{bat.procent}% · {staat}")
        self.profiel_rij.setVisible(profiel is not None)
        self.geen_profiel.setVisible(profiel is None)
        if profiel in self.profielen:
            self.profielen[profiel].setChecked(True)

    def zet_profiel(self, profiel: str) -> None:
        op_achtergrond(self, lambda: bi.zet_energieprofiel(profiel), lambda ok: self.melding.toon(
            t(f"Je computer werkt nu: {PROFIEL_TEKST[profiel][0][0].lower()}.",
              f"Your computer now works: {PROFIEL_TEKST[profiel][0][1].lower()}.") if ok else
            t("Dat lukte niet.", "That did not work."), "goed" if ok else "fout"))


