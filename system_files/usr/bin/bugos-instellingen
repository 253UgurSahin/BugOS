def scroll(w: QWidget) -> QScrollArea:
    s = QScrollArea()
    s.setWidgetResizable(True)
    s.setWidget(w)
    s.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
    return s


class Overzicht(QScrollArea):
    def __init__(self, ga_naar):
        super().__init__()
        self.setWidgetResizable(True)
        self.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        w, lay = pagina()
        self.setWidget(w)
        lay.addWidget(kop(t("Instellingen", "Settings"),
                          t("Alles wat je nodig hebt, op één plek.", "Everything you need, in one place.")))

        # Bovenaan: hoe staat de computer ervoor?
        status = Held(140)
        blok = QVBoxLayout()
        blok.setSpacing(6)
        v = versie()
        blok.addWidget(label(f"BugOS {v}".strip(), "kop2"))
        updates_auto = status_van("bugos-updates") or not bestaat("bugos-updates")
        blok.addWidget(label(t("Je computer is veilig en wordt vanzelf bijgewerkt." if updates_auto else
                               "Je computer is veilig. Updates doe je zelf.",
                               "Your computer is safe and updates itself." if updates_auto else
                               "Your computer is safe. You do updates yourself."), "klein"))
        chip = Chip(t("✓  Updates gaan vanzelf", "✓  Updates are automatic") if updates_auto
                    else t("Updates doe je zelf", "You do updates yourself"), "goed" if updates_auto else "grijs")
        blok.addWidget(chip)
        blok_w = QWidget()
        blok_w.setLayout(blok)
        blok_w.setMaximumWidth(460)
        status.lay.addWidget(blok_w)
        status.lay.addStretch(1)
        lay.addWidget(status)

        self.groepen: list[tuple[QWidget, QWidget, list[Tegel]]] = []
        for naam, tegels in groepen(ga_naar):
            kopje = sectie(naam)
            vak, g = raster(3)
            lay.addWidget(kopje)
            lay.addWidget(vak)
            self.groepen.append((kopje, vak, tegels))
        self.niks = label(t("Niks gevonden. Probeer een ander woord, of kies \"Alle instellingen\".",
                            "Nothing found. Try another word, or choose \"All settings\"."), "sub")
        self.niks.hide()
        lay.addWidget(self.niks)
        lay.addStretch(1)
        self.kolommen = 3
        self.filter("")

    def filter(self, zoek: str) -> None:
        iets = False
        for kopje, vak, tegels in self.groepen:
            g = vak.layout()
            for tg in tegels:
                g.removeWidget(tg)
                tg.hide()
            zichtbaar = [x for x in tegels if x.past_bij(zoek)]
            for i, tg in enumerate(zichtbaar):
                g.addWidget(tg, i // self.kolommen, i % self.kolommen)
                tg.show()
            for k in range(3):
                g.setColumnStretch(k, 1 if k < self.kolommen else 0)
            kopje.setVisible(bool(zichtbaar))
            vak.setVisible(bool(zichtbaar))
            iets = iets or bool(zichtbaar)
        self.niks.setVisible(not iets)

    def resizeEvent(self, e):  # noqa: N802
        nieuw = max(1, min(3, (self.width() - 80) // 250))
        if nieuw != self.kolommen:
            self.kolommen = nieuw
            self.filter(self.zoek_tekst if hasattr(self, "zoek_tekst") else "")
        super().resizeEvent(e)


class AanUit(QScrollArea):
    def __init__(self):
        super().__init__()
        self.setWidgetResizable(True)
        self.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        w, lay = pagina()
        self.setWidget(w)
        lay.addWidget(kop(t("Aan en uit", "On and off"),
                          t("Zet dingen aan of uit met één tik. Je kunt het altijd terugdraaien.",
                            "Turn things on or off with one tap. You can always undo it.")))

        lay.addWidget(sectie(t("Updates", "Updates")))
        g = Groep()
        upd = SchakelRij(t("Updates vanzelf", "Automatic updates"),
                         t("Aan: BugOS houdt zichzelf stil bij. Uit: jij kiest wanneer, je krijgt een melding.",
                           "On: BugOS quietly keeps itself up to date. Off: you choose when, you get a notification."),
                         status_van("bugos-updates") or not bestaat("bugos-updates"), "system-software-update", "groen")
        upd.omgezet.connect(lambda aan: start("pkexec", "/usr/bin/bugos-updates", "auto" if aan else "hand"))
        g.voeg(upd)
        knoppen = QWidget()
        rij = QHBoxLayout(knoppen)
        rij.setContentsMargins(18, 12, 18, 14)
        nu = Knop(t("Nu updaten", "Update now"), "rand", "view-refresh")
        nu.clicked.connect(lambda: start("pkexec", "/usr/bin/bugos-updates", "nu"))
        terug = Knop(t("Terug naar vorige versie", "Go back to previous version"), "stil", "edit-undo")
        terug.clicked.connect(lambda: start("pkexec", "/usr/bin/bugos-updates", "terug"))
        rij.addWidget(nu)
        rij.addWidget(terug)
        rij.addStretch(1)
        g.voeg(knoppen)
        lay.addWidget(g)

        lay.addWidget(sectie(t("Spelen en werken", "Play and work")))
        g = Groep()
        spel = SchakelRij(t("Game-modus", "Game mode"),
                          t("Volle kracht, meldingen stil en een FPS-teller in games.",
                            "Full power, quiet notifications and an FPS counter in games."),
                          status_van("bugos-spelmodus"), "input-gamepad", "paars")
        spel.omgezet.connect(lambda aan: zet_script("bugos-spelmodus", aan))
        g.voeg(spel)
        dev = SchakelRij(t("Ontwikkelaarsmodus", "Developer mode"),
                         t("Zet VS Code, containers en programmeertalen klaar. Uitzetten gooit niets weg.",
                           "Sets up VS Code, containers and programming languages. Turning off deletes nothing."),
                         status_van("bugos-ontwikkelaar"), "code-context", "grijs")
        dev.omgezet.connect(lambda aan: zet_script("bugos-ontwikkelaar", aan))
        g.voeg(dev)
        licht = SchakelRij(t("Lichte stand", "Light mode"),
                           t("Zware effecten uit, zodat een oudere computer vlot blijft.",
                             "Heavy effects off, so an older computer stays fast."),
                           status_van("bugos-lichte-stand"), "speedometer", "oranje")
        licht.omgezet.connect(lambda aan: zet_script("bugos-lichte-stand", aan))
        g.voeg(licht)
        lay.addWidget(g)

        lay.addWidget(sectie(t("Probeer iets nieuws", "Try something new")))
        g = Groep()
        sm = SchakelRij(t("Nieuw BugOS-startmenu", "New BugOS start menu"),
                        t("Grote zoekbalk, vastgezette apps en recente bestanden. Uit zet het gewone menu terug.",
                          "Big search bar, pinned apps and recent files. Off brings back the normal menu."),
                        status_van("bugos-paneel", "startmenu"), "view-list-icons", "rood")
        sm.omgezet.connect(lambda aan: start("bugos-paneel", "startmenu", "aan" if aan else "uit"))
        g.voeg(sm)
        sn = SchakelRij(t("Snelmenu op de taakbalk", "Quick menu on the taskbar"),
                        t("Grote knoppen voor wifi, bluetooth, game-modus, donker en volume.",
                          "Big buttons for Wi-Fi, Bluetooth, game mode, dark and volume."),
                        status_van("bugos-paneel", "snelmenu"), "settings-configure", "blauw")
        sn.omgezet.connect(lambda aan: start("bugos-paneel", "snelmenu", "aan" if aan else "uit"))
        g.voeg(sn)
        lay.addWidget(g)
        lay.addStretch(1)


class Over(QScrollArea):
    def __init__(self):
        super().__init__()
        self.setWidgetResizable(True)
        self.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        w, lay = pagina()
        self.setWidget(w)
        lay.addWidget(kop(t("Over deze computer", "About this computer")))
        boven = Kaart(marge=24, ruimte=18, richting="h")
        boven.lay.addWidget(IcoonChip("bugos-logo", "rood", 76, vol=False, icoon_maat=56))
        blok = QVBoxLayout()
        blok.setSpacing(2)
        blok.addWidget(label("BugOS", "groot"))
        blok.addWidget(label(t("Gratis, veilig en open. Gebouwd op Fedora en KDE.",
                               "Free, safe and open. Built on Fedora and KDE."), "sub"))
        boven.lay.addLayout(blok, 1)
        lay.addWidget(boven)

        g = Groep()
        self.info = systeem_info()
        for sleutel, waarde in self.info:
            rij = QWidget()
            r = QHBoxLayout(rij)
            r.setContentsMargins(18, 14, 18, 14)
            r.addWidget(label(sleutel, "klein", wrap=False))
            r.addStretch(1)
            r.addWidget(label(waarde, "kop3", kopieerbaar=True), 0, Qt.AlignmentFlag.AlignRight)
            g.voeg(rij)
        lay.addWidget(g)
        rij = QHBoxLayout()
        kopieer = Knop(t("Gegevens kopiëren", "Copy details"), "rand", "edit-copy")
        kopieer.clicked.connect(self.kopieer)
        hulp = Knop(t("Er werkt iets niet", "Something is not working"), "stil", "help-contents")
        hulp.clicked.connect(lambda: start("bugos-hulp"))
        rij.addWidget(kopieer)
        rij.addWidget(hulp)
        rij.addStretch(1)
        lay.addLayout(rij)
        self.melding = Banner()
        lay.addWidget(self.melding)
        lay.addStretch(1)

    def kopieer(self) -> None:
        QApplication.clipboard().setText("\n".join(f"{k}: {v}" for k, v in self.info))
        self.melding.zet(t("Gekopieerd. Je kunt het nu plakken in een bericht.",
                           "Copied. You can now paste it into a message."), "goed")


class Instellingen(QWidget):
    def __init__(self, begin: str = "start"):
        super().__init__()
        self.setObjectName("venster")
        self.setWindowTitle(t("BugOS Instellingen", "BugOS Settings"))
        self.resize(1120, 780)
        hoofd = QHBoxLayout(self)
        hoofd.setContentsMargins(0, 0, 0, 0)
        hoofd.setSpacing(0)

        # Links: logo, zoeken en de onderdelen
        zij = QWidget()
        zij.setObjectName("zijkant")
        zij.setFixedWidth(272)
        z = QVBoxLayout(zij)
        z.setContentsMargins(18, 22, 18, 18)
        z.setSpacing(16)
        z.addWidget(merk_label(30))
        self.zoek = Zoekveld(t("Zoek een instelling", "Search settings"))
        z.addWidget(self.zoek)
        self.nav = Zijbalk()
        self.nav.voeg_toe("go-home", t("Overzicht", "Overview"), "start")
        self.nav.voeg_toe("settings-configure", t("Aan en uit", "On and off"), "schakelaars")
        self.nav.voeg_toe("computer", t("Over deze computer", "About this computer"), "over")
        z.addWidget(self.nav, 1)
        alles = Knop(t("Alle instellingen", "All settings"), "stil", "configure")
        alles.clicked.connect(lambda: start("systemsettings"))
        z.addWidget(alles)
        hoofd.addWidget(zij)

        self.stapel = QStackedWidget()
        self.paginas = {"start": Overzicht(self.ga_naar), "schakelaars": AanUit(), "over": Over()}
        for p in self.paginas.values():
            self.stapel.addWidget(p)
        hoofd.addWidget(self.stapel, 1)

        self.nav.currentRowChanged.connect(
            lambda i: self.stapel.setCurrentWidget(self.paginas.get(self.nav.sleutel(i), self.paginas["start"])))
        self.zoek.textChanged.connect(self.zoeken)
        self.ga_naar(begin if begin in self.paginas else "start")
        self.nav.setFocus()

    def zoeken(self, tekst: str) -> None:
        if tekst and self.stapel.currentWidget() is not self.paginas["start"]:
            self.ga_naar("start")
        self.paginas["start"].zoek_tekst = tekst
        self.paginas["start"].filter(tekst)

    def ga_naar(self, naam: str) -> None:
        self.nav.kies(naam)
        self.stapel.setCurrentWidget(self.paginas[naam])


def main() -> int:
    app = maak_app("bugos-instellingen", "bugos-instellingen", sys.argv)
    begin = sys.argv[1] if len(sys.argv) > 1 else "start"
    return uitvoeren(app, Instellingen(begin))


if __name__ == "__main__":
    sys.exit(main())
