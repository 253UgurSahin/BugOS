class UpdatesPagina(Pagina):
    sleutel, icoon = "updates", "verversen"
    titel_nl, titel_en = "Updates en meer", "Updates and more"
    uitleg_nl = "Zet dingen aan of uit met één tik. Je kunt het altijd terugdraaien."
    uitleg_en = "Turn things on or off with one tap. You can always undo it."
    zoekwoorden = "update bijwerken versie terug game spel modus ontwikkelaar programmeren lichte stand startmenu snelmenu"

    def bouw(self) -> None:
        g = self.kaart(t("Updates", "Updates"))
        auto = status_van("bugos-updates") or not bestaat("bugos-updates")
        g.voeg(Rij("verversen", t("Updates vanzelf", "Automatic updates"),
                   t("Aan: BugOS houdt zichzelf stil bij. Uit: jij kiest wanneer.",
                     "On: BugOS quietly keeps itself up to date. Off: you choose when."),
                   schuifje(auto, lambda aan: None if bi.VOORBEELD else
                            start("pkexec", "/usr/bin/bugos-updates", "auto" if aan else "hand"))))
        knoppen = QWidget()
        kr = QHBoxLayout(knoppen)
        kr.setContentsMargins(52, 4, 14, 12)
        nu = Knop(t("Nu updaten", "Update now"), "gewoon", "lijn:verversen")
        nu.clicked.connect(lambda _c=False: None if bi.VOORBEELD else start("pkexec", "/usr/bin/bugos-updates", "nu"))
        terug = Knop(t("Terug naar de vorige versie", "Back to the previous version"), "stil", "lijn:terug")
        terug.clicked.connect(lambda _c=False: None if bi.VOORBEELD else
                              start("pkexec", "/usr/bin/bugos-updates", "terug"))
        kr.addWidget(nu)
        kr.addWidget(terug)
        kr.addStretch(1)
        g.lay.addWidget(knoppen)
        g = self.kaart(t("Spelen en werken", "Play and work"))
        for script, ic, (nl, en), (unl, uen) in (
                ("bugos-spelmodus", "spel", ("Game-modus", "Game mode"),
                 ("Volle kracht, meldingen stil en een FPS-teller in games.",
                  "Full power, quiet notifications and an FPS counter in games.")),
                ("bugos-ontwikkelaar", "code", ("Ontwikkelaarsmodus", "Developer mode"),
                 ("VS Code, containers en programmeertalen. Uitzetten gooit niets weg.",
                  "VS Code, containers and programming languages. Turning off deletes nothing.")),
                ("bugos-lichte-stand", "ster", ("Lichte stand", "Light mode"),
                 ("Zware effecten uit, zodat een oudere computer vlot blijft.",
                  "Heavy effects off, so an older computer stays fast."))):
            g.voeg(Rij(ic, t(nl, en), t(unl, uen),
                       schuifje(status_van(script), lambda aan, s=script: zet_script(s, aan))))
        g = self.kaart(t("Probeer iets nieuws", "Try something new"))
        for onderdeel, ic, (nl, en), (unl, uen) in (
                ("startmenu", "apps", ("Nieuw BugOS-startmenu", "New BugOS start menu"),
                 ("Grote zoekbalk, vastgezette apps en recente bestanden.", "Big search, pinned apps, recent files.")),
                ("snelmenu", "schakelaar", ("Snelmenu op de taakbalk", "Quick menu on the taskbar"),
                 ("Grote knoppen voor wifi, bluetooth, game-modus en volume.",
                  "Big buttons for Wi-Fi, Bluetooth, game mode and volume."))):
            g.voeg(Rij(ic, t(nl, en), t(unl, uen), schuifje(
                status_van("bugos-paneel", onderdeel),
                lambda aan, o=onderdeel: None if bi.VOORBEELD else start("bugos-paneel", o, "aan" if aan else "uit"))))
        g = self.kaart(t("Hulp", "Help"))
        for programma, ic, (nl, en), (unl, uen) in (
                ("bugos-taakbeheer", "grafiek", ("Taakbeheer", "Task Manager"),
                 ("Zien wat je computer doet, een programma sluiten dat vastzit.",
                  "See what your computer does, close a program that is stuck.")),
                ("bugos-backup", "opslag", ("Back-up", "Backup"),
                 ("Je bestanden veilig op een USB-schijf.", "Your files safe on a USB drive.")),
                ("bugos-hulp", "handig", ("Er werkt iets niet", "Something is not working"),
                 ("BugOS zoekt het probleem voor je.", "BugOS finds the problem for you."))):
            rij = Rij(ic, t(nl, en), t(unl, uen), klikbaar=True)
            rij.geklikt.connect(lambda p=programma: None if bi.VOORBEELD else start(p))
            g.voeg(rij)


# ===================================================== over deze computer ===

class OverPagina(Pagina):
    sleutel, icoon = "over", "laptop"
    titel_nl, titel_en = "Over deze computer", "About this computer"
    zoekwoorden = "over versie processor geheugen naam computer systeem info"

    def bouw(self) -> None:
        boven = Kaart(marge=24, ruimte=18, richting="h")
        logo = QLabel()
        logo.setPixmap(QPixmap("/usr/share/bugos/logo.svg").scaled(
            56, 56, Qt.AspectRatioMode.KeepAspectRatio, Qt.TransformationMode.SmoothTransformation))
        boven.lay.addWidget(logo)
        blok = QVBoxLayout()
        blok.setSpacing(2)
        blok.addWidget(label(f"BugOS {versie()}".strip(), "groot", wrap=False))
        blok.addWidget(label(t("Gratis, veilig en open. Gebouwd op Fedora en KDE.",
                               "Free, safe and open. Built on Fedora and KDE."), "sub"))
        boven.lay.addLayout(blok, 1)
        self.lay.addWidget(boven)
        g = self.kaart()
        self.info = systeem_info()
        for sleutel, waarde in self.info:
            rij = QWidget()
            r = QHBoxLayout(rij)
            r.setContentsMargins(16, 14, 16, 14)
            r.addWidget(label(sleutel, "klein", wrap=False))
            r.addStretch(1)
            r.addWidget(label(waarde, "kop3", kopieerbaar=True), 0, Qt.AlignmentFlag.AlignRight)
            g.voeg(rij)
        kopieer = Knop(t("Gegevens kopiëren", "Copy details"), "gewoon", "lijn:kopieer")
        kopieer.clicked.connect(self.kopieer)
        self.lay.addWidget(kopieer, 0, Qt.AlignmentFlag.AlignLeft)

    def kopieer(self) -> None:
        QApplication.clipboard().setText("\n".join(f"{k}: {v}" for k, v in self.info))
        self.melding.toon(t("Gekopieerd. Je kunt het nu plakken in een bericht.",
                            "Copied. You can now paste it into a message."), "goed")


# ================================================================= start ===

class StartPagina(Pagina):
    sleutel, icoon = "start", "huis"
    titel_nl, titel_en = "Instellingen", "Settings"
    uitleg_nl = "Alles op één plek, in gewone woorden."
    uitleg_en = "Everything in one place, in plain words."

    def bouw(self) -> None:
        # snel: de schuifjes die je het vaakst nodig hebt
        rooster = QGridLayout()
        rooster.setSpacing(12)
        self.snel: dict[str, Schuif] = {}
        self.snel_uitleg: dict[str, QLabel] = {}
        for i, (sleutel, ic, naam) in enumerate((("wifi", "wifi", t("Wifi", "Wi-Fi")),
                                                 ("bt", "bluetooth", "Bluetooth"),
                                                 ("nacht", "maan", t("Nachtlicht", "Night light")),
                                                 ("donker", "palet", t("Donker", "Dark")))):
            vak = QFrame()
            vak.setObjectName("snel")
            vl = QVBoxLayout(vak)
            vl.setContentsMargins(18, 16, 16, 14)
            vl.setSpacing(10)
            boven = QHBoxLayout()
            ik = QLabel()
            ik.setPixmap(lijn_icoon(ic, "tekst", 22, gekozen=None).pixmap(22, 22))
            boven.addWidget(ik)
            boven.addStretch(1)
            schuif = Schuif(False)
            schuif.toggled.connect(lambda aan, s=sleutel: self.zet_snel(s, aan))
            boven.addWidget(schuif)
            vl.addLayout(boven)
            vl.addWidget(label(naam, "kop3", wrap=False))
            uitleg = label("…", "klein", wrap=False)
            vl.addWidget(uitleg)
            self.snel[sleutel] = schuif
            self.snel_uitleg[sleutel] = uitleg
            rooster.addWidget(vak, 0, i)
        self.lay.addLayout(rooster)
        g = self.kaart()
        self.volume = Regelaar(50)
        self.volume.veranderd.connect(lambda w: op_achtergrond(self, lambda: bi.zet_volume(w), lambda _u: None))
        g.voeg(Rij("geluid", t("Volume", "Volume"), "", self.volume))
        # zoeken
        self.zoek_kop = sectie(t("Gevonden", "Found"))
        self.zoek_kop.hide()
        self.lay.addWidget(self.zoek_kop)
        self.zoek_kaart = Groep()
        self.zoek_kaart.lay.setContentsMargins(4, 4, 4, 4)
        self.zoek_kaart.hide()
        self.lay.addWidget(self.zoek_kaart)
        # alle onderdelen, met hoe ze nu staan
        self.alles_kop = sectie(t("Alle instellingen", "All settings"))
        self.lay.addWidget(self.alles_kop)
        self.alles = Groep()
        self.alles.lay.setContentsMargins(4, 4, 4, 4)
        self.lay.addWidget(self.alles)
        self.rijen: dict[str, Rij] = {}
        for klasse in PAGINAS[1:]:
            rij = Rij(klasse.icoon, klasse.naam(), t(klasse.uitleg_nl, klasse.uitleg_en) if klasse.uitleg_nl else "",
                      klikbaar=True)
            rij.geklikt.connect(lambda s=klasse.sleutel: self.venster.ga_naar(s))
            self.alles.voeg(rij)
            self.rijen[klasse.sleutel] = rij

    def ververs(self) -> None:
        def lees():
            return {"wifi": bi.wifi_aan(), "netwerken": bi.netwerken(), "bt": bi.bt_aan(), "nacht": bi.nachtlicht(),
                    "donker": bi.donker(), "geluid": bi.geluid()}
        op_achtergrond(self, lees, self.toon)

    def toon(self, s) -> None:
        if not s:
            return
        nu = next((n for n in s["netwerken"] if n.verbonden), None)
        for sleutel, aan, uitleg in (
                ("wifi", s["wifi"], (nu.naam if nu else t("Niet verbonden", "Not connected")) if s["wifi"]
                 else t("Uit", "Off")),
                ("bt", s["bt"], t("Aan", "On") if s["bt"] else t("Uit", "Off")),
                ("nacht", s["nacht"], t("'s Avonds warmer", "Warmer at night") if s["nacht"] else t("Uit", "Off")),
                ("donker", s["donker"], t("Aan", "On") if s["donker"] else t("Uit", "Off"))):
            self.snel[sleutel].zet_stil(bool(aan))
            self.snel_uitleg[sleutel].setText(uitleg)
        volume, _stil, uitgangen = s["geluid"]
        self.volume.zet(volume)
        if nu:
            self.rijen["wifi"].zet_uitleg(t(f"Verbonden met {nu.naam}", f"Connected to {nu.naam}"))
        gebruikt = next((u for u in uitgangen if u.standaard), None)
        if gebruikt:
            self.rijen["geluid"].zet_uitleg(t(f"{volume}% · {gebruikt.omschrijving}", f"{volume}% · "
                                              f"{gebruikt.omschrijving}"))

    def zet_snel(self, sleutel: str, aan: bool) -> None:
        werk = {"wifi": lambda: bi.zet_wifi(aan), "bt": lambda: bi.zet_bt(aan),
                "nacht": lambda: bi.zet_nachtlicht(aan), "donker": lambda: bi.zet_donker(aan)}[sleutel]
        op_achtergrond(self, werk, lambda _u: QTimer.singleShot(1200, self.ververs))

    def zoek(self, tekst: str) -> None:
        woorden = tekst.lower().split()
        leeg_groep(self.zoek_kaart)
        gevonden = 0
        if woorden:
            for klasse in PAGINAS[1:]:
                bron = f"{klasse.naam()} {klasse.uitleg_nl} {klasse.uitleg_en} {klasse.zoekwoorden}".lower()
                if all(w in bron for w in woorden):
                    rij = Rij(klasse.icoon, klasse.naam(), t(klasse.uitleg_nl, klasse.uitleg_en), klikbaar=True)
                    rij.geklikt.connect(lambda s=klasse.sleutel: self.venster.ga_naar(s))
                    self.zoek_kaart.voeg(rij)
                    gevonden += 1
            if not gevonden:
                self.zoek_kaart.voeg(Rij("kruis", t("Niks gevonden", "Nothing found"),
                                         t("Probeer een ander woord, of kies 'Meer instellingen'.",
                                           "Try another word, or choose 'More settings'.")))
        self.zoek_kop.setVisible(bool(woorden))
        self.zoek_kaart.setVisible(bool(woorden))


PAGINAS: list[type[Pagina]] = [StartPagina, WifiPagina, BluetoothPagina, GeluidPagina, SchermPagina, EnergiePagina,
                               UiterlijkPagina, UpdatesPagina, OverPagina]
OUDE_NAMEN = {"schakelaars": "updates"}


# ================================================================ venster ===

class Instellingen(QWidget):
    def __init__(self, begin: str = "start"):
        super().__init__()
        self.setObjectName("venster")
        self.setWindowTitle(t("Instellingen", "Settings"))
        self.setStyleSheet(stijl())
        self.resize(1120, 780)
        self.setMinimumSize(920, 600)
        hoofd = QHBoxLayout(self)
        hoofd.setContentsMargins(0, 0, 0, 0)
        hoofd.setSpacing(0)

        zij = QWidget()
        zij.setObjectName("zijkant")
        zij.setFixedWidth(272)
        z = QVBoxLayout(zij)
        z.setContentsMargins(18, 22, 18, 18)
        z.setSpacing(14)
        merk = merk_label(28)
        merk.setContentsMargins(6, 0, 0, 4)
        z.addWidget(merk)
        self.zoekveld = Zoekveld(t("Zoek een instelling", "Search settings"))
        self.zoekveld.textChanged.connect(self.zoeken)
        z.addWidget(self.zoekveld)
        self.nav = Zijbalk()
        for klasse in PAGINAS:
            self.nav.voeg_toe(f"lijn:{klasse.icoon}", klasse.naam() if klasse is not StartPagina else
                              t("Start", "Home"), klasse.sleutel)
        z.addWidget(self.nav, 1)
        alles = Knop(t("Meer instellingen", "More settings"), "stil", "lijn:code")
        alles.setToolTip(t("Alle KDE-instellingen (voor gevorderden)", "All KDE settings (advanced)"))
        alles.clicked.connect(lambda _c=False: start("systemsettings"))
        z.addWidget(alles)
        hoofd.addWidget(zij)

        self.stapel = QStackedWidget()
        self.paginas: dict[str, Pagina] = {}
        for klasse in PAGINAS:
            p = klasse(self)
            self.paginas[klasse.sleutel] = p
            self.stapel.addWidget(p)
        hoofd.addWidget(self.stapel, 1)
        self.nav.currentRowChanged.connect(lambda i: self.toon(self.nav.sleutel(i)))
        begin = OUDE_NAMEN.get(begin, begin)
        self.ga_naar(begin if begin in self.paginas else "start")
        self.nav.setFocus()  # niet meteen in het zoekveld

    def toon(self, sleutel: str) -> None:
        pagina = self.paginas.get(sleutel)
        if pagina is None:
            return
        self.stapel.setCurrentWidget(pagina)
        pagina.ververs()

    def ga_naar(self, sleutel: str) -> None:
        if self.nav.sleutel(self.nav.currentRow()) == sleutel:
            self.toon(sleutel)
        else:
            self.nav.kies(sleutel)

    def zoeken(self, tekst: str) -> None:
        if tekst and self.stapel.currentWidget() is not self.paginas["start"]:
            self.ga_naar("start")
        self.paginas["start"].zoek(tekst)


def begin_pagina(args: list[str]) -> str:
    """Welke pagina moet open? Het eerste woord dat een pagina is (Qt-opties zoals -qwindowgeometry tellen niet)."""
    namen = {k.sleutel for k in PAGINAS} | set(OUDE_NAMEN)
    return next((a for a in args if a in namen), "start")


def main() -> int:
    app = maak_app("bugos-instellingen", "bugos-instellingen", sys.argv)
    return uitvoeren(app, Instellingen(begin_pagina(sys.argv[1:])))


if __name__ == "__main__":
    sys.exit(main())
