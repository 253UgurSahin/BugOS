#!/usr/bin/python3
"""BugOS Instellingen: alles wat je nodig hebt, op één plek, in gewone woorden.

Zoals Instellingen in Windows, maar rustiger: de dingen die je echt gebruikt (wifi,
bluetooth, geluid, scherm, energie, uiterlijk, updates) regel je hier zelf, met één
schuifje of knop. Wie meer wil, vindt per onderdeel 'Meer instellingen (voor gevorderden)'.

Gebruik:  bugos-instellingen [pagina]
          pagina = start | wifi | bluetooth | geluid | scherm | energie | uiterlijk | updates | over
"""

from __future__ import annotations

import json
import os
import platform
import sys
from pathlib import Path

sys.path.insert(0, "/usr/lib/bugos/python")

import bugos_instellen as bi  # noqa: E402
from bugos_ui import (  # noqa: E402
    Chip, Groep, K, Kaart, KeuzeKaart, Knop, Schuif, Zijbalk, Zoekveld, bestaat, draai, kde_instelling, label,
    lijn_icoon, maak_app, merk_label, sectie, start, t, uitvoeren,
)
from PySide6.QtCore import QObject, QRunnable, QSize, Qt, QThreadPool, QTimer, Signal  # noqa: E402
from PySide6.QtGui import QPixmap  # noqa: E402
from PySide6.QtWidgets import (  # noqa: E402
    QApplication, QButtonGroup, QFileDialog, QFrame, QGridLayout, QHBoxLayout, QInputDialog, QLabel, QLineEdit,
    QPushButton, QScrollArea, QSlider, QStackedWidget, QVBoxLayout, QWidget,
)


# ============================================================ achtergrond ===

class Sein(QObject):
    klaar = Signal(object)


class Klusje(QRunnable):
    def __init__(self, werk, sein: Sein):
        super().__init__()
        self.werk, self.sein = werk, sein

    def run(self) -> None:
        try:
            uitkomst = self.werk()
        except Exception:  # noqa: BLE001  een kapotte instelling mag het venster nooit laten vallen
            uitkomst = None
        try:
            self.sein.klaar.emit(uitkomst)
        except RuntimeError:  # het venster is al dicht
            pass


def op_achtergrond(ouder: QObject, werk, klaar) -> None:
    """Doe iets traags (wifi zoeken, bluetooth vragen) zonder dat het venster vastloopt."""
    sein = Sein(ouder)
    sein.klaar.connect(lambda uitkomst: (klaar(uitkomst), sein.deleteLater()))
    QThreadPool.globalInstance().start(Klusje(werk, sein))


# ============================================================== toestand ===

def status_van(script: str, *voor: str) -> bool:
    """Vraag een bugos-script of iets aan staat."""
    if bi.VOORBEELD:
        return script == "bugos-updates"
    if not bestaat(script):
        return False
    _, uit = draai(script, *voor, "status", timeout=5)
    return uit.strip().endswith(("aan", "auto"))


def zet_script(script: str, aan: bool, aan_woord: str = "aan", uit_woord: str = "uit") -> None:
    if not bi.VOORBEELD:
        start(script, aan_woord if aan else uit_woord)


def versie() -> str:
    try:
        return json.loads(Path("/usr/share/bugos/image-info.json").read_text())["versie"]
    except (OSError, ValueError, KeyError):
        return os.environ.get("BUGOS_VERSIE", "")


def systeem_info() -> list[tuple[str, str]]:
    """Gegevens voor 'Over deze computer', in gewone taal."""
    info: list[tuple[str, str]] = [(t("BugOS-versie", "BugOS version"), versie() or "?")]
    try:
        for regel in Path("/proc/cpuinfo").read_text().splitlines():
            if regel.startswith("model name"):
                info.append((t("Processor", "Processor"), regel.split(":", 1)[1].strip()))
                break
    except OSError:
        pass
    try:
        kb = int(next(r for r in Path("/proc/meminfo").read_text().splitlines()
                      if r.startswith("MemTotal")).split()[1])
        info.append((t("Geheugen", "Memory"), f"{kb / 1024 / 1024:.0f} GB"))
    except (OSError, StopIteration, ValueError):
        pass
    try:
        st = os.statvfs(str(Path.home()))
        vrij = st.f_bavail * st.f_frsize / 1000**3
        totaal = st.f_blocks * st.f_frsize / 1000**3
        info.append((t("Opslag", "Storage"),
                     t(f"{vrij:.0f} GB vrij van {totaal:.0f} GB", f"{vrij:.0f} GB free of {totaal:.0f} GB")))
    except OSError:
        pass
    code, uit = draai("hostname", timeout=3)
    if code == 0 and uit.strip():
        info.append((t("Naam van deze computer", "Computer name"), uit.strip()))
    info.append((t("Linux-kern", "Linux kernel"), platform.release()))
    return info


# ============================================================ onderdelen ===

def stijl() -> str:
    return f"""
QFrame#rij {{ background: transparent; border-radius: 12px; }}
QFrame#rij[klikbaar="true"]:hover {{ background: {K['knop']}; }}
QFrame#snel {{ background: {K['vlak']}; border: 1px solid {K['rand']}; border-radius: 18px; }}
QFrame#melding {{ background: {K['knop']}; border-radius: 14px; }}
QFrame#melding[soort="goed"] {{ background: {K['goed_zacht']}; }}
QFrame#melding[soort="fout"] {{ background: {K['fout_zacht']}; }}
QPushButton#keus {{ background: transparent; border: none; border-radius: 10px; padding: 8px 14px; font-size: 14px;
    font-weight: 600; color: {K['tekst2']}; }}
QPushButton#keus:hover {{ color: {K['tekst']}; }}
QPushButton#keus:checked {{ background: {K['vlak']}; color: {K['tekst']}; }}
QFrame#keuzes {{ background: {K['knop']}; border-radius: 13px; }}
QSlider {{ min-height: 28px; }}
QSlider::groove:horizontal {{ height: 6px; border-radius: 3px; background: {K['knop_hover']}; }}
QSlider::sub-page:horizontal {{ height: 6px; border-radius: 3px; background: {K['accent']}; }}
QSlider::handle:horizontal {{ width: 22px; height: 22px; margin: -8px 0; border-radius: 11px; background: #FFFFFF;
    border: 1px solid {K['rand_sterk']}; }}
QPushButton#plaatje {{ background: transparent; border: 2px solid transparent; border-radius: 16px; padding: 3px; }}
QPushButton#plaatje:hover {{ border: 2px solid {K['rand_sterk']}; }}
QPushButton#plaatje:checked {{ border: 2px solid {K['accent']}; }}
"""


class Rij(QFrame):
    """Eén regel: icoontje, naam, uitleg en rechts een schuifje of knop."""

    geklikt = Signal()

    def __init__(self, icoon: str, titel: str, uitleg: str = "", rechts: QWidget | None = None, klikbaar: bool = False):
        super().__init__()
        self.setObjectName("rij")
        self.setProperty("klikbaar", "true" if klikbaar else "false")
        if klikbaar:
            self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setMinimumHeight(64)
        lay = QHBoxLayout(self)
        lay.setContentsMargins(16, 10, 14, 10)
        lay.setSpacing(14)
        self.icoon = QLabel()
        self.zet_icoon(icoon)
        lay.addWidget(self.icoon, 0, Qt.AlignmentFlag.AlignVCenter)
        blok = QVBoxLayout()
        blok.setSpacing(2)
        self.titel = label(titel, "kop3", wrap=False)
        self.uitleg = label(uitleg, "klein")
        self.uitleg.setVisible(bool(uitleg))
        blok.addWidget(self.titel)
        blok.addWidget(self.uitleg)
        lay.addLayout(blok, 1)
        self.rechts = rechts
        if rechts is not None:
            lay.addWidget(rechts, 0, Qt.AlignmentFlag.AlignVCenter)
        if klikbaar:
            pijl = QLabel()
            pijl.setPixmap(lijn_icoon("rechts", "tekst3", 16, gekozen=None).pixmap(16, 16))
            lay.addWidget(pijl)

    def zet_icoon(self, naam: str) -> None:
        self.icoon.setPixmap(lijn_icoon(naam, "tekst2", 22, gekozen=None).pixmap(22, 22))

    def zet_uitleg(self, tekst: str) -> None:
        self.uitleg.setText(tekst)
        self.uitleg.setVisible(bool(tekst))

    def mouseReleaseEvent(self, e) -> None:  # noqa: N802
        if self.property("klikbaar") == "true" and e.button() == Qt.MouseButton.LeftButton:
            self.geklikt.emit()
        super().mouseReleaseEvent(e)


class Keuzes(QFrame):
    """Een paar knoppen naast elkaar waarvan er één gekozen is (zoals 100% · 125% · 150%)."""

    gekozen = Signal(object)

    def __init__(self, opties: list[tuple[object, str]]):
        super().__init__()
        self.setObjectName("keuzes")
        lay = QHBoxLayout(self)
        lay.setContentsMargins(3, 3, 3, 3)
        lay.setSpacing(2)
        self.groep = QButtonGroup(self)
        self.knoppen: dict[object, QPushButton] = {}
        for waarde, tekst in opties:
            k = QPushButton(tekst)
            k.setObjectName("keus")
            k.setCheckable(True)
            k.setCursor(Qt.CursorShape.PointingHandCursor)
            k.clicked.connect(lambda _c=False, w=waarde: self.gekozen.emit(w))
            self.groep.addButton(k)
            self.knoppen[waarde] = k
            lay.addWidget(k)

    def zet(self, waarde: object) -> None:
        k = self.knoppen.get(waarde)
        if k is not None:
            k.setChecked(True)


class Regelaar(QWidget):
    """Een schuifbalk met het getal ernaast (volume, helderheid)."""

    veranderd = Signal(int)

    def __init__(self, waarde: int = 50, laag: str = "", hoog: str = ""):
        super().__init__()
        lay = QHBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(12)
        if laag:
            ic = QLabel()
            ic.setPixmap(lijn_icoon(laag, "tekst3", 18, gekozen=None).pixmap(18, 18))
            lay.addWidget(ic)
        self.balk = QSlider(Qt.Orientation.Horizontal)
        self.balk.setRange(0, 100)
        self.balk.setValue(waarde)
        self.balk.setMinimumWidth(240)
        self.balk.setCursor(Qt.CursorShape.PointingHandCursor)
        lay.addWidget(self.balk, 1)
        self.getal = label(f"{waarde}%", "kop3", wrap=False)
        self.getal.setFixedWidth(48)
        self.getal.setAlignment(Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter)
        lay.addWidget(self.getal)
        self.wacht = QTimer(self)
        self.wacht.setSingleShot(True)
        self.wacht.setInterval(120)  # niet bij elke pixel iets aan de computer veranderen
        self.wacht.timeout.connect(lambda: self.veranderd.emit(self.balk.value()))
        self.balk.valueChanged.connect(lambda w: (self.getal.setText(f"{w}%"), self.wacht.start()))

    def zet(self, waarde: int) -> None:
        self.balk.blockSignals(True)
        self.balk.setValue(waarde)
        self.balk.blockSignals(False)
        self.getal.setText(f"{waarde}%")


def schuifje(aan: bool, omgezet) -> Schuif:
    s = Schuif(aan)
    s.toggled.connect(omgezet)
    return s


class Melding(QFrame):
    """Een korte melding bovenaan (bijvoorbeeld 'Verbonden met Thuis')."""

    def __init__(self):
        super().__init__()
        self.setObjectName("melding")
        lay = QHBoxLayout(self)
        lay.setContentsMargins(16, 10, 16, 10)
        self.tekst = label("", wrap=True)
        lay.addWidget(self.tekst, 1)
        self.klok = QTimer(self)
        self.klok.setSingleShot(True)
        self.klok.timeout.connect(self.hide)
        self.hide()

    def toon(self, tekst: str, soort: str = "info", seconden: int = 6) -> None:
        self.setProperty("soort", soort)
        self.style().unpolish(self)
        self.style().polish(self)
        self.tekst.setText(tekst)
        self.show()
        self.klok.start(seconden * 1000)


class Pagina(QScrollArea):
    """Een pagina: grote titel, een zin uitleg, en daaronder kaarten met regels."""

    sleutel = ""
    icoon = ""
    titel_nl = titel_en = ""
    uitleg_nl = uitleg_en = ""
    zoekwoorden = ""
    kde = ""  # het KDE-onderdeel achter 'Meer instellingen (voor gevorderden)'

    def __init__(self, venster: Instellingen):
        super().__init__()
        self.venster = venster
        self.setFrameShape(QFrame.Shape.NoFrame)
        self.setWidgetResizable(True)
        self.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        binnen = QWidget()
        binnen.setObjectName("pagina")
        self.lay = QVBoxLayout(binnen)
        self.lay.setContentsMargins(40, 32, 40, 28)
        self.lay.setSpacing(14)
        self.lay.addWidget(label(self.naam(), "titel", wrap=False))
        if self.uitleg_nl:
            self.lay.addWidget(label(t(self.uitleg_nl, self.uitleg_en), "sub"))
        self.melding = Melding()
        self.lay.addWidget(self.melding)
        self.setWidget(binnen)
        self.bouw()
        if self.kde:
            meer = Knop(t("Meer instellingen (voor gevorderden)", "More settings (advanced)"), "stil", "lijn:code")
            meer.clicked.connect(lambda _c=False: kde_instelling(self.kde))
            self.lay.addWidget(meer, 0, Qt.AlignmentFlag.AlignLeft)
        self.lay.addStretch(1)

    @classmethod
    def naam(cls) -> str:
        return t(cls.titel_nl, cls.titel_en)

    def bouw(self) -> None:
        pass

    def ververs(self) -> None:
        """Wordt aangeroepen als je de pagina opent."""

    def kaart(self, kop: str = "") -> Groep:
        if kop:
            self.lay.addWidget(sectie(kop))
        g = Groep()
        g.lay.setContentsMargins(4, 4, 4, 4)
        self.lay.addWidget(g)
        return g


def leeg_groep(g: Groep) -> None:
    while g.lay.count():
        item = g.lay.takeAt(0)
        if item.widget():
            item.widget().deleteLater()


# ================================================================== wifi ===

def sterkte_woord(n: int) -> str:
    return t("Sterk", "Strong") if n >= 70 else t("Goed", "Good") if n >= 45 else t("Zwak", "Weak")


class WifiPagina(Pagina):
    sleutel, icoon = "wifi", "wifi"
    titel_nl, titel_en = "Wifi en internet", "Wi-Fi and internet"
    uitleg_nl = "Kies een netwerk om te verbinden. BugOS onthoudt het wachtwoord."
    uitleg_en = "Choose a network to connect. BugOS remembers the password."
    zoekwoorden = "wifi wlan internet netwerk draadloos wachtwoord kabel ethernet verbinding"
    kde = "kcm_networkmanagement"

    def bouw(self) -> None:
        g = self.kaart()
        self.schakel = schuifje(True, self.zet_wifi)
        self.hoofd = Rij("wifi", t("Wifi", "Wi-Fi"), "", self.schakel)
        g.voeg(self.hoofd)
        self.kabel = Rij("computer", t("Kabel", "Cable"), t("Verbonden met een netwerkkabel", "Connected by cable"))
        self.kabel.hide()
        g.voeg(self.kabel)
        kop = QHBoxLayout()
        kop.addWidget(sectie(t("Netwerken in de buurt", "Networks nearby")), 1)
        self.zoek_knop = Knop(t("Opnieuw zoeken", "Search again"), "stil", "lijn:verversen")
        self.zoek_knop.clicked.connect(lambda _c=False: self.ververs(True))
        kop.addWidget(self.zoek_knop)
        self.lay.addLayout(kop)
        self.lijst = self.kaart()

    def ververs(self, opnieuw: bool = False) -> None:
        self.hoofd.zet_uitleg(t("Even zoeken…", "Searching…"))
        op_achtergrond(self, lambda: (bi.wifi_aan(), bi.netwerken(opnieuw), bi.kabel_verbonden()), self.toon)

    def toon(self, uitkomst) -> None:
        if not uitkomst:
            return
        aan, netwerken, kabel = uitkomst
        self.schakel.zet_stil(aan)
        self.kabel.setVisible(kabel)
        nu = next((n for n in netwerken if n.verbonden), None)
        self.hoofd.zet_uitleg(t(f"Verbonden met {nu.naam}", f"Connected to {nu.naam}") if nu else
                              (t("Niet verbonden", "Not connected") if aan else t("Uit", "Off")))
        leeg_groep(self.lijst)
        for n in netwerken:
            if n.verbonden:
                knop = Knop(t("Verbreken", "Disconnect"), "gewoon")
                knop.clicked.connect(lambda _c=False, x=n: self.verbreek(x))
            else:
                knop = Knop(t("Verbinden", "Connect"), "gewoon")
                knop.clicked.connect(lambda _c=False, x=n: self.verbind(x))
            knop.setMinimumHeight(38)
            uitleg = (t("Verbonden · ", "Connected · ") if n.verbonden else "") + sterkte_woord(n.sterkte) + \
                (t(" · met wachtwoord", " · with password") if n.beveiligd else t(" · open netwerk", " · open network"))
            self.lijst.voeg(Rij("slot" if n.beveiligd else "wifi", n.naam, uitleg, knop))
        if not netwerken:
            self.lijst.voeg(Rij("wifi", t("Geen netwerken gevonden", "No networks found") if aan else
                                t("Wifi staat uit", "Wi-Fi is off"),
                                t("Zet wifi aan of zoek opnieuw.", "Turn on Wi-Fi or search again.")))

    def zet_wifi(self, aan: bool) -> None:
        op_achtergrond(self, lambda: bi.zet_wifi(aan), lambda _u: QTimer.singleShot(1500, self.ververs))

    def verbind(self, n: bi.Netwerk) -> None:
        wachtwoord = ""
        if n.beveiligd and not bi.bekend_netwerk(n.naam):
            d = QInputDialog(self)
            d.setWindowTitle(t("Wachtwoord", "Password"))
            d.setLabelText(t(f"Wat is het wachtwoord van '{n.naam}'?\n(Het staat vaak op de onderkant van het modem.)",
                             f"What is the password of '{n.naam}'?\n(It is often on the bottom of the router.)"))
            d.setTextEchoMode(QLineEdit.EchoMode.Password)
            d.setOkButtonText(t("Verbinden", "Connect"))
            d.setCancelButtonText(t("Annuleren", "Cancel"))
            if not d.exec() or not d.textValue():
                return
            wachtwoord = d.textValue()
        self.melding.toon(t(f"Verbinden met {n.naam}…", f"Connecting to {n.naam}…"), seconden=30)

        def klaar(uitkomst) -> None:
            gelukt = bool(uitkomst and uitkomst[0])
            self.melding.toon(t(f"Verbonden met {n.naam}.", f"Connected to {n.naam}.") if gelukt else
                              t("Verbinden lukte niet. Klopt het wachtwoord? Probeer het nog eens.",
                                "Connecting did not work. Is the password right? Try again."),
                              "goed" if gelukt else "fout")
            self.ververs()

        op_achtergrond(self, lambda: bi.verbind(n.naam, wachtwoord), klaar)

    def verbreek(self, n: bi.Netwerk) -> None:
        op_achtergrond(self, lambda: bi.verbreek(n.naam), lambda _u: self.ververs())


# ============================================================= bluetooth ===

def apparaat_icoon(soort: str) -> str:
    if soort.startswith("audio"):
        return "geluid"
    if soort.startswith("input-gaming"):
        return "spel"
    if soort == "phone":
        return "praten"
    return "bluetooth"


class BluetoothPagina(Pagina):
    sleutel, icoon = "bluetooth", "bluetooth"
    titel_nl, titel_en = "Bluetooth", "Bluetooth"
    uitleg_nl = "Koptelefoons, muizen, toetsenborden en telefoons zonder draad."
    uitleg_en = "Headphones, mice, keyboards and phones without a cable."
    zoekwoorden = "bluetooth koptelefoon oortjes muis toetsenbord telefoon koppelen draadloos"
    kde = "kcm_bluetooth"

    def bouw(self) -> None:
        g = self.kaart()
        self.schakel = schuifje(True, self.zet_bt)
        self.hoofd = Rij("bluetooth", "Bluetooth", "", self.schakel)
        g.voeg(self.hoofd)
        kop = QHBoxLayout()
        kop.addWidget(sectie(t("Jouw apparaten", "Your devices")), 1)
        nieuw = Knop(t("Nieuw apparaat koppelen", "Pair a new device"), "stil", "lijn:map-plus")
        nieuw.clicked.connect(lambda _c=False: start("bluedevil-wizard") if bestaat("bluedevil-wizard")
                              else kde_instelling("kcm_bluetooth"))
        kop.addWidget(nieuw)
        self.lay.addLayout(kop)
        self.lijst = self.kaart()

    def ververs(self) -> None:
        op_achtergrond(self, lambda: (bi.bt_aan(), bi.bt_apparaten()), self.toon)

    def toon(self, uitkomst) -> None:
        if not uitkomst:
            return
        aan, apparaten = uitkomst
        self.schakel.zet_stil(aan)
        verbonden = sum(1 for a in apparaten if a.verbonden)
        self.hoofd.zet_uitleg((t(f"Aan · {verbonden} verbonden", f"On · {verbonden} connected") if verbonden
                               else t("Aan", "On")) if aan else t("Uit", "Off"))
        leeg_groep(self.lijst)
        for a in apparaten:
            knop = Knop(t("Verbreken", "Disconnect") if a.verbonden else t("Verbinden", "Connect"), "gewoon")
            knop.setMinimumHeight(38)
            knop.setEnabled(aan)
            knop.clicked.connect(lambda _c=False, x=a: self.verbind(x))
            uitleg = t("Verbonden", "Connected") if a.verbonden else t("Niet verbonden", "Not connected")
            if a.batterij is not None:
                uitleg += t(f" · batterij {a.batterij}%", f" · battery {a.batterij}%")
            self.lijst.voeg(Rij(apparaat_icoon(a.soort), a.naam, uitleg, knop))
        if not apparaten:
            self.lijst.voeg(Rij("bluetooth", t("Nog niets gekoppeld", "Nothing paired yet"),
                                t("Kies 'Nieuw apparaat koppelen' en zet je apparaat in koppelstand.",
                                  "Choose 'Pair a new device' and put your device in pairing mode.")))

    def zet_bt(self, aan: bool) -> None:
        op_achtergrond(self, lambda: bi.zet_bt(aan), lambda _u: QTimer.singleShot(800, self.ververs))

    def verbind(self, a: bi.Apparaat) -> None:
        self.melding.toon(t(f"{a.naam}: even geduld…", f"{a.naam}: one moment…"), seconden=20)

        def klaar(gelukt) -> None:
            if gelukt:
                self.melding.toon(t(f"{a.naam} is verbroken.", f"{a.naam} is disconnected.") if a.verbonden else
                                  t(f"{a.naam} is verbonden.", f"{a.naam} is connected."), "goed")
            else:
                self.melding.toon(t(f"Dat lukte niet. Staat {a.naam} aan en dichtbij?",
                                    f"That did not work. Is {a.naam} on and nearby?"), "fout")
            self.ververs()

        op_achtergrond(self, lambda: bi.bt_verbind(a.adres, not a.verbonden), klaar)


# ================================================================ geluid ===

class GeluidPagina(Pagina):
    sleutel, icoon = "geluid", "geluid"
    titel_nl, titel_en = "Geluid", "Sound"
    uitleg_nl = "Hoe hard, en waar het geluid uit komt."
    uitleg_en = "How loud, and where the sound comes from."
    zoekwoorden = "geluid volume luidspreker speaker koptelefoon hdmi tv stil dempen microfoon"
    kde = "kcm_pulseaudio"

    def bouw(self) -> None:
        g = self.kaart()
        self.regelaar = Regelaar(50)
        self.regelaar.veranderd.connect(lambda w: op_achtergrond(self, lambda: bi.zet_volume(w), lambda _u: None))
        g.voeg(Rij("geluid", t("Volume", "Volume"), "", self.regelaar))
        self.stil = schuifje(False, lambda aan: op_achtergrond(self, lambda: bi.zet_stil(aan), lambda _u: None))
        g.voeg(Rij("kruis", t("Geluid uit", "Mute"), t("Alles even stil", "Everything quiet for a moment"),
                   self.stil))
        self.lijst = self.kaart(t("Waar komt het geluid uit?", "Where does the sound come from?"))

    def ververs(self) -> None:
        op_achtergrond(self, bi.geluid, self.toon)

    def toon(self, uitkomst) -> None:
        if not uitkomst:
            return
        volume, stil, uitgangen = uitkomst
        self.regelaar.zet(volume)
        self.stil.zet_stil(stil)
        leeg_groep(self.lijst)
        for u in uitgangen:
            if u.standaard:
                rechts = Chip(t("In gebruik", "In use"), "goed")
            else:
                rechts = Knop(t("Gebruiken", "Use"), "gewoon")
                rechts.setMinimumHeight(38)
                rechts.clicked.connect(lambda _c=False, x=u: op_achtergrond(
                    self, lambda: bi.kies_uitgang(x.naam), lambda _u: self.ververs()))
            self.lijst.voeg(Rij("geluid", u.omschrijving, "", rechts))
        if not uitgangen:
            self.lijst.voeg(Rij("geluid", t("Geen luidsprekers gevonden", "No speakers found"),
                                t("Sluit een koptelefoon of luidspreker aan.", "Connect headphones or a speaker.")))


# ================================================================ scherm ===

class SchermPagina(Pagina):
    sleutel, icoon = "scherm", "computer"
    titel_nl, titel_en = "Scherm", "Display"
    uitleg_nl = "Helderheid, warm licht voor de avond, en hoe groot alles is."
    uitleg_en = "Brightness, warm light for the evening, and how big everything is."
    zoekwoorden = "scherm beeldscherm monitor helderheid nachtlicht nachtlampje groot groter klein schaal tekst"
    kde = "kcm_kscreen"

    def bouw(self) -> None:
        g = self.kaart()
        self.helder = Regelaar(70)
        self.helder.veranderd.connect(lambda w: op_achtergrond(self, lambda: bi.zet_helderheid(w), lambda _u: None))
        self.helder_rij = Rij("zon", t("Helderheid", "Brightness"), "", self.helder)
        g.voeg(self.helder_rij)
        self.nacht = schuifje(False, lambda aan: op_achtergrond(self, lambda: bi.zet_nachtlicht(aan), lambda _u: None))
        g.voeg(Rij("maan", t("Nachtlicht", "Night light"),
                   t("'s Avonds warmer licht, prettiger voor je ogen", "Warmer light in the evening, easier on your eyes"),
                   self.nacht))
        self.lay.addWidget(sectie(t("Grootte", "Size")))
        g2 = self.kaart()
        self.grootte = Keuzes([(1.0, "100%"), (1.25, "125%"), (1.5, "150%"), (1.75, "175%"), (2.0, "200%")])
        self.grootte.gekozen.connect(self.zet_grootte)
        g2.voeg(Rij("computer", t("Alles groter of kleiner", "Make everything bigger or smaller"),
                    t("Tekst, knoppen en vensters", "Text, buttons and windows"), self.grootte))

    def ververs(self) -> None:
        op_achtergrond(self, lambda: (bi.helderheid(), bi.nachtlicht(), bi.schaal()), self.toon)

    def toon(self, uitkomst) -> None:
        if not uitkomst:
            return
        helder, nacht, schaal = uitkomst
        self.helder_rij.setVisible(helder is not None)
        if helder is not None:
            self.helder.zet(helder)
        self.nacht.zet_stil(nacht)
        self.grootte.zet(min((1.0, 1.25, 1.5, 1.75, 2.0), key=lambda w: abs(w - schaal)))

    def zet_grootte(self, waarde: float) -> None:
        self.melding.toon(t(f"Grootte {waarde:.0%} wordt ingesteld…", f"Setting size to {waarde:.0%}…"))
        op_achtergrond(self, lambda: bi.zet_schaal(waarde), lambda ok: self.melding.toon(
            t("Klaar. Sommige programma's worden pas groter als je ze opnieuw opent.",
              "Done. Some programs only change after you open them again.") if ok else
            t("Dat lukte niet. Probeer het bij 'Meer instellingen'.", "That did not work. Try 'More settings'."),
            "goed" if ok else "fout"))


# =============================================================== energie ===

PROFIEL_TEKST = {
    "power-saver": (("Zuinig", "Saver"), ("Batterij gaat langer mee", "Battery lasts longer"), "batterij"),
    "balanced": (("Gebalanceerd", "Balanced"), ("Aanbevolen", "Recommended"), "vink"),
    "performance": (("Snel", "Fast"), ("Volle kracht, voor games", "Full power, for games"), "spel"),
}


class EnergiePagina(Pagina):
    sleutel, icoon = "energie", "batterij"
    titel_nl, titel_en = "Energie", "Power"
    uitleg_nl = "Zuinig of snel, en hoe het met de batterij gaat."
    uitleg_en = "Saving or fast, and how the battery is doing."
    zoekwoorden = "energie batterij accu stroom zuinig snel prestaties slaapstand opladen"
    kde = "kcm_powerdevilprofilesconfig"

    def bouw(self) -> None:
        self.batterij_kaart = self.kaart()
        self.batterij = Rij("batterij", t("Batterij", "Battery"), "")
        self.batterij_kaart.voeg(self.batterij)
        self.lay.addWidget(sectie(t("Hoe moet je computer werken?", "How should your computer work?")))
        rij = QHBoxLayout()
        rij.setSpacing(12)
        self.profielen: dict[str, KeuzeKaart] = {}
        groep = QButtonGroup(self)
        for profiel in bi.PROFIELEN:
            (nl, en), (unl, uen), ic = PROFIEL_TEKST[profiel]
            inhoud = QWidget()
            il = QVBoxLayout(inhoud)
            il.setContentsMargins(4, 4, 4, 4)
            il.setSpacing(6)
            plaatje = QLabel()
            plaatje.setPixmap(lijn_icoon(ic, "accent", 26, gekozen=None).pixmap(26, 26))
            il.addWidget(plaatje)
            il.addWidget(label(t(nl, en), "kop3", wrap=False))
            il.addWidget(label(t(unl, uen), "klein"))
            kaart = KeuzeKaart(inhoud)
            kaart.setMinimumHeight(116)
            kaart.clicked.connect(lambda _c=False, p=profiel: self.zet_profiel(p))
            groep.addButton(kaart)
            self.profielen[profiel] = kaart
            rij.addWidget(kaart, 1)
        self.profiel_rij = QWidget()
        self.profiel_rij.setLayout(rij)
        self.lay.addWidget(self.profiel_rij)
        self.geen_profiel = label(t("Deze computer kan niet wisselen tussen zuinig en snel.",
                                    "This computer cannot switch between saving and fast."), "sub")
        self.geen_profiel.hide()
        self.lay.addWidget(self.geen_profiel)

    def ververs(self) -> None:
        op_achtergrond(self, lambda: (bi.batterij(), bi.energieprofiel()), self.toon)

    def toon(self, uitkomst) -> None:
        if not uitkomst:
            return
        bat, profiel = uitkomst
        self.batterij_kaart.setVisible(bat is not None)
        if bat is not None:
            staat = t("vol", "full") if bat.vol else t("wordt opgeladen", "charging") if bat.laadt else \
                t("op batterij", "on battery")
            self.batterij.zet_uitleg(f"{bat.procent}% · {staat}")
        self.profiel_rij.setVisible(profiel is not None)
        self.geen_profiel.setVisible(profiel is None)
        if profiel in self.profielen:
            self.profielen[profiel].setChecked(True)

    def zet_profiel(self, profiel: str) -> None:
        op_achtergrond(self, lambda: bi.zet_energieprofiel(profiel), lambda ok: self.melding.toon(
            t(f"Je computer werkt nu: {PROFIEL_TEKST[profiel][0][0].lower()}.",
              f"Your computer now works: {PROFIEL_TEKST[profiel][0][1].lower()}.") if ok else
            t("Dat lukte niet.", "That did not work."), "goed" if ok else "fout"))


# ============================================================= uiterlijk ===

class UiterlijkPagina(Pagina):
    sleutel, icoon = "uiterlijk", "palet"
    titel_nl, titel_en = "Uiterlijk", "Appearance"
    uitleg_nl = "Licht of donker, en de achtergrond van je bureaublad."
    uitleg_en = "Light or dark, and your desktop background."
    zoekwoorden = "uiterlijk licht donker thema kleur achtergrond bureaublad foto wallpaper"
    kde = "kcm_colors"

    def bouw(self) -> None:
        self.lay.addWidget(sectie(t("Licht of donker", "Light or dark")))
        rij = QHBoxLayout()
        rij.setSpacing(12)
        groep = QButtonGroup(self)
        self.thema: dict[bool, KeuzeKaart] = {}
        for donker, (nl, en), (unl, uen) in ((False, ("Licht", "Light"), ("Fris en helder", "Fresh and bright")),
                                             (True, ("Donker", "Dark"), ("Rustig voor je ogen", "Calm for your eyes"))):
            inhoud = QWidget()
            il = QVBoxLayout(inhoud)
            il.setContentsMargins(4, 4, 4, 4)
            il.setSpacing(6)
            plaatje = QLabel()
            plaatje.setPixmap(lijn_icoon("maan" if donker else "zon", "accent", 26, gekozen=None).pixmap(26, 26))
            il.addWidget(plaatje)
            il.addWidget(label(t(nl, en), "kop3", wrap=False))
            il.addWidget(label(t(unl, uen), "klein"))
            kaart = KeuzeKaart(inhoud)
            kaart.setMinimumHeight(116)
            kaart.setMinimumWidth(220)
            kaart.clicked.connect(lambda _c=False, d=donker: self.zet_thema(d))
            groep.addButton(kaart)
            self.thema[donker] = kaart
            rij.addWidget(kaart, 1)
        rij.addStretch(1)
        self.lay.addLayout(rij)
        self.lay.addSpacing(6)
        self.lay.addWidget(sectie(t("Achtergrond", "Background")))
        plaatjes = QHBoxLayout()
        plaatjes.setSpacing(12)
        groep2 = QButtonGroup(self)
        for naam, pad in bi.bugos_achtergronden():
            k = QPushButton()
            k.setObjectName("plaatje")
            k.setCheckable(True)
            k.setCursor(Qt.CursorShape.PointingHandCursor)
            k.setToolTip(naam)
            beeld = QPixmap(pad)
            if not beeld.isNull():
                k.setIcon(beeld.scaled(QSize(320, 180), Qt.AspectRatioMode.KeepAspectRatioByExpanding,
                                       Qt.TransformationMode.SmoothTransformation))
                k.setIconSize(QSize(176, 99))
            k.clicked.connect(lambda _c=False, p=pad: self.zet_achtergrond(p))
            groep2.addButton(k)
            plaatjes.addWidget(k)
        eigen = Knop(t("Eigen foto kiezen…", "Choose your own photo…"), "gewoon", "lijn:foto")
        eigen.clicked.connect(self.kies_foto)
        plaatjes.addWidget(eigen, 0, Qt.AlignmentFlag.AlignVCenter)
        plaatjes.addStretch(1)
        self.lay.addLayout(plaatjes)

    def ververs(self) -> None:
        op_achtergrond(self, bi.donker, lambda d: self.thema[bool(d)].setChecked(True))

    def zet_thema(self, donker: bool) -> None:
        op_achtergrond(self, lambda: bi.zet_donker(donker), lambda _u: self.melding.toon(
            t("Klaar. Open programma's krijgen de nieuwe kleuren als je ze opnieuw opent.",
              "Done. Open programs get the new colors when you open them again."), "goed"))

    def zet_achtergrond(self, pad: str) -> None:
        op_achtergrond(self, lambda: bi.zet_achtergrond(pad), lambda ok: self.melding.toon(
            t("Je achtergrond is veranderd.", "Your background has changed.") if ok else
            t("Dat lukte niet.", "That did not work."), "goed" if ok else "fout"))

    def kies_foto(self) -> None:
        map_ = Path.home() / t("Afbeeldingen", "Pictures")
        pad, _ = QFileDialog.getOpenFileName(self, t("Kies een foto", "Choose a photo"),
                                             str(map_ if map_.exists() else Path.home()),
                                             t("Foto's (*.jpg *.jpeg *.png *.webp)", "Photos (*.jpg *.jpeg *.png *.webp)"))
        if pad:
            self.zet_achtergrond(pad)


