#!/usr/bin/python3
"""BugOS Instellingen: alles wat je nodig hebt, op één plek, in gewone woorden.

Zoals Instellingen in Windows, maar rustiger: de dingen die je echt gebruikt (wifi,
bluetooth, printers, geluid, scherm, energie, uiterlijk, meldingen, muis, makkelijker zien,
tijd en taal, inloggen, standaardprogramma's, updates) regel je hier zelf. Klik op een
netwerk om te verbinden, op een luidspreker om die te gebruiken. Wie meer wil, vindt per
onderdeel 'Meer instellingen (voor gevorderden)'.

Gebruik:  bugos-settings [pagina]
          pagina = start | wifi | bluetooth | printers | geluid | scherm | energie | uiterlijk | meldingen
                   | muis | zien | tijd | inloggen | programmas | updates | over

Hier staan de startpagina en het venster; de andere pagina's staan in /usr/lib/bugos/python/bugos_settings_*.py.
"""

from __future__ import annotations

import sys

sys.path.insert(0, "/usr/lib/bugos/python")

import bugos_config as bi  # noqa: E402
from bugos_ui import (  # noqa: E402
    K, Groep, Rij, Schuif, Venster, label, leeg_groep, lijn_icoon, maak_app, px, schaal_css, sectie, start, t,
    uitvoeren, zoeksleutel,
)
from bugos_settings_account import InloggenPagina, TijdPagina  # noqa: E402
from bugos_settings_meldingen import MeldingenPagina, PrintersPagina, ProgrammasPagina  # noqa: E402
from bugos_settings_netwerk import BluetoothPagina, WifiPagina  # noqa: E402
from bugos_settings_onderdelen import (  # noqa: E402,F401  (KiesDialoog en WachtwoordDialoog: voor de test)
    Blad, KiesDialoog, Regelaar, WachtwoordDialoog, op_achtergrond, stijl,
)
from bugos_settings_scherm import EnergiePagina, GeluidPagina, SchermPagina, UiterlijkPagina  # noqa: E402
from bugos_settings_systeem import OverPagina, SpelenPagina, UpdatesPagina  # noqa: E402
from bugos_settings_zien import MuisPagina, ZienPagina  # noqa: E402
from PySide6.QtCore import QEvent, QSize, Qt, QTimer  # noqa: E402
from PySide6.QtWidgets import (  # noqa: E402
    QButtonGroup, QFrame, QGridLayout, QHBoxLayout, QLabel, QPushButton, QStackedWidget, QVBoxLayout, QWidget,
)


# ================================================================= start ===

class StartPagina(Blad):
    sleutel, icoon = "start", "huis"
    titel_nl, titel_en = "Instellingen", "Settings"
    uitleg_nl = "Alles op één plek, in gewone woorden."
    uitleg_en = "Everything in one place, in plain words."

    def bouw(self) -> None:
        # snel: de schuifjes die je het vaakst nodig hebt
        rooster = QGridLayout()
        rooster.setSpacing(12)
        self.snel: dict[str, Schuif] = {}
        self.snel_uitleg: dict[str, QLabel] = {}
        for i, (sleutel, ic, naam) in enumerate((("wifi", "wifi", t("Wifi", "Wi-Fi")),
                                                 ("bt", "bluetooth", "Bluetooth"),
                                                 ("nacht", "maan", t("Nachtlicht", "Night light")),
                                                 ("donker", "palet", t("Donker", "Dark")))):
            vak = QFrame()
            vak.setObjectName("snel")
            vl = QVBoxLayout(vak)
            vl.setContentsMargins(18, 16, 16, 14)
            vl.setSpacing(10)
            boven = QHBoxLayout()
            ik = QLabel()
            ik.setPixmap(lijn_icoon(ic, "tekst", 22, gekozen=None).pixmap(22, 22))
            boven.addWidget(ik)
            boven.addStretch(1)
            schuif = Schuif(False)
            schuif.toggled.connect(lambda aan, s=sleutel: self.zet_snel(s, aan))
            boven.addWidget(schuif)
            vl.addLayout(boven)
            vl.addWidget(label(naam, "kop3", wrap=False))
            uitleg = label("…", "klein", wrap=False)
            vl.addWidget(uitleg)
            self.snel[sleutel] = schuif
            self.snel_uitleg[sleutel] = uitleg
            rooster.addWidget(vak, 0, i)
        self.lay.addLayout(rooster)
        g = self.kaart()
        self.volume = Regelaar(50)
        self.volume.veranderd.connect(lambda w: op_achtergrond(self, lambda: bi.zet_volume(w), lambda _u: None))
        g.voeg(Rij("geluid", t("Volume", "Volume"), "", self.volume))
        # zoeken
        self.zoek_kop = sectie(t("Gevonden", "Found"))
        self.zoek_kop.hide()
        self.lay.addWidget(self.zoek_kop)
        self.zoek_kaart = Groep()
        self.zoek_kaart.lay.setContentsMargins(4, 4, 4, 4)
        self.zoek_kaart.hide()
        self.lay.addWidget(self.zoek_kaart)
        # alle onderdelen, met hoe ze nu staan
        self.alles = self.kaart(t("Alle instellingen", "All settings"))
        self.rijen: dict[str, Rij] = {}
        for g in GROEPEN[1:]:
            rij = Rij(g.icoon, g.naam(), g.uitleg(), klikbaar=True)
            eerste = g.paginas[0].sleutel
            rij.geklikt.connect(lambda s=eerste: self.venster.ga_naar(s))
            self.alles.voeg(rij)
            # Op de sleutel van elke pagina in de groep: toon() zet bijv. de wifi-naam en het volume erbij.
            for klasse in g.paginas:
                self.rijen.setdefault(klasse.sleutel, rij)

    def ververs(self) -> None:
        def lees():
            return {"wifi": bi.wifi_aan(), "netwerken": bi.netwerken(), "bt": bi.bt_aan(), "nacht": bi.nachtlicht(),
                    "donker": bi.donker(), "geluid": bi.geluid(), "heeft_wifi": bi.heeft_wifi(),
                    "heeft_bt": bi.VOORBEELD or bi.bt_hardware()}
        op_achtergrond(self, lees, self.toon)

    def toon(self, s) -> None:
        if not s:
            return
        nu = next((n for n in s["netwerken"] if n.verbonden), None)
        for sleutel, aan, uitleg in (
                ("wifi", s["wifi"], (nu.naam if nu else t("Niet verbonden", "Not connected")) if s["wifi"]
                 else t("Uit", "Off")),
                ("bt", s["bt"], t("Aan", "On") if s["bt"] else t("Uit", "Off")),
                ("nacht", s["nacht"], t("'s Avonds warmer", "Warmer at night") if s["nacht"] else t("Uit", "Off")),
                ("donker", s["donker"], t("Aan", "On") if s["donker"] else t("Uit", "Off"))):
            self.snel[sleutel].zet_stil(bool(aan))
            self.snel_uitleg[sleutel].setText(uitleg)
        # Een pc zonder wifi (aan een kabel): geen wifi-tegel die niets doet (U111).
        self.snel["wifi"].parentWidget().setVisible(s.get("heeft_wifi", True))
        self.snel["bt"].parentWidget().setVisible(s.get("heeft_bt", True))   # ook geen Bluetooth zonder Bluetooth (U157)
        volume, _stil, uitgangen = s["geluid"]
        self.volume.zet(volume)
        if nu:
            self.rijen["wifi"].zet_uitleg(t(f"Verbonden met {nu.naam}", f"Connected to {nu.naam}"))
        gebruikt = next((u for u in uitgangen if u.standaard), None)
        if gebruikt:
            self.rijen["geluid"].zet_uitleg(f"{volume}% · {gebruikt.omschrijving}")

    def zet_snel(self, sleutel: str, aan: bool) -> None:
        werk = {"wifi": lambda: bi.zet_wifi(aan), "bt": lambda: bi.zet_bt(aan),
                "nacht": lambda: bi.zet_nachtlicht(aan), "donker": lambda: bi.zet_donker(aan)}[sleutel]
        op_achtergrond(self, werk, lambda _u: QTimer.singleShot(1200, self.ververs))

    def zoek(self, tekst: str) -> None:
        woorden = zoeksleutel(tekst).split()   # (U268)
        leeg_groep(self.zoek_kaart)
        gevonden = 0
        if woorden:
            for klasse in PAGINAS[1:]:
                bron = zoeksleutel(f"{klasse.titel_nl} {klasse.titel_en} {klasse.uitleg_nl} {klasse.uitleg_en} "
                                   f"{klasse.zoekwoorden}")
                if all(w in bron for w in woorden):
                    rij = Rij(klasse.icoon, klasse.naam(), t(klasse.uitleg_nl, klasse.uitleg_en), klikbaar=True)
                    rij.geklikt.connect(lambda s=klasse.sleutel: self.venster.ga_naar(s))
                    self.zoek_kaart.voeg(rij)
                    gevonden += 1
            if not gevonden:
                self.zoek_kaart.voeg(Rij("kruis", t("Niks gevonden", "Nothing found"),
                                         t("Probeer een ander woord.", "Try another word.")))
        self.zoek_kop.setVisible(bool(woorden))
        self.zoek_kaart.setVisible(bool(woorden))


PAGINAS: list[type[Blad]] = [StartPagina, WifiPagina, BluetoothPagina, PrintersPagina, GeluidPagina, SchermPagina,
                             EnergiePagina, UiterlijkPagina, MeldingenPagina, MuisPagina, ZienPagina, TijdPagina,
                             InloggenPagina, ProgrammasPagina, SpelenPagina, UpdatesPagina, OverPagina]
OUDE_NAMEN = {"schakelaars": "updates"}


# ================================================================ groepen ===
# Zoals Windows 11: niet 17 losse onderdelen in de zijbalk (dat paste niet eens op een laptopscherm), maar 10
# groepen. Een groep met meer pagina's krijgt bovenaan tabjes. Elke pagina houdt zijn eigen sleutel, dus
# 'bugos-settings bluetooth', het zoeken in het startmenu en de links vanuit andere apps werken gewoon.

class Indeling:
    def __init__(self, sleutel: str, icoon: str, nl: str, en: str, unl: str, uen: str, paginas: list[type[Blad]]):
        self.sleutel, self.icoon, self.nl, self.en, self.unl, self.uen = sleutel, icoon, nl, en, unl, uen
        self.paginas = paginas

    def naam(self) -> str:
        return t(self.nl, self.en)

    def uitleg(self) -> str:
        return t(self.unl, self.uen)


GROEPEN: list[Indeling] = [
    Indeling("start", StartPagina.icoon, "Start", "Home", "", "", [StartPagina]),
    Indeling("wifi", WifiPagina.icoon, "Wifi en internet", "Wi-Fi and internet",
             "Klik op een netwerk om te verbinden.", "Click a network to connect.", [WifiPagina]),
    Indeling("apparaten", BluetoothPagina.icoon, "Apparaten", "Devices",
             "Bluetooth, printers en scanners, muis en touchpad.", "Bluetooth, printers and scanners, mouse and touchpad.",
             [BluetoothPagina, PrintersPagina, MuisPagina]),
    Indeling("geluid-groep", GeluidPagina.icoon, "Geluid en meldingen", "Sound and notifications",
             "Volume, luidsprekers, niet storen.", "Volume, speakers, do not disturb.", [GeluidPagina, MeldingenPagina]),
    Indeling("beeld", SchermPagina.icoon, "Scherm en uiterlijk", "Display and appearance",
             "Helderheid, grootte, licht of donker, achtergrond en taakbalk.",
             "Brightness, size, light or dark, background and taskbar.", [SchermPagina, UiterlijkPagina]),
    Indeling("energie", EnergiePagina.icoon, "Energie", "Power",
             "Zuinig of snel, batterij en slaapstand.", "Saving or fast, battery and sleep.", [EnergiePagina]),
    Indeling("account", InloggenPagina.icoon, "Account en taal", "Account and language",
             "Je naam en wachtwoord, de klok en de taal.", "Your name and password, the clock and the language.",
             [InloggenPagina, TijdPagina]),
    Indeling("zien", ZienPagina.icoon, "Makkelijker zien", "Easier to see",
             "Grotere letters, vergrootglas, voorlezen.", "Bigger text, magnifier, read aloud.", [ZienPagina]),
    Indeling("apps", SpelenPagina.icoon, "Apps en gamen", "Apps and gaming",
             "Standaardprogramma's, game-modus en ontwikkelaarsmodus.", "Default programs, game mode and developer mode.",
             [ProgrammasPagina, SpelenPagina]),
    Indeling("systeem", UpdatesPagina.icoon, "Updates en info", "Updates and info",
             "Updates, terug naar de vorige versie, over deze computer.",
             "Updates, back to the previous version, about this computer.", [UpdatesPagina, OverPagina]),
]
GROEP_VAN = {k.sleutel: g for g in GROEPEN for k in g.paginas}


class GroepPagina(QWidget):
    """Meer pagina's onder één onderdeel van de zijbalk, met tabjes bovenaan (zoals Windows)."""

    def __init__(self, groep: Indeling, bladen: list[Blad]):
        super().__init__()
        self.groep = groep
        self.bladen = {b.sleutel: b for b in bladen}
        lay = QVBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(0)
        rij = QHBoxLayout()
        rij.setContentsMargins(*TABS_MARGE)
        rij.setSpacing(4)
        self.tabs: dict[str, QPushButton] = {}
        knoppen = QButtonGroup(self)
        for b in bladen:
            # Stille tabjes zoals in Windows 11: geen tweede rode knop naast de rode hoofdknop van de pagina.
            k = QPushButton(b.naam())
            k.setObjectName("tab")
            k.setCheckable(True)
            k.setCursor(Qt.CursorShape.PointingHandCursor)
            k.setMinimumHeight(px(TAB_HOOGTE))
            k.clicked.connect(lambda _c=False, s=b.sleutel: self.toon(s))
            knoppen.addButton(k)
            rij.addWidget(k)
            self.tabs[b.sleutel] = k
        rij.addStretch(1)
        lay.addLayout(rij)
        self.stapel = QStackedWidget()
        for b in bladen:
            # Onder de tabjes begint de pagina hoger: de titel staat bijna even hoog als op een pagina zonder tabjes.
            m = b.lay.contentsMargins()
            b.lay.setContentsMargins(m.left(), BLAD_ONDER_TABS, m.right(), m.bottom())
            self.stapel.addWidget(b)
        lay.addWidget(self.stapel, 1)
        self.toon(bladen[0].sleutel, ververs=False)

    @property
    def sleutel(self) -> str:   # wat er nu echt open is (voor Instellingen.huidige en de tests)
        return self.stapel.currentWidget().sleutel

    def toon(self, sleutel: str, ververs: bool = True) -> None:
        blad = self.bladen[sleutel]
        self.stapel.setCurrentWidget(blad)
        self.tabs[sleutel].setChecked(True)
        if ververs:
            blad.ververs()

    def ververs(self) -> None:
        self.stapel.currentWidget().ververs()


# ================================================================ venster ===

TAB_HOOGTE = 32
TABS_MARGE = (40, 16, 40, 0)    # de rij tabjes boven een pagina (links, boven, rechts, onder)
BLAD_ONDER_TABS = 14            # de bovenmarge van een pagina onder de tabjes (een gewone pagina: 32)


def tab_stijl() -> str:
    """Tabjes zoals in Windows 11: stil (geen rand, geen rood vlak). Het gekozen tabje heeft rode letters op een
    zacht rood vlak (zoals in de zijbalk) en een rode streep eronder, die je ook zonder kleur goed ziet (3:1)."""
    return schaal_css(f"""
QPushButton#tab {{ border: none; border-radius: 12px; padding: 5px 14px; background: transparent;
                  color: {K['tekst2']}; font-size: 14px; font-weight: 600; }}
QPushButton#tab:hover {{ background: {K['knop']}; color: {K['tekst']}; }}
QPushButton#tab:checked {{ background: {K['accent_zacht']}; color: {K['accent_gekozen']};
                          border-bottom: 3px solid {K['accent']}; padding-bottom: 2px; }}
QPushButton#tab:focus {{ border: 2px solid {K['accent']}; padding: 3px 12px; }}
""")


class Instellingen(Venster):
    def __init__(self, begin: str = "start"):
        super().__init__(t("Instellingen", "Settings"), zoeken=t("Zoek een instelling", "Search settings"),
                         maat=(1120, 820))
        self.setStyleSheet(stijl())
        self.groepen: dict[str, GroepPagina] = {}
        for g in GROEPEN:
            bladen = [klasse(self) for klasse in g.paginas]
            if len(bladen) == 1:
                self.voeg_pagina(bladen[0].sleutel, g.icoon, g.naam(), bladen[0])
                continue
            groep = GroepPagina(g, bladen)
            self.voeg_pagina(g.sleutel, g.icoon, g.naam(), groep)
            self.groepen[g.sleutel] = groep
            for b in bladen:
                self.paginas[b.sleutel] = b   # elke pagina blijft op zijn eigen sleutel te vinden
        self.setStyleSheet(self.styleSheet() + tab_stijl())
        self.zoekveld.textChanged.connect(self.zoeken)
        begin = OUDE_NAMEN.get(begin, begin)
        self.ga_naar(begin if begin in self.paginas else "start")
        self.nav.setFocus()  # niet meteen in het zoekveld

    def open_blad(self):
        """De pagina die je nu ziet (in een groep: die van het gekozen tabje)."""
        w = self.stapel.currentWidget()
        return w.stapel.currentWidget() if isinstance(w, GroepPagina) else w

    def huidige(self) -> str:
        """De pagina die open is (in een groep: het gekozen tabje)."""
        rij = super().huidige()
        groep = self.groepen.get(rij) if hasattr(self, "groepen") else None
        return groep.sleutel if groep is not None else rij

    def ga_naar(self, sleutel: str) -> None:
        sleutel = OUDE_NAMEN.get(sleutel, sleutel)
        g = GROEP_VAN.get(sleutel)
        if g is None or g.sleutel not in getattr(self, "groepen", {}):
            super().ga_naar(sleutel)
            return
        groep = self.groepen[g.sleutel]
        if super().huidige() == g.sleutel:
            groep.toon(sleutel)
        else:
            groep.toon(sleutel, ververs=False)
            super().ga_naar(g.sleutel)   # opent de groep (en ververst het gekozen tabje)

    def tweede_start(self, args: list[str]) -> None:
        """Instellingen was al open en wordt opnieuw gestart (bijv. vanuit het snelmenu): naar die pagina (U208)."""
        if any(a in self.paginas or a in OUDE_NAMEN for a in args):
            begin = OUDE_NAMEN.get(begin_pagina(args), begin_pagina(args))
            self.ga_naar(begin if begin in self.paginas else "start")
        if getattr(self, "sluit_na_update", False):
            # Je opent Instellingen weer: het gaat na de update niet meer vanzelf dicht (U221).
            self.paginas["updates"].melding.toon(t("De update is nog bezig.", "The update is still busy."), seconden=0)

    # Pagina's waar je een KDE-venster voor opent (koppelen, printer toevoegen) of een app voor installeert:
    # kom je terug in Instellingen, dan opnieuw kijken (U227).
    VERVERS_BIJ_TERUGKOMEN = ("bluetooth", "printers", "programmas")

    def changeEvent(self, e) -> None:  # noqa: N802
        super().changeEvent(e)
        if e.type() != QEvent.Type.ActivationChange:
            return
        if not self.isActiveWindow():
            self._was_weg = True   # een ander venster kreeg de aandacht
            return
        terug, self._was_weg = getattr(self, "_was_weg", False), False
        if terug and self.huidige() in self.VERVERS_BIJ_TERUGKOMEN:
            ververs = getattr(self.paginas.get(self.huidige()), "ververs", None)
            if callable(ververs):
                ververs()

    def closeEvent(self, e) -> None:  # noqa: N802
        # Nooit midden in een update of het teruggaan stoppen (dan stopt rpm-ostree ook): wacht tot het
        # klaar is en ga dan vanzelf dicht, zoals Bestanden doet bij het kopiëren.
        updates = self.paginas.get("updates")
        if updates is not None and (getattr(updates, "bezig", False) or getattr(updates, "bezig_keuze", False)):
            self.sluit_na_update = True
            updates.melding.toon(t("Even wachten: de update is nog bezig. Daarna gaat Instellingen vanzelf dicht.",
                                   "One moment: the update is still busy. Settings closes by itself afterwards."),
                                 seconden=0)
            self.ga_naar("updates")
            e.ignore()
            return
        super().closeEvent(e)

    def zoeken(self, tekst: str) -> None:
        if tekst and self.huidige() != "start":
            self.ga_naar("start")
        self.paginas["start"].zoek(tekst)


def begin_pagina(args: list[str]) -> str:
    """Welke pagina moet open? Het eerste woord dat een pagina is (Qt-opties zoals -qwindowgeometry tellen niet)."""
    namen = {k.sleutel for k in PAGINAS} | set(OUDE_NAMEN)
    return next((a for a in args if a in namen), "start")


def main() -> int:
    app = maak_app("bugos-settings", "bugos-settings", sys.argv, een_keer=True)   # (U208)
    return uitvoeren(app, Instellingen(begin_pagina(sys.argv[1:])))


if __name__ == "__main__":
    sys.exit(main())
