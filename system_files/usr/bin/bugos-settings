#!/usr/bin/python3
"""BugOS Instellingen: alles wat je nodig hebt, op één plek, in gewone woorden.

Zoals Instellingen in Windows, maar rustiger: de dingen die je echt gebruikt (wifi,
bluetooth, printers, geluid, scherm, energie, uiterlijk, meldingen, muis, makkelijker zien,
tijd en taal, inloggen, standaardprogramma's, updates) regel je hier zelf. Klik op een
netwerk om te verbinden, op een luidspreker om die te gebruiken. Wie meer wil, vindt per
onderdeel 'Meer instellingen (voor gevorderden)'.

Gebruik:  bugos-settings [pagina]
          pagina = start | wifi | bluetooth | printers | geluid | scherm | energie | uiterlijk | meldingen
                   | muis | zien | tijd | inloggen | programmas | updates | over

Hier staan de startpagina en het venster; de andere pagina's staan in /usr/lib/bugos/python/bugos_settings_*.py.
"""

from __future__ import annotations

import sys

sys.path.insert(0, "/usr/lib/bugos/python")

import bugos_config as bi  # noqa: E402
from bugos_ui import (  # noqa: E402
    Groep, Rij, Schuif, Venster, label, leeg_groep, lijn_icoon, maak_app, sectie, start, t, uitvoeren,
)
from bugos_settings_account import InloggenPagina, TijdPagina  # noqa: E402
from bugos_settings_meldingen import MeldingenPagina, PrintersPagina, ProgrammasPagina  # noqa: E402
from bugos_settings_netwerk import BluetoothPagina, WifiPagina  # noqa: E402
from bugos_settings_onderdelen import (  # noqa: E402,F401  (KiesDialoog en WachtwoordDialoog: voor de test)
    Blad, KiesDialoog, Regelaar, WachtwoordDialoog, op_achtergrond, stijl,
)
from bugos_settings_scherm import EnergiePagina, GeluidPagina, SchermPagina, UiterlijkPagina  # noqa: E402
from bugos_settings_systeem import OverPagina, UpdatesPagina  # noqa: E402
from bugos_settings_zien import MuisPagina, ZienPagina  # noqa: E402
from PySide6.QtCore import QSize, QTimer  # noqa: E402
from PySide6.QtWidgets import QFrame, QGridLayout, QHBoxLayout, QLabel, QVBoxLayout  # noqa: E402


# ================================================================= start ===

class StartPagina(Blad):
    sleutel, icoon = "start", "huis"
    titel_nl, titel_en = "Instellingen", "Settings"
    uitleg_nl = "Alles op één plek, in gewone woorden."
    uitleg_en = "Everything in one place, in plain words."

    def bouw(self) -> None:
        # snel: de schuifjes die je het vaakst nodig hebt
        rooster = QGridLayout()
        rooster.setSpacing(12)
        self.snel: dict[str, Schuif] = {}
        self.snel_uitleg: dict[str, QLabel] = {}
        for i, (sleutel, ic, naam) in enumerate((("wifi", "wifi", t("Wifi", "Wi-Fi")),
                                                 ("bt", "bluetooth", "Bluetooth"),
                                                 ("nacht", "maan", t("Nachtlicht", "Night light")),
                                                 ("donker", "palet", t("Donker", "Dark")))):
            vak = QFrame()
            vak.setObjectName("snel")
            vl = QVBoxLayout(vak)
            vl.setContentsMargins(18, 16, 16, 14)
            vl.setSpacing(10)
            boven = QHBoxLayout()
            ik = QLabel()
            ik.setPixmap(lijn_icoon(ic, "tekst", 22, gekozen=None).pixmap(22, 22))
            boven.addWidget(ik)
            boven.addStretch(1)
            schuif = Schuif(False)
            schuif.toggled.connect(lambda aan, s=sleutel: self.zet_snel(s, aan))
            boven.addWidget(schuif)
            vl.addLayout(boven)
            vl.addWidget(label(naam, "kop3", wrap=False))
            uitleg = label("…", "klein", wrap=False)
            vl.addWidget(uitleg)
            self.snel[sleutel] = schuif
            self.snel_uitleg[sleutel] = uitleg
            rooster.addWidget(vak, 0, i)
        self.lay.addLayout(rooster)
        g = self.kaart()
        self.volume = Regelaar(50)
        self.volume.veranderd.connect(lambda w: op_achtergrond(self, lambda: bi.zet_volume(w), lambda _u: None))
        g.voeg(Rij("geluid", t("Volume", "Volume"), "", self.volume))
        # zoeken
        self.zoek_kop = sectie(t("Gevonden", "Found"))
        self.zoek_kop.hide()
        self.lay.addWidget(self.zoek_kop)
        self.zoek_kaart = Groep()
        self.zoek_kaart.lay.setContentsMargins(4, 4, 4, 4)
        self.zoek_kaart.hide()
        self.lay.addWidget(self.zoek_kaart)
        # alle onderdelen, met hoe ze nu staan
        self.alles = self.kaart(t("Alle instellingen", "All settings"))
        self.rijen: dict[str, Rij] = {}
        for klasse in PAGINAS[1:]:
            rij = Rij(klasse.icoon, klasse.naam(), t(klasse.uitleg_nl, klasse.uitleg_en) if klasse.uitleg_nl else "",
                      klikbaar=True)
            rij.geklikt.connect(lambda s=klasse.sleutel: self.venster.ga_naar(s))
            self.alles.voeg(rij)
            self.rijen[klasse.sleutel] = rij

    def ververs(self) -> None:
        def lees():
            return {"wifi": bi.wifi_aan(), "netwerken": bi.netwerken(), "bt": bi.bt_aan(), "nacht": bi.nachtlicht(),
                    "donker": bi.donker(), "geluid": bi.geluid()}
        op_achtergrond(self, lees, self.toon)

    def toon(self, s) -> None:
        if not s:
            return
        nu = next((n for n in s["netwerken"] if n.verbonden), None)
        for sleutel, aan, uitleg in (
                ("wifi", s["wifi"], (nu.naam if nu else t("Niet verbonden", "Not connected")) if s["wifi"]
                 else t("Uit", "Off")),
                ("bt", s["bt"], t("Aan", "On") if s["bt"] else t("Uit", "Off")),
                ("nacht", s["nacht"], t("'s Avonds warmer", "Warmer at night") if s["nacht"] else t("Uit", "Off")),
                ("donker", s["donker"], t("Aan", "On") if s["donker"] else t("Uit", "Off"))):
            self.snel[sleutel].zet_stil(bool(aan))
            self.snel_uitleg[sleutel].setText(uitleg)
        volume, _stil, uitgangen = s["geluid"]
        self.volume.zet(volume)
        if nu:
            self.rijen["wifi"].zet_uitleg(t(f"Verbonden met {nu.naam}", f"Connected to {nu.naam}"))
        gebruikt = next((u for u in uitgangen if u.standaard), None)
        if gebruikt:
            self.rijen["geluid"].zet_uitleg(f"{volume}% · {gebruikt.omschrijving}")

    def zet_snel(self, sleutel: str, aan: bool) -> None:
        werk = {"wifi": lambda: bi.zet_wifi(aan), "bt": lambda: bi.zet_bt(aan),
                "nacht": lambda: bi.zet_nachtlicht(aan), "donker": lambda: bi.zet_donker(aan)}[sleutel]
        op_achtergrond(self, werk, lambda _u: QTimer.singleShot(1200, self.ververs))

    def zoek(self, tekst: str) -> None:
        woorden = tekst.lower().split()
        leeg_groep(self.zoek_kaart)
        gevonden = 0
        if woorden:
            for klasse in PAGINAS[1:]:
                bron = (f"{klasse.titel_nl} {klasse.titel_en} {klasse.uitleg_nl} {klasse.uitleg_en} "
                        f"{klasse.zoekwoorden}").lower()
                if all(w in bron for w in woorden):
                    rij = Rij(klasse.icoon, klasse.naam(), t(klasse.uitleg_nl, klasse.uitleg_en), klikbaar=True)
                    rij.geklikt.connect(lambda s=klasse.sleutel: self.venster.ga_naar(s))
                    self.zoek_kaart.voeg(rij)
                    gevonden += 1
            if not gevonden:
                self.zoek_kaart.voeg(Rij("kruis", t("Niks gevonden", "Nothing found"),
                                         t("Probeer een ander woord, of kies 'Meer instellingen'.",
                                           "Try another word, or choose 'More settings'.")))
        self.zoek_kop.setVisible(bool(woorden))
        self.zoek_kaart.setVisible(bool(woorden))


PAGINAS: list[type[Blad]] = [StartPagina, WifiPagina, BluetoothPagina, PrintersPagina, GeluidPagina, SchermPagina,
                             EnergiePagina, UiterlijkPagina, MeldingenPagina, MuisPagina, ZienPagina, TijdPagina,
                             InloggenPagina, ProgrammasPagina, UpdatesPagina, OverPagina]
OUDE_NAMEN = {"schakelaars": "updates"}


# ================================================================ venster ===

class Instellingen(Venster):
    def __init__(self, begin: str = "start"):
        super().__init__(t("Instellingen", "Settings"), zoeken=t("Zoek een instelling", "Search settings"),
                         maat=(1120, 820))
        self.setStyleSheet(stijl())
        for klasse in PAGINAS:
            self.voeg_pagina(klasse.sleutel, klasse.icoon,
                             t("Start", "Home") if klasse is StartPagina else klasse.naam(), klasse(self))
        for i in range(self.nav.count()):  # veel onderdelen: de regels iets dichter op elkaar
            self.nav.item(i).setSizeHint(QSize(0, 40))
        self.onder_knop(t("Meer instellingen", "More settings"), "code", lambda: start("systemsettings"),
                        tip=t("Alle KDE-instellingen (voor gevorderden)", "All KDE settings (advanced)"))
        self.zoekveld.textChanged.connect(self.zoeken)
        begin = OUDE_NAMEN.get(begin, begin)
        self.ga_naar(begin if begin in self.paginas else "start")
        self.nav.setFocus()  # niet meteen in het zoekveld

    def closeEvent(self, e) -> None:  # noqa: N802
        # Nooit midden in een update of het teruggaan stoppen (dan stopt rpm-ostree ook): wacht tot het
        # klaar is en ga dan vanzelf dicht, zoals Bestanden doet bij het kopiëren.
        updates = self.paginas.get("updates")
        if updates is not None and getattr(updates, "bezig", False):
            self.sluit_na_update = True
            updates.melding.toon(t("Even wachten: de update is nog bezig. Daarna gaat Instellingen vanzelf dicht.",
                                   "One moment: the update is still busy. Settings closes by itself afterwards."),
                                 seconden=0)
            self.ga_naar("updates")
            e.ignore()
            return
        super().closeEvent(e)

    def zoeken(self, tekst: str) -> None:
        if tekst and self.huidige() != "start":
            self.ga_naar("start")
        self.paginas["start"].zoek(tekst)


def begin_pagina(args: list[str]) -> str:
    """Welke pagina moet open? Het eerste woord dat een pagina is (Qt-opties zoals -qwindowgeometry tellen niet)."""
    namen = {k.sleutel for k in PAGINAS} | set(OUDE_NAMEN)
    return next((a for a in args if a in namen), "start")


def main() -> int:
    app = maak_app("bugos-settings", "bugos-settings", sys.argv)
    return uitvoeren(app, Instellingen(begin_pagina(sys.argv[1:])))


if __name__ == "__main__":
    sys.exit(main())
