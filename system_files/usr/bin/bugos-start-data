#!/usr/bin/python3
"""Gegevens voor het BugOS-startmenu (en het snelmenu).

Het startmenu op de taakbalk (QML) roept dit aan en krijgt JSON terug.

  bugos-start-data                 -> apps (ook de pagina's van Instellingen), favorieten, recente bestanden, gebruiker
  bugos-start-data --start <pad>   -> start een app (.desktop-bestand) of 'instelling:<pagina>'
  bugos-start-data --open <pad>    -> open een bestand
  bugos-start-data --aan-uit <x>   -> uitloggen | herstarten | uitzetten | slot
  bugos-start-data --snel          -> status voor het snelmenu
  bugos-start-data --tray          -> korte status voor een taakbalk-icoontje (internet, volume, batterij)
  bugos-start-data --zet <wat> <waarde>  -> snelmenu-knop omzetten
"""

import configparser
import getpass
import json
import os
import pwd
import shutil
import subprocess
import sys
import time
import unicodedata
import xml.etree.ElementTree as ET
from datetime import datetime
from pathlib import Path
from urllib.parse import unquote, urlparse

HOME = Path.home()


def _taal() -> str:
    """Twee letters, bv. nl. KDE zet je gekozen taal in LANGUAGE (bv. nl:en_US): de eerste daarvan wint,
    behalve als de taalinstelling C of POSIX is (dan telt LANGUAGE niet, net als bij gettext)."""
    lang = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
    eerste = os.environ.get("LANGUAGE", "").split(":")[0]
    if eerste and lang.split(".")[0] not in ("C", "POSIX"):
        lang = eerste
    return (lang or "en")[:2].lower()


TAAL = _taal()

# Sommige programma's hebben twee namen: als rpm en als Flatpak. De eerste die bestaat, telt.
ZELFDE_APP = {
    "com.valvesoftware.Steam.desktop": ["steam.desktop"],
    "steam.desktop": ["com.valvesoftware.Steam.desktop"],
    "org.mozilla.firefox.desktop": ["firefox.desktop"],
    "firefox.desktop": ["org.mozilla.firefox.desktop"],
}

