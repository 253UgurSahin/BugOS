def t(nl: str, en: str) -> str:
    return nl if TAAL == "nl" else en


def app_mappen() -> list[Path]:
    data_home = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share"))
    data_dirs = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
    extra = ["/var/lib/flatpak/exports/share", str(HOME / ".local/share/flatpak/exports/share")]
    mappen = [data_home] + [Path(d) for d in data_dirs + extra]
    gezien, uit = set(), []
    for m in mappen:
        p = (m / "applications")
        if p.is_dir() and p not in gezien:
            gezien.add(p)
            uit.append(p)
    return uit


def lees_desktop(pad: Path) -> dict | None:
    cp = configparser.RawConfigParser(strict=False, interpolation=None)
    cp.optionxform = str
    try:
        cp.read(pad, encoding="utf-8")
    except (configparser.Error, UnicodeDecodeError, OSError):
        return None
    if not cp.has_section("Desktop Entry"):
        return None
    d = cp["Desktop Entry"]
    if d.get("Type", "Application") != "Application":
        return None
    if d.get("NoDisplay", "false").lower() == "true" or d.get("Hidden", "false").lower() == "true":
        return None
    huidig = os.environ.get("XDG_CURRENT_DESKTOP", "KDE").split(":")
    if "OnlyShowIn" in d and not set(d["OnlyShowIn"].strip(";").split(";")) & set(huidig):
        return None
    if "NotShowIn" in d and set(d["NotShowIn"].strip(";").split(";")) & set(huidig):
        return None

    def lokaal(sleutel: str) -> str:
        return d.get(f"{sleutel}[{TAAL}]") or d.get(sleutel, "")

    naam = lokaal("Name")
    if not naam:
        return None
    cats = [c for c in d.get("Categories", "").split(";") if c]
    groep = next((t(nl, en) for c, nl, en in CATEGORIE if c in cats), t("Overig", "Other"))
    return {
        "id": pad.name,
        "pad": str(pad),
        "naam": naam,
        "uitleg": lokaal("GenericName") or lokaal("Comment"),
        "icoon": d.get("Icon", "application-x-executable"),
        "groep": groep,
        "zoek": zoeksleutel(" ".join([naam, lokaal("GenericName"), lokaal("Comment"), lokaal("Keywords"), d.get("Keywords", "")])),
        "soort": "app",
    }


def zoeksleutel(tekst: str) -> str:
    """Tekst om in te zoeken: kleine letters zonder accenten, zodat 'izleyici' 'İzleyici' vindt (Turks) en 'cafe'
    'café' (U268). Precies dezelfde regel als StartMenu.qml en bugos_base: NFKD, kleine letters, U+0300-U+036F weg,
    ß wordt ss en ς wordt σ (U280)."""
    import re
    t = re.sub("[\u0300-\u036f]", "", unicodedata.normalize("NFKD", tekst).lower())
    return t.replace("ß", "ss").replace("ς", "σ")


def alle_apps() -> list[dict]:
    apps: dict[str, dict] = {}
    for map_ in app_mappen():
        for pad in sorted(map_.rglob("*.desktop")):
            app_id = str(pad.relative_to(map_)).replace("/", "-")
            if app_id in apps:
                continue  # eerste map wint (gebruiker > systeem)
            info = lees_desktop(pad)
            if info:
                info["id"] = app_id
                apps[app_id] = info
            else:
                apps[app_id] = {}  # verborgen: ook niet uit een latere map halen
    return sorted((a for a in apps.values() if a), key=lambda a: a["naam"].lower())


def instellingen_apps() -> list[dict]:
    """De pagina's van BugOS Instellingen als 'apps', alleen voor het zoeken."""
    uit = []
    for pagina, nl, en, icoon, zoek in INSTELLINGEN:
        naam = t(nl, en)
        uit.append({
            "id": f"instelling-{pagina}",
            "pad": f"instelling:{pagina}",
            "naam": naam,
            "uitleg": t("Instellingen", "Settings"),
            "icoon": icoon,
            "groep": t("Instellingen", "Settings"),
            "zoek": zoeksleutel(f"{naam} {nl} {en} {zoek}"),
            "soort": "instelling",
        })
    return uit


def favorieten(apps: list[dict]) -> list[dict]:
    ids = list(STANDAARD_FAVORIETEN)
    eigen = HOME / ".config/bugos/favorieten.json"
    try:
        ids = json.loads(eigen.read_text())
        # Geen lijst (null, een getal, met de hand bewerkt)? Dan niet het hele startmenu leeg, maar de standaard (U414).
        if not isinstance(ids, list):
            raise ValueError("geen lijst")
        ids = [i for i in ids if isinstance(i, str)]
    except (OSError, ValueError):
        ids = list(STANDAARD_FAVORIETEN)
        cfg = configparser.RawConfigParser(strict=False)
        try:
            cfg.read("/etc/xdg/kicker-extra-favoritesrc")
            if cfg.has_option("General", "Prepend"):
                ids = [x for x in cfg.get("General", "Prepend").split(";") if x]
        except configparser.Error:
            pass
    per_id = {a["id"]: a for a in apps}
    uit, gezien = [], set()
    for i in ids:
        for kandidaat in [i] + ZELFDE_APP.get(i, []):
            if kandidaat in per_id and kandidaat not in gezien:
                gezien.add(kandidaat)
                uit.append(per_id[kandidaat])
                break
    return uit


def recente_bestanden(max_aantal: int = 8) -> list[dict]:
    # Ook die van apps uit de Winkel (Flatpak: LibreOffice, VLC, ...): die schrijven hun lijst in hun eigen map (U113).
    lijsten = [Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "recently-used.xbel"]
    lijsten += sorted((HOME / ".var" / "app").glob("*/data/recently-used.xbel"))
    bookmarks = []
    for xbel in lijsten:
        try:
            bookmarks += list(ET.parse(xbel).getroot().iter("bookmark"))
        except (OSError, ET.ParseError):
            continue
    items = []
    for b in bookmarks:
        url = urlparse(b.get("href", ""))
        if url.scheme != "file":
            continue
        pad = Path(unquote(url.path))
        if pad.exists():
            items.append((b.get("modified") or b.get("visited") or "", pad))
    items.sort(reverse=True)
    uit, gezien = [], set()
    for _, pad in items:
        if pad in gezien:
            continue
        gezien.add(pad)
        # Alleen het begin van het pad wordt '~' (niet ook een map die toevallig zo heet) (U352).
        ouder = str(pad.parent)
        if ouder == str(HOME) or ouder.startswith(str(HOME) + os.sep):
            ouder = "~" + ouder[len(str(HOME)):]
        uit.append({"naam": pad.name, "pad": str(pad), "map": ouder})
        if len(uit) >= max_aantal:
            break
    return uit


def gebruiker() -> dict:
    naam = getpass.getuser()
    try:
        volledig = pwd.getpwnam(naam).pw_gecos.split(",")[0] or naam
    except KeyError:
        volledig = naam
    # Eerst die van AccountsService (die verandert Instellingen > Gebruikers), dan een oude ~/.face.icon.
    kandidaten = [Path(os.environ.get("BUGOS_ACCOUNTS_ICONEN", "/var/lib/AccountsService/icons")) / naam, HOME / ".face.icon"]
    foto = next((k for k in kandidaten if k.exists()), None)
    try:
        tijd = int(foto.stat().st_mtime) if foto else 0
    except OSError:
        tijd = 0
    # 'tijd': een nieuwe foto heeft dezelfde bestandsnaam; met de tijd erbij laadt het startmenu hem opnieuw (U112).
    return {"naam": volledig, "foto": str(foto) if foto else "", "foto_tijd": tijd}


def draai(*cmd: str) -> str:
    # We lezen de uitvoer, dus in het Engels (C.UTF-8): anders zegt nmcli 'ingeschakeld'. Onze eigen
    # bugos-hulpjes houden je taal, want die laten een melding zien.
    env = dict(os.environ)
    if not os.path.basename(cmd[0]).startswith("bugos-"):
        env["LC_ALL"] = "C.UTF-8"
        env.pop("LANGUAGE", None)
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5, env=env).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def eigen_plek(cmd: tuple | list) -> list[str]:
    """Start een programma (met een .desktop-bestand) in zijn eigen systemd-scope, zoals KDE dat doet: dan ziet
    Taakbeheer het als dat programma (niet als deel van wie het startte) en kun je het daar sluiten (U125).
    Zonder systemd voor de gebruiker (of een opdracht zonder .desktop): gewoon zoals het was."""
    naam = os.path.basename(cmd[0]) if cmd else ""
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    # Alleen namen die systemd in een eenheid toestaat; anders zou systemd-run weigeren en start er niets (U146).
    if not naam or not runtime or not os.path.exists(os.path.join(runtime, "systemd", "private")) or \
            not shutil.which("systemd-run") or not all(c.isascii() and (c.isalnum() or c in "-_.:") for c in naam):
        return list(cmd)
    mappen = [os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share"))] + \
        os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
    if not any(os.path.exists(os.path.join(m, "applications", f"{naam}.desktop")) for m in mappen if m):
        return list(cmd)
    eenheid = "app-" + naam.replace("\\", "\\x5c").replace("-", "\\x2d") + f"-{os.getpid():x}{os.urandom(3).hex()}.scope"
    return ["systemd-run", "--user", "--scope", "--quiet", "--collect", f"--unit={eenheid}", "--", *cmd]


def los_starten(*cmd: str) -> bool:
    try:
        subprocess.Popen(eigen_plek(cmd), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return True
    except OSError as e:
        print(f"bugos-start-data: {cmd[0]} kon niet starten: {e}", file=sys.stderr)
        return False


# ------------------------------------------------------------- snelmenu ----

NIET_STOREN_TOT = "2999,12,31,0,0,0"  # dezelfde waarde als lib.sh en bugos_config.py


def niet_storen_tot_in_toekomst(tekst: str) -> bool:
    """KDE schrijft 'jaar,maand,dag,uur,min,sec' of een ISO-tijd. Is die nog niet voorbij?"""
    tekst = tekst.strip()
    if not tekst:
        return False
    nu = datetime.now().astimezone()
    # KConfig schrijft de seconden met een komma-deel ("7.913") en soms een tijdzone als 7e veld (U072).
    delen = tekst.split(",")
    try:
        if len(delen) >= 3:
            getallen = [int(float(x)) for x in delen[:6]]
            zone = None
            if len(delen) > 6:
                from zoneinfo import ZoneInfo
                try:
                    zone = ZoneInfo(delen[6].strip())
                except (ValueError, KeyError, OSError):
                    zone = None
            tot = datetime(*getallen, tzinfo=zone) if zone else datetime(*getallen).astimezone()
            return tot > nu
    except (ValueError, TypeError, OverflowError):
        pass
    try:
        tot = datetime.fromisoformat(tekst.replace("Z", "+00:00"))
        return (tot if tot.tzinfo else tot.astimezone()) > nu
    except ValueError:
        return False


def kde_lees(bestand: str, groep: str, sleutel: str) -> str:
    return draai("kreadconfig6", "--file", bestand, "--group", groep, "--key", sleutel).strip()


def volume_status() -> tuple[int | None, bool | None]:
    vol = draai("wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@") if shutil.which("wpctl") else ""
    try:
        procent = round(float(vol.split()[1]) * 100)
    except (IndexError, ValueError):
        procent = None
    if procent is None:
        return None, None   # geen geluid (geen wpctl of geen luidspreker): ook de knop 'Geluid uit' grijs (U347)
    return procent, "MUTED" in vol


def backlight() -> Path | None:
    """De schermverlichting van een laptop (een losse monitor heeft dit meestal niet)."""
    basis = Path(os.environ.get("BUGOS_SYS", "/sys")) / "class" / "backlight"
    for pad in sorted(basis.glob("*")):
        if (pad / "max_brightness").exists():
            return pad
    return None


def helderheid() -> int | None:
    pad = backlight()
    if pad is None:
        return None
    try:
        return round(int((pad / "brightness").read_text()) / max(int((pad / "max_brightness").read_text()), 1) * 100)
    except (OSError, ValueError):
        return None


def batterij() -> tuple[int | None, bool]:
    """(procent, laadt) van de eerste batterij; (None, False) op een computer zonder batterij."""
    basis = Path(os.environ.get("BUGOS_SYS", "/sys")) / "class" / "power_supply"
    # Zoals Instellingen (U155): een batterij herken je aan type=Battery (niet alleen 'BAT0'), maar niet die van een
    # muis of toetsenbord (scope=Device) (U346).
    gevonden = []
    for pad in sorted(basis.glob("*")):
        try:
            soort = (pad / "type").read_text().strip() if (pad / "type").exists() else \
                ("Battery" if pad.name.startswith("BAT") else "")
            if soort != "Battery":
                continue
            if (pad / "scope").exists() and (pad / "scope").read_text().strip() == "Device":
                continue
            procent = int((pad / "capacity").read_text().strip())
            staat = (pad / "status").read_text().strip()
        except (OSError, ValueError):
            continue
        nu = vol = None
        for a, b in (("energy_now", "energy_full"), ("charge_now", "charge_full")):
            try:
                nu, vol = int((pad / a).read_text()), int((pad / b).read_text())
                break
            except (OSError, ValueError):
                continue
        gevonden.append((procent, staat, nu, vol))
    if not gevonden:
        return None, False
    # Twee batterijen (veel ThinkPads): samen tellen, zoals Instellingen (U399).
    if len(gevonden) > 1 and all(g[2] is not None and g[3] for g in gevonden):
        procent = round(100 * sum(g[2] for g in gevonden) / sum(g[3] for g in gevonden))
    else:
        procent = round(sum(g[0] for g in gevonden) / len(gevonden))
    return procent, any(g[1] == "Charging" for g in gevonden)


def snel_status() -> dict:
    if os.environ.get("BUGOS_SNEL_VOORBEELD"):  # voor foto's en tests: niets aan de computer vragen
        return {"wifi": True, "bluetooth": False, "spel": False,
                "donker": is_donker(),
                "volume": 60, "stil": False, "niet_storen": False,
                "helderheid": 70, "batterij": 76, "laadt": False}
    s: dict = {}
    # Geen wifi in deze computer (een pc aan een kabel)? Dan geen tegel, ook al zegt nmcli 'enabled' (U111).
    # Lukt nmcli (nog) niet, net na het inloggen: dan zoals Instellingen gewoon aannemen dat er wifi is (U123).
    apparaten = draai("nmcli", "-t", "-f", "TYPE", "device").split() if shutil.which("nmcli") else []
    heeft_wifi = bool(shutil.which("nmcli")) and (not apparaten or "wifi" in apparaten)
    s["wifi"] = draai("nmcli", "-t", "-f", "WIFI", "radio").strip() == "enabled" if heeft_wifi else None
    # Zonder bluetooth-hardware wacht 'bluetoothctl' tot zijn tijd op is: dan niet vragen (geen tegel).
    bt_map = Path(os.environ.get("BUGOS_SYS", "/sys")) / "class" / "bluetooth"
    heeft_bt = bt_map.is_dir() and any(bt_map.iterdir())
    bt = draai("bluetoothctl", "show") if heeft_bt and shutil.which("bluetoothctl") else ""
    s["bluetooth"] = None if "Controller" not in bt else ("Powered: yes" in bt)
    if s["bluetooth"] is None and not heeft_bt:
        # Uit met de vliegtuigstand (hci0 is dan weg, de rfkill-schakelaar niet): tegel 'uit', zodat je hem weer
        # aan kunt zetten (U165).
        rfkill = Path(os.environ.get("BUGOS_SYS", "/sys")) / "class" / "rfkill"
        try:
            if any((r / "type").read_text().strip() == "bluetooth" and any(
                    (r / k).exists() and (r / k).read_text().strip() == "1" for k in ("soft", "hard"))
                    for r in rfkill.iterdir()):   # alleen een schakelaar die echt uit staat (U188)
                s["bluetooth"] = False
        except OSError:
            pass
    s["spel"] = draai("bugos-game-mode", "status").strip() == "aan" if shutil.which("bugos-game-mode") else None
    s["donker"] = is_donker()
    s["volume"], s["stil"] = volume_status()
    s["niet_storen"] = niet_storen_tot_in_toekomst(kde_lees("plasmanotifyrc", "DoNotDisturb", "Until"))
    s["helderheid"] = helderheid()
    s["batterij"], s["laadt"] = batterij()
    return s


def tray_status() -> dict:
    """Korte status voor een icoontje op de taakbalk: internet, volume, batterij."""
    s: dict = {"internet": "geen", "wifi": None, "volume": None, "stil": False, "batterij": None, "laadt": False}
    if shutil.which("nmcli"):
        s["wifi"] = draai("nmcli", "-t", "-f", "WIFI", "radio").strip() == "enabled"
        soorten = set()
        for regel in draai("nmcli", "-t", "-f", "TYPE,STATE", "device").splitlines():
            delen = regel.split(":")
            if len(delen) >= 2 and delen[1] == "connected":
                soorten.add(delen[0])
        s["internet"] = "kabel" if "ethernet" in soorten else "wifi" if "wifi" in soorten else "geen"
    s["volume"], s["stil"] = volume_status()
    s["batterij"], s["laadt"] = batterij()
    return s


def is_donker() -> bool:
    """Donker: het BugOS-schema, of een ander donker schema uit de KDE-instellingen (Breeze Dark) (U325)."""
    schema = kde_lees("kdeglobals", "General", "ColorScheme")
    if schema in ("BugOSDark", "BugOSLight", ""):
        return schema == "BugOSDark"
    try:
        r, g, b = (int(x) for x in kde_lees("kdeglobals", "Colors:Window", "BackgroundNormal").split(",")[:3])
    except ValueError:
        return False
    return r * 299 + g * 587 + b * 114 < 128000


def snel_zet(wat: str, waarde: str) -> None:
    aan = waarde in ("aan", "true", "1", "on")
    if wat == "wifi":
        draai("nmcli", "radio", "wifi", "on" if aan else "off")
    elif wat == "bluetooth":
        # De laatste klik telt: klik je tijdens het wachten 'uit', dan niet daarna alsnog 'aan' (U517).
        wens = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / f"bugos-bt-wens-{os.getuid()}"
        mijn = f"{os.getpid()}-{time.time_ns()}"
        try:
            wens.write_text(mijn)
        except OSError:
            pass
        if aan:
            draai("rfkill", "unblock", "bluetooth")
            # Na de vliegtuigstand komt de kaart pas even later terug: wachten, zoals Instellingen en Help (U499, U504).
            for _ in range(10):
                if "Controller" in (draai("bluetoothctl", "show") or ""):
                    break
                time.sleep(0.5)
            try:
                if wens.read_text() != mijn:
                    return   # intussen een nieuwere klik
            except OSError:
                pass
        if not aan and "Controller" not in (draai("bluetoothctl", "show") or ""):
            # De kaart is er (nog) niet, bijv. net na de vliegtuigstand: 'power off' doet dan niets, en BlueZ zet hem
            # straks vanzelf aan. Dan blokkeren, zodat 'uit' ook echt uit blijft (U529).
            draai("rfkill", "block", "bluetooth")
            return
        draai("bluetoothctl", "power", "on" if aan else "off")
    elif wat == "spel":
        # Los starten: na 5 s afbreken (draai) liet 'volle kracht' en 'niet storen' half aan staan (U260).
        los_starten("bugos-game-mode", "aan" if aan else "uit")
    elif wat == "donker":
        # Eén plek voor licht/donker: kleuren, KDE-programma's (Kvantum) en de Plasma-stijl.
        los_starten("bugos-theme", "donker" if aan else "licht")
    elif wat == "volume":
        try:
            procent = max(0, min(100, int(waarde)))
        except ValueError:
            return
        # Alleen het volume; 'stil' blijft zoals het was (dat is een eigen knop).
        draai("wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{procent / 100:.2f}")
    elif wat == "helderheid":
        pad = backlight()
        try:
            procent = max(5, min(100, int(waarde)))
            maximum = int((pad / "max_brightness").read_text()) if pad else 0
        except (ValueError, OSError):
            return
        if pad and maximum:
            # Via logind: mag zonder wachtwoord voor wie achter de computer zit (net als Instellingen).
            draai("gdbus", "call", "--system", "--dest", "org.freedesktop.login1", "--object-path",
                  "/org/freedesktop/login1/session/auto", "--method", "org.freedesktop.login1.Session.SetBrightness",
                  "backlight", pad.name, str(max(1, round(maximum * procent / 100))))
    elif wat == "stil":
        draai("wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1" if aan else "0")
    elif wat == "niet_storen":
        if aan:
            draai("kwriteconfig6", "--file", "plasmanotifyrc", "--group", "DoNotDisturb", "--key", "Until", "--notify",
                  NIET_STOREN_TOT)
        else:
            draai("kwriteconfig6", "--file", "plasmanotifyrc", "--group", "DoNotDisturb", "--key", "Until", "--notify",
                  "--delete")


# ------------------------------------------------------------------ main ----

def start(pad: str) -> None:
    if pad.startswith("instelling:"):
        pagina = pad.split(":", 1)[1]
        los_starten("bugos-settings", pagina) if pagina else los_starten("bugos-settings")
    elif shutil.which("kioclient"):
        los_starten("kioclient", "exec", pad)
    else:
        los_starten("gio", "launch", pad)


def main(args: list[str]) -> int:
    if len(args) == 2 and args[0] == "--start":
        start(args[1])
        return 0
    if len(args) == 2 and args[0] == "--open":
        los_starten("xdg-open", args[1])
        return 0
    if len(args) == 2 and args[0] == "--aan-uit":
        acties = {
            "uitloggen": ("qdbus6", "org.kde.LogoutPrompt", "/LogoutPrompt", "promptLogout"),
            "herstarten": ("qdbus6", "org.kde.LogoutPrompt", "/LogoutPrompt", "promptReboot"),
            "uitzetten": ("qdbus6", "org.kde.LogoutPrompt", "/LogoutPrompt", "promptShutDown"),
            "slot": ("loginctl", "lock-session"),
        }
        if args[1] in acties:
            cmd = acties[args[1]]
            if cmd[0] == "qdbus6" and not shutil.which("qdbus6"):
                cmd = ("gdbus", "call", "--session", "--dest", cmd[1], "--object-path", cmd[2], "--method",
                       f"org.kde.LogoutPrompt.{cmd[3]}")
            los_starten(*cmd)
        return 0
    if args == ["--snel"]:
        print(json.dumps(snel_status()))
        return 0
    if args == ["--tray"]:
        print(json.dumps(tray_status()))
        return 0
    if len(args) == 3 and args[0] == "--zet":
        snel_zet(args[1], args[2])
        s = snel_status()
        if args[1] in ("donker", "spel"):
            # bugos-theme of bugos-game-mode loopt nog: toon wat je net koos (U128, U260).
            s[args[1]] = args[2] in ("aan", "true", "1", "on")
        print(json.dumps(s))
        return 0
    apps = alle_apps()
    print(json.dumps({
        "apps": apps + instellingen_apps(),
        "favorieten": favorieten(apps),
        "recent": recente_bestanden(),
        "gebruiker": gebruiker(),
    }, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
