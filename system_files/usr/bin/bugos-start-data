    "org.mozilla.firefox.desktop", "bugos-files.desktop", "bugos-store.desktop",
    "bugos-settings.desktop", "org.libreoffice.LibreOffice.writer.desktop",
    "org.videolan.VLC.desktop", "com.valvesoftware.Steam.desktop", "bugos-help.desktop",
]

