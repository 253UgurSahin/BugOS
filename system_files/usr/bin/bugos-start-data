#!/usr/bin/python3
"""Gegevens voor het BugOS-startmenu (en het snelmenu).

Het startmenu op de taakbalk (QML) roept dit aan en krijgt JSON terug.

  bugos-start-data                 -> apps, favorieten, recente bestanden, gebruiker
  bugos-start-data --start <pad>   -> start een app (.desktop-bestand)
  bugos-start-data --open <pad>    -> open een bestand
  bugos-start-data --aan-uit <x>   -> uitloggen | herstarten | uitzetten | slot
  bugos-start-data --snel          -> status voor het snelmenu
  bugos-start-data --zet <wat> <waarde>  -> snelmenu-knop omzetten
"""

import configparser
import getpass
import json
import os
import pwd
import shutil
import subprocess
import sys
import xml.etree.ElementTree as ET
from pathlib import Path
from urllib.parse import unquote, urlparse

HOME = Path.home()
TAAL = (os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "en")[:2].lower()

STANDAARD_FAVORIETEN = [
    "org.mozilla.firefox.desktop", "org.kde.dolphin.desktop", "bugos-winkel.desktop",
    "bugos-instellingen.desktop", "org.libreoffice.LibreOffice.writer.desktop",
    "org.videolan.VLC.desktop", "com.valvesoftware.Steam.desktop", "bugos-hulp.desktop",
]

CATEGORIE = [
    # (freedesktop-categorie, nl, en)
    ("Network", "Internet", "Internet"),
    ("Office", "Kantoor", "Office"),
    ("Graphics", "Foto en video", "Photo and video"),
    ("AudioVideo", "Muziek en film", "Music and film"),
    ("Game", "Games", "Games"),
    ("Education", "Leren", "Learning"),
    ("Development", "Programmeren", "Coding"),
    ("Settings", "Instellingen", "Settings"),
    ("System", "Systeem", "System"),
    ("Utility", "Hulpmiddelen", "Utilities"),
]


def t(nl: str, en: str) -> str:
    return nl if TAAL == "nl" else en


def app_mappen() -> list[Path]:
    data_home = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share"))
    data_dirs = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
    extra = ["/var/lib/flatpak/exports/share", str(HOME / ".local/share/flatpak/exports/share")]
    mappen = [data_home] + [Path(d) for d in data_dirs + extra]
    gezien, uit = set(), []
    for m in mappen:
        p = (m / "applications")
        if p.is_dir() and p not in gezien:
            gezien.add(p)
            uit.append(p)
    return uit


def lees_desktop(pad: Path) -> dict | None:
    cp = configparser.RawConfigParser(strict=False, interpolation=None)
    cp.optionxform = str
    try:
        cp.read(pad, encoding="utf-8")
    except (configparser.Error, UnicodeDecodeError, OSError):
        return None
    if not cp.has_section("Desktop Entry"):
        return None
    d = cp["Desktop Entry"]
    if d.get("Type", "Application") != "Application":
        return None
    if d.get("NoDisplay", "false").lower() == "true" or d.get("Hidden", "false").lower() == "true":
        return None
    huidig = os.environ.get("XDG_CURRENT_DESKTOP", "KDE").split(":")
    if "OnlyShowIn" in d and not set(d["OnlyShowIn"].strip(";").split(";")) & set(huidig):
        return None
    if "NotShowIn" in d and set(d["NotShowIn"].strip(";").split(";")) & set(huidig):
        return None

    def lokaal(sleutel: str) -> str:
        return d.get(f"{sleutel}[{TAAL}]") or d.get(sleutel, "")

    naam = lokaal("Name")
    if not naam:
        return None
    cats = [c for c in d.get("Categories", "").split(";") if c]
    groep = next((t(nl, en) for c, nl, en in CATEGORIE if c in cats), t("Overig", "Other"))
    return {
        "id": pad.name,
        "pad": str(pad),
        "naam": naam,
        "uitleg": lokaal("GenericName") or lokaal("Comment"),
        "icoon": d.get("Icon", "application-x-executable"),
        "groep": groep,
        "zoek": " ".join([naam, lokaal("GenericName"), lokaal("Comment"), lokaal("Keywords"), d.get("Keywords", "")]).lower(),
    }


def alle_apps() -> list[dict]:
    apps: dict[str, dict] = {}
    for map_ in app_mappen():
        for pad in sorted(map_.rglob("*.desktop")):
            app_id = str(pad.relative_to(map_)).replace("/", "-")
            if app_id in apps:
                continue  # eerste map wint (gebruiker > systeem)
            info = lees_desktop(pad)
            if info:
                info["id"] = app_id
                apps[app_id] = info
            else:
                apps[app_id] = {}  # verborgen: ook niet uit een latere map halen
    return sorted((a for a in apps.values() if a), key=lambda a: a["naam"].lower())


def favorieten(apps: list[dict]) -> list[dict]:
    ids = list(STANDAARD_FAVORIETEN)
    eigen = HOME / ".config/bugos/favorieten.json"
    try:
        ids = json.loads(eigen.read_text())
    except (OSError, ValueError):
        cfg = configparser.RawConfigParser(strict=False)
        try:
            cfg.read("/etc/xdg/kicker-extra-favoritesrc")
            if cfg.has_option("General", "Prepend"):
                ids = [x for x in cfg.get("General", "Prepend").split(";") if x]
        except configparser.Error:
            pass
    per_id = {a["id"]: a for a in apps}
    return [per_id[i] for i in ids if i in per_id]


def recente_bestanden(max_aantal: int = 8) -> list[dict]:
    xbel = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "recently-used.xbel"
    try:
        wortel = ET.parse(xbel).getroot()
    except (OSError, ET.ParseError):
        return []
    items = []
    for b in wortel.iter("bookmark"):
        url = urlparse(b.get("href", ""))
        if url.scheme != "file":
            continue
        pad = Path(unquote(url.path))
        if pad.exists():
            items.append((b.get("modified") or b.get("visited") or "", pad))
    items.sort(reverse=True)
    uit, gezien = [], set()
    for _, pad in items:
        if pad in gezien:
            continue
        gezien.add(pad)
        uit.append({"naam": pad.name, "pad": str(pad), "map": str(pad.parent).replace(str(HOME), "~")})
        if len(uit) >= max_aantal:
            break
    return uit


def gebruiker() -> dict:
    naam = getpass.getuser()
    try:
        volledig = pwd.getpwnam(naam).pw_gecos.split(",")[0] or naam
    except KeyError:
        volledig = naam
    foto = HOME / ".face.icon"
    if not foto.exists():
        foto = Path(f"/var/lib/AccountsService/icons/{naam}")
    return {"naam": volledig, "foto": str(foto) if foto.exists() else ""}


def draai(*cmd: str) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def los_starten(*cmd: str) -> None:
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


# ------------------------------------------------------------- snelmenu ----

def snel_status() -> dict:
    s: dict = {}
    s["wifi"] = draai("nmcli", "radio", "wifi").strip() == "enabled" if shutil.which("nmcli") else None
    bt = draai("bluetoothctl", "show") if shutil.which("bluetoothctl") else ""
    s["bluetooth"] = None if "Controller" not in bt else ("Powered: yes" in bt)
    s["spel"] = draai("bugos-spelmodus", "status").strip() == "aan" if shutil.which("bugos-spelmodus") else False
    kleur = draai("kreadconfig6", "--file", "kdeglobals", "--group", "General", "--key", "ColorScheme").strip()
    s["donker"] = "donker" in kleur.lower() or "dark" in kleur.lower()
    vol = draai("wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@") if shutil.which("wpctl") else ""
    try:
        s["volume"] = round(float(vol.split()[1]) * 100)
    except (IndexError, ValueError):
        s["volume"] = None
    s["stil"] = "MUTED" in vol
    dnd = draai("kreadconfig6", "--file", "plasmanotifyrc", "--group", "DoNotDisturb", "--key", "Until").strip()
    s["niet_storen"] = bool(dnd)
    return s


def snel_zet(wat: str, waarde: str) -> None:
    aan = waarde in ("aan", "true", "1", "on")
    if wat == "wifi":
        draai("nmcli", "radio", "wifi", "on" if aan else "off")
    elif wat == "bluetooth":
        if aan:
            draai("rfkill", "unblock", "bluetooth")
        draai("bluetoothctl", "power", "on" if aan else "off")
    elif wat == "spel":
        draai("bugos-spelmodus", "aan" if aan else "uit")
    elif wat == "donker":
        draai("plasma-apply-colorscheme", "BugOSDonker" if aan else "BugOSLicht")
    elif wat == "volume":
        try:
            procent = max(0, min(150, int(waarde)))
        except ValueError:
            return
        draai("wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{procent / 100:.2f}")
        draai("wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "0")
    elif wat == "stil":
        draai("wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1" if aan else "0")
    elif wat == "niet_storen":
        if aan:
            draai("kwriteconfig6", "--file", "plasmanotifyrc", "--group", "DoNotDisturb", "--key", "Until", "2099,1,1,0,0,0.000")
        else:
            draai("kwriteconfig6", "--file", "plasmanotifyrc", "--group", "DoNotDisturb", "--key", "Until", "--delete")


# ------------------------------------------------------------------ main ----

def main(args: list[str]) -> int:
    if len(args) == 2 and args[0] == "--start":
        pad = args[1]
        if shutil.which("kioclient"):
            los_starten("kioclient", "exec", pad)
        else:
            los_starten("gio", "launch", pad)
        return 0
    if len(args) == 2 and args[0] == "--open":
        los_starten("xdg-open", args[1])
        return 0
    if len(args) == 2 and args[0] == "--aan-uit":
        acties = {
            "uitloggen": ("qdbus6", "org.kde.LogoutPrompt", "/LogoutPrompt", "promptLogout"),
            "herstarten": ("qdbus6", "org.kde.LogoutPrompt", "/LogoutPrompt", "promptReboot"),
            "uitzetten": ("qdbus6", "org.kde.LogoutPrompt", "/LogoutPrompt", "promptShutDown"),
            "slot": ("loginctl", "lock-session"),
        }
        if args[1] in acties:
            los_starten(*acties[args[1]])
        return 0
    if args == ["--snel"]:
        print(json.dumps(snel_status()))
        return 0
    if len(args) == 3 and args[0] == "--zet":
        snel_zet(args[1], args[2])
        print(json.dumps(snel_status()))
        return 0
    apps = alle_apps()
    print(json.dumps({
        "apps": apps,
        "favorieten": favorieten(apps),
        "recent": recente_bestanden(),
        "gebruiker": gebruiker(),
    }, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
