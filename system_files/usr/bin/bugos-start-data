    "org.kde.kcharselect.desktop": ("Speciale tekens", "Special characters", "Tekens als é, ß of ©",
                                    "Characters like é, ß or ©"),
}


def lees_desktop(pad: Path) -> dict | None:
    cp = configparser.RawConfigParser(strict=False, interpolation=None)
    cp.optionxform = str
    try:
        cp.read(pad, encoding="utf-8")
    except (configparser.Error, UnicodeDecodeError, OSError):
        return None
    if not cp.has_section("Desktop Entry"):
        return None
    d = cp["Desktop Entry"]
    if d.get("Type", "Application") != "Application":
        return None
    if d.get("NoDisplay", "false").lower() == "true" or d.get("Hidden", "false").lower() == "true":
        return None
    huidig = os.environ.get("XDG_CURRENT_DESKTOP", "KDE").split(":")
    if "OnlyShowIn" in d and not set(d["OnlyShowIn"].strip(";").split(";")) & set(huidig):
        return None
    if "NotShowIn" in d and set(d["NotShowIn"].strip(";").split(";")) & set(huidig):
        return None

    def lokaal(sleutel: str) -> str:
        return d.get(f"{sleutel}[{TAAL}]") or d.get(sleutel, "")

    naam = lokaal("Name")
    if not naam:
        return None
    oude_naam = ""
    uitleg = lokaal("GenericName") or lokaal("Comment")
    # Geen uitleg die alleen de naam herhaalt ("Terminal / Terminal", "Document Viewer").
    if uitleg.strip().lower() == naam.strip().lower():
        uitleg = lokaal("Comment") if lokaal("Comment").strip().lower() != naam.strip().lower() else ""
    if pad.name in EIGEN_NAMEN:
        nl, en, unl, uen = EIGEN_NAMEN[pad.name]
        # Kate zonder KWrite ernaast (zelfde map): dan is Kate toch de Teksteditor, anders is er geen (A-14).
        if pad.name == "org.kde.kate.desktop" and not (pad.parent / "org.kde.kwrite.desktop").exists():
            nl, en, unl, uen = "Teksteditor", "Text editor", "Platte tekst en code schrijven", "Write plain text and code"
        oude_naam, naam, uitleg = naam, t(nl, en), t(unl, uen)
    cats = [c for c in d.get("Categories", "").split(";") if c]
    groep = next((t(nl, en) for c, nl, en in CATEGORIE if c in cats), t("Overig", "Other"))
    # Flatpak zet in elk .desktop-bestand dat hij klaarzet (exports/share/applications) 'X-Flatpak=<app-id>'.
    # Alleen zulke apps kun je verwijderen (de rest hoort bij BugOS zelf): dan staat 'Verwijderen' in het menu
    # van de rechtermuisknop, en dat opent de Winkel op die app (met zijn eigen 'Weet je het zeker?').
    flatpak = d.get("X-Flatpak", "").strip()
    return {
        "id": pad.name,
        "pad": str(pad),
        "naam": naam,
        "uitleg": uitleg,
        "icoon": d.get("Icon", "application-x-executable"),
        "groep": groep,
        "zoek": zoeksleutel(" ".join([naam, oude_naam, lokaal("GenericName"), lokaal("Comment"), lokaal("Keywords"), d.get("Keywords", "")])),
        "soort": "app",
        # De eigen acties van de app ('Nieuw privévenster' bij Firefox), voor het menu van de rechtermuisknop.
        "acties": desktop_acties(cp, d),
        # Het Flatpak-id ('org.mozilla.firefox') als je de app kunt verwijderen, anders leeg.
        "verwijder": flatpak if APP_ID_VORM.match(flatpak) else "",
        # 'Openen in quarantaine' (bugos-quarantaine): voor elke app, behalve de onderdelen van BugOS zelf.
        "quarantaine": not pad.name.startswith("bugos-") and quarantaine_kan(),
    }


_QUARANTAINE: list[bool] = []


def quarantaine_kan() -> bool:
    """Is bugos-quarantaine er? Eén keer kijken, niet per app."""
    if not _QUARANTAINE:
        _QUARANTAINE.append(bool(shutil.which("bugos-quarantaine")))
    return _QUARANTAINE[0]


# Een Flatpak-id zoals de Winkel die kent (org.mozilla.firefox): letters, cijfers, _ en -, met punten ertussen.
# Alleen zo'n id gaat naar 'bugos-store appstream://<id>'; een vreemde waarde in een .desktop-bestand niet.
APP_ID_VORM = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*(\.[A-Za-z0-9_-]+)+$")
# Een desktop-id zoals het startmenu het doorgeeft (org.mozilla.firefox.desktop): geen mappen, geen spaties.
DESKTOP_ID_VORM = re.compile(r"^[A-Za-z0-9_.+-]+\.desktop$")


def desktop_acties(cp: configparser.RawConfigParser, d) -> list[dict]:
    """De [Desktop Action ...]-groepen die 'Actions=' in [Desktop Entry] noemt, op volgorde.

    Elke actie: {"id": "new-private-window", "naam": "Nieuw privévenster", "icoon": "..."}. De naam in je eigen
    taal (Name[nl]), anders de gewone Name. Een actie zonder naam of zonder Exec laten we weg: die kun je niet
    tonen of niet starten. Hoe een actie start, staat niet in de JSON: dat leest '--actie' straks opnieuw uit het
    bestand zelf (zie actie_opdracht), zodat het startmenu nooit zelf een opdracht hoeft door te geven."""
    uit = []
    for actie_id in [a.strip() for a in d.get("Actions", "").split(";") if a.strip()]:
        sectie = f"Desktop Action {actie_id}"
        if not cp.has_section(sectie):
            continue
        a = cp[sectie]
        naam = a.get(f"Name[{TAAL}]") or a.get("Name", "")
        if not naam.strip() or not a.get("Exec", "").strip():
            continue
        uit.append({"id": actie_id, "naam": naam.strip(), "icoon": a.get("Icon", "")})
    return uit


# Veldcodes in een Exec-regel (freedesktop Desktop Entry Specification). Het startmenu start een actie zonder
# bestand of adres, dus %f %F %u %U (en de oude %d %D %n %N %v %m) vallen weg. %i, %c en %k vullen we in.
LEGE_VELDCODES = {"%f", "%F", "%u", "%U", "%d", "%D", "%n", "%N", "%v", "%m"}


def exec_argumenten(exec_regel: str, naam: str = "", icoon: str = "", pad: str = "") -> list[str]:
    """Een Exec-regel uit een .desktop-bestand als lijst argumenten, zonder shell (er wordt dus nooit iets
    'uitgevoerd' wat in de regel staat, alleen het programma zelf met zijn argumenten).

    Eerst de gewone tekens-met-backslash van de specificatie (\\s is een spatie, \\\\ een backslash), daarna de
    aanhalingstekens zoals een shell ze leest (shlex). Veldcodes: %f/%u/... weg, %i wordt '--icon <icoon>', %c
    de naam, %k het pad van het .desktop-bestand, %% een gewoon procentteken. Flatpak zet bv.
    'flatpak run ... org.mozilla.firefox --private-window @@u %u @@': na het weghalen van %u blijft '@@u @@'
    staan, en dat is precies wat flatpak zelf verwacht als er geen bestand meekomt. Een kapotte regel (een
    aanhalingsteken te weinig) geeft een lege lijst: dan starten we niets."""
    import shlex
    # Stap 1 van de specificatie: de algemene tekens-met-backslash, van links naar rechts (zodat '\\s' een
    # backslash plus 's' blijft en geen spatie wordt). Een andere backslash blijft staan voor stap 2 (shlex).
    vervang = {"s": " ", "n": "\n", "t": "\t", "r": "\r", "\\": "\\"}
    regel, i = "", 0
    while i < len(exec_regel):
        if exec_regel[i] == "\\" and i + 1 < len(exec_regel) and exec_regel[i + 1] in vervang:
            regel += vervang[exec_regel[i + 1]]
            i += 2
        else:
            regel += exec_regel[i]
            i += 1
    try:
        delen = shlex.split(regel)
    except ValueError:
        return []
    uit = []
    for deel in delen:
        if deel in LEGE_VELDCODES:
            continue
        if deel == "%i":
            if icoon:
                uit += ["--icon", icoon]
            continue
        if deel == "%c":
            uit.append(naam)
            continue
        if deel == "%k":
            uit.append(pad)
            continue
        # Een veldcode midden in een argument (bv. '--bestand=%f'): weghalen; '%%' wordt '%'.
        schoon = re.sub(r"%(.)", lambda m: "%" if m.group(1) == "%" else "", deel)
        if schoon or not deel:
            uit.append(schoon)
    return uit


def actie_opdracht(pad: Path, actie_id: str) -> list[str]:
    """De opdracht voor één eigen actie van een app ('new-private-window' van Firefox), uit het .desktop-bestand
    zelf. Leeg als het geen echt .desktop-bestand is, of als die actie er niet (meer) in staat: alleen acties die
    het bestand zelf noemt, kunnen starten."""
    if pad.suffix != ".desktop" or not pad.is_file():
        return []
    cp = configparser.RawConfigParser(strict=False, interpolation=None)
    cp.optionxform = str
    try:
        cp.read(pad, encoding="utf-8")
    except (configparser.Error, UnicodeDecodeError, OSError):
        return []
    if not cp.has_section("Desktop Entry"):
        return []
    d = cp["Desktop Entry"]
    genoemd = [a.strip() for a in d.get("Actions", "").split(";") if a.strip()]
    sectie = f"Desktop Action {actie_id}"
    if actie_id not in genoemd or not cp.has_section(sectie):
        return []
    a = cp[sectie]
    naam = a.get(f"Name[{TAAL}]") or a.get("Name", "")
    return exec_argumenten(a.get("Exec", ""), naam, a.get("Icon", "") or d.get("Icon", ""), str(pad))


def zoeksleutel(tekst: str) -> str:
    """Tekst om in te zoeken: kleine letters zonder accenten, zodat 'izleyici' 'İzleyici' vindt (Turks) en 'cafe'
    'café' (U268). Precies dezelfde regel als StartMenu.qml en bugos_base: NFKD, kleine letters, U+0300-U+036F weg,
    ß wordt ss en ς wordt σ (U280)."""
    import re
    t = re.sub("[\u0300-\u036f]", "", unicodedata.normalize("NFKD", tekst).lower())
    return t.replace("ß", "ss").replace("ς", "σ")


def alle_apps() -> list[dict]:
    apps: dict[str, dict] = {}
    for map_ in app_mappen():
        for pad in sorted(map_.rglob("*.desktop")):
            app_id = str(pad.relative_to(map_)).replace("/", "-")
            if app_id in apps:
                continue  # eerste map wint (gebruiker > systeem)
            info = lees_desktop(pad)
            if info:
                info["id"] = app_id
                apps[app_id] = info
            else:
                apps[app_id] = {}  # verborgen: ook niet uit een latere map halen
    return sorted((a for a in apps.values() if a), key=lambda a: a["naam"].lower())


def instellingen_apps() -> list[dict]:
    """De pagina's van BugOS Instellingen als 'apps', alleen voor het zoeken."""
    uit = []
    for pagina, nl, en, icoon, zoek in INSTELLINGEN:
        naam = t(nl, en)
        uit.append({
            "id": f"instelling-{pagina}",
            "pad": f"instelling:{pagina}",
            "naam": naam,
            "uitleg": t("Instellingen", "Settings"),
            "icoon": icoon,
            "groep": t("Instellingen", "Settings"),
            "zoek": zoeksleutel(f"{naam} {nl} {en} {zoek}"),
            "soort": "instelling",
        })
    return uit


def favorieten_bestand() -> Path:
    """Waar je eigen lijst van vastgezette apps staat. Bestaat hij niet, dan geldt de standaardlijst."""
    return HOME / ".config/bugos/favorieten.json"


def favoriet_ids() -> list[str]:
    """De desktop-id's van je vastgezette apps, op volgorde (ook die van apps die er nu niet zijn: die blijven
    in de lijst staan, zodat ze terugkomen als je de app opnieuw installeert)."""
    eigen = favorieten_bestand()
    try:
        ids = json.loads(eigen.read_text())
        # Geen lijst (null, een getal, met de hand bewerkt)? Dan niet het hele startmenu leeg, maar de standaard (U414).
        if not isinstance(ids, list):
            raise ValueError("geen lijst")
        ids = [i for i in ids if isinstance(i, str)]
    except (OSError, ValueError):
        ids = list(STANDAARD_FAVORIETEN)
        cfg = configparser.RawConfigParser(strict=False)
        try:
            cfg.read("/etc/xdg/kicker-extra-favoritesrc")
            if cfg.has_option("General", "Prepend"):
                ids = [x for x in cfg.get("General", "Prepend").split(";") if x]
        except configparser.Error:
            pass
        # De browser die je in Welkom koos (bugos-browser) staat op de plek van Firefox in de standaardlijst.
        gekozen = gekozen_browser()
        if gekozen and gekozen not in ids:
            ids = [gekozen if i in ("org.mozilla.firefox.desktop", "firefox.desktop") else i for i in ids]
    return ids


def gekozen_browser() -> str:
    """De desktop-id van de browser die je in Welkom koos (~/.config/bugos/browser, van bugos-browser), of ''."""
    try:
        app_id = (HOME / ".config/bugos/browser").read_text().split("\n", 1)[0].strip()
    except OSError:
        return ""
    return f"{app_id}.desktop" if APP_ID_VORM.match(app_id) else ""


def favorieten(apps: list[dict]) -> list[dict]:
    ids = favoriet_ids()
    per_id = {a["id"]: a for a in apps}
    uit, gezien = [], set()
    for i in ids:
        for kandidaat in [i] + ZELFDE_APP.get(i, []):
            if kandidaat in per_id and kandidaat not in gezien:
                gezien.add(kandidaat)
                uit.append(per_id[kandidaat])
                break
    return uit


def zelfde_namen(app_id: str) -> list[str]:
    """De app zelf en zijn andere naam (rpm of Flatpak, zie ZELFDE_APP): Firefox staat vast, welke naam ook."""
    return [app_id] + ZELFDE_APP.get(app_id, [])


def schrijf_json(pad: Path, waarde) -> bool:
    """Veilig wegschrijven: eerst naar een tijdelijk bestand ernaast, dan in één keer vervangen. Zo blijft er nooit
    een half bestand staan als de computer net op dat moment uitgaat (dan zou het startmenu de standaard tonen)."""
    try:
        pad.parent.mkdir(parents=True, exist_ok=True)
        tijdelijk = pad.with_name(pad.name + ".nieuw")
        tijdelijk.write_text(json.dumps(waarde, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")
        os.replace(tijdelijk, pad)
        return True
    except OSError as e:
        print(f"bugos-start-data: kon {pad} niet schrijven: {e}", file=sys.stderr)
        return False


def favoriet_zet(app_id: str, aan: bool) -> bool:
    """'Vastmaken aan Start' (aan) of 'Losmaken van Start' (uit), zoals in Windows 11.

    Vastmaken zet de app achteraan (staat hij er al, ook onder zijn andere naam, dan verandert er niets).
    Losmaken haalt hem weg, onder elke naam. De lijst komt in ~/.config/bugos/favorieten.json, het bestand dat
    favorieten() al las: was er nog geen eigen lijst, dan begint die met de standaardlijst (je verliest dus niet
    de andere vastgezette apps als je er één losmaakt)."""
    if not DESKTOP_ID_VORM.match(app_id):
        return False
    ids = favoriet_ids()
    namen = zelfde_namen(app_id)
    if aan:
        if any(n in ids for n in namen):
            return True
        nieuw = ids + [app_id]
    else:
        nieuw = [i for i in ids if i not in namen]
    return schrijf_json(favorieten_bestand(), nieuw)


# ------------------------------------------------------- taakbalk ----
# De vastgezette apps op de taakbalk zijn die van KDE's takenlijst (org.kde.plasma.icontasks): de lijst
# 'launchers' in zijn instellingen, bv. 'applications:org.mozilla.firefox.desktop'. Lezen kan rechtstreeks uit
# het bestand van Plasma; veranderen gaat via 'bugos-panel taakbalk vastmaken|losmaken <id>' (een script in
# Plasma zelf), want alleen dan ziet de takenlijst het meteen. Plasma schrijft zijn bestand pas een paar seconden
# later weg: daarom onthouden we wat bugos-panel als nieuwe lijst teruggaf (taakbalk_onthouden) en gebruiken we
# die tot het bestand van Plasma nieuwer is.
TAKENLIJSTEN = ("org.kde.plasma.icontasks", "org.kde.plasma.taskmanager")


def config_map() -> Path:
    return Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))


def taakbalk_onthouden() -> Path:
    return Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "bugos" / "taakbalk.json"


def launcher_id(launcher: str) -> str:
    """'applications:org.mozilla.firefox.desktop' of 'file:///.../x.desktop' -> de desktop-id; anders leeg
    (bv. 'preferred://browser': dat is geen vaste app)."""
    if launcher.startswith("applications:"):
        return launcher[len("applications:"):]
    if launcher.startswith("file://") and launcher.endswith(".desktop"):
        return unquote(urlparse(launcher).path).rsplit("/", 1)[-1]
    return ""


def taakbalk_ids() -> list[str] | None:
    """De desktop-id's die vastgezet zijn op de taakbalk, of None als er geen takenlijst is (dan kan
    'Vastmaken aan taakbalk' niet, en laat het menu die regel weg).

    Leest plasma-org.kde.plasma.desktop-appletsrc als gewone tekst: groepskoppen als
    [Containments][2][Applets][5] met 'plugin=org.kde.plasma.icontasks', en daaronder
    [Containments][2][Applets][5][Configuration][General] met 'launchers=a,b,c'. (configparser zou bij een
    vreemde regel in dit grote bestand van Plasma het hele bestand opgeven.)"""
    pad = config_map() / "plasma-org.kde.plasma.desktop-appletsrc"
    groepen: dict[str, dict[str, str]] = {}
    try:
        groep = ""
        for regel in pad.read_text(encoding="utf-8", errors="replace").splitlines():
            regel = regel.strip()
            if regel.startswith("[") and regel.endswith("]"):
                groep = regel
                groepen.setdefault(groep, {})
            elif "=" in regel and groep and not regel.startswith("#"):
                sleutel, waarde = regel.split("=", 1)
                groepen[groep][sleutel.strip()] = waarde.strip()
    except OSError:
        return None
    takenlijsten = [g for g, w in groepen.items() if w.get("plugin") in TAKENLIJSTEN]
    if not takenlijsten:
        return None
    uit: list[str] = []
    for g in takenlijsten:
        for l in groepen.get(g + "[Configuration][General]", {}).get("launchers", "").split(","):
            i = launcher_id(l.strip())
            if i and i not in uit:
                uit.append(i)
    # Net iets veranderd via bugos-panel, en Plasma heeft zijn bestand nog niet bijgewerkt? Dan die lijst.
    try:
        onthouden = json.loads(taakbalk_onthouden().read_text())
        if onthouden.get("tijd", 0) > pad.stat().st_mtime and isinstance(onthouden.get("lijst"), list):
            return [i for i in onthouden["lijst"] if isinstance(i, str)]
    except (OSError, ValueError, AttributeError):
        pass
    return uit


def taakbalk_zet(app_id: str, aan: bool) -> bool:
    """'Vastmaken aan taakbalk' (aan) of 'Losmaken van taakbalk' (uit), via bugos-panel. bugos-panel antwoordt
    met 'ok:<id>,<id>,...' (de nieuwe lijst); die onthouden we, zie taakbalk_ids()."""
    if not DESKTOP_ID_VORM.match(app_id) or not shutil.which("bugos-panel"):
        return False
    # Losmaken: onder elke naam (Firefox kan als firefox.desktop op de taakbalk staan). Vastmaken: deze naam.
    lijst = None
    for naam in ([app_id] if aan else zelfde_namen(app_id)):
        # Niet via draai(): die geeft het na 5 s op, en bugos-panel haalt eerst het slot van de taakbalk af.
        try:
            uit = subprocess.run(["bugos-panel", "taakbalk", "vastmaken" if aan else "losmaken", naam],
                                 capture_output=True, text=True, timeout=20).stdout
        except (OSError, subprocess.SubprocessError):
            uit = ""
        for regel in uit.splitlines():
            if regel.strip().startswith("ok:"):
                lijst = [i for i in regel.strip()[3:].split(",") if i]
    if lijst is None:
        return False
    schrijf_json(taakbalk_onthouden(), {"tijd": time.time(), "lijst": lijst})
    return True


def verwijder(flatpak_id: str) -> None:
    """'Verwijderen' in het menu van de rechtermuisknop: opent de Winkel op die app. Daar staat de knop
    'Verwijderen' met de vraag 'Weet je het zeker?' (en of je je eigen gegevens wilt houden). Het startmenu
    verwijdert dus nooit zelf iets."""
    if APP_ID_VORM.match(flatpak_id):
        los_starten("bugos-store", f"appstream://{flatpak_id}")


def start_actie(pad: str, actie_id: str) -> bool:
    """Een eigen actie van een app starten (Firefox: 'Nieuw privévenster'), net zo als --start: los, in een eigen
    systemd-scope met de naam van de app (zodat Taakbeheer hem als die app ziet)."""
    cmd = actie_opdracht(Path(pad), actie_id)
    if not cmd:
        print(f"bugos-start-data: actie {actie_id!r} van {pad} niet gevonden", file=sys.stderr)
        return False
    return los_starten(*cmd, app=Path(pad).stem)


def gegevens() -> dict:
    """Alles voor het startmenu. Per app ook of hij vastgezet is op Start ('vastgezet') en op de taakbalk
    ('op_taakbalk'), zodat het menu van de rechtermuisknop 'Vastmaken' of 'Losmaken' kan zeggen."""
    apps = alle_apps()
    favs = favorieten(apps)
    vast = {a["id"] for a in favs}
    taakbalk = taakbalk_ids()
    for a in apps:
        a["vastgezet"] = a["id"] in vast
        a["op_taakbalk"] = bool(taakbalk) and any(n in taakbalk for n in zelfde_namen(a["id"]))
    return {
        "apps": apps + instellingen_apps(),
        "favorieten": favs,
        "recent": recente_bestanden(),
        "gebruiker": gebruiker(),
        # Is er een takenlijst op de taakbalk om apps aan vast te maken (en kan bugos-panel dat)?
        "taakbalk_kan": taakbalk is not None and bool(shutil.which("bugos-panel")),
    }


def map_naam(map_pad: Path) -> str:
    """Een gewone naam voor de map van een recent bestand, zoals Windows: 'Documenten', niet '/var/home/jan/Documenten'.

    - In je thuismap: het stukje na de thuismap ('Documenten', 'Documenten/Werk'); de thuismap zelf heet 'Thuismap'.
    - Daarbuiten (een USB-stick, /tmp): het hele pad, want dan is dat wel nodig om te weten waar het staat.
    Op Fedora Kinoite is /home een koppeling naar /var/home: HOME zegt '/home/jan', maar de lijst van recente
    bestanden (recently-used.xbel) schrijft vaak '/var/home/jan/...'. Vroeger keken we alleen naar het begin van
    HOME, en dan bleef het lange technische pad staan (A-07, VM-test). Daarom beide paden eerst 'echt' maken
    (os.path.realpath volgt de koppeling), en ook nog de letterlijke HOME proberen (als realpath faalt).
    Alleen het begin van het pad telt, nooit een map verderop die toevallig zo heet (U352).
    """
    kandidaten = []
    for thuis in (os.path.realpath(HOME), str(HOME)):
        if thuis not in kandidaten:
            kandidaten.append(thuis)
    for pad in (os.path.realpath(map_pad), str(map_pad)):
        for thuis in kandidaten:
            if pad == thuis:
                return t("Thuismap", "Home folder")
            if pad.startswith(thuis.rstrip(os.sep) + os.sep):
                return pad[len(thuis.rstrip(os.sep)) + 1:]
    return str(map_pad)


def recente_bestanden(max_aantal: int = 8) -> list[dict]:
    # Ook die van apps uit de Winkel (Flatpak: LibreOffice, VLC, ...): die schrijven hun lijst in hun eigen map (U113).
    lijsten = [Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "recently-used.xbel"]
    lijsten += sorted((HOME / ".var" / "app").glob("*/data/recently-used.xbel"))
    bookmarks = []
    for xbel in lijsten:
        try:
            bookmarks += list(ET.parse(xbel).getroot().iter("bookmark"))
        except (OSError, ET.ParseError):
            continue
    items = []
    for b in bookmarks:
        url = urlparse(b.get("href", ""))
        if url.scheme != "file":
            continue
        pad = Path(unquote(url.path))
        if pad.exists():
            items.append((b.get("modified") or b.get("visited") or "", pad))
    items.sort(reverse=True)
    uit, gezien = [], set()
    for _, pad in items:
        if pad in gezien:
            continue
        gezien.add(pad)
        uit.append({"naam": pad.name, "pad": str(pad), "map": map_naam(pad.parent)})
        if len(uit) >= max_aantal:
            break
    return uit


def gebruiker() -> dict:
    naam = getpass.getuser()
    try:
        volledig = pwd.getpwnam(naam).pw_gecos.split(",")[0] or naam
    except KeyError:
        volledig = naam
    # Eerst die van AccountsService (die verandert Instellingen > Gebruikers), dan een oude ~/.face.icon.
    kandidaten = [Path(os.environ.get("BUGOS_ACCOUNTS_ICONEN", "/var/lib/AccountsService/icons")) / naam, HOME / ".face.icon"]
    foto = next((k for k in kandidaten if k.exists()), None)
    try:
        tijd = int(foto.stat().st_mtime) if foto else 0
    except OSError:
        tijd = 0
    # 'tijd': een nieuwe foto heeft dezelfde bestandsnaam; met de tijd erbij laadt het startmenu hem opnieuw (U112).
    return {"naam": volledig, "foto": str(foto) if foto else "", "foto_tijd": tijd}


def draai(*cmd: str) -> str:
    # We lezen de uitvoer, dus in het Engels (C.UTF-8): anders zegt nmcli 'ingeschakeld'. Onze eigen
    # bugos-hulpjes houden je taal, want die laten een melding zien.
    env = dict(os.environ)
    if not os.path.basename(cmd[0]).startswith("bugos-"):
        env["LC_ALL"] = "C.UTF-8"
        env.pop("LANGUAGE", None)
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5, env=env).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def eigen_plek(cmd: tuple | list, app: str = "") -> list[str]:
    """Start een programma (met een .desktop-bestand) in zijn eigen systemd-scope, zoals KDE dat doet: dan ziet
    Taakbeheer het als dat programma (niet als deel van wie het startte) en kun je het daar sluiten (U125).
    Zonder systemd voor de gebruiker (of een opdracht zonder .desktop): gewoon zoals het was.
    app: de naam van het .desktop-bestand (zonder .desktop) als die niet gelijk is aan het programma, bv. bij een
    eigen actie van Firefox ('flatpak run ... org.mozilla.firefox --private-window' hoort bij
    org.mozilla.firefox.desktop, niet bij een 'flatpak.desktop')."""
    naam = app or (os.path.basename(cmd[0]) if cmd else "")
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    # Alleen namen die systemd in een eenheid toestaat; anders zou systemd-run weigeren en start er niets (U146).
    if not naam or not runtime or not os.path.exists(os.path.join(runtime, "systemd", "private")) or \
            not shutil.which("systemd-run") or not all(c.isascii() and (c.isalnum() or c in "-_.:") for c in naam):
        return list(cmd)
    mappen = [os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share"))] + \
        os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
    # (Met 'app' weten we het .desktop-bestand al: start_actie las het net. Dat kan ook in de Flatpak-map staan,
    # die niet altijd in XDG_DATA_DIRS staat.)
    if not app and not any(os.path.exists(os.path.join(m, "applications", f"{naam}.desktop")) for m in mappen if m):
        return list(cmd)
    eenheid = "app-" + naam.replace("\\", "\\x5c").replace("-", "\\x2d") + f"-{os.getpid():x}{os.urandom(3).hex()}.scope"
    return ["systemd-run", "--user", "--scope", "--quiet", "--collect", f"--unit={eenheid}", "--", *cmd]


def los_starten(*cmd: str, app: str = "") -> bool:
    try:
        subprocess.Popen(eigen_plek(cmd, app), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return True
    except OSError as e:
        print(f"bugos-start-data: {cmd[0]} kon niet starten: {e}", file=sys.stderr)
        return False


# ------------------------------------------------------------- snelmenu ----

NIET_STOREN_TOT = "2999,12,31,0,0,0"  # dezelfde waarde als lib.sh en bugos_config.py


def niet_storen_tot_in_toekomst(tekst: str) -> bool:
    """KDE schrijft 'jaar,maand,dag,uur,min,sec' of een ISO-tijd. Is die nog niet voorbij?"""
    tekst = tekst.strip()
    if not tekst:
        return False
    nu = datetime.now().astimezone()
    # KConfig schrijft de seconden met een komma-deel ("7.913") en soms een tijdzone als 7e veld (U072).
    delen = tekst.split(",")
    try:
        if len(delen) >= 3:
            getallen = [int(float(x)) for x in delen[:6]]
            zone = None
            if len(delen) > 6:
                from zoneinfo import ZoneInfo
                try:
                    zone = ZoneInfo(delen[6].strip())
                except (ValueError, KeyError, OSError):
                    zone = None
            tot = datetime(*getallen, tzinfo=zone) if zone else datetime(*getallen).astimezone()
            return tot > nu
    except (ValueError, TypeError, OverflowError):
        pass
    try:
        tot = datetime.fromisoformat(tekst.replace("Z", "+00:00"))
        return (tot if tot.tzinfo else tot.astimezone()) > nu
    except ValueError:
        return False


def kde_lees(bestand: str, groep: str, sleutel: str) -> str:
    return draai("kreadconfig6", "--file", bestand, "--group", groep, "--key", sleutel).strip()


def volume_status() -> tuple[int | None, bool | None]:
    vol = draai("wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@") if shutil.which("wpctl") else ""
    try:
        procent = round(float(vol.split()[1]) * 100)
    except (IndexError, ValueError):
        procent = None
    if procent is None:
        return None, None   # geen geluid (geen wpctl of geen luidspreker): ook de knop 'Geluid uit' grijs (U347)
    return procent, "MUTED" in vol


def backlight() -> Path | None:
    """De schermverlichting van een laptop (een losse monitor heeft dit meestal niet)."""
    basis = Path(os.environ.get("BUGOS_SYS", "/sys")) / "class" / "backlight"
    for pad in sorted(basis.glob("*")):
        if (pad / "max_brightness").exists():
            return pad
    return None


def helderheid() -> int | None:
    pad = backlight()
    if pad is None:
        return None
    try:
        return round(int((pad / "brightness").read_text()) / max(int((pad / "max_brightness").read_text()), 1) * 100)
    except (OSError, ValueError):
        return None


def batterij() -> tuple[int | None, bool]:
    """(procent, laadt) van de eerste batterij; (None, False) op een computer zonder batterij."""
    basis = Path(os.environ.get("BUGOS_SYS", "/sys")) / "class" / "power_supply"
    # Zoals Instellingen (U155): een batterij herken je aan type=Battery (niet alleen 'BAT0'), maar niet die van een
    # muis of toetsenbord (scope=Device) (U346).
    gevonden = []
    for pad in sorted(basis.glob("*")):
        try:
            soort = (pad / "type").read_text().strip() if (pad / "type").exists() else \
                ("Battery" if pad.name.startswith("BAT") else "")
            if soort != "Battery":
                continue
            if (pad / "scope").exists() and (pad / "scope").read_text().strip() == "Device":
                continue
            procent = int((pad / "capacity").read_text().strip())
            staat = (pad / "status").read_text().strip()
        except (OSError, ValueError):
            continue
        nu = vol = None
        for a, b in (("energy_now", "energy_full"), ("charge_now", "charge_full")):
            try:
                nu, vol = int((pad / a).read_text()), int((pad / b).read_text())
                break
            except (OSError, ValueError):
                continue
        gevonden.append((procent, staat, nu, vol))
    if not gevonden:
        return None, False
    # Twee batterijen (veel ThinkPads): samen tellen, zoals Instellingen (U399).
    if len(gevonden) > 1 and all(g[2] is not None and g[3] for g in gevonden):
        procent = round(100 * sum(g[2] for g in gevonden) / sum(g[3] for g in gevonden))
    else:
        procent = round(sum(g[0] for g in gevonden) / len(gevonden))
    return procent, any(g[1] == "Charging" for g in gevonden)


def snel_status() -> dict:
    if os.environ.get("BUGOS_SNEL_VOORBEELD"):  # voor foto's en tests: niets aan de computer vragen
        return {"wifi": True, "bluetooth": False, "spel": False,
                "donker": is_donker(),
                "volume": 60, "stil": False, "niet_storen": False,
                "helderheid": 70, "batterij": 76, "laadt": False}
    s: dict = {}
    # Geen wifi in deze computer (een pc aan een kabel)? Dan geen tegel, ook al zegt nmcli 'enabled' (U111).
    # Lukt nmcli (nog) niet, net na het inloggen: dan zoals Instellingen gewoon aannemen dat er wifi is (U123).
    apparaten = draai("nmcli", "-t", "-f", "TYPE", "device").split() if shutil.which("nmcli") else []
    heeft_wifi = bool(shutil.which("nmcli")) and (not apparaten or "wifi" in apparaten)
    s["wifi"] = draai("nmcli", "-t", "-f", "WIFI", "radio").strip() == "enabled" if heeft_wifi else None
    # Zonder bluetooth-hardware wacht 'bluetoothctl' tot zijn tijd op is: dan niet vragen (geen tegel).
    bt_map = Path(os.environ.get("BUGOS_SYS", "/sys")) / "class" / "bluetooth"
    heeft_bt = bt_map.is_dir() and any(bt_map.iterdir())
    bt = draai("bluetoothctl", "show") if heeft_bt and shutil.which("bluetoothctl") else ""
    s["bluetooth"] = None if "Controller" not in bt else ("Powered: yes" in bt)
    if s["bluetooth"] is None and not heeft_bt:
        # Uit met de vliegtuigstand (hci0 is dan weg, de rfkill-schakelaar niet): tegel 'uit', zodat je hem weer
        # aan kunt zetten (U165).
        rfkill = Path(os.environ.get("BUGOS_SYS", "/sys")) / "class" / "rfkill"
        try:
            if any((r / "type").read_text().strip() == "bluetooth" and any(
                    (r / k).exists() and (r / k).read_text().strip() == "1" for k in ("soft", "hard"))
                    for r in rfkill.iterdir()):   # alleen een schakelaar die echt uit staat (U188)
                s["bluetooth"] = False
        except OSError:
            pass
    s["spel"] = draai("bugos-game-mode", "status").strip() == "aan" if shutil.which("bugos-game-mode") else None
    s["donker"] = is_donker()
    s["volume"], s["stil"] = volume_status()
    s["niet_storen"] = niet_storen_tot_in_toekomst(kde_lees("plasmanotifyrc", "DoNotDisturb", "Until"))
    s["helderheid"] = helderheid()
    s["batterij"], s["laadt"] = batterij()
    return s


def tray_status() -> dict:
    """Korte status voor een icoontje op de taakbalk: internet, volume, batterij."""
    s: dict = {"internet": "geen", "wifi": None, "volume": None, "stil": False, "batterij": None, "laadt": False}
    if shutil.which("nmcli"):
        s["wifi"] = draai("nmcli", "-t", "-f", "WIFI", "radio").strip() == "enabled"
        soorten = set()
        for regel in draai("nmcli", "-t", "-f", "TYPE,STATE", "device").splitlines():
            delen = regel.split(":")
            if len(delen) >= 2 and delen[1] == "connected":
                soorten.add(delen[0])
        s["internet"] = "kabel" if "ethernet" in soorten else "wifi" if "wifi" in soorten else "geen"
    s["volume"], s["stil"] = volume_status()
    s["batterij"], s["laadt"] = batterij()
    return s


def is_donker() -> bool:
    """Donker: het BugOS-schema, of een ander donker schema uit de KDE-instellingen (Breeze Dark) (U325)."""
    schema = kde_lees("kdeglobals", "General", "ColorScheme")
    if schema in ("BugOSDark", "BugOSLight", ""):
        return schema == "BugOSDark"
    try:
        r, g, b = (int(x) for x in kde_lees("kdeglobals", "Colors:Window", "BackgroundNormal").split(",")[:3])
    except ValueError:
        return False
    return r * 299 + g * 587 + b * 114 < 128000


def snel_zet(wat: str, waarde: str) -> None:
    aan = waarde in ("aan", "true", "1", "on")
    if wat == "wifi":
        draai("nmcli", "radio", "wifi", "on" if aan else "off")
    elif wat == "bluetooth":
        # De laatste klik telt: klik je tijdens het wachten 'uit', dan niet daarna alsnog 'aan' (U517).
        wens = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / f"bugos-bt-wens-{os.getuid()}"
        mijn = f"{os.getpid()}-{time.time_ns()}"
        try:
            wens.write_text(mijn)
        except OSError:
            pass
        if aan:
            draai("rfkill", "unblock", "bluetooth")
            # Na de vliegtuigstand komt de kaart pas even later terug: wachten, zoals Instellingen en Help (U499, U504).
            for _ in range(10):
                if "Controller" in (draai("bluetoothctl", "show") or ""):
                    break
                time.sleep(0.5)
            try:
                if wens.read_text() != mijn:
                    return   # intussen een nieuwere klik
            except OSError:
                pass
        if not aan and "Controller" not in (draai("bluetoothctl", "show") or ""):
            # De kaart is er (nog) niet, bijv. net na de vliegtuigstand: 'power off' doet dan niets, en BlueZ zet hem
            # straks vanzelf aan. Dan blokkeren, zodat 'uit' ook echt uit blijft (U529).
            draai("rfkill", "block", "bluetooth")
            return
        draai("bluetoothctl", "power", "on" if aan else "off")
    elif wat == "spel":
        # Los starten: na 5 s afbreken (draai) liet 'volle kracht' en 'niet storen' half aan staan (U260).
        los_starten("bugos-game-mode", "aan" if aan else "uit")
    elif wat == "donker":
        # Eén plek voor licht/donker: kleuren, KDE-programma's (Kvantum) en de Plasma-stijl.
        los_starten("bugos-theme", "donker" if aan else "licht")
    elif wat == "volume":
        try:
            procent = max(0, min(100, int(waarde)))
        except ValueError:
            return
        # Alleen het volume; 'stil' blijft zoals het was (dat is een eigen knop).
        draai("wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{procent / 100:.2f}")
    elif wat == "helderheid":
        pad = backlight()
        try:
            procent = max(5, min(100, int(waarde)))
            maximum = int((pad / "max_brightness").read_text()) if pad else 0
        except (ValueError, OSError):
            return
        if pad and maximum:
            # Via logind: mag zonder wachtwoord voor wie achter de computer zit (net als Instellingen).
            draai("gdbus", "call", "--system", "--dest", "org.freedesktop.login1", "--object-path",
                  "/org/freedesktop/login1/session/auto", "--method", "org.freedesktop.login1.Session.SetBrightness",
                  "backlight", pad.name, str(max(1, round(maximum * procent / 100))))
    elif wat == "stil":
        draai("wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1" if aan else "0")
    elif wat == "niet_storen":
        if aan:
            draai("kwriteconfig6", "--file", "plasmanotifyrc", "--group", "DoNotDisturb", "--key", "Until", "--notify",
                  NIET_STOREN_TOT)
        else:
            draai("kwriteconfig6", "--file", "plasmanotifyrc", "--group", "DoNotDisturb", "--key", "Until", "--notify",
                  "--delete")


# ------------------------------------------------------------------ main ----

def start(pad: str) -> None:
    if pad.startswith("instelling:"):
        pagina = pad.split(":", 1)[1]
        los_starten("bugos-settings", pagina) if pagina else los_starten("bugos-settings")
    elif shutil.which("kioclient"):
        los_starten("kioclient", "exec", pad)
    else:
        los_starten("gio", "launch", pad)


def main(args: list[str]) -> int:
    if len(args) == 2 and args[0] == "--start":
        start(args[1])
        return 0
    if len(args) == 2 and args[0] == "--open":
        # Een .exe/.msi/.deb/.rpm uit 'Recent' in het startmenu rechtstreeks naar BugOS' eigen helper: xdg-open gaat
        # via kde-open, en KIO weigert "uitvoerbare bestanden" (D-01; dezelfde lijst als EIGEN_OPENER in Bestanden).
        opener = {".exe": "bugos-exe", ".msi": "bugos-exe", ".deb": "bugos-package",
                  ".rpm": "bugos-package"}.get(os.path.splitext(args[1])[1].lower())
        los_starten(opener, args[1]) if opener else los_starten("xdg-open", args[1])
        return 0
    if len(args) == 2 and args[0] == "--aan-uit":
        acties = {
            "uitloggen": ("qdbus6", "org.kde.LogoutPrompt", "/LogoutPrompt", "promptLogout"),
            "herstarten": ("qdbus6", "org.kde.LogoutPrompt", "/LogoutPrompt", "promptReboot"),
            "uitzetten": ("qdbus6", "org.kde.LogoutPrompt", "/LogoutPrompt", "promptShutDown"),
            "slot": ("loginctl", "lock-session"),
        }
        if args[1] in acties:
            cmd = acties[args[1]]
            if cmd[0] == "qdbus6" and not shutil.which("qdbus6"):
                cmd = ("gdbus", "call", "--session", "--dest", cmd[1], "--object-path", cmd[2], "--method",
                       f"org.kde.LogoutPrompt.{cmd[3]}")
            los_starten(*cmd)
        return 0
    if args == ["--snel"]:
        print(json.dumps(snel_status()))
        return 0
    if args == ["--tray"]:
        print(json.dumps(tray_status()))
        return 0
    if len(args) == 3 and args[0] == "--zet":
        snel_zet(args[1], args[2])
        s = snel_status()
        if args[1] in ("donker", "spel"):
            # bugos-theme of bugos-game-mode loopt nog: toon wat je net koos (U128, U260).
            s[args[1]] = args[2] in ("aan", "true", "1", "on")
        print(json.dumps(s))
        return 0
    # Het menu van de rechtermuisknop op een app (StartMenu.qml, appMenu).
    if len(args) == 3 and args[0] == "--actie":
        # Een eigen actie van de app ('new-private-window'): de opdracht komt uit het .desktop-bestand zelf.
        return 0 if start_actie(args[1], args[2]) else 1
    if len(args) == 2 and args[0] == "--quarantaine":
        # 'Openen in quarantaine': alleen een echt .desktop-bestand, en altijd met het venster.
        if args[1].endswith(".desktop") and os.path.isfile(args[1]):
            los_starten("bugos-quarantaine", "--venster", args[1])
            return 0
        return 1
    if len(args) == 2 and args[0] == "--verwijder":
        verwijder(args[1])
        return 0
    if len(args) == 2 and args[0] in ("--vastzetten", "--losmaken"):
        # Daarna meteen de nieuwe gegevens, zodat het startmenu de tegel er direct bij zet of weghaalt.
        favoriet_zet(args[1], args[0] == "--vastzetten")
        print(json.dumps(gegevens(), ensure_ascii=False))
        return 0
    if len(args) == 3 and args[0] == "--taakbalk" and args[1] in ("vastmaken", "losmaken"):
        taakbalk_zet(args[2], args[1] == "vastmaken")
        print(json.dumps(gegevens(), ensure_ascii=False))
        return 0
    print(json.dumps(gegevens(), ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
