#!/usr/bin/bash
# bugos-paneel - het BugOS-startmenu en -snelmenu aan of uit zetten op de taakbalk.
#
#   bugos-paneel startmenu aan|uit|status
#   bugos-paneel snelmenu  aan|uit|status
#
# Jip-en-Janneke: dit wisselt de startknop op de taakbalk om tussen het
# gewone KDE-menu en het nieuwe BugOS-menu. Gaat er iets mis? "uit" zet
# alles terug zoals het was.

# shellcheck source=system_files/usr/share/bugos/lib.sh
. /usr/share/bugos/lib.sh

WAT="${1:-}"
ACTIE="${2:-status}"

plasma_script() {
    qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$1" 2>/dev/null
}

# Hulpje (JavaScript voor Plasma): vervang widget-soort A door B op elke taakbalk,
# op dezelfde plek. Als A "" is, wordt B toegevoegd vóór "voor".
JS_VERVANG='
function vervang(oud, nieuw, voor) {
    var ps = panels();
    var gedaan = 0;
    for (var i = 0; i < ps.length; i++) {
        var p = ps[i];
        var ws = p.widgets();
        var doel = null, buur = null, alAanwezig = false;
        for (var j = 0; j < ws.length; j++) {
            if (oud !== "" && ws[j].type == oud) doel = ws[j];
            if (voor !== "" && ws[j].type == voor) buur = ws[j];
            if (ws[j].type == nieuw) alAanwezig = true;
        }
        if (alAanwezig) { gedaan++; continue; }
        if (oud !== "" && doel === null) continue;
        if (oud === "" && buur === null) continue;
        var w = p.addWidget(nieuw);
        if (nieuw == "org.kde.plasma.kickoff") {
            w.currentConfigGroup = ["General"];
            w.writeConfig("icon", "bugos-logo");
        }
        p.currentConfigGroup = ["General"];
        var volgorde = String(p.readConfig("AppletOrder", "")).split(";").filter(function (x) { return x !== "" && x != String(w.id); });
        var plek = volgorde.indexOf(String(oud !== "" ? doel.id : buur.id));
        if (plek < 0) plek = 0;
        if (oud !== "") volgorde[plek] = String(w.id); else volgorde.splice(plek, 0, String(w.id));
        p.writeConfig("AppletOrder", volgorde.join(";"));
        if (oud !== "") doel.remove();
        p.reloadConfig();
        gedaan++;
    }
    print(gedaan);
}
function weg(soort) {
    var ps = panels(), n = 0;
    for (var i = 0; i < ps.length; i++) {
        var ws = ps[i].widgets();
        for (var j = 0; j < ws.length; j++) if (ws[j].type == soort) { ws[j].remove(); n++; }
    }
    print(n);
}
function heeft(soort) {
    var ps = panels(), n = 0;
    for (var i = 0; i < ps.length; i++) {
        var ws = ps[i].widgets();
        for (var j = 0; j < ws.length; j++) if (ws[j].type == soort) n++;
    }
    print(n > 0 ? "aan" : "uit");
}
'

case "$WAT:$ACTIE" in
startmenu:aan)
    plasma_script "$JS_VERVANG vervang(\"org.kde.plasma.kickoff\", \"org.bugos.startmenu\", \"\");" >/dev/null
    melding "$(t "Nieuw startmenu staat aan" "New start menu is on")" \
        "$(t "Bevalt het niet? Zet het uit in Instellingen." "Don't like it? Turn it off in Settings.")"
    ;;
startmenu:uit)
    plasma_script "$JS_VERVANG vervang(\"org.bugos.startmenu\", \"org.kde.plasma.kickoff\", \"\");" >/dev/null
    ;;
startmenu:status)
    uit="$(plasma_script "$JS_VERVANG heeft(\"org.bugos.startmenu\");")"
    echo "${uit:-uit}"
    ;;
snelmenu:aan)
    plasma_script "$JS_VERVANG vervang(\"\", \"org.bugos.snelmenu\", \"org.kde.plasma.systemtray\");" >/dev/null
    ;;
snelmenu:uit)
    plasma_script "$JS_VERVANG weg(\"org.bugos.snelmenu\");" >/dev/null
    ;;
snelmenu:status)
    uit="$(plasma_script "$JS_VERVANG heeft(\"org.bugos.snelmenu\");")"
    echo "${uit:-uit}"
    ;;
*)
    echo "Gebruik: bugos-paneel startmenu|snelmenu aan|uit|status" >&2
    exit 2
    ;;
esac
