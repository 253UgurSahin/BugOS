#!/usr/bin/bash
# bugos-developer - de "Ontwikkelaarsmodus" aan of uit.
#
#   bugos-developer aan | uit | status
#
# Aan zet klaar:
#   • Visual Studio Code (uit de Winkel)
#   • Podman met Docker-commando's (containers)
#   • een "dev"-doosje (Distrobox) met git, Python, Node.js, Rust, Go, C/C++
# Gewone gebruikers merken hier niets van zolang het uit staat.

# shellcheck source=system_files/usr/share/bugos/lib.sh
. /usr/share/bugos/lib.sh

MARKER="$BUGOS_CONFIG/ontwikkelaar-aan"
DOOS=dev
# Dezelfde Fedora-versie als BugOS zelf (een vaste versie, niet 'latest') (U263).
# (Lezen met sed en niet met ". /etc/os-release" in een $(...): daar struikelt shellcheck 0.9 over, SC2031.)
FEDORA_VERSIE="$(sed -n 's/^VERSION_ID=//p' /etc/os-release 2>/dev/null | tr -d '"' | head -n 1)"
DOOS_BEELD="registry.fedoraproject.org/fedora-toolbox:${FEDORA_VERSIE:-44}"
DEV_PAKKETTEN="git gcc gcc-c++ make cmake python3 python3-pip nodejs npm rust cargo golang jq"
VSCODE=com.visualstudio.code
FLATHUB_URL=https://dl.flathub.org/repo/flathub.flatpakrepo
# Wat flatpak, distrobox en podman zeiden, blijft bewaard (ook als het lukte): dan kun jij (of wie je helpt) lezen
# wat er misging. Eerst ging het in een tijdelijk bestand dat meteen weer weg was.
LOGBOEK="${XDG_STATE_HOME:-$HOME/.local/state}/bugos/ontwikkelaar.log"

# Een kopje in het logboek, met de tijd.
stap() { printf '\n== %s (%s)\n' "$1" "$(date '+%F %T')" >>"$LOGBOEK"; }
# Een opdracht met alles wat hij zegt in het logboek. In het Engels (LC_ALL=C.UTF-8): we zoeken in die woorden (vol,
# netwerk). 9>&-: het slot (U262) niet doorgeven aan wat blijft draaien (podman/conmon van het doosje), anders bleef
# het slot de hele sessie dicht en wachtte 'uit' eeuwig (U270).
loggen() { LC_ALL=C.UTF-8 "$@" >>"$LOGBOEK" 2>&1 9>&-; }

# Wat NetworkManager zegt: full (online), portal (eerst inloggen op de wifi), limited, none, of leeg (niet te weten).
# Dezelfde vraag als online() in Instellingen.
verbinding() {
    command -v nmcli >/dev/null 2>&1 || return 0
    timeout 20 nmcli -t networking connectivity check 2>/dev/null 9>&- | tail -n 1
}

# VS Code zoals de Winkel het doet (U059): systeembreed van Flathub (die zet bugos-first-boot neer), met -y en zonder
# --noninteractive, zodat KDE om een wachtwoord kan vragen. Eerst stond hier --user (er is geen flathub voor de
# gebruiker, dus dat mislukte altijd) en daarna --noninteractive (dan vraagt niemand een wachtwoord).
vscode() {
    stap "VS Code"
    if flatpak info "$VSCODE" >/dev/null 2>&1 9>&-; then
        echo "VS Code staat er al." >>"$LOGBOEK"
        return 0
    fi
    if flatpak remotes --system --columns=name 2>/dev/null 9>&- | grep -qx flathub &&
        loggen flatpak install --system -y flathub "$VSCODE"; then
        return 0
    fi
    # Geen flathub op het systeem (bugos-first-boot kon hem nog niet neerzetten, bijv. omdat de wifi er pas later
    # was), of geen wachtwoord (geen beheerder, of Annuleren): dan alleen voor jou. Dat mag zonder wachtwoord, maar
    # dan moet jij zelf de bron flathub hebben (--if-not-exists: hij blijft als hij er al is).
    stap "VS Code, alleen voor deze gebruiker"
    loggen flatpak remote-add --user --if-not-exists flathub "$FLATHUB_URL" || return 1
    loggen flatpak remote-modify --user --enable flathub || true
    loggen flatpak install --user -y --noninteractive flathub "$VSCODE"
}

# Het dev-doosje: het beeld van Fedora ophalen (create), en de eerste keer binnengaan installeert de ontwikkelpakketten
# erin met dnf (enter: dat duurt het langst). Zet MISLUKT op 'doos' of 'pakketten'.
doosje() {
    local nieuw=nee
    if ! distrobox list 2>/dev/null 9>&- | grep -q " $DOOS "; then
        stap "Dev-doosje maken ($DOOS_BEELD)"
        if ! loggen distrobox create --yes --name "$DOOS" --image "$DOOS_BEELD" \
            --additional-packages "$DEV_PAKKETTEN"; then
            MISLUKT=doos
            return 1
        fi
        nieuw=ja
    fi
    stap "Dev-doosje afmaken (de ontwikkelpakketten installeren)"
    if ! loggen distrobox enter "$DOOS" -- true; then
        MISLUKT=pakketten
        # Een half doosje dat we net maakten, niet laten staan: anders zag de volgende poging 'het doosje is er al'
        # en ging hij een kapot doosje binnen. Een doosje dat er al was (van jou) blijft altijd.
        [ "$nieuw" = ja ] && loggen distrobox rm --force "$DOOS" </dev/null
        return 1
    fi
}

# Waarom het niet lukte, eerlijk: vol, niet online, de wifi wil dat je inlogt, een netwerk dat een server tegenhoudt,
# of de stap die mislukte. Nooit 'ben je online?' als NetworkManager zegt dat je online bent.
waarom() {
    local net reden
    if grep -qiE "no space left on device|not enough (disk |free )?space|disk quota exceeded" "$LOGBOEK"; then
        t "Je computer is vol. Maak eerst ruimte (bijv. de prullenbak leegmaken in Bestanden) en probeer het dan opnieuw." \
            "Your computer is full. Make room first (for example empty the trash in Files) and try again."
        return
    fi
    net="$(verbinding)"
    stap "NetworkManager: ${net:-onbekend}"
    case "$net" in
    none | limited)
        t "Je bent niet online. Maak verbinding met het internet en probeer het dan opnieuw." \
            "You are not online. Connect to the internet and try again."
        return
        ;;
    portal)
        t "Je wifi wil eerst dat je inlogt of iets accepteert. Open de browser, doe dat, en probeer het dan opnieuw." \
            "Your Wi-Fi first wants you to log in or accept something. Open the browser, do that, and try again."
        return
        ;;
    esac
    case "$MISLUKT" in
    vscode) reden="$(t "Visual Studio Code kon niet van Flathub worden geïnstalleerd." \
        "Visual Studio Code could not be installed from Flathub.")" ;;
    doos) reden="$(t "Het dev-doosje kon niet worden gemaakt: het Fedora-beeld ophalen lukte niet." \
        "The dev box could not be made: getting the Fedora image did not work.")" ;;
    *) reden="$(t "Het dev-doosje is gemaakt, maar de ontwikkelpakketten erin installeren lukte niet." \
        "The dev box was made, but installing the developer tools in it did not work.")" ;;
    esac
    if grep -qiE "insufficient uids|newuidmap|newgidmap|/etc/subuid|/etc/subgid" "$LOGBOEK"; then
        reden="$reden $(t "Containers werken nog niet voor jouw account (er staan geen gebruikers-ID's voor je in /etc/subuid). Vraag het aan wie de computer beheert." \
            "Containers do not work for your account yet (there are no user IDs for you in /etc/subuid). Ask the person who looks after this computer.")"
    elif [ "$net" = full ] && grep -qiE "could not resolve|couldn.t resolve|no such host|name resolution|network is unreachable|timed out|timeout|connection refused|connection reset|tls handshake|couldn.t connect|could not connect|failed to connect|unable to connect|i/o timeout" "$LOGBOEK"; then
        reden="$reden $(t "Je internet werkt, maar de server kon niet worden bereikt. Sommige netwerken (zoals een gastnetwerk) houden dat tegen: probeer het op een ander netwerk, of later opnieuw." \
            "Your internet works, but the server could not be reached. Some networks (like a guest network) block this: try another network, or try again later.")"
    elif [ "$net" = full ]; then
        reden="$reden $(t "Probeer het later opnieuw." "Try again later.")"
    else
        reden="$reden $(t "Kijk of je online bent en probeer het dan opnieuw." "Check that you are online and try again.")"
    fi
    echo "$reden"
}

aan() {
    mkdir -p "$BUGOS_CONFIG" "${LOGBOEK%/*}"
    : >"$LOGBOEK" 2>/dev/null || LOGBOEK=/dev/null
    melding "$(t "Ontwikkelaarsmodus wordt klaargezet..." "Setting up developer mode...")" \
        "$(t "Dit kan 5 tot 10 minuten duren." "This can take 5 to 10 minutes.")"

    # Lukt een stap niet, dan zeggen we dat eerlijk en blijft de modus uit (geen "AAN" zonder dat het werkt).
    MISLUKT=""
    vscode || MISLUKT=vscode

    systemctl --user enable --now podman.socket >/dev/null 2>&1 9>&-

    [ -z "$MISLUKT" ] && doosje

    if [ -n "$MISLUKT" ]; then
        stap "Mislukt: $MISLUKT"
        local tekst
        tekst="$(t "Ontwikkelaarsmodus klaarzetten lukte niet." "Setting up developer mode did not work.") $(waarom)"
        if [ "$LOGBOEK" != /dev/null ]; then
            tekst="$tekst\n\n$(t "Wat er precies gebeurde, staat in dit bestand:" "What exactly happened is in this file:") $LOGBOEK"
        fi
        fout "$tekst"
        return 1
    fi
    stap "Klaar"

    touch "$MARKER"
    melding "$(t "Ontwikkelaarsmodus staat AAN 🛠️" "Developer mode is ON 🛠️")" \
        "$(t "Open de Terminal en typ 'distrobox enter dev' voor je dev-doosje." \
            "Open the Terminal and type 'distrobox enter dev' for your dev box.")"
}

uit() {
    # We gooien niets weg: je code en doosjes blijven bewaard.
    rm -f "$MARKER"
    melding "$(t "Ontwikkelaarsmodus staat UIT" "Developer mode is OFF")" \
        "$(t "Je bestanden en doosjes zijn bewaard." "Your files and boxes are kept.")"
}

# Nooit twee keer tegelijk (Welkom en Instellingen): de tweede wacht, en ziet dan dat het doosje er al is (U262).
slot() {
    mkdir -p "$BUGOS_CONFIG"
    exec 9>"$BUGOS_CONFIG/.ontwikkelaar.slot"
    flock 9 2>/dev/null || true
}

case "${1:-status}" in
aan) slot; aan ;;
uit) slot; uit ;;
status) if [ -f "$MARKER" ]; then echo aan; else echo uit; fi ;;
*)
    echo "Gebruik: bugos-developer aan|uit|status" >&2
    exit 2
    ;;
esac
