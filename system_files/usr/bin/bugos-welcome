#!/usr/bin/python3
"""BugOS Welkom - het eerste scherm na het installeren.

Jip-en-Janneke: een paar grote, simpele stappen.
  1. Hallo + taal
  2. Internet (wifi)
  3. Licht of donker
  4. Updates: vanzelf of zelf
  5. Wat ga je doen? (gamen / programmeren / oudere computer)
  6. Klaar!

Gestart met --eerste-keer opent hij alleen als hij nog nooit is afgemaakt.
"""

import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, "/usr/lib/bugos/python")


def _al_klaar() -> bool:
    """Bij elk inloggen (--eerste-keer): al klaar, of op de live-USB? Dan meteen stoppen, vóór PySide6 en bugos_ui
    geladen zijn: dat kostte bij elk inloggen een kwart seconde en 50 MB, alleen om te stoppen (U309)."""
    import os
    if (Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "bugos" / "welkom-klaar").exists():
        return True
    try:
        return "rd.live.image" in Path("/proc/cmdline").read_text()
    except OSError:
        return False


if __name__ == "__main__" and "--eerste-keer" in sys.argv and _al_klaar():
    sys.exit(0)

import bugos_ui  # noqa: E402
from bugos_ui import (  # noqa: E402
    CONFIG, Chip, Groep, IcoonChip, Kaart, KeuzeKaart, Knop, SchakelRij, Tegel, achtergrond_pad, bestaat, draai,
    label, maak_app, ronde_pixmap, schuifbaar, start, t, uitvoeren,
)
from bugos_welcome_panel import Zijpaneel  # noqa: E402
from PySide6.QtCore import QLocale, QProcess, QRectF, QSize, Qt, QThread, QTimer, Signal  # noqa: E402
from PySide6.QtWidgets import QApplication  # noqa: E402
from PySide6.QtGui import QColor, QIcon, QPainter, QPixmap  # noqa: E402
from PySide6.QtWidgets import (  # noqa: E402
    QButtonGroup, QHBoxLayout, QLabel, QPushButton, QStackedWidget, QVBoxLayout, QWidget,
)

KLAAR = CONFIG / "welkom-klaar"


def heeft_internet() -> bool:
    code, uit = draai("nmcli", "-t", "-f", "CONNECTIVITY", "general", timeout=5)
    return code == 0 and uit.strip() == "full"


# ============================================================== pagina's ===

class Pagina(QWidget):
    def __init__(self, kop_tekst: str, sub: str):
        super().__init__()
        self.setObjectName("pagina")
        self.lay = QVBoxLayout(self)
        self.lay.setContentsMargins(48, 46, 48, 12)
        self.lay.setSpacing(18)
        self.lay.addWidget(label(kop_tekst, "titel"))
        self.lay.addWidget(label(sub, "sub"))
        self.lay.addSpacing(6)

    def klaar_met_vullen(self) -> None:
        self.lay.addStretch(1)

    def bij_volgende(self) -> None:
        """Wordt aangeroepen als de gebruiker op Volgende drukt."""


class Hallo(Pagina):
    def __init__(self):
        super().__init__(t("Hallo! Fijn dat je er bent.", "Hello! Glad you're here."),
                         t("In een paar simpele stappen zetten we alles voor je klaar. "
                           "Je kunt alles later nog veranderen.",
                           "In a few simple steps we'll set everything up for you. "
                           "You can change everything later."))
        taal = Kaart(marge=20, ruimte=16, richting="h")
        taal.lay.addWidget(IcoonChip("lijn:wereld", "neutraal", 48, vol=False))
        blok = QVBoxLayout()
        blok.setSpacing(2)
        blok.addWidget(label(t("Taal", "Language"), "klein"))
        naam = QLocale().nativeLanguageName() or t("Nederlands", "English")   # (U213: met LANG=C is dat Engels)
        blok.addWidget(label(naam[:1].upper() + naam[1:], "kop2"))
        taal.lay.addLayout(blok, 1)
        knop = Knop(t("Andere taal", "Other language"), "rand")
        knop.clicked.connect(lambda: start("bugos-settings", "tijd"))
        taal.lay.addWidget(knop)
        self.lay.addWidget(taal)

        tips = Groep()
        for icoon, tint, kop_t, sub_t in (
            ("lijn:vink", "neutraal", t("Kan niet stuk", "Can't break"),
             t("Gaat er iets mis na een update? Dan ga je terug naar de vorige versie in Instellingen. Start de "
               "computer niet meer goed? Houd bij het opstarten Shift ingedrukt (of druk op Esc) en kies de vorige.",
               "Something wrong after an update? Go back to the previous version in Settings. If the computer does "
               "not start properly, hold Shift (or press Esc) while it starts and pick the previous one.")),   # het opstartmenu is normaal verborgen (U360)
            ("lijn:ster", "neutraal", t("Alles in de BugOS Winkel", "Everything in the BugOS Store"),
             t("Apps installeer je met één klik, zoals op je telefoon.", "Install apps with one click, like on your phone.")),
            ("lijn:slot", "neutraal", t("Geen account, geen reclame", "No account, no ads"),
             t("BugOS verzamelt niks over jou.", "BugOS collects nothing about you.")),
        ):
            rij = QWidget()
            r = QHBoxLayout(rij)
            r.setContentsMargins(18, 14, 18, 14)
            r.setSpacing(14)
            r.addWidget(IcoonChip(icoon, tint, 38, vol=False))
            b = QVBoxLayout()
            b.setSpacing(1)
            b.addWidget(label(kop_t, "kop3"))
            b.addWidget(label(sub_t, "klein"))
            r.addLayout(b, 1)
            tips.voeg(rij)
        self.lay.addWidget(tips)
        self.klaar_met_vullen()


class Kijker(QThread):
    """Kijkt op de achtergrond of er internet is (nmcli kan even duren), zodat het venster niet hapert."""

    klaar = Signal(bool)

    def run(self) -> None:
        try:
            self.klaar.emit(bool(heeft_internet()))
        except Exception:  # noqa: BLE001
            self.klaar.emit(False)


class Internet(Pagina):
    def __init__(self):
        super().__init__(t("Internet", "Internet"),
                         t("Voor updates en de Winkel heb je internet nodig.",
                           "You need internet for updates and the Store."))
        kaart = Kaart(marge=22, ruimte=16, richting="h")
        self.chip_icoon = IcoonChip("lijn:wifi", "neutraal", 52, vol=False)
        kaart.lay.addWidget(self.chip_icoon)
        blok = QVBoxLayout()
        blok.setSpacing(4)
        self.kop = label("", "kop2")
        self.sub = label("", "klein")
        blok.addWidget(self.kop)
        blok.addWidget(self.sub)
        kaart.lay.addLayout(blok, 1)
        self.status = Chip("", "grijs")
        kaart.lay.addWidget(self.status)
        self.lay.addWidget(kaart)
        rij = QHBoxLayout()
        kies = Knop(t("Wifi kiezen", "Choose Wi-Fi"), "hoofd", "lijn:wifi", groot=True)
        kies.clicked.connect(lambda: start("bugos-settings", "wifi"))   # de eenvoudige wifi-pagina van BugOS (U334)
        opnieuw = Knop(t("Opnieuw kijken", "Check again"), "stil", "lijn:verversen")
        opnieuw.clicked.connect(self.ververs)
        rij.addWidget(kies)
        rij.addWidget(opnieuw)
        rij.addStretch(1)
        self.lay.addLayout(rij)
        self.klaar_met_vullen()
        self.kijker: Kijker | None = None
        self.toon(False)
        # Alleen kijken zolang deze pagina te zien is (niet elke 4 seconden nmcli op de andere pagina's).
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.ververs)

    def showEvent(self, e) -> None:  # noqa: N802
        super().showEvent(e)
        self.ververs()
        self.timer.start(4000)

    def hideEvent(self, e) -> None:  # noqa: N802
        self.timer.stop()
        if not self.window().isVisible() and self.kijker is not None:
            self.kijker.wait(8000)  # het venster gaat dicht: laat het kijken eerst afmaken
        super().hideEvent(e)

    def ververs(self) -> None:
        if self.kijker is not None and self.kijker.isRunning():
            return
        self.kijker = Kijker(self)
        self.kijker.klaar.connect(self.toon)
        self.kijker.start()

    def toon(self, online: bool) -> None:
        if online:
            self.kop.setText(t("Je bent verbonden", "You are connected"))
            self.sub.setText(t("Mooi zo. Je kunt verder.", "Great. You can continue."))
            self.status.setText(t("Online", "Online"))
            self.status.setStyleSheet(Chip("", "goed").styleSheet())
        else:
            self.kop.setText(t("Nog geen internet", "No internet yet"))
            self.sub.setText(t("Kies je wifi, of steek een netwerkkabel in. Overslaan mag ook.",
                               "Choose your Wi-Fi, or plug in a network cable. Skipping is fine too."))
            self.status.setText(t("Offline", "Offline"))
            self.status.setStyleSheet(Chip("", "let_op").styleSheet())


def voorbeeld(donker: bool, b: int = 300, h: int = 176) -> QPixmap:
    """Een klein plaatje van het bureaublad in licht of donker."""
    pm = QPixmap(QSize(b * 2, h * 2))
    pm.setDevicePixelRatio(2)
    pm.fill(QColor("#000"))
    p = QPainter(pm)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform)
    beeld = QPixmap(achtergrond_pad(donker=donker))
    if not beeld.isNull():
        p.drawPixmap(QRectF(0, 0, b, h), beeld, QRectF(0, 0, beeld.width(), beeld.height()))
    vlak = QColor("#1C1E24" if donker else "#FFFFFF")
    lijn = QColor("#3A3E48" if donker else "#E6E2E2")
    tekst = QColor("#EDEEF1" if donker else "#16171C")
    # venstertje
    p.setPen(Qt.PenStyle.NoPen)
    p.setBrush(QColor(0, 0, 0, 60))
    p.drawRoundedRect(QRectF(26, 26, 150, 98), 9, 9)
    p.setBrush(vlak)
    p.drawRoundedRect(QRectF(24, 22, 150, 98), 9, 9)
    p.setBrush(lijn)
    for i, w in enumerate((92, 120, 70)):
        p.drawRoundedRect(QRectF(38, 52 + i * 16, w, 7), 3.5, 3.5)
    p.setBrush(QColor("#DE2F3E"))
    p.drawRoundedRect(QRectF(38, 34, 46, 9), 4.5, 4.5)
    p.setBrush(tekst)
    p.drawEllipse(QRectF(150, 32, 10, 10))
    # taakbalk
    p.setBrush(QColor(28, 30, 36, 220) if donker else QColor(255, 255, 255, 220))
    p.drawRoundedRect(QRectF(8, h - 24, b - 16, 18), 7, 7)
    logo = QIcon("/usr/share/bugos/logo-dark.svg" if donker else "/usr/share/bugos/logo.svg")
    logo.paint(p, 15, h - 22, 14, 14)
    p.setBrush(lijn)
    for i in range(3):
        p.drawRoundedRect(QRectF(36 + i * 18, h - 20, 12, 10), 3, 3)
    p.end()
    return ronde_pixmap(pm, 24)


class Uiterlijk(Pagina):
    def __init__(self):
        super().__init__(t("Licht of donker?", "Light or dark?"),
                         t("Kies wat jij fijn vindt om naar te kijken.", "Choose what you like to look at."))
        rij = QHBoxLayout()
        rij.setSpacing(18)
        self.groep = QButtonGroup(self)
        self.knoppen = {}
        for donker, naam in ((False, t("Licht", "Light")), (True, t("Donker", "Dark"))):
            binnen = QWidget()
            b = QVBoxLayout(binnen)
            b.setContentsMargins(0, 0, 0, 0)
            b.setSpacing(12)
            plaat = QLabel()
            plaat.setPixmap(voorbeeld(donker))
            b.addWidget(plaat)
            b.addWidget(label(naam, "kop3"))
            k = KeuzeKaart(binnen)
            k.clicked.connect(lambda _=False, d=donker: self.kies(d))
            self.groep.addButton(k)
            self.knoppen[donker] = k
            rij.addWidget(k)
        rij.addStretch(1)
        self.lay.addLayout(rij)
        self.lay.addWidget(label(t("Tip: je kunt dit later veranderen bij Instellingen → Uiterlijk.",
                                   "Tip: you can change this later in Settings → Appearance."), "klein"))
        self.klaar_met_vullen()
        self.knoppen[bugos_ui.DONKER].setChecked(True)

    def kies(self, donker: bool) -> None:
        # Eén plek voor licht/donker: kleuren, KDE-programma's en de Plasma-stijl.
        start("bugos-theme", "donker" if donker else "licht")


class Updates(Pagina):
    def __init__(self):
        super().__init__(t("Updates", "Updates"),
                         t("Updates houden je computer veilig. Ze worden pas actief na opnieuw opstarten, "
                           "en gaat er ooit iets mis, dan ga je terug naar de vorige versie in Instellingen (of, als "
                           "hij niet meer goed start: houd bij het opstarten Shift ingedrukt of druk op Esc).",
                           "Updates keep your computer safe. They only take effect after a restart, "
                           "and if something ever goes wrong, go back to the previous version in Settings (or, if it "
                           "does not start properly: hold Shift or press Esc while it starts)."))   # (U360, U367)
        self.groep = QButtonGroup(self)
        self.auto = self._optie("lijn:vink", "neutraal", t("Vanzelf, stil op de achtergrond", "Automatically, quietly"),
                                t("BugOS houdt zichzelf bij. Jij merkt er niks van.",
                                  "BugOS keeps itself up to date. You won't notice a thing."), True)
        self.hand = self._optie("lijn:verversen", "neutraal", t("Ik kies zelf wanneer", "I choose when"),
                                t("Je krijgt een melding als er een nieuwe BugOS is. Je apps werk je bij met 'Nu updaten' in Instellingen.",
                                  "You get a notification when a new BugOS is available. Update your apps with 'Update now' "
                                  "in Settings."),
                                False)
        huidig = "auto"
        if bestaat("bugos-updates"):
            huidig = (draai("bugos-updates", "status", timeout=5)[1].strip() or "auto")
        self.begin = huidig
        (self.hand if huidig == "hand" else self.auto).setChecked(True)
        # Lukte het kiezen niet (Annuleren bij het wachtwoord)? Dan zeggen we dat hier en met een melding (U412).
        self.mislukt = label("", "klein")
        self.mislukt.hide()
        self.lay.addWidget(self.mislukt)
        self.klaar_met_vullen()

    def _optie(self, icoon: str, tint: str, kop_t: str, sub_t: str, aanbevolen: bool) -> QPushButton:
        binnen = QWidget()
        r = QHBoxLayout(binnen)
        r.setContentsMargins(6, 4, 6, 4)
        r.setSpacing(16)
        r.addWidget(IcoonChip(icoon, tint, 48, vol=False))
        b = QVBoxLayout()
        b.setSpacing(2)
        kop_rij = QHBoxLayout()
        kop_rij.setSpacing(10)
        kop_rij.addWidget(label(kop_t, "kop3", wrap=False))
        if aanbevolen:
            kop_rij.addWidget(Chip(t("Aangeraden", "Recommended"), "goed"))
        kop_rij.addStretch(1)
        b.addLayout(kop_rij)
        b.addWidget(label(sub_t, "klein"))
        r.addLayout(b, 1)
        k = KeuzeKaart(binnen)
        self.groep.addButton(k)
        self.lay.addWidget(k)
        return k

    def bij_volgende(self) -> None:
        gekozen = "hand" if self.hand.isChecked() else "auto"
        if gekozen != self.begin and not getattr(self, "bezig", False):
            # Pas onthouden als het lukte: Annuleren bij het wachtwoord, dan probeert Volgende het opnieuw (U129).
            self.bezig = True
            proces = QProcess(self)

            def klaar(code, _status, p=proces, g=gekozen) -> None:
                self.bezig = False
                if code == 0:
                    self.begin = g
                    self.mislukt.hide()
                else:
                    # Je ging al naar de volgende pagina: zeg dat de keuze niet is doorgevoerd, en zet de knop terug (U412).
                    (self.hand if self.begin == "hand" else self.auto).setChecked(True)
                    if code not in (126, 127):
                        # Geen kwestie van toestemming: bewaren lukte niet (bijv. een volle computer) (U422).
                        tekst = t("De updatekeuze kon niet bewaard worden (is je computer vol?). Kies het later opnieuw in "
                                  "Instellingen.", "The update choice could not be saved (is your computer full?). "
                                  "Choose it again later in Settings.")
                    else:
                        tekst = (t("Updates staan nog op 'vanzelf': er was geen toestemming. Ga terug naar 'Updates' om het "
                                   "opnieuw te proberen, of kies het later in Instellingen.",
                                   "Updates are still automatic: permission was not given. Go back to 'Updates' to try "
                                   "again, or choose it later in Settings.") if self.begin != "hand" else
                                 t("Updates staan nog op 'ik kies zelf': er was geen toestemming. Ga terug naar 'Updates' om "
                                   "het opnieuw te proberen, of kies het later in Instellingen.",
                                   "Updates are still 'I choose when': permission was not given. Go back to 'Updates' to "
                                   "try again, or choose it later in Settings."))
                    self.mislukt.setText(tekst)
                    self.mislukt.show()
                    QProcess.startDetached("notify-send", ["-a", "BugOS", "-i", "bugos-logo",
                                                           t("Updatekeuze niet doorgevoerd", "Update choice not saved"),
                                                           tekst])
                p.deleteLater()

            proces.finished.connect(klaar)
            proces.start("pkexec", ["/usr/bin/bugos-updates", gekozen])


class Jij(Pagina):
    def __init__(self):
        super().__init__(t("Wat ga je doen?", "What will you do?"),
                         t("Zet aan wat bij jou past. Niks aanzetten mag ook.", "Turn on what fits you. Turning on nothing is fine too."))
        g = Groep()
        self.gamer = SchakelRij(t("Ik ga gamen", "I'm going to play games"),
                                t("Steam staat in het startmenu (of komt er zo bij). Met de Game-modus speel je op volle kracht.",
                                  "Steam is in the start menu (or will be soon). Game mode gives you full power."),
                                False, "lijn:spel", "neutraal")
        self.dev = SchakelRij(t("Ik ga programmeren", "I'm going to code"),
                              t("BugOS zet VS Code, containers en programmeertalen voor je klaar.",
                                "BugOS sets up VS Code, containers and programming languages."), False, "lijn:code", "neutraal")
        self.oud = SchakelRij(t("Mijn computer is wat ouder", "My computer is a bit older"),
                              t("Zware effecten uit, zodat alles vlot blijft.", "Heavy effects off, so everything stays fast."),
                              False, "lijn:ster", "neutraal")
        for w in (self.gamer, self.dev, self.oud):
            g.voeg(w)
        self.lay.addWidget(g)
        # Wat al gestart is, gaat door (ook als je via Terug hier weer komt): elk maar één keer starten (U074).
        self.gestart: set[str] = set()
        self.al_bezig = label(t("Wat je hier aanzette, wordt al klaargezet. Uitzetten kan later in Instellingen.",
                                "What you turned on here is already being set up. You can turn it off later in Settings."),
                              "klein")
        self.al_bezig.hide()
        self.lay.addWidget(self.al_bezig)
        self.steam_nog = label(t("Steam wordt nog gedownload (of komt zodra je internet hebt). Hij staat straks in het "
                                 "startmenu.", "Steam is still being downloaded (or will be once you are online). It will "
                                 "be in the start menu soon."), "klein")
        self.steam_nog.hide()
        self.lay.addWidget(self.steam_nog)
        # Wat al aan staat (de lichte stand zet zichzelf aan op een oudere pc), staat hier ook aan (U179).
        for naam, rij, script in (("oud", self.oud, "bugos-light-mode"), ("dev", self.dev, "bugos-developer")):
            try:
                if subprocess.run([script, "status"], capture_output=True, text=True,
                                  timeout=5).stdout.strip() == "aan":
                    rij.schuif.setChecked(True)
                    rij.schuif.setEnabled(False)   # staat al aan: uitzetten kan in Instellingen (U189)
                    self.gestart.add(naam)
                    self.al_bezig.show()
            except (OSError, subprocess.SubprocessError):
                pass
        self.klaar_met_vullen()

    def bij_volgende(self) -> None:
        for naam, rij, opdracht in (("dev", self.dev, ("bugos-developer", "aan")),
                                    ("oud", self.oud, ("bugos-light-mode", "aan")),
                                    ("gamer", self.gamer, steam_opdracht()
                                     if self.gamer.schuif.isChecked() and "gamer" not in self.gestart else ())):
            if naam == "gamer" and rij.schuif.isChecked() and not opdracht and naam not in self.gestart:
                self.steam_nog.show()   # (U181)
            if naam in self.gestart or not rij.schuif.isChecked() or not opdracht:
                continue
            start(*opdracht)
            self.gestart.add(naam)
            rij.schuif.setEnabled(False)   # niet meer uit te zetten hier: het loopt al
            self.al_bezig.show()


def steam_opdracht() -> tuple:
    """Steam starten: het programma, of de Flatpak-versie (als Steam zo in BugOS kwam) (U130)."""
    if shutil.which("steam"):
        return ("steam",)
    try:
        if shutil.which("flatpak") and subprocess.run(["flatpak", "info", "com.valvesoftware.Steam"],
                                                      capture_output=True, timeout=10).returncode == 0:
            return ("flatpak", "run", "com.valvesoftware.Steam")
    except (OSError, subprocess.SubprocessError):
        pass
    return ()


