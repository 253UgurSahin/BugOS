#!/usr/bin/python3
"""BugOS Bestanden - je foto's, documenten en downloads. Simpel en mooi.

Jip-en-Janneke:
  - Links staan je vaste plekken (Thuis, Bureaublad, Documenten, Afbeeldingen,
    Muziek, Video's, Downloads), je USB-sticks en de prullenbak.
  - Rechts zie je grote tegels met een voorbeeldje van elk bestand.
    Dubbelklik om iets te openen.
  - Weggooien gaat altijd eerst naar de prullenbak. Daar zet je het terug.
  - Meer knoppen nodig? Rechtermuisknop, of "Openen in Dolphin" voor gevorderden.

Gebruik:  bugos-bestanden [map of bestand]
"""

from __future__ import annotations

import hashlib
import json
import os
import shutil
import subprocess
import sys
import urllib.parse
import zipfile
from datetime import datetime
from pathlib import Path

sys.path.insert(0, "/usr/lib/bugos/python")

from bugos_ui import (  # noqa: E402
    K, Knop, Zijbalk, Zoekveld, label, lijn_icoon, lijn_pixmap, maak_app, merk_label, t, uitvoeren,
)
from PySide6.QtCore import (  # noqa: E402
    QCollator, QDir, QEvent, QMimeData, QModelIndex, QObject, QRectF, QRunnable, QSize, QSortFilterProxyModel,
    QStorageInfo, Qt, QThread, QThreadPool, QTimer, QUrl, Signal,
)
from PySide6.QtGui import (  # noqa: E402
    QColor, QDesktopServices, QFont, QFontMetrics, QImage, QImageReader, QKeySequence,
    QLinearGradient, QPainter, QPainterPath, QPen, QPixmap, QShortcut, QStandardItem, QStandardItemModel,
