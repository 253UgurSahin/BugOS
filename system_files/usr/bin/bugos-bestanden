        ll.addStretch(1)
        self.leeg_beeld = QLabel()
        self.leeg_beeld.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.leeg_kop = label("", "kop2")
        self.leeg_kop.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.leeg_sub = label("", "sub")
        self.leeg_sub.setAlignment(Qt.AlignmentFlag.AlignCenter)
        for w in (self.leeg_beeld, self.leeg_kop, self.leeg_sub):
            ll.addWidget(w)
        ll.addStretch(2)
        self.computer = QScrollArea()
        self.computer.setFrameShape(QFrame.Shape.NoFrame)
        self.computer.setWidgetResizable(True)
        self.computer.viewport().setAutoFillBackground(False)
        binnen = QWidget()
        binnen.setObjectName("computer_binnen")
        self.computer_lay = QVBoxLayout(binnen)
        self.computer_lay.setContentsMargins(4, 4, 4, 4)
        self.computer_lay.setSpacing(14)
        self.computer.setWidget(binnen)
        self.stapel = QStackedWidget()
        self.stapel.addWidget(self.lijst)
        self.stapel.addWidget(self.leeg)
        self.stapel.addWidget(self.computer)
        rechts.addWidget(self.stapel, 1)

        # zweeft onderin zodra je iets kiest
        self.keuzebalk = ActieBalk(self)
        self.keuzebalk.knop("openen", "openen", t("Openen", "Open"), self.openen)
        self.keuzebalk.knop("kopieer", "kopieer", t("Kopiëren", "Copy"), self.kopieer)
        self.keuzebalk.knop("knip", "schaar", t("Knippen", "Cut"), self.knip)
        self.keuzebalk.knop("naam", "potlood", t("Naam wijzigen", "Rename"), self.hernoem)
        self.keuzebalk.knop("weg", "prullenbak", t("Weggooien", "Delete"), self.weggooien)
        self.keuzebalk.knop("terugzetten", "terug", t("Zet terug", "Restore"), self.zet_terug)
        self.keuzebalk.klaar()
        self.keuzebalk.gesloten.connect(self.lijst.clearSelection)
        QApplication.clipboard().dataChanged.connect(self.ververs_plak)

        # sneltoetsen, net als in Windows
        for toets, actie in (
            (QKeySequence.StandardKey.Copy, self.kopieer), (QKeySequence.StandardKey.Cut, self.knip),
            (QKeySequence.StandardKey.Paste, self.plak), (QKeySequence.StandardKey.Delete, self.weggooien),
            (QKeySequence.StandardKey.Find, self.zoek.setFocus), (QKeySequence.StandardKey.Refresh, self.ververs),
            (QKeySequence("F2"), self.hernoem), (QKeySequence("Backspace"), self.terug),
            (QKeySequence("Alt+Left"), self.terug), (QKeySequence("Alt+Right"), self.vooruit),
            (QKeySequence("Alt+Up"), self.omhoog), (QKeySequence("Ctrl+Shift+N"), self.nieuwe_map),
            (QKeySequence("Ctrl+H"), self.wissel_verborgen),
        ):
            sc = QShortcut(QKeySequence(toets), self)
            sc.activated.connect(lambda f=actie: f())
        wis = QShortcut(QKeySequence("Escape"), self)
        wis.activated.connect(self.escape)

        self.vul_zijbalk()
        self.apparaten = QTimer(self)
        self.apparaten.timeout.connect(self.vul_zijbalk)
        self.apparaten.start(3000)
        self.ga_naar(start or thuis(), geschiedenis=False)
        if kies:
            QTimer.singleShot(400, lambda: self.selecteer(kies))

    # ------------------------------------------------------------ zijbalk
    def vul_zijbalk(self) -> None:
        """Vaste plekken, en daaronder 'Schijven': Deze computer, USB-sticks en andere schijven."""
        oud, lijst = self.lijst_schijven, schijven()
        self.lijst_schijven = lijst
        sleutels = ([f"plek:{p[0]}:{p[1]}" for p in plekken()]
                    + [f"{x.apparaat}|{x.naam}|{x.wortel}|{x.op_slot}" for x in lijst])
        if getattr(self, "_zijbalk_sleutels", None) == sleutels:
            return
        self._zijbalk_sleutels = sleutels
        # Stond je in een schijf die nu dicht is of eruit is gehaald? Dan terug naar Thuis.
        weg = None if self.in_prullenbak or self.in_computer else schijf_van(self.huidig, oud)
        if weg and not any(x.wortel == weg.wortel for x in lijst):
            nog_er = any(x.apparaat == weg.apparaat for x in lijst)
            self.ga_naar(thuis(), geschiedenis=False)
            self.melding.toon(t(f"'{weg.naam}' is dichtgegaan.", f"'{weg.naam}' was closed.") if nog_er else
                              t(f"'{weg.naam}' is eruit gehaald.", f"'{weg.naam}' was removed."))
        self.zijbalk.clear()
        for sleutel, naam, ic, _pad in plekken():
            self.zijbalk.voeg_toe(f"lijn:{ic}", naam, f"plek:{sleutel}")
        self.zijbalk.voeg_kop(t("Schijven", "Drives"))
        self.zijbalk.voeg_toe("lijn:laptop", t("Deze computer", "This computer"), "computer")
        for x in lijst:
            item = self.zijbalk.voeg_toe(f"lijn:{'slot' if x.op_slot else x.icoon}", x.naam, f"schijf:{x.apparaat}")
            item.setToolTip(self.schijf_uitleg(x))
        self.markeer_zijbalk()
        if self.in_computer:
            self.vul_computer()
        elif not self.in_prullenbak:
            self.bouw_pad()

    def markeer_zijbalk(self) -> None:
        self.zijbalk.clearSelection()
        self.bak_lijst.clearSelection()
        if self.in_prullenbak:
            self.bak_lijst.setCurrentRow(0)
            return
        if self.in_computer:
            self.zijbalk.kies("computer")
            return
        beste, lengte = "", -1
        for sleutel, _n, _i, pad in plekken():
            if (self.huidig == pad or zit_in(self.huidig, pad)) and len(str(pad)) > lengte:
                beste, lengte = f"plek:{sleutel}", len(str(pad))
        hier = schijf_van(self.huidig, self.lijst_schijven)
        if hier and len(hier.wortel) > lengte:
            beste = f"schijf:{hier.apparaat}"
        if beste:
            self.zijbalk.kies(beste)

    def schijf(self, apparaat: str) -> Schijf | None:
        return next((x for x in self.lijst_schijven if x.apparaat == apparaat), None)

    def zijbalk_klik(self, item) -> None:
        sleutel = item.data(Qt.ItemDataRole.UserRole) or ""
        if sleutel.startswith("plek:"):
            for s, _n, _i, pad in plekken():
                if f"plek:{s}" == sleutel:
                    pad.mkdir(parents=True, exist_ok=True)
                    self.ga_naar(pad)
        elif sleutel == "computer":
            self.open_computer()
        elif sleutel.startswith("schijf:"):
            gevonden = self.schijf(sleutel[7:])
            if gevonden:
                self.open_schijf(gevonden)

    def zijbalk_menu(self, punt) -> None:
        item = self.zijbalk.itemAt(punt)
        sleutel = (item.data(Qt.ItemDataRole.UserRole) or "") if item else ""
        gevonden = self.schijf(sleutel[7:]) if sleutel.startswith("schijf:") else None
        if gevonden is None:
            return
        self.schijf_menu(gevonden).exec(self.zijbalk.mapToGlobal(punt))

    # -------------------------------------------------------- navigeren
    def ga_naar(self, pad: Path, geschiedenis: bool = True) -> None:
        pad = Path(pad)
        if not pad.is_dir():
            self.melding.toon(t(f"De map '{pad.name}' bestaat niet (meer).", f"The folder '{pad.name}' does not exist."), "fout")
            return
        if geschiedenis and (self.in_prullenbak or self.in_computer or pad != self.huidig):
            self.terug_lijst.append(self.plek_nu())
            self.vooruit_lijst.clear()
        self.in_prullenbak = self.in_computer = False
        self.huidig = pad
        self.zoek.blockSignals(True)
        self.zoek.clear()
        self.zoek.blockSignals(False)
        self.sorteer.zet_zoek("")
        self.sorteer.wortel = str(pad)
        if self.lijst.model() is not self.sorteer:
            self.lijst.setModel(self.sorteer)
            self.lijst.selectionModel().selectionChanged.connect(lambda *_: self.ververs_staat())
        else:
            self.lijst.selectionModel().clear()  # niets uit de vorige map blijft gekozen
        bron = self.model.setRootPath(str(pad))
        self.lijst.setRootIndex(self.sorteer.mapFromSource(bron))
        self.lijst.scrollToTop()
        self.voorbeelden.vergeet()
        self.bouw_pad()
        self.markeer_zijbalk()
        self.ververs_staat()

    def plek_nu(self) -> Path:
        """Waar zijn we? (voor de terug- en vooruitknop)"""
        if self.in_prullenbak:
            return Path("::prullenbak")
        return Path("::computer") if self.in_computer else self.huidig

    def open_prullenbak(self, geschiedenis: bool = True) -> None:
        if geschiedenis and not self.in_prullenbak:
            self.terug_lijst.append(self.plek_nu())
            self.vooruit_lijst.clear()
        self.in_prullenbak, self.in_computer = True, False
        self.bak_model.clear()
        for bestand, info, herkomst in prullenbak_inhoud():
            it = QStandardItem(bestand.name)
            it.setData(str(bestand), PAD_ROL)
            it.setData(str(info), INFO_ROL)
            it.setData(str(herkomst or ""), HERKOMST_ROL)
            it.setToolTip(t(f"Kwam uit: {herkomst.parent if herkomst else '?'}", f"Came from: {herkomst.parent if herkomst else '?'}"))
            it.setEditable(False)
            self.bak_model.appendRow(it)
        self.lijst.setModel(self.bak_model)
        self.lijst.setRootIndex(QModelIndex())
        self.lijst.selectionModel().selectionChanged.connect(lambda *_: self.ververs_staat())
        self.bouw_pad()
        self.markeer_zijbalk()
        self.ververs_staat()

    def terug(self) -> None:
        if not self.terug_lijst:
            return
        vorige = self.terug_lijst.pop()
        self.vooruit_lijst.append(self.plek_nu())
        self._spring(vorige)

    def vooruit(self) -> None:
        if not self.vooruit_lijst:
            return
        volgende = self.vooruit_lijst.pop()
        self.terug_lijst.append(self.plek_nu())
        self._spring(volgende)

    def _spring(self, doel: Path) -> None:
        if str(doel) == "::prullenbak":
            self.open_prullenbak(geschiedenis=False)
        elif str(doel) == "::computer":
            self.open_computer(geschiedenis=False)
        else:
            self.ga_naar(doel, geschiedenis=False)

    def omhoog(self) -> None:
        if not self.in_prullenbak and not self.in_computer and self.huidig.parent != self.huidig:
            self.ga_naar(self.huidig.parent)

    def plek_naam(self) -> str:
        """De naam die bovenin staat: het laatste stukje van het pad, of (zonder pad) de naam in de balk.

        Er is geen aparte grote titel meer; dit is dus wat de gebruiker ziet als 'waar ben ik'."""
        if not self.pad_vak.isHidden():
            # Uit de layout lezen (niet findChildren): oude kruimels staan dan al niet meer
            # in de layout, ook al heeft Qt ze nog niet echt opgeruimd (deleteLater).
            for i in range(self.pad_lay.count() - 1, -1, -1):
                w = self.pad_lay.itemAt(i).widget()
                if isinstance(w, QPushButton):
                    return w.text()
            return ""
        return self.titel.text()

    def bouw_pad(self) -> None:
        while self.pad_lay.count():
            w = self.pad_lay.takeAt(0).widget()
            if w:
                w.deleteLater()
        in_map = not self.in_prullenbak and not self.in_computer
        self.pad_vak.setVisible(in_map)
        self.titel.setVisible(not in_map)
        self.zoek.setVisible(in_map)
        self.nieuw_knop.setVisible(in_map)
        self.ververs_plak()
        self.leeg_knop.setVisible(self.in_prullenbak)
        hier = schijf_van(self.huidig, self.lijst_schijven) if in_map else None
        self.uitwerp_knop.setVisible(bool(hier and hier.los))
        self.terug_knop.setEnabled(bool(self.terug_lijst))
        self.vooruit_knop.setEnabled(bool(self.vooruit_lijst))
        if not in_map:
            # Geen pad hier (Prullenbak, Deze computer): de naam staat dan in de balk zelf,
            # op de plek van het pad, zodat je altijd bovenin ziet waar je bent.
            titel = t("Prullenbak", "Trash") if self.in_prullenbak else t("Deze computer", "This computer")
            self.titel.setText(titel)
            self.setWindowTitle(titel)
            return
        self.setWindowTitle(f"{self.huidig.name or '/'} - {t('Bestanden', 'Files')}")
        # Van waar tellen we? Thuis, een schijf, of de hele computer.
        delen: list[tuple[str, Path]] = []
        wortel_naam, wortel = t("Computer", "Computer"), Path("/")
        if hier:
            wortel_naam, wortel = hier.naam, Path(hier.wortel)
        if wortel == Path("/") and (self.huidig == thuis() or zit_in(self.huidig, thuis())):
            wortel_naam, wortel = t("Thuis", "Home"), thuis()
        delen.append((wortel_naam, wortel))
        try:
            rest = self.huidig.resolve().relative_to(wortel.resolve()).parts
        except ValueError:
            rest = self.huidig.parts[1:]
        p = wortel
        for deel in rest:
            p = p / deel
            delen.append((deel, p))
        if len(delen) > 5:
            delen = delen[:1] + [("…", delen[-4][1])] + delen[-3:]
        for i, (naam, doel) in enumerate(delen):
            if i:
                pijl = QLabel()
                pijl.setPixmap(lijn_icoon("rechts", "tekst3", 14, gekozen=None).pixmap(14, 14))
                self.pad_lay.addWidget(pijl)
            k = QPushButton(naam)
            k.setObjectName("kruimel")
            k.setProperty("laatste", "true" if i == len(delen) - 1 else "false")
            k.setCursor(Qt.CursorShape.PointingHandCursor)
            k.clicked.connect(lambda _=False, d=doel: self.ga_naar(d))
            self.pad_lay.addWidget(k)
        self.pad_lay.addStretch(1)

    # ----------------------------------------------------------- inhoud
    def ververs_staat(self) -> None:
        if self.in_computer:
            n = len(self.lijst_schijven)
            self.status.setText(t(f"{n} aangesloten", f"{n} connected") if n else
                                t("Niets aangesloten", "Nothing connected"))
            self.stapel.setCurrentWidget(self.computer)
            self.keuzebalk.toon(0)
            self.plaats_keuzebalk()
            return
        model = self.lijst.model()
        if model is None:
            return
        aantal = model.rowCount(self.lijst.rootIndex())
        gekozen = len(self.gekozen())
        if aantal == 0:
            if self.in_prullenbak:
                ic, kop, sub = "prullenbak", t("De prullenbak is leeg", "The trash is empty"), \
                    t("Wat je weggooit, komt eerst hier. Je kunt het terugzetten.", "What you delete comes here first. You can restore it.")
            elif self.sorteer.zoek:
                ic, kop, sub = "map", t("Niks gevonden", "Nothing found"), \
                    t(f"Er staat niks met '{self.zoek.text()}' in deze map.", f"Nothing with '{self.zoek.text()}' in this folder.")
            else:
                ic, kop, sub = "map", t("Deze map is leeg", "This folder is empty"), \
                    t("Sleep er iets naartoe, of maak een nieuwe map.", "Drag something here, or make a new folder.")
            self.leeg_beeld.setPixmap(lijn_icoon(ic, "tekst3", 56, gekozen=None).pixmap(56, 56))
            self.leeg_kop.setText(kop)
            self.leeg_sub.setText(sub)
            self.stapel.setCurrentWidget(self.leeg)
        else:
            self.stapel.setCurrentWidget(self.lijst)
        woord = t("ding" if aantal == 1 else "dingen", "item" if aantal == 1 else "items")
        delen = [f"{aantal} {woord}"]
        if gekozen:
            delen.append(t(f"{gekozen} gekozen", f"{gekozen} selected"))
        if not self.in_prullenbak:
            hier = schijf_van(self.huidig, self.lijst_schijven)
            vrij = mooie_maat(hier.vrij) if hier and hier.vrij is not None else vrije_ruimte(self.huidig)
            if vrij:
                delen.append(t(f"{vrij} vrij", f"{vrij} free"))
        self.status.setText("  ·  ".join(delen))
        self.leeg_knop.setEnabled(aantal > 0)
        if self.in_prullenbak:
            knoppen = {"terugzetten"}
        else:
            knoppen = {"openen", "kopieer", "knip", "weg"} | ({"naam"} if gekozen == 1 else set())
        self.keuzebalk.toon(gekozen, knoppen)
        self.plaats_keuzebalk()

    def plaats_keuzebalk(self) -> None:
        """Midden onderin over de tegels; de tegels schuiven op zodat er niets onder verdwijnt."""
        balk = self.keuzebalk
        onder = balk.sizeHint().height() + 28 if not balk.isHidden() else 0
        if self.lijst.viewportMargins().bottom() != onder:
            self.lijst.setViewportMargins(0, 0, 0, onder)
        balk.plaats(QRect(self.stapel.mapTo(self, QPoint(0, 0)), self.stapel.size()))

    def closeEvent(self, e) -> None:  # noqa: N802
        if self.klus and self.klus.isRunning():
            # Nooit midden in het kopiëren stoppen: wacht tot het klaar is en sluit dan vanzelf.
            self.sluit_na_klus = True
            self.melding.toon(t("Even wachten: het kopiëren is nog bezig. Daarna gaat het venster vanzelf dicht.",
                                "One moment: copying is still busy. The window closes by itself afterwards."),
                              seconden=0)
            e.ignore()
            return
        self.apparaten.stop()
        self.voorbeelden.stop()
        STOP.set()
        QThreadPool.globalInstance().waitForDone(2000)
        laat_klembord_los()
        super().closeEvent(e)

    def resizeEvent(self, e) -> None:  # noqa: N802
        super().resizeEvent(e)
        if hasattr(self, "keuzebalk"):
            self.plaats_keuzebalk()

    def event(self, e) -> bool:
        if e.type() == QEvent.Type.WindowActivate:
            self.ververs_plak()  # er kan in een ander programma iets gekopieerd zijn
        return super().event(e)

    def ververs_plak(self) -> None:
        self.plak_knop.setVisible(not self.in_prullenbak and not self.in_computer and self.klembord_heeft_bestanden())

    def escape(self) -> None:
        if self.zoek.text():
            self.zoek.clear()
        else:
            self.lijst.clearSelection()

    def zoeken(self, tekst: str) -> None:
        self.sorteer.zet_zoek(tekst)
        self.ververs_staat()

    def ververs(self) -> None:
        if self.in_prullenbak:
            self.open_prullenbak(geschiedenis=False)
            return
        self.voorbeelden.vergeet()
        self.ga_naar(self.huidig, geschiedenis=False)

    def wissel_verborgen(self) -> None:
        self.verborgen = not self.verborgen
        filter_ = QDir.Filter.AllEntries | QDir.Filter.NoDotAndDotDot
        if self.verborgen:
            filter_ |= QDir.Filter.Hidden
        self.model.setFilter(filter_)

    def gekozen(self) -> list[Path]:
        sel = self.lijst.selectionModel()
        if sel is None or self.in_computer:
            return []
        return [Path(i.data(PAD_ROL)) for i in sel.selectedIndexes() if i.data(PAD_ROL)]

    def selecteer(self, pad: Path) -> None:
        if self.in_prullenbak or self.in_computer:
            return
        idx = self.sorteer.mapFromSource(self.model.index(str(pad)))
        if idx.isValid():
            self.lijst.setCurrentIndex(idx)
            self.lijst.scrollTo(idx)

    def openen(self, index=None) -> None:
        paden = [Path(index.data(PAD_ROL))] if index is not None and index.data(PAD_ROL) else self.gekozen()
        if self.in_prullenbak:
            self.melding.toon(t("Zet het eerst terug om het te openen.", "Restore it first to open it."))
            return
        for pad in paden[:10]:
            if pad.is_dir():
                self.ga_naar(pad)
                return
            QDesktopServices.openUrl(QUrl.fromLocalFile(str(pad)))

    # ----------------------------------------------------------- menu
    def menu(self, punt) -> None:
        m = QMenu(self)

        def actie(ic: str, tekst: str, doe, aan: bool = True) -> None:
            a = m.addAction(lijn_icoon(ic, "tekst", 18, gekozen=None), tekst)
            a.triggered.connect(lambda _c=False, f=doe: f())
            a.setEnabled(aan)

        index = self.lijst.indexAt(punt)
        if index.isValid() and not self.lijst.selectionModel().isSelected(index):
            self.lijst.setCurrentIndex(index)
        gekozen = self.gekozen() if index.isValid() else []
        if self.in_prullenbak:
            actie("terug", t("Zet terug", "Restore"), self.zet_terug, bool(gekozen))
            m.addSeparator()
            actie("prullenbak", t("Prullenbak leegmaken", "Empty trash"), self.leegmaken,
                  self.bak_model.rowCount() > 0)
        elif gekozen:
            actie("openen", t("Openen", "Open"), self.openen)
            m.addSeparator()
            actie("kopieer", t("Kopiëren", "Copy"), self.kopieer)
            actie("schaar", t("Knippen", "Cut"), self.knip)
            actie("potlood", t("Naam wijzigen", "Rename"), self.hernoem, len(gekozen) == 1)
            m.addSeparator()
            actie("prullenbak", t("Naar de prullenbak", "Move to trash"), self.weggooien)
            if shutil.which("dolphin"):
                m.addSeparator()
                actie("oog", t("Openen in Dolphin (voor gevorderden)", "Open in Dolphin (advanced)"), self.in_dolphin)
        else:
            actie("plak", t("Plakken", "Paste"), self.plak, self.klembord_heeft_bestanden())
            actie("map-plus", t("Nieuwe map", "New folder"), self.nieuwe_map)
            if shutil.which("dolphin"):
                m.addSeparator()
                actie("oog", t("Openen in Dolphin (voor gevorderden)", "Open in Dolphin (advanced)"), self.in_dolphin)
        m.exec(self.lijst.viewport().mapToGlobal(punt))

    def in_dolphin(self) -> None:
        subprocess.Popen(["dolphin", str(self.huidig)], start_new_session=True)

    # ------------------------------------------- kopiëren en plakken
    def _naar_klembord(self, knip: bool) -> None:
        paden = self.gekozen()
        if not paden or self.in_prullenbak:
            return
        data = QMimeData()
        data.setUrls([QUrl.fromLocalFile(str(p)) for p in paden])
        data.setData("application/x-kde-cutselection", b"1" if knip else b"0")
        regels = ["cut" if knip else "copy"] + [QUrl.fromLocalFile(str(p)).toString() for p in paden]
        data.setData("x-special/gnome-copied-files", "\n".join(regels).encode())
        zet_op_klembord(data)
        n = len(paden)
        self.melding.toon(t(f"{n} {'ding' if n == 1 else 'dingen'} {'geknipt' if knip else 'gekopieerd'}. Ga naar een map en kies Plakken.",
                            f"{n} {'item' if n == 1 else 'items'} {'cut' if knip else 'copied'}. Go to a folder and choose Paste."))

    def kopieer(self) -> None:
        self._naar_klembord(False)

    def knip(self) -> None:
        self._naar_klembord(True)

    def klembord_heeft_bestanden(self) -> bool:
        data = QApplication.clipboard().mimeData()
        return bool(data and data.hasUrls() and any(u.isLocalFile() for u in data.urls()))

    def plak(self) -> None:
        if self.in_prullenbak or self.in_computer or not self.klembord_heeft_bestanden() or \
                (self.klus and self.klus.isRunning()):
            return
        data = QApplication.clipboard().mimeData()
        bronnen = [Path(u.toLocalFile()) for u in data.urls() if u.isLocalFile() and Path(u.toLocalFile()).exists()]
        knip = bytes(data.data("application/x-kde-cutselection")).strip() == b"1" or \
            bytes(data.data("x-special/gnome-copied-files")).startswith(b"cut")
        if not bronnen:
            return
        self.klus = Klus(bronnen, self.huidig, knip)
        self.klus.voortgang.connect(lambda i, n: self.melding.toon(
            t(f"Bezig met {'verplaatsen' if knip else 'kopiëren'}: {i + 1} van {n}…", f"{'Moving' if knip else 'Copying'}: {i + 1} of {n}…"),
            seconden=0))
        self.klus.klaar.connect(lambda gelukt, fout: self._klus_klaar(gelukt, fout, knip))
        self.klus.start()

    def _klus_klaar(self, gelukt: int, fout: str, knip: bool) -> None:
        if fout:
            self.melding.toon(t(f"Niet alles lukte: {fout}", f"Not everything worked: {fout}"), "fout", seconden=12)
        else:
            self.melding.toon(t(f"Klaar: {gelukt} {'ding' if gelukt == 1 else 'dingen'} {'verplaatst' if knip else 'gekopieerd'}.",
                                f"Done: {gelukt} {'item' if gelukt == 1 else 'items'} {'moved' if knip else 'copied'}."), "goed")
        if knip:
            QApplication.clipboard().clear()
        if self.sluit_na_klus:
            QTimer.singleShot(0, self.close)

    # ------------------------------------------------------------ vragen
    def vraag_tekst(self, titel: str, vraag: str, tekst: str, ok: str = "") -> str | None:
        d = QInputDialog(self)
        d.setWindowTitle(titel)
        d.setLabelText(vraag)
        d.setTextValue(tekst)
        d.setOkButtonText(ok or t("Klaar", "OK"))
        d.setCancelButtonText(t("Annuleren", "Cancel"))
        for uitleg in d.findChildren(QLabel):
            uitleg.setWordWrap(True)  # lange uitleg netjes over een paar regels
        d.resize(460, d.sizeHint().height())
        return d.textValue().strip() if d.exec() else None

    def vraag_ja(self, titel: str, tekst: str, ja: str) -> bool:
        box = QMessageBox(self)
        box.setWindowTitle(titel)
        box.setText(tekst)
        box.setIcon(QMessageBox.Icon.Warning)
        ja_knop = box.addButton(ja, QMessageBox.ButtonRole.DestructiveRole)
        nee = box.addButton(t("Annuleren", "Cancel"), QMessageBox.ButtonRole.RejectRole)
        box.setDefaultButton(nee)
        box.exec()
        return box.clickedButton() is ja_knop

    # ------------------------------------------- naam, map, weggooien
    def hernoem(self) -> None:
        paden = self.gekozen()
        if len(paden) != 1 or self.in_prullenbak:
            return
        oud = paden[0]
        nieuw = self.vraag_tekst(t("Naam wijzigen", "Rename"), t("Nieuwe naam:", "New name:"), oud.name)
        if not nieuw or nieuw == oud.name:
            return
        if "/" in nieuw or nieuw in (".", ".."):
            self.melding.toon(t("Een naam mag geen / bevatten.", "A name cannot contain /."), "fout")
            return
        doel = oud.with_name(nieuw)
        if doel.exists():
            self.melding.toon(t(f"Er staat al iets met de naam '{nieuw}'.", f"Something named '{nieuw}' already exists."), "fout")
            return
        try:
            oud.rename(doel)
        except OSError as e:
            self.melding.toon(t(f"Naam wijzigen lukte niet: {e.strerror}", f"Rename failed: {e.strerror}"), "fout")

    def nieuwe_map(self) -> None:
        if self.in_prullenbak or self.in_computer:
            return
        naam = self.vraag_tekst(t("Nieuwe map", "New folder"), t("Naam van de map:", "Folder name:"),
                                t("Nieuwe map", "New folder"))
        if not naam:
            return
        if "/" in naam:
            self.melding.toon(t("Een naam mag geen / bevatten.", "A name cannot contain /."), "fout")
            return
        doel = vrije_naam(self.huidig / naam)
        try:
            doel.mkdir()
            QTimer.singleShot(300, lambda: self.selecteer(doel))
        except OSError as e:
            self.melding.toon(t(f"De map maken lukte niet: {e.strerror}", f"Could not make the folder: {e.strerror}"), "fout")

    def weggooien(self) -> None:
        if self.in_prullenbak:
            return
        paden = self.gekozen()
        if not paden:
            return
        ver = [p for p in paden if not zelfde_schijf(p, thuis())]
        if ver:
            if not self.vraag_ja(t("Echt weggooien?", "Really delete?"),
                                 t("Dit staat op een USB-stick of een andere schijf. Weggooien kan daar niet ongedaan "
                                   "worden. Echt weggooien?",
                                   "This is on a USB stick or another drive. Deleting there cannot be undone. "
                                   "Really delete?"),
                                 t("Weggooien", "Delete")):
                return
        weg, fout = [], ""
        for p in paden:
            try:
                if p in ver:
                    if p.is_dir() and not p.is_symlink():
                        shutil.rmtree(p)
                    else:
                        p.unlink()
                else:
                    weg.append(naar_prullenbak(p))
            except OSError as e:
                fout = e.strerror or str(e)
        self.laatst_weg = weg
        if fout:
            self.melding.toon(t(f"Niet alles kon weg: {fout}", f"Not everything could be deleted: {fout}"), "fout")
        elif weg:
            n = len(weg)
            self.melding.toon(t(f"{n} {'ding' if n == 1 else 'dingen'} naar de prullenbak.", f"{n} {'item' if n == 1 else 'items'} moved to the trash."),
                              knop=t("Ongedaan maken", "Undo"), actie=self.ongedaan, seconden=10)

    def ongedaan(self) -> None:
        mislukt = 0
        for bestand, info in self.laatst_weg:
            try:
                terugzetten(bestand, info)
            except OSError:
                mislukt += 1
        self.laatst_weg = []
        if mislukt:
            self.melding.toon(t(f"{mislukt} {'ding kon' if mislukt == 1 else 'dingen konden'} niet terug. "
                                "Kijk in de prullenbak.",
                                f"{mislukt} {'item' if mislukt == 1 else 'items'} could not be restored. "
                                "Look in the trash."), "fout")
        else:
            self.melding.toon(t("Teruggezet.", "Restored."), "goed")

    # ------------------------------------------------------ prullenbak
    def zet_terug(self) -> None:
        if not self.in_prullenbak:
            return
        sel = self.lijst.selectionModel().selectedIndexes()
        n = mislukt = 0
        for i in sel:
            try:
                terugzetten(Path(i.data(PAD_ROL)), Path(i.data(INFO_ROL)))
                n += 1
            except OSError:
                mislukt += 1
        self.open_prullenbak(geschiedenis=False)
        if mislukt:
            self.melding.toon(t(f"{n} teruggezet, {mislukt} {'lukte' if mislukt == 1 else 'lukten'} niet "
                                "(is de plek waar het stond er nog, en mag je daar schrijven?).",
                                f"{n} restored, {mislukt} could not be restored "
                                "(does the original place still exist, and may you write there?)."), "fout")
        elif n:
            self.melding.toon(t(f"{n} {'ding' if n == 1 else 'dingen'} teruggezet.", f"{n} {'item' if n == 1 else 'items'} restored."), "goed")

    def leegmaken(self) -> None:
        if self.vraag_ja(t("Prullenbak leegmaken?", "Empty the trash?"),
                         t("Alles in de prullenbak wordt echt weggegooid. Dit kan niet ongedaan worden.",
                           "Everything in the trash will be deleted for good. This cannot be undone."),
                         t("Leegmaken", "Empty")):
            mislukt = prullenbak_legen()
            self.open_prullenbak(geschiedenis=False)
            if mislukt:
                self.melding.toon(t(f"{mislukt} {'ding kon' if mislukt == 1 else 'dingen konden'} niet weg. "
                                    "Ze staan nog in de prullenbak.",
                                    f"{mislukt} {'item' if mislukt == 1 else 'items'} could not be deleted. "
                                    "They are still in the trash."), "fout")
            else:
                self.melding.toon(t("De prullenbak is leeg.", "The trash is empty."), "goed")

    # --------------------------------------------- schijven en USB-sticks
    def schijf_uitleg(self, x: Schijf) -> str:
        """Een zin over een schijf, voor de uitleg en de tooltip."""
        if x.nieuw:
            return t("Nog niet in gebruik. Klik op 'In gebruik nemen' om hem klaar te maken.",
                     "Not in use yet. Click 'Set up' to get it ready.")
        maat = f"{mooie_maat(x.grootte)} · " if x.grootte else ""
        if x.op_slot:
            return maat + t("Op slot. Klik erop, dan vraagt BugOS om het wachtwoord.",
                            "Locked. Click it and BugOS asks for the password.")
        if not x.wortel:
            return maat + t("Nog dicht. Klik om te openen.", "Closed. Click to open.")
        if x.vrij is not None and x.grootte:
            return t(f"{mooie_maat(x.vrij)} vrij van {mooie_maat(x.grootte)}",
                     f"{mooie_maat(x.vrij)} free of {mooie_maat(x.grootte)}")
        return t("Open", "Open")

    def open_computer(self, geschiedenis: bool = True) -> None:
        """De pagina 'Deze computer': al je schijven, en hoeveel ruimte er nog is (zoals 'Deze pc' in Windows)."""
        if geschiedenis and not self.in_computer:
            self.terug_lijst.append(self.plek_nu())
            self.vooruit_lijst.clear()
        if self.lijst.selectionModel() is not None:
            self.lijst.selectionModel().clear()
        self.in_computer, self.in_prullenbak = True, False
        self.vul_computer()
        self.bouw_pad()
        self.markeer_zijbalk()
        self.ververs_staat()

    def vul_computer(self) -> None:
        """Bovenaan: hoeveel ruimte je computer nog heeft. Daaronder: USB-sticks en andere schijven."""
        lay = self.computer_lay
        while lay.count():
            item = lay.takeAt(0)
            if item.widget():
                item.widget().deleteLater()
            elif item.layout():
                while item.layout().count():
                    w = item.layout().takeAt(0).widget()
                    if w:
                        w.deleteLater()

        # --- de computer zelf: groot getal, balk, en wat de ruimte inneemt
        totaal, vrij = eigen_ruimte()
        nep = voorbeeld_ruimte()
        if nep and self.ruimte is None:
            self.ruimte = dict(zip([sl for sl, _k in RUIMTE_SOORTEN], nep[2:]))
            self.ruimte_tijd = time.monotonic()
        kaart = QFrame()
        kaart.setObjectName("kaart")
        binnen = QVBoxLayout(kaart)
        binnen.setContentsMargins(26, 22, 26, 20)
        binnen.setSpacing(0)
        regel = QHBoxLayout()
        regel.setSpacing(12)
        regel.addWidget(label(t(f"{mooie_maat(vrij)} vrij", f"{mooie_maat(vrij)} free"), "groot", wrap=False),
                        0, Qt.AlignmentFlag.AlignBottom)
        van = label(t(f"van de {mooie_maat(totaal)}", f"of {mooie_maat(totaal)}"), "sub", wrap=False)
        van.setContentsMargins(0, 0, 0, 9)
        regel.addWidget(van, 0, Qt.AlignmentFlag.AlignBottom)
        regel.addStretch(1)
        ruimte_knop = Knop(t("Ruimte maken", "Free up space"), "gewoon")
        ruimte_knop.setMinimumHeight(38)
        ruimte_knop.clicked.connect(lambda _c=False, k=ruimte_knop: self.ruimte_menu().exec(
            k.mapToGlobal(k.rect().bottomLeft())))
        regel.addWidget(ruimte_knop, 0, Qt.AlignmentFlag.AlignTop)
        binnen.addLayout(regel)
        binnen.addSpacing(14)
        self.ruimte_balk = RuimteBalk()
        binnen.addWidget(self.ruimte_balk)
        binnen.addSpacing(8)
        self.legenda = QGridLayout()
        self.legenda.setHorizontalSpacing(4)
        self.legenda.setVerticalSpacing(0)
        binnen.addLayout(self.legenda)
        lay.addWidget(kaart)
        self.ruimte_totaal, self.ruimte_vrij = totaal, vrij
        self.toon_ruimte()
        if not self.tellen_bezig and (self.ruimte is None or time.monotonic() - self.ruimte_tijd > 120):
            self.tellen_bezig = True
            mappen = [(sl, pad) for sl, _n, _i, pad in plekken() if sl in dict(RUIMTE_SOORTEN)]
            mappen.append(("prullenbak", prullenbak() / "files"))
            QThreadPool.globalInstance().start(Teller(mappen, self.telsein))

        # --- USB-sticks en schijven: een gewone lijst
        lay.addSpacing(10)
        lay.addWidget(sectie(t("USB-sticks en schijven", "USB sticks and drives")))
        lijst_kaart = QFrame()
        lijst_kaart.setObjectName("kaart")
        rijen = QVBoxLayout(lijst_kaart)
        rijen.setContentsMargins(6, 6, 6, 6)
        rijen.setSpacing(2)
        for i, x in enumerate(self.lijst_schijven):
            if i:
                streep = lijn()
                streep.setContentsMargins(50, 0, 10, 0)
                rijen.addWidget(streep)
            rijen.addWidget(self.schijf_rij(x))
        if not self.lijst_schijven:
            rijen.addWidget(SchijfRij("usb", t("Nog niets aangesloten", "Nothing plugged in yet"),
                                      t("Steek een USB-stick in, dan staat hij hier.",
                                        "Plug in a USB stick and it shows up here."), leeg=True))
        lay.addWidget(lijst_kaart)
        if shutil.which("partitionmanager"):
            beheer = Knop(t("Schijfbeheer (voor gevorderden)", "Disk management (advanced)"), "stil", "lijn:opslag")
            beheer.setToolTip(t("Schijven indelen en formatteren, zoals Schijfbeheer in Windows",
                                "Partition and format drives, like Disk Management in Windows"))
            beheer.clicked.connect(lambda _c=False: subprocess.Popen(["partitionmanager"], start_new_session=True))
            lay.addWidget(beheer, 0, Qt.AlignmentFlag.AlignRight)
        lay.addStretch(1)

    def schijf_rij(self, x: Schijf) -> SchijfRij:
        """Eén regel: open = hoeveel vrij + 'Veilig verwijderen'; dicht of op slot = 'Openen'."""
        if x.wortel:
            gebruikt = 1 - x.vrij / x.grootte if x.vrij is not None and x.grootte else None
            uitleg = self.schijf_uitleg(x)
            rij = SchijfRij(x.icoon, x.naam, uitleg, gebruikt, uitwerpen=x.los)
            if rij.knop is not None:
                rij.knop.clicked.connect(lambda _c=False, g=x: self.uitwerpen(g.station))
        elif x.nieuw:
            rij = SchijfRij(x.icoon, x.naam, t("Nog niet in gebruik", "Not in use yet"), None,
                            t("In gebruik nemen", "Set up"), soort_knop="hoofd")
            rij.knop.clicked.connect(lambda _c=False, g=x: self.neem_in_gebruik(g))
        else:
            uitleg = (t("Op slot · klik om te openen", "Locked · click to open") if x.op_slot
                      else t("Nog dicht · klik om te openen", "Closed · click to open"))
            if x.grootte:
                uitleg = f"{mooie_maat(x.grootte)} · " + uitleg
            rij = SchijfRij("slot" if x.op_slot else x.icoon, x.naam, uitleg, None)
        rij.setToolTip(self.schijf_uitleg(x))
        rij.geklikt.connect(lambda g=x: self.open_schijf(g))
        rij.meer.clicked.connect(lambda _c=False, g=x, k=rij.meer: self.schijf_menu(g).exec(
            k.mapToGlobal(k.rect().bottomLeft())))
        rij.setContextMenuPolicy(Qt.ContextMenuPolicy.CustomContextMenu)
        rij.customContextMenuRequested.connect(lambda punt, g=x, r=rij: self.schijf_menu(g).exec(r.mapToGlobal(punt)))
        return rij

    def schijf_menu(self, x: Schijf) -> QMenu:
        """Alles wat je met een stick of schijf kunt doen, in één rustig menu."""
        m = QMenu(self)

        def actie(ic: str, tekst: str, doe, aan: bool = True, kleur_: str = "tekst") -> None:
            a = m.addAction(lijn_icoon(ic, kleur_, 18, gekozen=None), tekst)
            a.triggered.connect(lambda _c=False, f=doe: f())
            a.setEnabled(aan)

        vrij_spel = x.apparaat not in self.bezig and x.station not in self.bezig
        if x.nieuw:
            actie("vink", t("In gebruik nemen…", "Set up…"), lambda: self.neem_in_gebruik(x), vrij_spel)
            if x.los:
                m.addSeparator()
                actie("uitwerpen", t("Veilig verwijderen", "Safely remove"), lambda: self.uitwerpen(x.station),
                      vrij_spel)
            return m
        actie("openen", t("Openen", "Open"), lambda: self.open_schijf(x), vrij_spel)
        if x.soort != "cd":
            m.addSeparator()
            actie("potlood", t("Naam wijzigen…", "Rename…"), lambda: self.hernoem_schijf(x),
                  vrij_spel and not x.op_slot and x.fs in MAX_NAAM)
            actie("vink", t("Controleren en repareren", "Check and repair"), lambda: self.repareer_schijf(x),
                  vrij_spel and not x.op_slot)
            # Alleen voor schijven die je eruit kunt halen: nooit per ongeluk de Windows-schijf of een
            # andere interne schijf wissen (daarvoor is Schijfbeheer, voor gevorderden).
            if x.los:
                actie("prullenbak", t("Leegmaken (alles wissen)…", "Erase (delete everything)…"),
                      lambda: self.leegmaak_schijf(x), vrij_spel, "fout")
        if x.los:
            m.addSeparator()
            actie("uitwerpen", t("Veilig verwijderen", "Safely remove"), lambda: self.uitwerpen(x.station), vrij_spel)
        return m

    def beheer(self, x: Schijf, stappen: list[list[str]], bezig: str, gelukt: str, mislukt: str) -> None:
        """Voer een beheer-klus uit op de achtergrond, met een melding voor en na."""
        if x.apparaat in self.bezig:
            return
        if not shutil.which("gdbus") or not shutil.which("udisksctl"):
            self.melding.toon(t("Dat kan hier niet.", "That is not possible here."), "fout")
            return
        if not self.in_prullenbak and not self.in_computer and x.wortel and zit_in(self.huidig, Path(x.wortel)):
            self.ga_naar(thuis())  # zelf niet meer 'in' de schijf staan
        self.bezig.add(x.apparaat)
        self.melding.toon(bezig, seconden=0)

        def klaar(ok: bool, _uitvoer: str) -> None:
            self.bezig.discard(x.apparaat)
            self._zijbalk_sleutels = None
            self.vul_zijbalk()
            self.melding.toon(gelukt if ok else mislukt, "goed" if ok else "fout", seconden=10)

        self.draai(stappen, klaar)

    def hernoem_schijf(self, x: Schijf) -> None:
        maximum = MAX_NAAM.get(x.fs, 15)
        naam = self.vraag_tekst(t("Naam wijzigen", "Rename"),
                                t(f"Nieuwe naam voor '{x.naam}' (hoogstens {maximum} tekens):",
                                  f"New name for '{x.naam}' (at most {maximum} characters):"), x.naam)
        if not naam or naam == x.naam:
            return
        if len(naam) > maximum or "/" in naam:
            self.melding.toon(t(f"Die naam is te lang of heeft een /. Hoogstens {maximum} tekens.",
                                f"That name is too long or has a /. At most {maximum} characters."), "fout")
            return
        self.beheer(x, hernoem_stappen(x, naam), t(f"Naam wijzigen naar '{naam}'…", f"Renaming to '{naam}'…"),
                    t(f"De naam is nu '{naam}'.", f"The name is now '{naam}'."),
                    t("Naam wijzigen lukte niet. Probeer het nog eens.", "Renaming did not work. Try again."))

    def repareer_schijf(self, x: Schijf) -> None:
        self.beheer(x, repareer_stappen(x),
                    t(f"'{x.naam}' controleren en repareren… Haal hem er niet uit.",
                      f"Checking and repairing '{x.naam}'… Do not unplug it."),
                    t(f"Klaar: '{x.naam}' is gecontroleerd en zo nodig gerepareerd.",
                      f"Done: '{x.naam}' was checked and repaired where needed."),
                    t(f"Repareren lukte niet. Zet de bestanden van '{x.naam}' veilig en maak hem daarna leeg.",
                      f"Repair did not work. Save the files from '{x.naam}' and erase it afterwards."))

    def leegmaak_schijf(self, x: Schijf) -> None:
        if not self.vraag_ja(t("Alles wissen?", "Erase everything?"),
                             t(f"Alles op '{x.naam}' wordt gewist. Dit kan niet ongedaan worden.\n\n"
                               "Daarna is hij leeg en werkt hij op elke computer (ook Windows en Mac).",
                               f"Everything on '{x.naam}' will be erased. This cannot be undone.\n\n"
                               "Afterwards it is empty and works on any computer (Windows and Mac too)."),
                             t("Alles wissen", "Erase everything")):
            return
        # Zit precies dezelfde schijf er nog in? (Er kan intussen een andere stick in zitten.)
        nu = next((s for s in schijven() if s.apparaat == x.apparaat), None)
        if not x.los or nu is None or (nu.station, nu.grootte, nu.naam, nu.udisks_deel) != (
                x.station, x.grootte, x.naam, x.udisks_deel):
            self.melding.toon(t(f"'{x.naam}' zit er niet meer in. Er is niets gewist.",
                                f"'{x.naam}' is no longer there. Nothing was erased."), "fout")
            self._zijbalk_sleutels = None
            self.vul_zijbalk()
            return
        naam = x.naam if len(x.naam) <= 15 and "(" not in x.naam else t("USB-stick", "USB stick")
        self.beheer(x, leegmaak_stappen(x, naam),
                    t(f"'{x.naam}' leegmaken… Haal hem er niet uit.", f"Erasing '{x.naam}'… Do not unplug it."),
                    t(f"Klaar: '{naam}' is leeg.", f"Done: '{naam}' is empty."),
                    t("Leegmaken lukte niet. Haal de stick eruit, steek hem er opnieuw in en probeer het nog eens.",
                      "Erasing did not work. Unplug the stick, plug it in again and try again."))

    def neem_in_gebruik(self, x: Schijf) -> None:
        """Een nieuwe, lege schijf klaarmaken (zoals Schijfbeheer in Windows), met één vraag: de naam."""
        standaard = t("USB-stick", "USB stick") if x.soort == "stick" else t("Opslag", "Storage")
        maximum = 15 if x.los else 16
        naam = self.vraag_tekst(
            t("In gebruik nemen", "Set up"),
            t(f"BugOS maakt '{x.naam}' klaar, zodat je er bestanden op kunt zetten. Er staat nog niets op.\n\n"
              f"Hoe moet hij heten? (hoogstens {maximum} tekens)",
              f"BugOS gets '{x.naam}' ready so you can put files on it. There is nothing on it yet.\n\n"
              f"What should it be called? (at most {maximum} characters)"), standaard,
            ok=t("In gebruik nemen", "Set up"))
        if not naam:
            return
        if len(naam) > maximum or "/" in naam:
            self.melding.toon(t(f"Die naam is te lang of heeft een /. Hoogstens {maximum} tekens.",
                                f"That name is too long or has a /. At most {maximum} characters."), "fout")
            return
        self.beheer(x, klaarmaak_stappen(x, naam),
                    t(f"'{naam}' klaarmaken… Dit duurt even.", f"Getting '{naam}' ready… This takes a moment."),
                    t(f"Klaar: '{naam}' staat nu links bij Schijven en is er voortaan altijd.",
                      f"Done: '{naam}' is now listed under Drives and will always be there."),
                    t("Klaarmaken lukte niet. Probeer het nog eens, of vraag hulp.",
                      "Setting up did not work. Try again, or ask for help."))

    def ruimte_menu(self) -> QMenu:
        """Ruimte maken: de prullenbak leegmaken, of (voor gevorderden) Schijfbeheer."""
        m = QMenu(self)
        bak = (self.ruimte or {}).get("prullenbak")
        tekst = t(f"Prullenbak leegmaken ({mooie_maat(bak)})", f"Empty the trash ({mooie_maat(bak)})") if bak else \
            t("Prullenbak leegmaken", "Empty the trash")
        a = m.addAction(lijn_icoon("prullenbak", "tekst", 18, gekozen=None), tekst)
        a.triggered.connect(lambda _c=False: self.leegmaken())
        a.setEnabled(bool(prullenbak_inhoud()))
        return m

    def toon_ruimte(self) -> None:
        """Kleur de balk: Afbeeldingen, Video's, ... en de rest (BugOS en apps). Wat over is, is vrij."""
        totaal, vrij = self.ruimte_totaal, self.ruimte_vrij
        if totaal <= 0:
            return
        gebruikt = max(totaal - vrij, 0)
        while self.legenda.count():
            w = self.legenda.takeAt(0).widget()
            if w:
                w.deleteLater()
        namen = {sl: (naam, pad) for sl, naam, _i, pad in plekken()}
        delen: list[tuple[float, QColor]] = []
        items: list[tuple[QColor, str, Path | None]] = []
        if self.ruimte:
            som = sum(v for k, v in self.ruimte.items() if k in dict(RUIMTE_SOORTEN))
            schaal = min(1.0, gebruikt / som) if som else 1.0
            for sl, kl in RUIMTE_SOORTEN:
                grootte = self.ruimte.get(sl, 0) * schaal
                if grootte < max(totaal * 0.002, 50 * 10**6):
                    continue  # te klein om te zien: telt mee bij de rest
                kleur_ = QColor(K["accent"] if kl == "accent" else kl)
                delen.append((grootte / totaal, kleur_))
                items.append((kleur_, f"{namen[sl][0]}  {mooie_maat(grootte)}", namen[sl][1]))
            rest = max(gebruikt - sum(d * totaal for d, _k in delen), 0)
            grijs = QColor(K["tekst3"])
            delen.append((rest / totaal, grijs))
            items.append((grijs, t(f"BugOS en apps  {mooie_maat(rest)}", f"BugOS and apps  {mooie_maat(rest)}"), None))
        else:
            grijs = QColor(K["tekst3"])
            delen.append((gebruikt / totaal, grijs))
            items.append((grijs, t(f"In gebruik  {mooie_maat(gebruikt)}  (bezig met tellen…)",
                                   f"In use  {mooie_maat(gebruikt)}  (counting…)"), None))
        self.ruimte_balk.zet(delen)
        kolommen = 3 if len(items) > 4 else max(len(items), 1)
        for i, (kleur_, tekst, pad) in enumerate(items):
            k = QPushButton(tekst)
            k.setObjectName("legenda")
            k.setIcon(stip_icoon(kleur_, hol=pad == "vrij"))
            k.setIconSize(QSize(12, 12))
            if isinstance(pad, Path):
                k.setCursor(Qt.CursorShape.PointingHandCursor)
                k.setToolTip(t(f"Open {pad.name}", f"Open {pad.name}"))
                k.clicked.connect(lambda _c=False, d=pad: self.ga_naar(d))
            else:
                k.setEnabled(False)
            self.legenda.addWidget(k, i // kolommen, i % kolommen)

    def _geteld(self, uitslag: dict) -> None:
        self.tellen_bezig = False
        self.ruimte, self.ruimte_tijd = uitslag, time.monotonic()
        if self.in_computer:
            self.toon_ruimte()

    def draai(self, stappen: list[list[str]], klaar, laatste: list[str] | None = None) -> None:
        """Voer opdrachten na elkaar uit, zonder dat het venster vastloopt (ook niet als KDE om een wachtwoord vraagt)."""
        rij = [list(x) for x in stappen]
        uitvoer: list[str] = []

        def start(opdracht: list[str], verder) -> None:
            proces = QProcess(self)
            gedaan = []

            def af(code: int, status) -> None:
                if gedaan:
                    return
                gedaan.append(True)
                uitvoer.append(bytes(proces.readAllStandardOutput()).decode(errors="ignore")
                               + bytes(proces.readAllStandardError()).decode(errors="ignore"))
                proces.deleteLater()
                verder(code == 0 and status == QProcess.ExitStatus.NormalExit)

            def fout(soort) -> None:
                if soort == QProcess.ProcessError.FailedToStart and not gedaan:
                    gedaan.append(True)
                    proces.deleteLater()
                    verder(False)

            proces.finished.connect(af)
            proces.errorOccurred.connect(fout)
            proces.start(opdracht[0], opdracht[1:])

        def volgende(ok: bool = True) -> None:
            if not ok:
                klaar(False, "".join(uitvoer))
            elif rij:
                start(rij.pop(0), volgende)
            elif laatste:
                start(laatste, lambda _ok: klaar(True, "".join(uitvoer)))
            else:
                klaar(True, "".join(uitvoer))

        volgende()

    def open_schijf(self, x: Schijf) -> None:
        if x.nieuw:
            self.neem_in_gebruik(x)
            return
        if x.wortel:
            self.ga_naar(Path(x.wortel))
            return
        if x.apparaat in self.bezig:
            return
        opdracht = openen_stappen(x)
        if not shutil.which(opdracht[0]):
            self.melding.toon(t(f"'{x.naam}' kan hier niet open. Probeer Dolphin (voor gevorderden).",
                                f"'{x.naam}' cannot be opened here. Try Dolphin (advanced)."), "fout")
            return
        self.bezig.add(x.apparaat)
        self.melding.toon(t(f"'{x.naam}' openen…", f"Opening '{x.naam}'…"), seconden=0)

        def klaar(ok: bool, uitvoer: str) -> None:
            self.bezig.discard(x.apparaat)
            self._zijbalk_sleutels = None
            self.vul_zijbalk()
            nu = self.schijf(x.apparaat)
            if nu and nu.wortel:
                self.melding.hide()
                self.ga_naar(Path(nu.wortel))
            elif ok and " at " in uitvoer:
                self.melding.hide()
                self.ga_naar(Path(uitvoer.rsplit(" at ", 1)[1].strip().rstrip(".")))
            elif x.op_slot:
                self.melding.toon(t("Openen lukte niet. Klopte het wachtwoord?",
                                    "Opening did not work. Was the password right?"), "fout")
            else:
                self.melding.toon(t(f"'{x.naam}' kon niet open. Haal hem eruit en steek hem er opnieuw in.",
                                    f"'{x.naam}' could not be opened. Unplug it and plug it in again."), "fout")

        self.draai([opdracht], klaar)

    def uitwerpen_hier(self) -> None:
        hier = schijf_van(self.huidig, self.lijst_schijven)
        if hier and hier.los:
            self.uitwerpen(hier.station)

    def uitwerpen(self, station: str) -> None:
        """Veilig verwijderen: alle delen van de stick dicht, dan de stroom eraf."""
        if station in self.bezig:
            return
        delen = [x for x in self.lijst_schijven if x.station == station]
        naam = delen[0].naam if delen else t("De schijf", "The drive")
        stappen, laatste = uitwerp_stappen(self.lijst_schijven, station)
        if not shutil.which("udisksctl"):
            self.melding.toon(t("Veilig verwijderen kan hier niet.", "Safe removal is not available here."), "fout")
            return
        if not self.in_prullenbak and not self.in_computer and any(
                x.wortel and zit_in(self.huidig, Path(x.wortel)) for x in delen):
            self.ga_naar(thuis())  # zelf niet meer 'in' de stick staan
        self.bezig.add(station)
        self.melding.toon(t(f"'{naam}' veilig verwijderen…", f"Safely removing '{naam}'…"), seconden=0)

        def klaar(ok: bool, _uitvoer: str) -> None:
            self.bezig.discard(station)
            self._zijbalk_sleutels = None
            self.vul_zijbalk()
            if ok:
                self.melding.toon(t(f"Je kunt '{naam}' er nu veilig uithalen.", f"You can now safely remove '{naam}'."),
                                  "goed")
            else:
                self.melding.toon(t(f"'{naam}' is nog bezig. Sluit wat erop openstaat en probeer het opnieuw.",
                                    f"'{naam}' is still busy. Close what is open on it and try again."), "fout")

        self.draai(stappen, klaar, laatste)


_ONS_KLEMBORD: list[QMimeData] = []  # wat wij zelf op het klembord hebben gezet


def zet_op_klembord(data: QMimeData) -> None:
    _ONS_KLEMBORD[:] = [data]
    QApplication.clipboard().setMimeData(data)


def laat_klembord_los() -> None:
    """Wat wij op het klembord zetten, ruimen we zelf op voordat het programma stopt.

    Anders ruimt Qt het pas op als Python al weg is, en dan crasht het programma bij het
    afsluiten. De klembordbeheerder van KDE heeft het al bewaard, dus plakken kan daarna nog.
    """
    klembord = QApplication.clipboard()
    if klembord is None or not _ONS_KLEMBORD:
        return
    try:
        nog_van_ons = klembord.ownsClipboard() or klembord.mimeData() is _ONS_KLEMBORD[0]
    except RuntimeError:
        nog_van_ons = False
    _ONS_KLEMBORD.clear()
    if nog_van_ons:
        klembord.clear()


def start_pad(args: list[str]) -> tuple[Path | None, Path | None]:
    """Map om te openen (en eventueel een bestand om te kiezen) uit de opdrachtregel."""
    for a in args:
        pad = Path(QUrl(a).toLocalFile()) if a.startswith("file:") else Path(a).expanduser()
        if pad.is_dir():
            return pad, None
        if pad.exists():
            return pad.parent, pad
    return None, None


def main() -> int:
    app = maak_app("bugos-bestanden", "bugos-bestanden", sys.argv)
    app.aboutToQuit.connect(laat_klembord_los)
    start, kies = start_pad(sys.argv[1:])
    venster = Bestanden(start, kies)
    if any(a.startswith("computer:") for a in sys.argv[1:]):  # bugos-bestanden computer:/
        venster.open_computer(geschiedenis=False)
    return uitvoeren(app, venster)


if __name__ == "__main__":
    sys.exit(main())
