class Melding(QFrame):
    """Een korte melding bovenin, eventueel met een knop (bijvoorbeeld 'Ongedaan maken')."""

    def __init__(self):
        super().__init__()
        self.setObjectName("melding")
        lay = QHBoxLayout(self)
        lay.setContentsMargins(16, 8, 8, 8)
        lay.setSpacing(12)
        self.tekst = label("", wrap=False)
        self.knop = Knop("", "stil")
        self.knop.setMinimumHeight(36)
        lay.addWidget(self.tekst, 1)
        lay.addWidget(self.knop)
        self.actie = None
        self.knop.clicked.connect(self._klik)
        self.klok = QTimer(self)
        self.klok.setSingleShot(True)
        self.klok.timeout.connect(self.hide)
        self.hide()

    def toon(self, tekst: str, soort: str = "info", knop: str = "", actie=None, seconden: int = 7) -> None:
        self.setProperty("soort", soort)
        self.style().unpolish(self)
        self.style().polish(self)
        self.tekst.setText(tekst)
        self.knop.setText(knop)
        self.knop.setVisible(bool(knop))
        self.actie = actie
        self.show()
        if seconden:
            self.klok.start(seconden * 1000)
        else:
            self.klok.stop()

    def _klik(self) -> None:
        actie, self.actie = self.actie, None
        self.hide()
        if actie:
            actie()


def ronde_knop(icoon_naam: str, tip: str) -> QPushButton:
    k = QPushButton()
    k.setObjectName("rond")
    k.setIcon(lijn_icoon(icoon_naam, "tekst", 20, gekozen=None))
    k.setIconSize(QSize(20, 20))
    k.setToolTip(tip)
    k.setAccessibleName(tip)
    k.setCursor(Qt.CursorShape.PointingHandCursor)
    return k


class Zoekbalk(Zoekveld):
    """Het zoekveld bovenin: liefst 240 breed, maar het mag krimpen in een smal venster."""

    def sizeHint(self) -> QSize:  # noqa: N802
        return QSize(240, super().sizeHint().height())


class Keuzebalk(QFrame):
    """Zweeft onderin zodra je iets kiest: wat kun je ermee? Knoppen met gewone woorden."""

    def __init__(self, ouder: QWidget):
        super().__init__(ouder)
        self.setObjectName("keuzebalk")
        self.lay = QHBoxLayout(self)
        self.lay.setContentsMargins(20, 7, 7, 7)
        self.lay.setSpacing(2)
        self.aantal = label("", "kop3", wrap=False)
        self.lay.addWidget(self.aantal)
        self.lay.addSpacing(10)
        streep = QFrame()
        streep.setObjectName("streep")
        streep.setFixedHeight(26)
        self.lay.addWidget(streep)
        self.lay.addSpacing(6)
        self.knoppen: dict[str, QPushButton] = {}
        self.sluit = ronde_knop("kruis", t("Niets meer kiezen", "Clear selection"))
        donker = QColor(K["achter"]).lightness() < 128
        schaduw = QGraphicsDropShadowEffect(self)
        schaduw.setBlurRadius(36)
        schaduw.setOffset(0, 10)
        schaduw.setColor(QColor(0, 0, 0, 150 if donker else 46))
        self.setGraphicsEffect(schaduw)
        self.hide()

    def knop(self, sleutel: str, icoon: str, tekst: str, actie, gevaar: bool = False) -> None:
        k = QPushButton(tekst)
        k.setObjectName("balkknop")
        k.setIcon(lijn_icoon(icoon, "fout" if gevaar else "tekst", 18, gekozen=None))
        k.setIconSize(QSize(18, 18))
        k.setCursor(Qt.CursorShape.PointingHandCursor)
        k.setProperty("gevaar", "true" if gevaar else "false")
        k.clicked.connect(lambda _c=False, f=actie: f())
        self.lay.addWidget(k)
        self.knoppen[sleutel] = k

    def klaar(self) -> None:
        """Na de laatste knop: ruimte en het kruisje om niets meer te kiezen."""
        self.lay.addSpacing(6)
        self.lay.addWidget(self.sluit)

    def toon(self, n: int, prullenbak: bool) -> None:
        if not n:
            self.hide()
            return
        self.aantal.setText(t(f"{n} gekozen", f"{n} selected"))
        for sleutel, k in self.knoppen.items():
            if prullenbak:
                k.setVisible(sleutel == "terugzetten")
            else:
                k.setVisible(sleutel != "terugzetten" and (sleutel != "naam" or n == 1))
        self.adjustSize()
        self.show()
        self.raise_()


class RuimteBalk(QWidget):
    """Eén brede balk: elk stukje kleur is een soort bestanden; het lichte deel is nog vrij."""

    def __init__(self):
        super().__init__()
        self.setFixedHeight(16)
        self.delen: list[tuple[float, QColor]] = []

    def zet(self, delen: list[tuple[float, QColor]]) -> None:
        self.delen = delen
        self.update()

    def paintEvent(self, _e) -> None:  # noqa: N802
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        r = QRectF(self.rect())
        spoor = QPainterPath()
        spoor.addRoundedRect(r, r.height() / 2, r.height() / 2)
        p.fillPath(spoor, QColor(K["knop"]))
        p.setClipPath(spoor)
        x = r.left()
        for deel, kleur_ in self.delen:
            breedte = r.width() * max(0.0, deel)
            if breedte < 0.5:
                continue
            p.fillRect(QRectF(x, r.top(), breedte, r.height()), kleur_)
            x += breedte
            p.fillRect(QRectF(x - 1, r.top(), 2, r.height()), QColor(K["vlak"]))  # een dun naadje
        p.end()


class SchijfRij(QFrame):
    """Eén regel in de lijst: icoontje, naam, hoeveel ruimte er vrij is, en één knop."""

    geklikt = Signal()

    def __init__(self, icoon_naam: str, naam: str, uitleg: str, gebruikt: float | None = None,
                 knop: str = "", knop_icoon: str = "", leeg: bool = False):
        super().__init__()
        self.setObjectName("schijfrij")
        if leeg:
            self.setProperty("leeg", "true")
        else:
            self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setMinimumHeight(60)
        lay = QHBoxLayout(self)
        lay.setContentsMargins(14, 8, 10, 8)
        lay.setSpacing(14)
        ic = QLabel()
        ic.setPixmap(lijn_icoon(icoon_naam, "tekst3" if leeg else "tekst2", 22, gekozen=None).pixmap(22, 22))
        lay.addWidget(ic)
        lay.addWidget(label(naam, "sub" if leeg else "kop3", wrap=False), 1)
        lay.addWidget(label(uitleg, "klein", wrap=False))
        self.balk = None
        if gebruikt is not None:
            balk = QProgressBar()
            balk.setObjectName("dun")
            balk.setTextVisible(False)
            balk.setRange(0, 1000)
            balk.setValue(int(max(0.0, min(1.0, gebruikt)) * 1000))
            balk.setProperty("vol", "true" if gebruikt >= 0.9 else "false")
            balk.setFixedWidth(110)
            lay.addWidget(balk)
            self.balk = balk
        self.knop = None
        if knop:
            self.knop = Knop(knop, "gewoon", f"lijn:{knop_icoon}" if knop_icoon else None)
            self.knop.setMinimumHeight(38)
            lay.addWidget(self.knop)
        self.meer = None
        if not leeg:
            self.meer = QPushButton()
            self.meer.setObjectName("rond_klein")
            self.meer.setIcon(lijn_icoon("meer", "tekst2", 20, gekozen=None))
            self.meer.setIconSize(QSize(20, 20))
            self.meer.setToolTip(t("Meer: naam wijzigen, repareren, leegmaken…", "More: rename, repair, erase…"))
            self.meer.setAccessibleName(t("Meer", "More"))
            self.meer.setCursor(Qt.CursorShape.PointingHandCursor)
            lay.addWidget(self.meer)

    @property
    def uitwerp_knop(self):
        return self.knop if self.knop is not None and self.knop.property("uitwerpen") else None

    def mouseReleaseEvent(self, e) -> None:  # noqa: N802
        if e.button() == Qt.MouseButton.LeftButton and self.rect().contains(e.position().toPoint()):
            self.geklikt.emit()
        super().mouseReleaseEvent(e)


def stip_icoon(kleur_: QColor, hol: bool = False) -> QIcon:
    """Een rond gekleurd stipje voor de uitleg bij de ruimtebalk (hol = een rondje, voor 'Vrij')."""
    beeld = QPixmap(36, 36)
    beeld.fill(Qt.GlobalColor.transparent)
    p = QPainter(beeld)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    if hol:
        p.setPen(QPen(QColor(K["tekst3"]), 4))
        p.setBrush(Qt.BrushStyle.NoBrush)
        p.drawEllipse(QRectF(8, 8, 20, 20))
    else:
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(kleur_)
        p.drawEllipse(QRectF(6, 6, 24, 24))
    p.end()
    beeld.setDevicePixelRatio(3)
    return QIcon(beeld)


