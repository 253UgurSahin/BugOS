from PySide6.QtWidgets import (  # noqa: E402
    QAbstractItemView, QApplication, QFileSystemModel, QFrame, QGraphicsDropShadowEffect, QHBoxLayout, QInputDialog,
    QLabel, QListView, QMenu, QMessageBox, QPushButton, QStackedWidget, QStyle, QStyledItemDelegate, QVBoxLayout,
    QWidget,
)

PAD_ROL = int(Qt.ItemDataRole.UserRole) + 1        # = QFileSystemModel.FilePathRole
INFO_ROL = int(Qt.ItemDataRole.UserRole) + 40     # prullenbak: pad van het .trashinfo-bestand
HERKOMST_ROL = int(Qt.ItemDataRole.UserRole) + 41  # prullenbak: waar het vandaan kwam

AFBEELDING = {".jpg", ".jpeg", ".png", ".webp", ".gif", ".bmp", ".tif", ".tiff", ".svg", ".avif", ".heic", ".ico"}
ODF = {".odt", ".ods", ".odp", ".odg"}
SOORTEN = {  # extensie -> (kleur, teken in het papiertje)
    "pdf": ("#D3263A", "tekst"), "doc": ("#2F7BF5", "tekst"), "docx": ("#2F7BF5", "tekst"),
    "odt": ("#2F7BF5", "tekst"), "rtf": ("#2F7BF5", "tekst"), "txt": ("#6B7280", "tekst"),
    "md": ("#6B7280", "tekst"), "xls": ("#14965A", "tabel"), "xlsx": ("#14965A", "tabel"),
    "ods": ("#14965A", "tabel"), "csv": ("#14965A", "tabel"), "ppt": ("#F2711C", "tekst"),
    "pptx": ("#F2711C", "tekst"), "odp": ("#F2711C", "tekst"), "zip": ("#6B7280", "doos"),
    "7z": ("#6B7280", "doos"), "rar": ("#6B7280", "doos"), "tar": ("#6B7280", "doos"), "gz": ("#6B7280", "doos"),
    "exe": ("#8B5CF6", "doos"), "msi": ("#8B5CF6", "doos"), "iso": ("#6B7280", "doos"),
    "mp3": ("#E2457A", "muziek"), "flac": ("#E2457A", "muziek"), "ogg": ("#E2457A", "muziek"),
    "wav": ("#E2457A", "muziek"), "m4a": ("#E2457A", "muziek"), "mp4": ("#0EA5A4", "film"),
    "mkv": ("#0EA5A4", "film"), "avi": ("#0EA5A4", "film"), "mov": ("#0EA5A4", "film"), "webm": ("#0EA5A4", "film"),
}
MAP_ROOD = ("#FF6A5A", "#E5303E", "#C82434")  # licht, midden, donker (achterkant)
VERBERG_EXT = AFBEELDING | ODF | {".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".txt", ".rtf", ".md",
                                  ".csv", ".mp3", ".flac", ".ogg", ".wav", ".m4a", ".mp4", ".mkv", ".avi", ".mov", ".webm"}


def toon_naam(naam: str, is_map: bool) -> str:
    """'Recept.odt' wordt 'Recept'. Programma's en onbekende bestanden houden hun extensie (veiliger)."""
    p = Path(naam)
    if not is_map and p.suffix.lower() in VERBERG_EXT and p.stem:
        return p.stem
    return naam


# ================================================================ plekken ===

def thuis() -> Path:
    return Path.home()


def xdg_map(sleutel: str, standaard: str) -> Path:
    """Waar staat bijvoorbeeld 'Afbeeldingen'? Uit ~/.config/user-dirs.dirs (de taal van de gebruiker)."""
    bestand = Path(os.environ.get("XDG_CONFIG_HOME", thuis() / ".config")) / "user-dirs.dirs"
    try:
        for regel in bestand.read_text(encoding="utf-8").splitlines():
            if regel.startswith(f"XDG_{sleutel}_DIR="):
                waarde = regel.split("=", 1)[1].strip().strip('"').replace("$HOME", str(thuis()))
                pad = Path(waarde)
                if pad != thuis():
                    return pad
    except OSError:
        pass
    return thuis() / standaard


def plekken() -> list[tuple[str, str, str, Path]]:
    """(sleutel, naam, lijn-icoon, pad) voor de vaste plekken."""
    lijst = [("thuis", t("Thuis", "Home"), "huis", thuis())]
    for sleutel, xdg, std, nl, en, ic in (
        ("bureaublad", "DESKTOP", "Desktop", "Bureaublad", "Desktop", "computer"),
        ("documenten", "DOCUMENTS", "Documents", "Documenten", "Documents", "document"),
        ("afbeeldingen", "PICTURES", "Pictures", "Afbeeldingen", "Pictures", "foto"),
        ("muziek", "MUSIC", "Music", "Muziek", "Music", "muziek"),
        ("videos", "VIDEOS", "Videos", "Video's", "Videos", "film"),
        ("downloads", "DOWNLOAD", "Downloads", "Downloads", "Downloads", "download"),
    ):
        lijst.append((sleutel, t(nl, en), ic, xdg_map(xdg, std)))
    return lijst


def bijzondere_mappen() -> dict[str, str]:
    """Pad -> lijn-icoon, zodat 'Documenten' ook in het overzicht een eigen tekentje krijgt."""
    return {str(p): ic for sleutel, _n, ic, p in plekken() if sleutel != "thuis"}


def usb_volumes() -> list[tuple[str, str, str]]:
    """(naam, map, apparaat) van USB-sticks en losse schijven die open (aangekoppeld) zijn."""
    if os.environ.get("BUGOS_USB"):  # voor tests en schermafbeeldingen
        return [(Path(p).name, p, "") for p in os.environ["BUGOS_USB"].split(":") if Path(p).is_dir()]
    uit = []
    for v in QStorageInfo.mountedVolumes():
        wortel = v.rootPath()
        if v.isValid() and v.isReady() and wortel.startswith(("/run/media/", "/media/")):
            uit.append((v.displayName() or Path(wortel).name, wortel, bytes(v.device()).decode(errors="ignore")))
    return uit


def dichte_usb() -> list[tuple[str, str]]:
    """(naam, apparaat) van USB-sticks die er wel zijn maar nog niet open staan."""
    if os.environ.get("BUGOS_USB") is not None:
        return []
    try:
        uit = subprocess.run(["lsblk", "-J", "-o", "PATH,LABEL,SIZE,HOTPLUG,MOUNTPOINT,FSTYPE,TYPE"],
                             capture_output=True, text=True, timeout=3).stdout
        lijst = []

        def loop(apparaten: list[dict], hotplug: bool) -> None:
            for a in apparaten:
                hp = hotplug or bool(a.get("hotplug"))
                if hp and a.get("fstype") and not a.get("mountpoint") and a.get("type") == "part":
                    lijst.append((a.get("label") or t(f"USB-stick ({a.get('size')})", f"USB stick ({a.get('size')})"),
                                  a["path"]))
                loop(a.get("children") or [], hp)
        loop(json.loads(uit).get("blockdevices", []), False)
        return lijst
    except (OSError, subprocess.SubprocessError, ValueError):
        return []


def vrije_ruimte(pad: Path) -> str:
    info = QStorageInfo(str(pad))
    return mooie_maat(info.bytesAvailable()) if info.isValid() else ""


def mooie_maat(n: int | float) -> str:
    for eenheid in ("bytes", "kB", "MB", "GB", "TB"):
        if n < 1000 or eenheid == "TB":
            if eenheid == "bytes":
                return f"{int(n)} bytes"
            return f"{n:.1f} {eenheid}".replace(".", ",") if n < 10 else f"{n:.0f} {eenheid}"
        n /= 1000
    return ""


# ========================================================= veilige acties ===

def vrije_naam(doel: Path) -> Path:
    """Bestaat 'doel' al? Dan 'Naam (2).jpg', 'Naam (3).jpg', ... Nooit iets overschrijven."""
    if not doel.exists() and not doel.is_symlink():
        return doel
    stam, ext = (doel.name, "") if doel.is_dir() else (doel.stem, doel.suffix)
    i = 2
    while True:
        kandidaat = doel.with_name(f"{stam} ({i}){ext}")
        if not kandidaat.exists() and not kandidaat.is_symlink():
            return kandidaat
        i += 1


def prullenbak() -> Path:
    return Path(os.environ.get("XDG_DATA_HOME", thuis() / ".local" / "share")) / "Trash"


def zelfde_schijf(a: Path, b: Path) -> bool:
    try:
        return os.stat(a).st_dev == os.stat(b).st_dev
    except OSError:
        return False


def naar_prullenbak(pad: Path) -> tuple[Path, Path]:
    """Zet iets in de prullenbak (volgens de freedesktop-afspraak, dus ook KDE ziet het).

    Geeft (plek in de prullenbak, .trashinfo-bestand) terug, zodat het terug kan.
    """
    bak = prullenbak()
    (bak / "files").mkdir(parents=True, exist_ok=True)
    (bak / "info").mkdir(parents=True, exist_ok=True)
    naam, i = pad.name, 2
    while True:
        info = bak / "info" / f"{naam}.trashinfo"
        try:  # naam vastleggen: maak het info-bestand als eerste, alleen als het nog niet bestaat
            fd = os.open(info, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        except FileExistsError:
            naam = f"{pad.stem} ({i}){pad.suffix}" if pad.is_file() else f"{pad.name} ({i})"
            i += 1
            continue
        if (bak / "files" / naam).exists():
            os.close(fd)
            info.unlink(missing_ok=True)
            naam = f"{pad.stem} ({i}){pad.suffix}" if pad.is_file() else f"{pad.name} ({i})"
            i += 1
            continue
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write("[Trash Info]\n")
            f.write(f"Path={urllib.parse.quote(str(pad.absolute()))}\n")
            f.write(f"DeletionDate={datetime.now().strftime('%Y-%m-%dT%H:%M:%S')}\n")
        doel = bak / "files" / naam
        try:
            os.rename(pad, doel)
        except OSError:
            info.unlink(missing_ok=True)
            raise
        return doel, info


def lees_herkomst(info: Path) -> Path | None:
    try:
        for regel in info.read_text(encoding="utf-8").splitlines():
            if regel.startswith("Path="):
                return Path(urllib.parse.unquote(regel[5:].strip()))
    except OSError:
        pass
    return None


def terugzetten(bestand: Path, info: Path) -> Path:
    """Zet iets uit de prullenbak terug waar het stond (of ernaast, als daar al iets staat)."""
    herkomst = lees_herkomst(info) or (thuis() / bestand.name)
    doel = vrije_naam(herkomst)
    doel.parent.mkdir(parents=True, exist_ok=True)
    shutil.move(str(bestand), str(doel))
    info.unlink(missing_ok=True)
    return doel


def prullenbak_inhoud() -> list[tuple[Path, Path, Path | None]]:
    """(bestand, info, herkomst) van alles in de prullenbak, nieuwste eerst."""
    bak = prullenbak()
    uit = []
    for info in (bak / "info").glob("*.trashinfo"):
        bestand = bak / "files" / info.name[: -len(".trashinfo")]
        if bestand.exists() or bestand.is_symlink():
            uit.append((bestand, info, lees_herkomst(info)))
    uit.sort(key=lambda x: x[1].stat().st_mtime if x[1].exists() else 0, reverse=True)
    return uit


def prullenbak_legen() -> None:
    bak = prullenbak()
    for map_ in (bak / "files", bak / "info"):
        if not map_.is_dir():
            continue
        for p in map_.iterdir():
            if p.is_dir() and not p.is_symlink():
                shutil.rmtree(p, ignore_errors=True)
            else:
                p.unlink(missing_ok=True)


def zit_in(kind: Path, ouder: Path) -> bool:
    try:
        kind.resolve().relative_to(ouder.resolve())
        return True
    except ValueError:
        return False


def kopieer_een(bron: Path, doelmap: Path, verplaats: bool) -> Path | None:
    """Kopieer of verplaats één ding naar 'doelmap'. Nooit overschrijven; nooit een map in zichzelf."""
    if bron.is_dir() and zit_in(doelmap, bron):
        raise ValueError(t(f"'{bron.name}' kan niet in zichzelf.", f"'{bron.name}' cannot go inside itself."))
    if verplaats and bron.parent.resolve() == doelmap.resolve():
        return bron  # staat er al
    doel = vrije_naam(doelmap / bron.name)
    if verplaats:
        shutil.move(str(bron), str(doel))
    elif bron.is_dir() and not bron.is_symlink():
        shutil.copytree(bron, doel, symlinks=True)
    else:
        shutil.copy2(bron, doel, follow_symlinks=False)
    return doel


class Klus(QThread):
    """Kopiëren of verplaatsen op de achtergrond, zodat het venster niet vastloopt."""

    voortgang = Signal(int, int)
    klaar = Signal(int, str)

    def __init__(self, bronnen: list[Path], doelmap: Path, verplaats: bool):
        super().__init__()
        self.bronnen, self.doelmap, self.verplaats = bronnen, doelmap, verplaats

    def run(self) -> None:
        gelukt, fout = 0, ""
        for i, bron in enumerate(self.bronnen):
            self.voortgang.emit(i, len(self.bronnen))
            try:
                kopieer_een(bron, self.doelmap, self.verplaats)
                gelukt += 1
            except (OSError, ValueError, shutil.Error) as e:
                fout = str(e)
        self.klaar.emit(gelukt, fout)


# ============================================================ voorbeelden ===

def freedesktop_voorbeeld(pad: str) -> QImage:
    """Heeft KDE of een ander programma al een voorbeeldje gemaakt? Gebruik dat."""
    uri = QUrl.fromLocalFile(pad).toString(QUrl.ComponentFormattingOption.FullyEncoded)
    naam = hashlib.md5(uri.encode()).hexdigest() + ".png"
    cache = Path(os.environ.get("XDG_CACHE_HOME", thuis() / ".cache")) / "thumbnails"
    for maat in ("xx-large", "x-large", "large", "normal"):
        p = cache / maat / naam
        if p.exists():
            return QImage(str(p))
    return QImage()


def maak_voorbeeld(pad: str) -> QImage:
    ext = Path(pad).suffix.lower()
    if ext in AFBEELDING:
        lezer = QImageReader(pad)
        lezer.setAutoTransform(True)
        maat = lezer.size()
        if maat.isValid() and (maat.width() > 512 or maat.height() > 512):
            lezer.setScaledSize(maat.scaled(QSize(512, 512), Qt.AspectRatioMode.KeepAspectRatio))
        beeld = lezer.read()
        if not beeld.isNull():
            return beeld
    if ext in ODF:
        try:
            with zipfile.ZipFile(pad) as z:
                return QImage.fromData(z.read("Thumbnails/thumbnail.png"))
        except (OSError, KeyError, zipfile.BadZipFile):
            pass
    return freedesktop_voorbeeld(pad)


class Seinen(QObject):
    klaar = Signal(str, QImage)


class VoorbeeldTaak(QRunnable):
    def __init__(self, pad: str, seinen: Seinen):
        super().__init__()
        self.pad, self.seinen = pad, seinen

    def run(self) -> None:
        try:
            beeld = maak_voorbeeld(self.pad)
        except Exception:  # een kapot bestand mag nooit de app laten vallen
            beeld = QImage()
        try:
            self.seinen.klaar.emit(self.pad, beeld)
        except RuntimeError:  # het venster is al dicht
            pass


class Voorbeelden(QObject):
    """Voorbeeldjes laden op de achtergrond en onthouden."""

    bijgewerkt = Signal()

    def __init__(self):
        super().__init__()
        self.cache: dict[str, QPixmap | None] = {}
        self.bezig: set[str] = set()
        self.pool = QThreadPool()
        self.pool.setMaxThreadCount(2)
        self.seinen = Seinen()
        self.seinen.klaar.connect(self._klaar)
        self.tik = QTimer(self)
        self.tik.setSingleShot(True)
        self.tik.setInterval(60)
        self.tik.timeout.connect(self.bijgewerkt.emit)

    def heeft_voorbeeld(self, pad: str) -> bool:
        ext = Path(pad).suffix.lower()
        return ext in AFBEELDING or ext in ODF or ext in (".pdf", ".mp4", ".mkv", ".webm", ".mov", ".avi")

    def pixmap(self, pad: str) -> QPixmap | None:
        if pad in self.cache:
            return self.cache[pad]
        if pad not in self.bezig and self.heeft_voorbeeld(pad):
            self.bezig.add(pad)
            self.pool.start(VoorbeeldTaak(pad, self.seinen))
        return None

    def _klaar(self, pad: str, beeld: QImage) -> None:
        self.bezig.discard(pad)
        self.cache[pad] = QPixmap.fromImage(beeld) if not beeld.isNull() else None
        self.tik.start()

    def vergeet(self) -> None:
        self.cache.clear()

    def stop(self) -> None:
        self.pool.clear()
        self.pool.waitForDone(1500)


# ================================================================ tekenen ===

def teken_map(p: QPainter, r: QRectF, teken: str = "") -> None:
    """Een rode BugOS-map (met eventueel een tekentje erop, zoals bij Documenten)."""
    licht, midden, donker = (QColor(c) for c in MAP_ROOD)
    w, h = r.width(), r.height()
    straal = w * 0.085
    tab = QPainterPath()
    tab.addRoundedRect(QRectF(r.left(), r.top(), w * 0.44, h * 0.32), straal, straal)
    p.fillPath(tab, donker)
    achter = QPainterPath()
    achter.addRoundedRect(QRectF(r.left(), r.top() + h * 0.1, w, h * 0.9), straal, straal)
    p.fillPath(achter, donker)
    voor = QPainterPath()
    voor_r = QRectF(r.left(), r.top() + h * 0.24, w, h * 0.76)
    voor.addRoundedRect(voor_r, straal, straal)
    verloop = QLinearGradient(0, voor_r.top(), 0, voor_r.bottom())
    verloop.setColorAt(0, licht)
    verloop.setColorAt(1, midden)
    p.fillPath(voor, verloop)
    p.setPen(QPen(QColor(255, 255, 255, 80), 1.2))
    p.drawLine(int(voor_r.left() + straal), int(voor_r.top() + 1), int(voor_r.right() - straal), int(voor_r.top() + 1))
    if teken:
        m = h * 0.38
        dpr = p.device().devicePixelRatioF() if p.device() else 1.0
        pm = lijn_pixmap(teken, QColor(255, 255, 255, 235), int(m * dpr), 2.2)
        p.drawPixmap(QRectF(voor_r.center().x() - m / 2, voor_r.center().y() - m / 2 + h * 0.02, m, m), pm, QRectF())


def teken_papier(p: QPainter, r: QRectF, ext: str) -> None:
    """Een papiertje met een gekleurd labeltje (PDF, DOCX, ...)."""
    kleur, soort = SOORTEN.get(ext, ("#8A8F9A", "tekst"))
    w, h = r.width(), r.height()
    hoek = w * 0.26
    pad = QPainterPath()
    pad.moveTo(r.left() + 6, r.top())
    pad.lineTo(r.right() - hoek, r.top())
    pad.lineTo(r.right(), r.top() + hoek)
    pad.lineTo(r.right(), r.bottom() - 6)
    pad.quadTo(r.right(), r.bottom(), r.right() - 6, r.bottom())
    pad.lineTo(r.left() + 6, r.bottom())
    pad.quadTo(r.left(), r.bottom(), r.left(), r.bottom() - 6)
    pad.lineTo(r.left(), r.top() + 6)
    pad.quadTo(r.left(), r.top(), r.left() + 6, r.top())
    p.fillPath(pad, QColor(K["vlak"]))
    p.setPen(QPen(QColor(K["rand_sterk"]), 1))
    p.drawPath(pad)
    vouw = QPainterPath()
    vouw.moveTo(r.right() - hoek, r.top())
    vouw.lineTo(r.right() - hoek, r.top() + hoek - 4)
    vouw.quadTo(r.right() - hoek, r.top() + hoek, r.right() - hoek + 4, r.top() + hoek)
    vouw.lineTo(r.right(), r.top() + hoek)
    p.fillPath(vouw, QColor(K["knop"]))
    p.drawPath(vouw)
    dpr = p.device().devicePixelRatioF() if p.device() else 1.0
    if soort in ("muziek", "film", "doos"):
        icoon = {"muziek": "muziek", "film": "film", "doos": "map"}[soort]
        m = w * 0.46
        pm = lijn_pixmap(icoon, QColor(kleur), int(m * dpr), 2.0)
        p.drawPixmap(QRectF(r.center().x() - m / 2, r.top() + h * 0.22, m, m), pm, QRectF())
    else:
        p.setPen(QPen(QColor(K["rand_sterk"]), 2.2, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap))
        for i in range(4 if soort == "tekst" else 3):
            y = r.top() + h * (0.26 + i * 0.11)
            breed = 0.62 if i % 2 == 0 else 0.48
            if soort == "tabel":
                p.drawLine(int(r.left() + w * 0.18), int(y), int(r.left() + w * 0.82), int(y))
            else:
                p.drawLine(int(r.left() + w * 0.18), int(y), int(r.left() + w * (0.18 + breed)), int(y))
    if ext:
        f = QFont(p.font())
        f.setPixelSize(max(9, int(w * 0.17)))
        f.setWeight(QFont.Weight.Bold)
        p.setFont(f)
        tekst = ext.upper()[:4]
        fm = QFontMetrics(f)
        bw = fm.horizontalAdvance(tekst) + 10
        label_r = QRectF(r.left() + w * 0.12, r.bottom() - h * 0.3, bw, h * 0.18)
        lab = QPainterPath()
        lab.addRoundedRect(label_r, 4, 4)
        p.fillPath(lab, QColor(kleur))
        p.setPen(QColor("#FFFFFF"))
        p.drawText(label_r, Qt.AlignmentFlag.AlignCenter, tekst)


def twee_regels(fm: QFontMetrics, tekst: str, breedte: int) -> list[str]:
    """Naam over hoogstens twee regels, met ... als het niet past."""
    if fm.horizontalAdvance(tekst) <= breedte:
        return [tekst]
    woorden, eerste = tekst.split(" "), ""
    for i in range(len(woorden), 0, -1):
        poging = " ".join(woorden[:i])
        if fm.horizontalAdvance(poging) <= breedte:
            eerste = poging
            rest = " ".join(woorden[i:])
            break
    if not eerste:  # één lang woord: hard afbreken
        n = len(tekst)
        while n > 1 and fm.horizontalAdvance(tekst[:n]) > breedte:
            n -= 1
        eerste, rest = tekst[:n], tekst[n:]
    return [eerste, fm.elidedText(rest, Qt.TextElideMode.ElideMiddle, breedte)] if rest else [eerste]


class TegelTekenaar(QStyledItemDelegate):
    """Tekent elk bestand als een tegel: voorbeeldje boven, naam eronder."""

    TEGEL = QSize(148, 164)

    def __init__(self, voorbeelden: Voorbeelden, bijzonder: dict[str, str]):
        super().__init__()
        self.voorbeelden = voorbeelden
        self.bijzonder = bijzonder

    def sizeHint(self, _optie, _index) -> QSize:  # noqa: N802
        return self.TEGEL

    def paint(self, p: QPainter, optie, index) -> None:
        p.save()
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform)
        r = QRectF(optie.rect).adjusted(5, 5, -5, -5)
        gekozen = bool(optie.state & QStyle.StateFlag.State_Selected)
        boven = bool(optie.state & QStyle.StateFlag.State_MouseOver)
        if gekozen or boven:
            vak = QPainterPath()
            vak.addRoundedRect(r, 14, 14)
            p.fillPath(vak, QColor(K["accent_zacht"] if gekozen else K["knop"]))
            if gekozen:
                p.setPen(QPen(QColor(K["accent_lijn"]), 1.2))
                p.drawPath(vak)
        pad = index.data(PAD_ROL) or ""
        is_map = os.path.isdir(pad)
        plek = QRectF(r.left() + 14, r.top() + 10, r.width() - 28, 92)
        if is_map:
            m = QRectF(0, 0, 84, 66)
            m.moveCenter(plek.center())
            teken_map(p, m, self.bijzonder.get(pad, ""))
        else:
            voorbeeld = self.voorbeelden.pixmap(pad)
            if voorbeeld is not None and not voorbeeld.isNull():
                maat = voorbeeld.size().scaled(plek.size().toSize(), Qt.AspectRatioMode.KeepAspectRatio)
                doel = QRectF(0, 0, maat.width(), maat.height())
                doel.moveCenter(plek.center())
                schaduw = QPainterPath()
                schaduw.addRoundedRect(doel.translated(0, 2), 7, 7)
                p.fillPath(schaduw, QColor(0, 0, 0, 40))
                rond = QPainterPath()
                rond.addRoundedRect(doel, 7, 7)
                p.setClipPath(rond)
                p.drawPixmap(doel, voorbeeld, QRectF(voorbeeld.rect()))
                p.setClipping(False)
                p.setPen(QPen(QColor(0, 0, 0, 30), 1))
                p.drawPath(rond)
            elif Path(pad).suffix.lower() in AFBEELDING and pad in self.voorbeelden.bezig:
                wacht = QPainterPath()
                wacht.addRoundedRect(QRectF(plek.center().x() - 50, plek.center().y() - 36, 100, 72), 7, 7)
                p.fillPath(wacht, QColor(K["knop"]))
            else:
                papier = QRectF(0, 0, 62, 80)
                papier.moveCenter(plek.center())
                teken_papier(p, papier, Path(pad).suffix.lower().lstrip("."))
        naam = toon_naam(index.data(Qt.ItemDataRole.DisplayRole) or Path(pad).name, is_map)
        f = QFont(optie.font)
        f.setPixelSize(13)
        if gekozen:
            f.setWeight(QFont.Weight.DemiBold)
        p.setFont(f)
        fm = QFontMetrics(f)
        regels = twee_regels(fm, naam, int(r.width() - 16))
        p.setPen(QColor(K["tekst"]))
        y = plek.bottom() + 10
        for regel in regels:
            p.drawText(QRectF(r.left() + 8, y, r.width() - 16, fm.height()), Qt.AlignmentFlag.AlignHCenter, regel)
            y += fm.height()
        p.restore()


# ================================================================== model ===

class Sorteerder(QSortFilterProxyModel):
    """Mappen eerst, dan bestanden; 'Foto 2' voor 'Foto 10'. Zoeken binnen de open map."""

    def __init__(self):
        super().__init__()
        self.zoek = ""
        self.wortel = ""
        self.collator = QCollator()
        self.collator.setNumericMode(True)
        self.collator.setCaseSensitivity(Qt.CaseSensitivity.CaseInsensitive)

    def zet_zoek(self, tekst: str) -> None:
        if hasattr(self, "beginFilterChange"):  # Qt 6.10 en nieuwer
            self.beginFilterChange()
            self.zoek = tekst.strip().lower()
            self.endFilterChange()
        else:
            self.zoek = tekst.strip().lower()
            self.invalidateFilter()

    def filterAcceptsRow(self, rij: int, ouder: QModelIndex) -> bool:  # noqa: N802
        if not self.zoek:
            return True
        bron = self.sourceModel()
        if bron.filePath(ouder) != self.wortel:
            return True
        return self.zoek in bron.fileName(bron.index(rij, 0, ouder)).lower()

    def lessThan(self, a: QModelIndex, b: QModelIndex) -> bool:  # noqa: N802
        bron = self.sourceModel()
        map_a, map_b = bron.isDir(a), bron.isDir(b)
        if map_a != map_b:
            return map_a
        return self.collator.compare(bron.fileName(a), bron.fileName(b)) < 0


# ================================================================ venster ===

def stijl() -> str:
    return f"""
QPushButton#rond {{ min-width: 42px; max-width: 42px; min-height: 42px; max-height: 42px; border-radius: 21px;
    background: {K['knop']}; border: none; padding: 0; }}
QPushButton#rond:hover {{ background: {K['knop_hover']}; }}
QPushButton#rond:disabled {{ background: transparent; }}
QFrame#pad {{ background: {K['vlak']}; border: 1px solid {K['rand']}; border-radius: 14px; }}
QPushButton#kruimel {{ background: transparent; border: none; border-radius: 8px; padding: 6px 8px;
    font-size: 14px; color: {K['tekst2']}; }}
QPushButton#kruimel:hover {{ background: {K['knop']}; color: {K['tekst']}; }}
QPushButton#kruimel[laatste="true"] {{ color: {K['tekst']}; font-weight: 600; }}
QListView#tegels {{ background: transparent; border: none; outline: 0; }}
QFrame#melding {{ background: {K['knop']}; border-radius: 14px; }}
QFrame#melding[soort="goed"] {{ background: {K['goed_zacht']}; }}
QFrame#melding[soort="fout"] {{ background: {K['fout_zacht']}; }}
QFrame#keuzebalk {{ background: {K['vlak']}; border: 1px solid {K['rand']}; border-radius: 20px; }}
QPushButton#balkknop {{ background: transparent; border: none; border-radius: 12px; padding: 9px 14px;
    font-size: 14px; font-weight: 600; color: {K['tekst']}; }}
QPushButton#balkknop:hover {{ background: {K['knop']}; }}
QPushButton#balkknop:focus {{ background: {K['knop']}; }}
QPushButton#balkknop[gevaar="true"] {{ color: {K['fout']}; }}
QFrame#streep {{ background: {K['rand']}; min-width: 1px; max-width: 1px; border: none; }}
"""


class Melding(QFrame):
    """Een korte melding bovenin, eventueel met een knop (bijvoorbeeld 'Ongedaan maken')."""

    def __init__(self):
        super().__init__()
        self.setObjectName("melding")
        lay = QHBoxLayout(self)
        lay.setContentsMargins(16, 8, 8, 8)
        lay.setSpacing(12)
        self.tekst = label("", wrap=False)
        self.knop = Knop("", "stil")
        self.knop.setMinimumHeight(36)
        lay.addWidget(self.tekst, 1)
        lay.addWidget(self.knop)
        self.actie = None
        self.knop.clicked.connect(self._klik)
        self.klok = QTimer(self)
        self.klok.setSingleShot(True)
        self.klok.timeout.connect(self.hide)
        self.hide()

    def toon(self, tekst: str, soort: str = "info", knop: str = "", actie=None, seconden: int = 7) -> None:
        self.setProperty("soort", soort)
        self.style().unpolish(self)
        self.style().polish(self)
        self.tekst.setText(tekst)
        self.knop.setText(knop)
        self.knop.setVisible(bool(knop))
        self.actie = actie
        self.show()
        if seconden:
            self.klok.start(seconden * 1000)
        else:
            self.klok.stop()

    def _klik(self) -> None:
        actie, self.actie = self.actie, None
        self.hide()
        if actie:
            actie()


def ronde_knop(icoon_naam: str, tip: str) -> QPushButton:
    k = QPushButton()
    k.setObjectName("rond")
    k.setIcon(lijn_icoon(icoon_naam, "tekst", 20, gekozen=None))
    k.setIconSize(QSize(20, 20))
    k.setToolTip(tip)
    k.setAccessibleName(tip)
    k.setCursor(Qt.CursorShape.PointingHandCursor)
    return k


class Zoekbalk(Zoekveld):
    """Het zoekveld bovenin: liefst 240 breed, maar het mag krimpen in een smal venster."""

    def sizeHint(self) -> QSize:  # noqa: N802
        return QSize(240, super().sizeHint().height())


class Keuzebalk(QFrame):
    """Zweeft onderin zodra je iets kiest: wat kun je ermee? Knoppen met gewone woorden."""

    def __init__(self, ouder: QWidget):
        super().__init__(ouder)
        self.setObjectName("keuzebalk")
        self.lay = QHBoxLayout(self)
        self.lay.setContentsMargins(20, 7, 7, 7)
        self.lay.setSpacing(2)
        self.aantal = label("", "kop3", wrap=False)
        self.lay.addWidget(self.aantal)
        self.lay.addSpacing(10)
        streep = QFrame()
        streep.setObjectName("streep")
        streep.setFixedHeight(26)
        self.lay.addWidget(streep)
        self.lay.addSpacing(6)
        self.knoppen: dict[str, QPushButton] = {}
        self.sluit = ronde_knop("kruis", t("Niets meer kiezen", "Clear selection"))
        donker = QColor(K["achter"]).lightness() < 128
        schaduw = QGraphicsDropShadowEffect(self)
        schaduw.setBlurRadius(36)
        schaduw.setOffset(0, 10)
        schaduw.setColor(QColor(0, 0, 0, 150 if donker else 46))
        self.setGraphicsEffect(schaduw)
        self.hide()

    def knop(self, sleutel: str, icoon: str, tekst: str, actie, gevaar: bool = False) -> None:
        k = QPushButton(tekst)
        k.setObjectName("balkknop")
        k.setIcon(lijn_icoon(icoon, "fout" if gevaar else "tekst", 18, gekozen=None))
        k.setIconSize(QSize(18, 18))
        k.setCursor(Qt.CursorShape.PointingHandCursor)
        k.setProperty("gevaar", "true" if gevaar else "false")
        k.clicked.connect(lambda _c=False, f=actie: f())
        self.lay.addWidget(k)
        self.knoppen[sleutel] = k

    def klaar(self) -> None:
        """Na de laatste knop: ruimte en het kruisje om niets meer te kiezen."""
        self.lay.addSpacing(6)
        self.lay.addWidget(self.sluit)

    def toon(self, n: int, prullenbak: bool) -> None:
        if not n:
            self.hide()
            return
        self.aantal.setText(t(f"{n} gekozen", f"{n} selected"))
        for sleutel, k in self.knoppen.items():
            if prullenbak:
                k.setVisible(sleutel == "terugzetten")
            else:
                k.setVisible(sleutel != "terugzetten" and (sleutel != "naam" or n == 1))
        self.adjustSize()
        self.show()
        self.raise_()


