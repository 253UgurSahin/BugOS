#!/usr/bin/bash
# bugos-ondertekend - zet deze computer één keer over op ondertekende updates.
#
# Draait als systeemdienst (bugos-ondertekend.service), alleen als BugOS een
# openbare sleutel heeft (/etc/pki/containers/bugos.pub). Haalt deze computer
# zijn updates nog op zonder handtekening te controleren ("ostree-unverified-
# registry"), dan zetten we hem om naar dezelfde plek mét controle
# ("ostree-image-signed"). Dat wordt actief bij de volgende keer opstarten,
# net als een gewone update. Lukt het niet (geen internet, nog geen
# handtekening), dan blijft alles zoals het was en proberen we het later opnieuw.

set -u
KLAAR=/var/lib/bugos/ondertekend
SLEUTEL=/etc/pki/containers/bugos.pub

[ -s "$SLEUTEL" ] || exit 0
# Niet op het merkteken in /var vertrouwen: dat delen alle versies. Ging je na het overstappen 'terug naar de
# vorige versie', dan draait die nog zonder controle, en moet hij opnieuw overstappen (U303).
mkdir -p /var/lib/bugos

# Even wachten op internet (de dienst wacht er niet meer op bij het opstarten) (U312).
nm-online -q -t 120 >/dev/null 2>&1 || true
# Niet over een verbinding met een databundel (telefoon-hotspot): een heel BugOS is gauw een paar gigabyte. Dan
# over een half uur opnieuw kijken (Restart=on-failure) (U236, U318).
gemeten="$(busctl get-property org.freedesktop.NetworkManager /org/freedesktop/NetworkManager \
    org.freedesktop.NetworkManager Metered 2>/dev/null | cut -c 3-)"
if [ "$gemeten" = 1 ] || [ "$gemeten" = 3 ]; then
    echo "BugOS: verbinding met een databundel, overstappen op ondertekende updates later." >&2
    exit 1
fi

STATUS="$(rpm-ostree status --json 2>/dev/null)" || exit 1
REF="$(echo "$STATUS" | jq -r '.deployments[] | select(.booted) | ."container-image-reference" // empty')"
# Staat de overstap al klaar voor de volgende keer opstarten? Dan niet nog een keer.
VOLGENDE="$(echo "$STATUS" | jq -r '.deployments[0] | select(.booted | not) | ."container-image-reference" // empty')"
case "$VOLGENDE" in ostree-image-signed:*) exit 0 ;; esac
# Is er een nieuwere, al ondertekende versie waar je bewust vanaf ging ('terug')? Dan niet meteen weer overstappen:
# dat zou die nieuwere versie terugzetten. Na de volgende gewone update gebeurt het alsnog (U307).
NIEUWER_ONDERTEKEND="$(echo "$STATUS" | jq -r '(.deployments[] | select(.booted) | .timestamp // 0) as $nu
    | [.deployments[] | select((.booted | not) and ((."container-image-reference" // "") | startswith("ostree-image-signed:"))
        and ((.timestamp // 0) > $nu))] | length')"
[ "${NIEUWER_ONDERTEKEND:-0}" -gt 0 ] && exit 0

case "$REF" in
ostree-image-signed:*)
    touch "$KLAAR" # al goed
    exit 0
    ;;
ostree-unverified-registry:ghcr.io/253ugursahin/* | ostree-unverified-image:docker://ghcr.io/253ugursahin/*)
    PLEK="${REF#ostree-unverified-registry:}"
    PLEK="${PLEK#ostree-unverified-image:docker://}"
    ;;
*)
    # Een ander beeld (iemand heeft zelf iets anders gekozen, of een test): niets aan doen.
    touch "$KLAAR"
    exit 0
    ;;
esac

if rpm-ostree rebase "ostree-image-signed:docker://$PLEK"; then
    touch "$KLAAR"
    echo "BugOS: updates worden voortaan op een handtekening gecontroleerd (actief na opnieuw opstarten)."
else
    echo "BugOS: overstappen op ondertekende updates lukte nog niet; de volgende keer opnieuw." >&2
    exit 1
fi
