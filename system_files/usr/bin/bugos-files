#!/usr/bin/python3
"""BugOS Bestanden - je foto's, documenten en downloads. Simpel en mooi.

Jip-en-Janneke:
  - Links staan je vaste plekken (Thuis, Bureaublad, Documenten, Afbeeldingen,
    Muziek, Video's, Downloads), je USB-sticks en de prullenbak.
  - Rechts zie je grote tegels met een voorbeeldje van elk bestand.
    Dubbelklik om iets te openen.
  - Weggooien gaat altijd eerst naar de prullenbak. Daar zet je het terug.
  - Meer knoppen nodig? Rechtermuisknop, of "Openen in Dolphin" voor gevorderden.

Gebruik:  bugos-files [map of bestand]
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

sys.path.insert(0, "/usr/lib/bugos/python")

from bugos_ui import maak_app, uitvoeren  # noqa: E402
# Alles hieronder woont nu in /usr/lib/bugos/python/bugos_files_*.py (gesorteerd op klus).
# Ze staan hier ook, zodat bijvoorbeeld 'bestanden.kopieer_een' in de tests blijft werken.
from bugos_files_plekken import (  # noqa: E402,F401
    AFBEELDING, HERKOMST_ROL, INFO_ROL, ODF, PAD_ROL, RUIMTE_SOORTEN, SOORTEN, STOP, VERBERG_EXT, Telsein, Teller,
    bijzondere_mappen, eigen_ruimte, mapgrootte, plekken, schijf_van, thuis, toon_naam, voorbeeld_ruimte,
    vrije_ruimte, xdg_map, zit_in,
)
from bugos_files_acties import (  # noqa: E402,F401
    Klus, kopieer_een, lees_herkomst, naar_prullenbak, prullenbak, prullenbak_inhoud, prullenbak_legen, ruim_op,
    terugzetten, vrije_naam, zelfde_schijf,
)
from bugos_files_tegels import (  # noqa: E402,F401
    Seinen, Sorteerder, TegelTekenaar, VoorbeeldTaak, Voorbeelden, freedesktop_voorbeeld, maak_voorbeeld, teken_map,
    teken_papier, twee_regels,
)
from bugos_files_onderdelen import RuimteBalk, SchijfRij, Zoekbalk, stijl, stip_icoon  # noqa: E402,F401
from bugos_files_bewerken import laat_klembord_los, zet_op_klembord  # noqa: E402,F401
from bugos_files_venster import Bestanden  # noqa: E402
from PySide6.QtCore import QUrl  # noqa: E402


def start_pad(args: list[str]) -> tuple[Path | None, Path | None]:
    """Map om te openen (en eventueel een bestand om te kiezen) uit de opdrachtregel."""
    for a in args:
        pad = Path(QUrl(a).toLocalFile()) if a.startswith("file:") else Path(a).expanduser()
        # 'bugos-files Documents' vanuit een terminal: maak er een volledig pad van (anders werkt zoeken niet).
        # abspath en niet resolve: een snelkoppeling naar een map blijft gewoon zo heten.
        pad = Path(os.path.abspath(pad))
        if pad.is_dir():
            return pad, None
        if pad.exists():
            return pad.parent, pad
    return None, None


def main() -> int:
    app = maak_app("bugos-files", "bugos-files", sys.argv)
    app.aboutToQuit.connect(laat_klembord_los)
    start, kies = start_pad(sys.argv[1:])
    venster = Bestanden(start, kies)
    if any(a.startswith("computer:") for a in sys.argv[1:]):  # bugos-files computer:/
        venster.open_computer(geschiedenis=False)
    return uitvoeren(app, venster)


if __name__ == "__main__":
    sys.exit(main())
