#!/usr/bin/bash
# bugos-exe - een Windows-programma (.exe/.msi) openen met dubbelklik.
#
# Hoe werkt het (Jip-en-Janneke):
#   1. Je dubbelklikt op een .exe.
#   2. BugOS start hem via Wine (een "vertaler" van Windows naar Linux).
#   3. Werkt het niet? Dan zegt BugOS netjes wat je in plaats daarvan kunt
#      gebruiken, bijvoorbeeld LibreOffice in plaats van Word.

# shellcheck source=system_files/usr/share/bugos/lib.sh
. /usr/share/bugos/lib.sh

BESTAND="${1:-}"
if [ -z "$BESTAND" ] || [ ! -f "$BESTAND" ]; then
    fout "$(t "Ik kan dit bestand niet vinden." "I cannot find this file.")"
    exit 1
fi

NAAM="$(basename "$BESTAND")"
# De meldingen lezen \n als nieuwe regel (printf %b): een \ in de bestandsnaam moet dus dubbel.
TOON="${NAAM//\\/\\\\}"
# Een naam als "<b>…</b>" mag de tekst van de vraag niet opmaken of verbergen (kdialog leest < > als opmaak) (U251).
TOON="${TOON//</‹}"
TOON="${TOON//>/›}"
ALTERNATIEVEN=/usr/share/bugos/alternatives.txt

# Is er een beter, echt Linux-alternatief? Dan dat eerst aanbieden.
zoek_alternatief() {
    local klein
    klein="$(echo "$NAAM" | tr '[:upper:]' '[:lower:]')"
    while IFS='|' read -r woord app id; do
        case "$woord" in '#'* | '') continue ;; esac
        # Een woord dat met ^ begint, moet aan het begin van de naam staan ('^tsetup' is Telegram, maar
        # 'ChatGPTSetup.exe' niet) (U190).
        if [[ "$woord" == ^* ]]; then
            [[ "$klein" == "${woord#^}"* ]] || continue
            echo "$app|$id"
            return 0
        fi
        if [[ "$klein" == *"$woord"* ]]; then
            echo "$app|$id"
            return 0
        fi
    done <"$ALTERNATIEVEN"
    return 1
}

# Het .desktop-bestand van een app die al op deze computer staat (uit het systeem, een Flatpak of je eigen map), of
# niets. Zo zien we dat bijv. KWrite (voor Notepad++) of Firefox er al is: dan hoeft hij niet uit de Winkel (D-04).
geinstalleerde_app() {
    local map
    local IFS=:
    for map in "${XDG_DATA_HOME:-$HOME/.local/share}" ${XDG_DATA_DIRS:-/usr/local/share:/usr/share} \
        /var/lib/flatpak/exports/share "$HOME/.local/share/flatpak/exports/share"; do
        if [ -n "$map" ] && [ -f "$map/applications/$1.desktop" ]; then
            echo "$map/applications/$1.desktop"
            return 0
        fi
    done
    return 1
}

# Microsoft Office (365, 2019 en nieuwer) werkt niet goed met Wine: installeren, activeren en inloggen lopen vast.
# Dan de echte Office van Microsoft aanbieden, in de browser, als apps in het startmenu (bugos-windows). Zelfde
# herkenning als bugos_windows.is_office_installatie.
if [[ "${NAAM,,}" =~ officesetup|o365|microsoft\ ?365|office\ ?(19|20|21|24)|setup\.x(64|86)\. ]]; then
    if vraag "$(t \
        "Dit lijkt het installatieprogramma van Microsoft Office. Office werkt helaas niet goed op BugOS.\n\nWil je Word, Excel, PowerPoint, Outlook en OneDrive in je startmenu? Het is de echte Office van Microsoft, in je browser, gratis met een Microsoft-account.\n(Kies Nee om het installatieprogramma toch te proberen.)" \
        "This looks like the installer of Microsoft Office. Sadly, Office does not work well on BugOS.\n\nDo you want Word, Excel, PowerPoint, Outlook and OneDrive in your start menu? It is the real Office from Microsoft, in your browser, free with a Microsoft account.\n(Choose No to try the installer anyway.)")"; then
        bugos-windows office aan
        melding "$(t "Microsoft 365 staat in je startmenu" "Microsoft 365 is in your start menu")" \
            "$(t "Word, Excel, PowerPoint, Outlook en OneDrive. Log in met je Microsoft-account." \
                "Word, Excel, PowerPoint, Outlook and OneDrive. Sign in with your Microsoft account.")"
        exit 0
    fi
elif ALT="$(zoek_alternatief)"; then
    APP="${ALT%%|*}"
    ID="${ALT##*|}"
    if DESKTOP="$(geinstalleerde_app "$ID")"; then
        # Al op BugOS: aanbieden hem meteen te openen (gio start het .desktop-bestand, zoals Bestanden dat doet).
        if vraag "$(t \
            "BugOS heeft al $APP. Dat doet hetzelfde als dit Windows-programma, en werkt beter op BugOS.\n\nWil je $APP openen?\n(Kies Nee om de Windows-versie toch te proberen.)" \
            "BugOS already has $APP. It does the same as this Windows program, and works better on BugOS.\n\nDo you want to open $APP?\n(Choose No to try the Windows version anyway.)")"; then
            if command -v gio >/dev/null 2>&1; then
                exec gio launch "$DESKTOP"
            fi
            exec kioclient exec "$DESKTOP"
        fi
    elif vraag "$(t \
        "Dit lijkt op een programma waarvoor een betere versie voor BugOS bestaat: $APP.\n\nWil je $APP uit de BugOS Winkel halen?\n(Kies Nee om de Windows-versie toch te proberen.)" \
        "This looks like a program that has a better version for BugOS: $APP.\n\nDo you want to get $APP from the BugOS Store?\n(Choose No to try the Windows version anyway.)")"; then
        exec bugos-store "appstream://$ID"
    fi
fi

if ! command -v wine >/dev/null 2>&1; then
    fout "$(t "Windows-programma's openen is nog niet klaar op deze computer." \
        "Opening Windows programs is not set up on this computer yet.")"
    exit 1
fi

# Elke gebruiker krijgt één eigen "Windows-map" voor zijn programma's.
export WINEPREFIX="${WINEPREFIX:-$HOME/.local/share/bugos/windows}"

# Is de schijf (bijna) vol waar de Windows-map komt? Een nieuwe Windows-map is zo'n 500 MB; met minder dan 1 GB vrij
# noemen we de computer "vol". Alleen dan zeggen we dat ook: een andere fout is geen volle schijf (D-02).
# df -Pk: altijd één regel per schijf in KB (ook met een lange naam); we kijken bij de dichtstbijzijnde map die al
# bestaat, want de Windows-map zelf bestaat nog niet.
schijf_vol() {
    local map="$1" vrij
    while [ ! -d "$map" ] && [ "$map" != / ] && [ -n "$map" ]; do map="$(dirname "$map")"; done
    vrij="$(df -Pk -- "$map" 2>/dev/null | awk 'NR==2 {print $4}')"
    [[ "$vrij" =~ ^[0-9]+$ ]] && [ "$vrij" -lt 1048576 ]
}

# Windows klaarzetten zonder dat Wine zijn eigen vensters laat zien ("De Wine-configuratie wordt bijgewerkt", en
# vroeger de vraag om Mono te downloaden) (D-05). BugOS laat zelf al "Even geduld..." zien. Zonder DISPLAY en
# WAYLAND_DISPLAY kan Wine geen venster openen; Mono en Gecko komen uit de pakketten van het systeem (wine-mono,
# mingw*-wine-gecko), dus er hoeft niets gedownload of gevraagd te worden. Lukt het zo niet (een Wine die per se een
# scherm wil), dan nog één keer gewoon, met scherm: liever een Wine-venster dan geen Windows-programma's.
# Daarna wachten tot de Wine-achtergronddienst (wineserver) van dat klaarzetten weg is: anders zou het programma
# straks in die sessie zonder scherm starten en zie je zijn venster niet. Hoogstens een minuut, dan stoppen we hem.
wine_klaarzetten() {
    if env -u DISPLAY -u WAYLAND_DISPLAY WINEDEBUG=-all wineboot --init >/dev/null 2>&1; then
        timeout 60 wineserver -w >/dev/null 2>&1 || wineserver -k >/dev/null 2>&1
        return 0
    fi
    wineserver -k >/dev/null 2>&1
    WINEDEBUG=-all wineboot --init >/dev/null 2>&1
}

# Een Windows-map die er wel is maar niet af (een eerste keer die halverwege stopte: stroom weg, schijf vol, of een
# fout van een oudere BugOS), werkt nooit: Wine zegt dan "could not load kernel32.dll". Zo'n map zetten we opzij (niet
# weg: er kunnen al programma's in staan) en we maken een nieuwe. Af = kernel32.dll (64- én 32-bits) en system.reg
# (VM-test 2026-11-16).
wine_compleet() {
    # Beide helften: 64-bits (system32) en 32-bits (syswow64). In de VM was syswow64 leeg (de 32-bits helft liep
    # destijds vast op SELinux) terwijl system32 er wel stond: dan zegt Wine bij elk 32-bits programma
    # "could not load kernel32.dll".
    [ -f "$WINEPREFIX/drive_c/windows/system32/kernel32.dll" ] &&
        [ -f "$WINEPREFIX/drive_c/windows/syswow64/kernel32.dll" ] &&
        [ -f "$WINEPREFIX/system.reg" ]
}
if [ -d "$WINEPREFIX" ] && ! wine_compleet; then
    mv -- "$WINEPREFIX" "$WINEPREFIX-onaf-$(date +%Y%m%d-%H%M%S)" 2>/dev/null || rm -rf -- "$WINEPREFIX"
fi

if [ ! -d "$WINEPREFIX" ]; then
    melding "$(t "Even geduld..." "Please wait...")" \
        "$(t "De eerste keer zet BugOS alles klaar voor Windows-programma's. Dit duurt een minuutje." \
            "The first time, BugOS prepares everything for Windows programs. This takes a minute.")"
    # Wine maakt alleen de laatste map zelf: ~/.local/share/bugos bestaat op een nieuwe computer nog niet, en dan
    # mislukte het klaarzetten altijd ("chdir ... No such file or directory") (D-02). Dus de map erboven eerst maken.
    mkdir -p -- "$(dirname "$WINEPREFIX")" 2>/dev/null
    if ! wine_klaarzetten; then
        # Een half klaargezette Windows-map werkt later ook niet: weg ermee, dan de volgende keer opnieuw.
        rm -rf -- "$WINEPREFIX"
        if schijf_vol "$WINEPREFIX"; then
            fout "$(t "Klaarzetten voor Windows-programma's lukte niet: je computer is vol. Maak eerst ruimte (bijv. de prullenbak leegmaken in Bestanden) en probeer het dan nog eens." \
                "Preparing for Windows programs did not work: your computer is full. Make room first (for example empty the trash in Files) and then try again.")"
        else
            fout "$(t "Klaarzetten voor Windows-programma's lukte niet. Probeer het straks nog eens, of herstart de computer eerst." \
                "Preparing for Windows programs did not work. Try again later, or restart the computer first.")"
        fi
        exit 1
    fi
fi

# BugOS-kleuren in Windows-programma's (licht of donker, zoals de rest). Alleen als
# er iets veranderd is: een andere stand, of nieuwe kleuren na een BugOS-update.
THEMA="$(bugos-theme status 2>/dev/null)"
[ "$THEMA" = donker ] || THEMA=licht
KLEUREN="/usr/share/bugos/wine/$THEMA.reg"
if [ -f "$KLEUREN" ]; then
    STEMPEL="$THEMA $(cksum <"$KLEUREN")"
    if [ "$(cat "$WINEPREFIX/.bugos-kleuren" 2>/dev/null)" != "$STEMPEL" ]; then
        WINEDEBUG=-all wine regedit /S "$(WINEDEBUG=-all winepath -w "$KLEUREN")" >/dev/null 2>&1 &&
            echo "$STEMPEL" >"$WINEPREFIX/.bugos-kleuren"
    fi
fi

# Een Windows-script (.bat, .cmd) kan net zo veel als een programma, ook bij je eigen bestanden: eerst vragen.
case "${NAAM,,}" in
*.bat | *.cmd)
    vraag "$(t \
        "\"$TOON\" is een Windows-script. Het kan bestanden veranderen, net als een programma.\n\nOpen het alleen als je het vertrouwt. Openen?" \
        "\"$TOON\" is a Windows script. It can change files, just like a program.\n\nOnly open it if you trust it. Open it?")" || exit 0
    ;;
esac

START=$(date +%s)
case "${NAAM,,}" in
*.msi) WINEDEBUG=-all wine msiexec /i "$BESTAND" ;;
*.bat | *.cmd) WINEDEBUG=-all wine cmd /c "$(WINEDEBUG=-all winepath -w "$BESTAND")" ;;
# .exe, en een Windows-snelkoppeling (.lnk): start opent wat erachter zit.
*) WINEDEBUG=-all wine start /wait /unix "$BESTAND" ;;
esac
CODE=$?
DUUR=$(($(date +%s) - START))

# Annuleren in een Windows-installatie (msiexec 1602, ERROR_CANCELLED 1223): niets aan de hand, niets zeggen (U082).
# Linux houdt van een afsluitcode alleen de laatste 8 bits over: 1602 wordt 66, 1223 wordt 199.
if [ "$CODE" -eq 199 ] || { [ "$CODE" -eq 66 ] && [[ "${NAAM,,}" == *.msi ]]; }; then
    exit 0
fi
# Een installatieprogramma (NSIS, Inno) geeft bij Annuleren 1 of 2: dan niet stellig "werkt niet" zeggen.
installatie=0
case "${NAAM,,}" in *setup* | *install* | *.msi) installatie=1 ;; esac
if [ "$CODE" -ne 0 ] && [ "$DUUR" -lt 10 ] && [ "$installatie" = 1 ] && { [ "$CODE" -eq 1 ] || [ "$CODE" -eq 2 ]; }; then
    fout "$(t \
        "\"$TOON\" stopte meteen.\n\nKlikte je op Annuleren? Dan is er niets aan de hand.\nAnders werkt het misschien niet op BugOS: kijk in de BugOS Winkel of er een versie voor BugOS is." \
        "\"$TOON\" stopped right away.\n\nDid you click Cancel? Then nothing is wrong.\nOtherwise it may not work on BugOS: check the BugOS Store for a BugOS version.")"
    exit 1
fi
# Stopte het programma meteen met een fout? Dan vriendelijk uitleggen. Vaak ontbreekt een onderdeel van Microsoft
# (Visual C++, .NET, een .dll): dat kun je toevoegen in Windows-programma's (bugos-windows), en dan opnieuw proberen.
if [ "$CODE" -ne 0 ] && [ "$DUUR" -lt 10 ]; then
    if vraag "$(t \
        "Helaas, \"$TOON\" werkt niet op BugOS (nog niet).\n\nVaak mist er een onderdeel van Microsoft, zoals Visual C++ of .NET. Wil je dat toevoegen in Windows-programma's en het daarna opnieuw proberen?\n\nTip: kijk ook in de BugOS Winkel of er een versie voor BugOS is. Je computer is niet kapot, er is niks veranderd." \
        "Sorry, \"$TOON\" does not work on BugOS (yet).\n\nOften a component from Microsoft is missing, like Visual C++ or .NET. Do you want to add it in Windows programs and then try again?\n\nTip: also check the BugOS Store for a BugOS version. Your computer is fine, nothing has changed.")"; then
        exec bugos-windows
    fi
    exit 1
fi
