#!/usr/bin/bash
# bugos-exe - een Windows-programma (.exe/.msi) openen met dubbelklik.
#
# Hoe werkt het (Jip-en-Janneke):
#   1. Je dubbelklikt op een .exe.
#   2. BugOS start hem via Wine (een "vertaler" van Windows naar Linux).
#   3. Werkt het niet? Dan zegt BugOS netjes wat je in plaats daarvan kunt
#      gebruiken, bijvoorbeeld LibreOffice in plaats van Word.

# shellcheck source=system_files/usr/share/bugos/lib.sh
. /usr/share/bugos/lib.sh

BESTAND="${1:-}"
if [ -z "$BESTAND" ] || [ ! -f "$BESTAND" ]; then
    fout "$(t "Ik kan dit bestand niet vinden." "I cannot find this file.")"
    exit 1
fi

NAAM="$(basename "$BESTAND")"
# De meldingen lezen \n als nieuwe regel (printf %b): een \ in de bestandsnaam moet dus dubbel.
TOON="${NAAM//\\/\\\\}"
# Een naam als "<b>…</b>" mag de tekst van de vraag niet opmaken of verbergen (kdialog leest < > als opmaak) (U251).
TOON="${TOON//</‹}"
TOON="${TOON//>/›}"
ALTERNATIEVEN=/usr/share/bugos/alternatives.txt

# Is er een beter, echt Linux-alternatief? Dan dat eerst aanbieden.
zoek_alternatief() {
    local klein
    klein="$(echo "$NAAM" | tr '[:upper:]' '[:lower:]')"
    while IFS='|' read -r woord app id; do
        case "$woord" in '#'* | '') continue ;; esac
        # Een woord dat met ^ begint, moet aan het begin van de naam staan ('^tsetup' is Telegram, maar
        # 'ChatGPTSetup.exe' niet) (U190).
        if [[ "$woord" == ^* ]]; then
            [[ "$klein" == "${woord#^}"* ]] || continue
            echo "$app|$id"
            return 0
        fi
        if [[ "$klein" == *"$woord"* ]]; then
            echo "$app|$id"
            return 0
        fi
    done <"$ALTERNATIEVEN"
    return 1
}

if ALT="$(zoek_alternatief)"; then
    APP="${ALT%%|*}"
    ID="${ALT##*|}"
    if vraag "$(t \
        "Dit lijkt op een programma waarvoor een betere versie voor BugOS bestaat: $APP.\n\nWil je $APP uit de BugOS Winkel halen?\n(Kies Nee om de Windows-versie toch te proberen.)" \
        "This looks like a program that has a better version for BugOS: $APP.\n\nDo you want to get $APP from the BugOS Store?\n(Choose No to try the Windows version anyway.)")"; then
        exec bugos-store "appstream://$ID"
    fi
fi

if ! command -v wine >/dev/null 2>&1; then
    fout "$(t "Windows-programma's openen is nog niet klaar op deze computer." \
        "Opening Windows programs is not set up on this computer yet.")"
    exit 1
fi

# Elke gebruiker krijgt één eigen "Windows-map" voor zijn programma's.
export WINEPREFIX="${WINEPREFIX:-$HOME/.local/share/bugos/windows}"
if [ ! -d "$WINEPREFIX" ]; then
    melding "$(t "Even geduld..." "Please wait...")" \
        "$(t "De eerste keer zet BugOS alles klaar voor Windows-programma's. Dit duurt een minuutje." \
            "The first time, BugOS prepares everything for Windows programs. This takes a minute.")"
    if ! WINEDEBUG=-all wineboot --init >/dev/null 2>&1; then
        # Een half klaargezette Windows-map werkt later ook niet: weg ermee, dan de volgende keer opnieuw.
        rm -rf -- "$WINEPREFIX"
        fout "$(t "Klaarzetten voor Windows-programma's lukte niet. Is je computer vol? Probeer het straks nog eens." \
            "Preparing for Windows programs did not work. Is your computer full? Try again later.")"
        exit 1
    fi
fi

# BugOS-kleuren in Windows-programma's (licht of donker, zoals de rest). Alleen als
# er iets veranderd is: een andere stand, of nieuwe kleuren na een BugOS-update.
THEMA="$(bugos-theme status 2>/dev/null)"
[ "$THEMA" = donker ] || THEMA=licht
KLEUREN="/usr/share/bugos/wine/$THEMA.reg"
if [ -f "$KLEUREN" ]; then
    STEMPEL="$THEMA $(cksum <"$KLEUREN")"
    if [ "$(cat "$WINEPREFIX/.bugos-kleuren" 2>/dev/null)" != "$STEMPEL" ]; then
        WINEDEBUG=-all wine regedit /S "$(WINEDEBUG=-all winepath -w "$KLEUREN")" >/dev/null 2>&1 &&
            echo "$STEMPEL" >"$WINEPREFIX/.bugos-kleuren"
    fi
fi

START=$(date +%s)
case "$NAAM" in
*.msi | *.MSI) WINEDEBUG=-all wine msiexec /i "$BESTAND" ;;
*) WINEDEBUG=-all wine start /wait /unix "$BESTAND" ;;
esac
CODE=$?
DUUR=$(($(date +%s) - START))

# Annuleren in een Windows-installatie (msiexec 1602, ERROR_CANCELLED 1223): niets aan de hand, niets zeggen (U082).
# Linux houdt van een afsluitcode alleen de laatste 8 bits over: 1602 wordt 66, 1223 wordt 199.
if [ "$CODE" -eq 199 ] || { [ "$CODE" -eq 66 ] && [[ "${NAAM,,}" == *.msi ]]; }; then
    exit 0
fi
# Een installatieprogramma (NSIS, Inno) geeft bij Annuleren 1 of 2: dan niet stellig "werkt niet" zeggen.
installatie=0
case "${NAAM,,}" in *setup* | *install* | *.msi) installatie=1 ;; esac
if [ "$CODE" -ne 0 ] && [ "$DUUR" -lt 10 ] && [ "$installatie" = 1 ] && { [ "$CODE" -eq 1 ] || [ "$CODE" -eq 2 ]; }; then
    fout "$(t \
        "\"$TOON\" stopte meteen.\n\nKlikte je op Annuleren? Dan is er niets aan de hand.\nAnders werkt het misschien niet op BugOS: kijk in de BugOS Winkel of er een versie voor BugOS is." \
        "\"$TOON\" stopped right away.\n\nDid you click Cancel? Then nothing is wrong.\nOtherwise it may not work on BugOS: check the BugOS Store for a BugOS version.")"
    exit 1
fi
# Stopte het programma meteen met een fout? Dan vriendelijk uitleggen.
if [ "$CODE" -ne 0 ] && [ "$DUUR" -lt 10 ]; then
    fout "$(t \
        "Helaas, \"$TOON\" werkt niet op BugOS.\n\nTips:\n• Kijk in de BugOS Winkel of er een versie voor BugOS is.\n• Zoek op internet naar \"$TOON alternatief Linux\".\n\nJe computer is niet kapot, er is niks veranderd." \
        "Sorry, \"$TOON\" does not work on BugOS.\n\nTips:\n• Check the BugOS Store for a BugOS version.\n• Search the internet for \"$TOON alternative Linux\".\n\nYour computer is fine, nothing has changed.")"
    exit 1
fi
