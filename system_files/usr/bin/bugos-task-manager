#!/usr/bin/python3
"""BugOS Taakbeheer: zien wat je computer doet, en een programma sluiten dat vastzit.

Zoals Taakbeheer in Windows (Ctrl+Shift+Esc), maar simpeler:
- Programma's: wat er openstaat, hoeveel kracht en geheugen het gebruikt. Klik op een
  programma, dan verschijnt onderin 'Sluiten' (netjes, net als op het kruisje klikken) en
  'Geforceerd sluiten' (als het niet reageert).
- Prestaties: processor, geheugen, schijf, internet (en de videokaart) met grafiekjes.
- Opstarten: programma's die vanzelf meestarten aan- of uitzetten.
Bovenaan staat in gewone woorden hoe het gaat, met een tip als het druk is.
"""

from __future__ import annotations

import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

sys.path.insert(0, "/usr/lib/bugos/python")

import bugos_tasks as bt  # noqa: E402
from bugos_tasks_ui import (  # noqa: E402
    GESCHIEDENIS, Klusdraad, Meetdraad, MeetKaart, OpstartRij, Status, TaakRij, stijl,
)
from bugos_ui import (  # noqa: E402
    ActieBalk, Kaart, Knop, Pagina, Venster, label, lijn, lijn_icoon, maak_app, sectie, t, uitvoeren,
)
from PySide6.QtCore import Qt, QTimer  # noqa: E402
from PySide6.QtGui import QKeySequence, QShortcut  # noqa: E402
from PySide6.QtWidgets import QApplication, QFrame, QGridLayout, QHBoxLayout, QLabel, QVBoxLayout  # noqa: E402


# ================================================================= venster ===

class Taakbeheer(Venster):
    def __init__(self):
        super().__init__(t("Taakbeheer", "Task Manager"), maat=(1080, 720), minimum=(900, 560))
        self.setStyleSheet(stijl())
        self.processor_geschiedenis: list[float] = []
        self.rijen: dict[str, TaakRij] = {}
        self.achter_rijen: dict[str, TaakRij] = {}
        self.laatste: dict | None = None
        self.gekozen: str | None = None
        self.draden: list[Klusdraad] = []  # lopende klusjes (vasthouden, anders ruimt Python ze te vroeg op)
        self.statussen: list[Status] = []

        self.voeg_pagina("programmas", "apps", t("Programma's", "Programs"), self.maak_programmas())
        self.voeg_pagina("prestaties", "grafiek", t("Prestaties", "Performance"), self.maak_prestaties())
        self.voeg_pagina("opstarten", "aan", t("Opstarten", "Startup"), self.maak_opstarten())
        if shutil.which("plasma-systemmonitor"):
            self.onder_knop(t("Systeemmonitor", "System Monitor"), "code",
                            lambda: subprocess.Popen(["plasma-systemmonitor"], start_new_session=True),
                            tip=t("Alles tot in detail (voor gevorderden)", "Everything in detail (advanced)"))

        # zweeft onderin zodra je een programma kiest
        self.balk = ActieBalk(self)
        self.balk.knop("sluiten", "kruis", t("Sluiten", "Close"), self.sluit_gekozen)
        self.balk.knop("forceren", "uitroep", t("Geforceerd sluiten", "Force close"), self.forceer_gekozen)
        self.balk.klaar()
        self.balk.gesloten.connect(lambda: self.kies(None))
        self.pagina_gekozen.connect(lambda _s: self.kies(None))

        sluit = QShortcut(QKeySequence("Escape"), self)
        sluit.activated.connect(self.escape)
        self.ga_naar("programmas")

        self.draad = Meetdraad()
        self.draad.meting.connect(self.nieuwe_meting)
        self.draad.start()
        QApplication.instance().aboutToQuit.connect(self.stop_meten)

    def stop_meten(self) -> None:
        self.draad.stoppen = True
        self.draad.wait(3000)

    # ------------------------------------------------------------ pagina's
    def status_regel(self, pagina: Pagina) -> None:
        s = Status()
        self.statussen.append(s)
        pagina.lay.insertWidget(1, s)

    def maak_programmas(self) -> Pagina:
        p = Pagina(t("Programma's", "Programs"))
        self.status_regel(p)
        self.programmas = p
        # samenvatting: vier getallen op een rij
        samen = Kaart(marge=20, ruimte=0, richting="h")
        self.kort: dict[str, QLabel] = {}
        for i, (sleutel, naam) in enumerate((("processor", t("Processor", "Processor")),
                                             ("geheugen", t("Geheugen", "Memory")),
                                             ("schijf", t("Schijf", "Disk")),
                                             ("internet", t("Internet", "Internet")))):
            if i:
                streep = QFrame()
                streep.setObjectName("streep")
                samen.lay.addWidget(streep)
            blok = QVBoxLayout()
            blok.setContentsMargins(14 if i else 4, 0, 4, 0)
            blok.setSpacing(2)
            blok.addWidget(label(naam, "klein", wrap=False))
            self.kort[sleutel] = label("–", "kop2", wrap=False)
            blok.addWidget(self.kort[sleutel])
            samen.lay.addLayout(blok, 1)
        p.lay.addWidget(samen)
        kop = QHBoxLayout()
        kop.setContentsMargins(4 + 14, 6, 4 + 12, 0)  # dezelfde marges als de regels in de kaart
        kop.setSpacing(14)
        kop.addWidget(sectie(t("Open programma's. Klik om te kiezen.", "Open programs. Click to choose.")), 1)
        for tekst, breedte in ((t("Processor", "Processor"), 84), (t("Geheugen", "Memory"), 92)):
            k = sectie(tekst)
            k.setFixedWidth(breedte)
            k.setAlignment(Qt.AlignmentFlag.AlignRight)
            kop.addWidget(k)
        p.lay.addLayout(kop)
        self.apps_kaart = p.kaart()
        self.apps_lay = self.apps_kaart.lay
        self.geen_apps = label(t("Er staan geen programma's open.", "No programs are open."), "sub")
        self.geen_apps.setContentsMargins(14, 10, 14, 10)
        self.apps_lay.addWidget(self.geen_apps)
        self.achter_knop = Knop(t("Achtergrond tonen (voor gevorderden)", "Show background (advanced)"), "stil",
                                "lijn:rechts")
        self.achter_knop.clicked.connect(self.wissel_achtergrond)
        p.lay.addWidget(self.achter_knop, 0, Qt.AlignmentFlag.AlignLeft)
        self.achter_kaart = p.kaart()
        self.achter_lay = self.achter_kaart.lay
        self.achter_kaart.hide()
        p.klaar()
        return p

    def maak_prestaties(self) -> Pagina:
        p = Pagina(t("Prestaties", "Performance"), breedte=1100)
        self.status_regel(p)
        rooster = QGridLayout()
        rooster.setSpacing(14)
        self.kaart_processor = MeetKaart(t("Processor", "Processor"))
        self.kaart_geheugen = MeetKaart(t("Geheugen", "Memory"))
        self.kaart_schijf = MeetKaart(t("Schijf", "Disk"), None)
        self.kaart_internet = MeetKaart(t("Internet", "Internet"), None)
        self.kaart_video = MeetKaart(t("Videokaart", "Graphics card"))
        self.kaart_video.hide()
        for i, k in enumerate((self.kaart_processor, self.kaart_geheugen, self.kaart_schijf, self.kaart_internet,
                               self.kaart_video)):
            rooster.addWidget(k, i // 3, i % 3)
        for kolom in range(3):
            rooster.setColumnStretch(kolom, 1)
        p.lay.addLayout(rooster)
        p.klaar()
        return p

    def maak_opstarten(self) -> Pagina:
        p = Pagina(t("Opstarten", "Startup"),
                   t("Deze programma's starten vanzelf als je inlogt. Zet uit wat je niet elke dag nodig hebt: "
                     "dan is je computer sneller klaar.",
                     "These programs start by themselves when you log in. Turn off what you do not need every day: "
                     "then your computer is ready sooner."))
        self.opstart_pagina = p
        self.opstart_kaart = p.kaart()
        p.klaar()
        p.ververs = self.vul_opstarten
        return p

    def vul_opstarten(self) -> None:
        kaart = self.opstart_kaart
        while kaart.lay.count():
            item = kaart.lay.takeAt(0)
            if item.widget():
                item.widget().deleteLater()
        lijst = bt.opstart_lijst()
        for i, item in enumerate(lijst):
            if i:
                kaart.lay.addWidget(lijn())
            kaart.lay.addWidget(OpstartRij(item, self.zet_opstart))
        if not lijst:
            leeg = label(t("Er start niets extra mee. Mooi zo: zo is je computer snel klaar.",
                           "Nothing extra starts. Good: your computer is ready quickly."), "sub")
            leeg.setContentsMargins(14, 12, 14, 12)
            kaart.lay.addWidget(leeg)

    def zet_opstart(self, item: bt.Opstart, aan: bool) -> None:
        try:
            bt.zet_opstart(item, aan)
            item.aan = aan
            self.opstart_pagina.melding.toon(
                t(f"{item.naam} start voortaan mee.", f"{item.naam} will start from now on.") if aan
                else t(f"{item.naam} start voortaan niet meer mee.", f"{item.naam} will no longer start."),
                "goed", seconden=5)
        except OSError as e:
            self.opstart_pagina.melding.toon(t(f"Dat lukte niet: {e.strerror}", f"That did not work: {e.strerror}"),
                                             "fout")

    def wissel_achtergrond(self) -> None:
        zichtbaar = not self.achter_kaart.isVisible()
        self.achter_kaart.setVisible(zichtbaar)
        self.achter_knop.setIcon(lijn_icoon("onder" if zichtbaar else "rechts", "tekst", 18, gekozen=None))
        self.achter_knop.setText(t("Achtergrond verbergen", "Hide background") if zichtbaar
                                 else t("Achtergrond tonen (voor gevorderden)", "Show background (advanced)"))

    # -------------------------------------------------------------- kiezen
    def kies(self, sleutel: str | None) -> None:
        """Eén programma kiezen: de regel licht op en onderin verschijnt de knoppenbalk."""
        for rijen in (self.rijen, self.achter_rijen):
            for s, rij in rijen.items():
                rij.kies(s == sleutel)
        self.gekozen = sleutel
        taak = self.taak_van(sleutel)
        self.balk.toon(1 if taak else 0)
        if taak:
            self.balk.aantal.setText(taak.naam)
            self.balk.knoppen["sluiten"].setText(t("Sluiten", "Close") if taak.soort == "app"
                                                 else t("Beëindigen", "End"))
        self.plaats_balk()

    def taak_van(self, sleutel: str | None) -> bt.Taak | None:
        rij = self.rijen.get(sleutel) or self.achter_rijen.get(sleutel)
        return rij.taak if rij else None

    def plaats_balk(self) -> None:
        self.balk.plaats(self.inhoud.geometry())

    def resizeEvent(self, e) -> None:  # noqa: N802
        super().resizeEvent(e)
        if hasattr(self, "balk"):
            self.plaats_balk()

    def escape(self) -> None:
        if self.gekozen:
            self.kies(None)
        else:
            self.close()

    def sluit_gekozen(self) -> None:
        taak = self.taak_van(self.gekozen)
        if taak:
            self.sluiten(taak)
            self.kies(None)

    def forceer_gekozen(self) -> None:
        taak = self.taak_van(self.gekozen)
        if taak:
            self.forceren(taak)
            self.kies(None)

    # ------------------------------------------------------------ metingen
    def nieuwe_meting(self, m: dict) -> None:
        self.laatste = m
        self.processor_geschiedenis = (self.processor_geschiedenis + [m["processor"]])[-GESCHIEDENIS:]
        taken = m["taken"]
        soort, zin = bt.advies(self.processor_geschiedenis, m["geheugen_gebruikt"], m["geheugen_totaal"], taken)
        for s in self.statussen:
            s.zet(soort, zin)
        gebruikt, totaal = m["geheugen_gebruikt"], m["geheugen_totaal"]
        self.kort["processor"].setText(f"{m['processor']:.0f}%")
        self.kort["geheugen"].setText(t(f"{bt.maat(gebruikt)} van {bt.maat(totaal)}", f"{bt.maat(gebruikt)} of "
                                        f"{bt.maat(totaal)}"))
        self.kort["schijf"].setText(bt.snelheid(m["schijf"]))
        self.kort["internet"].setText(bt.snelheid(m["binnen"] + m["buiten"]))
        # prestaties
        temp = m.get("temperatuur")
        kernen = bt.aantal_kernen()
        self.kaart_processor.zet(f"{m['processor']:.0f}%",
                                 (f"{temp:.0f} °C · " if temp else "") + t(f"{kernen} kernen", f"{kernen} cores"),
                                 m["processor"])
        self.kaart_geheugen.zet(bt.maat(gebruikt), t(f"in gebruik, van de {bt.maat(totaal)}",
                                                     f"in use, of {bt.maat(totaal)}"),
                                gebruikt / totaal * 100 if totaal else 0)
        self.kaart_schijf.zet(bt.snelheid(m["schijf"]), t(f"{m['schijf_bezig']:.0f}% van de tijd bezig",
                                                          f"busy {m['schijf_bezig']:.0f}% of the time"), m["schijf"])
        self.kaart_internet.zet(f"↓ {bt.snelheid(m['binnen'])}",
                                t(f"↑ {bt.snelheid(m['buiten'])} verstuurd", f"↑ {bt.snelheid(m['buiten'])} sent"),
                                m["binnen"] + m["buiten"])
        if m.get("videokaart") is not None:
            self.kaart_video.show()
            self.kaart_video.zet(f"{m['videokaart']:.0f}%", t("bezig", "busy"), m["videokaart"])
        # programma's
        self.werk_lijst_bij(self.apps_lay, self.rijen, [x for x in taken if x.soort == "app"], self.geen_apps)
        achter = sorted([x for x in taken if x.soort != "app"],
                        key=lambda x: (x.soort == "systeem", -x.processor, -x.geheugen))[:60]
        self.werk_lijst_bij(self.achter_lay, self.achter_rijen, achter, None)
        n = len([x for x in taken if x.soort != "app"])
        if not self.achter_kaart.isVisible():
            self.achter_knop.setText(t(f"Achtergrond tonen ({n}, voor gevorderden)",
                                       f"Show background ({n}, advanced)"))
        if self.gekozen and self.taak_van(self.gekozen) is None:
            self.kies(None)  # het gekozen programma is weg

    def werk_lijst_bij(self, lay: QVBoxLayout, rijen: dict[str, TaakRij], taken: list[bt.Taak],
                       leeg: QLabel | None) -> None:
        """Bestaande regels bijwerken; alleen als er iets bij komt of weggaat, de lijst opnieuw opbouwen."""
        sleutels = [x.sleutel for x in taken]
        if sleutels == list(rijen):
            for x in taken:
                rijen[x.sleutel].zet(x)
            return
        oud = dict(rijen)
        rijen.clear()
        while lay.count():
            item = lay.takeAt(0)
            w = item.widget()
            if w is not None and w is not leeg:
                if isinstance(w, TaakRij):
                    w.setParent(None)
                else:
                    w.deleteLater()
        for x in taken:
            rij = oud.pop(x.sleutel, None)
            if rij is None:
                rij = TaakRij(x)
                rij.geklikt.connect(lambda s=x.sleutel: self.kies(None if self.gekozen == s else s))
            else:
                rij.zet(x)
            if rijen:
                lay.addWidget(lijn())
            lay.addWidget(rij)
            rijen[x.sleutel] = rij
        for rij in oud.values():
            rij.deleteLater()
        if leeg is not None:
            lay.addWidget(leeg)
            leeg.setVisible(not taken)

    # ------------------------------------------------------------- sluiten
    def op_achtergrond(self, werk, klaar) -> None:
        """Iets traags (KWin vragen, systemctl) op de achtergrond, zodat het venster nooit vastloopt."""
        draad = Klusdraad(werk)
        self.draden.append(draad)
        draad.klaar.connect(lambda uitkomst: (self.draden.remove(draad), klaar(uitkomst)))
        draad.start()

    def sluiten(self, taak: bt.Taak) -> None:
        """Netjes sluiten: de vensters dicht, zoals op het kruisje klikken (het programma kan nog vragen
        of je wilt opslaan). Achtergrondtaken krijgen een vriendelijk stopverzoek."""
        sleutel, naam, pids, app = taak.sleutel, taak.naam, list(taak.pids), taak.soort == "app"

        def werk() -> bool:
            if app and self.sluit_vensters(pids):
                return True
            bt.stop(pids)
            return False

        def klaar(vensters) -> None:
            self.programmas.melding.toon(t(f"{naam} wordt gesloten…", f"Closing {naam}…") if vensters is True
                                         else t(f"{naam} wordt gestopt…", f"Stopping {naam}…"), seconden=6)
            QTimer.singleShot(6000, lambda: self.nog_open(sleutel, naam, pids))

        self.programmas.melding.toon(t(f"{naam} wordt gesloten…", f"Closing {naam}…"), seconden=6)
        self.op_achtergrond(werk, klaar)

    def nog_open(self, sleutel: str, naam: str, pids: list[int]) -> None:
        if not bt.leeft(pids):
            self.programmas.melding.toon(t(f"{naam} is gesloten.", f"{naam} is closed."), "goed", seconden=5)
            return
        # De knop werkt alleen een minuut: daarna kan een procesnummer al van een ander programma zijn.
        self.programmas.melding.toon(
            t(f"{naam} is nog open. Vraagt het iets, bijvoorbeeld of je wilt opslaan? Kijk dan even in dat "
              "venster. Reageert het niet? Sluit het dan geforceerd.",
              f"{naam} is still open. Is it asking something, for example whether to save? Then look at that "
              "window. Not responding? Then force it to close."),
            "let_op", knop=t("Geforceerd sluiten", "Force close"), actie=lambda: self.forceren_sleutel(sleutel, naam),
            seconden=60)

    def forceren_sleutel(self, sleutel: str, naam: str) -> None:
        """Pas op het moment van klikken kijken welke processen er nu bij dit programma horen."""
        taak = self.taak_van(sleutel)
        if taak is None:
            self.programmas.melding.toon(t(f"{naam} is al gesloten.", f"{naam} is already closed."), "goed", seconden=5)
            return
        self.forceren(taak)

    def forceren(self, taak: bt.Taak) -> None:
        if taak.beschermd:
            return
        naam, pids, eenheid = taak.naam, list(taak.pids), taak.eenheid if taak.soort == "app" else ""

        def werk() -> None:
            bt.stop(pids, hard=True)
            if eenheid and shutil.which("systemctl"):
                try:
                    subprocess.run(["systemctl", "--user", "kill", "--signal=SIGKILL", eenheid],
                                   capture_output=True, timeout=10)
                except (OSError, subprocess.SubprocessError):
                    pass

        self.op_achtergrond(werk, lambda _: self.programmas.melding.toon(
            t(f"{naam} is geforceerd gesloten.", f"{naam} was force closed."), "goed", seconden=5))

    @staticmethod
    def sluit_vensters(pids: list[int]) -> bool:
        """Vraag KWin (die de vensters beheert) om de vensters van deze programma's te sluiten."""
        if not shutil.which("gdbus"):
            return False
        map_ = Path(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir())
        naam = f"bugos-sluit-{os.getpid()}-{int(time.time() * 1000)}"
        script = map_ / f"{naam}.js"
        bus = ["gdbus", "call", "--session", "--dest", "org.kde.KWin"]
        try:
            script.write_text(bt.sluit_script(pids), encoding="utf-8")
            uit = subprocess.run(bus + ["--object-path", "/Scripting", "--method",
                                        "org.kde.kwin.Scripting.loadScript", str(script), naam],
                                 capture_output=True, text=True, timeout=5).stdout
            nummer = uit.strip("()\n ,").split(",")[0].strip()
            if not nummer.lstrip("-").isdigit() or int(nummer) < 0:
                return False
            subprocess.run(bus + ["--object-path", f"/Scripting/Script{nummer}", "--method", "org.kde.kwin.Script.run"],
                           capture_output=True, timeout=5)
            subprocess.run(bus + ["--object-path", "/Scripting", "--method", "org.kde.kwin.Scripting.unloadScript",
                                  naam], capture_output=True, timeout=5)
            return True
        except (OSError, subprocess.SubprocessError):
            return False
        finally:
            try:
                script.unlink()
            except OSError:
                pass

    def closeEvent(self, e) -> None:  # noqa: N802
        self.stop_meten()
        for draad in list(self.draden):  # een lopend klusje eerst laten afmaken (hooguit een paar seconden)
            draad.wait(12000)
        super().closeEvent(e)


def main() -> int:
    app = maak_app("bugos-task-manager", "bugos-task-manager", sys.argv)
    venster = Taakbeheer()
    if "--prestaties" in sys.argv:
        venster.ga_naar("prestaties")
    elif "--opstarten" in sys.argv:
        venster.ga_naar("opstarten")
    return uitvoeren(app, venster)


if __name__ == "__main__":
    sys.exit(main())
