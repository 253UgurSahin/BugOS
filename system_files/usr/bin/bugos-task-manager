#!/usr/bin/python3
"""BugOS Taakbeheer: zien wat je computer doet, en een programma sluiten dat vastzit.

Zoals Taakbeheer in Windows (Ctrl+Shift+Esc), maar simpeler:
- Programma's: wat er openstaat, hoeveel kracht en geheugen het gebruikt. Klik op een
  programma, dan verschijnt onderin 'Sluiten' (netjes, net als op het kruisje klikken) en
  'Geforceerd sluiten' (als het niet reageert).
- Prestaties: processor, geheugen, schijf, internet (en de videokaart) met grafiekjes.
- Opstarten: programma's die vanzelf meestarten aan- of uitzetten.
- Details: alles wat draait, ook losse processen (voor wie helpt). Zoeken, sorteren, en beëindigen wat van jou is.
Bovenaan staat in gewone woorden hoe het gaat, met een tip als het druk is.

  bugos-task-manager [--prestaties | --opstarten | --details]
"""

from __future__ import annotations

import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

sys.path.insert(0, "/usr/lib/bugos/python")

import bugos_tasks as bt  # noqa: E402
from bugos_tasks_ui import (  # noqa: E402
    GESCHIEDENIS, KOLOM_GEHEUGEN, KOLOM_PROCESSOR, REGEL_ROL, Klusdraad, Meetdraad, MeetKaart, OpstartRij, Plooi,
    ProcesFilter, ProcesModel, ProcesTabel, Status, TaakRij, stijl,
)
from bugos_ui import (  # noqa: E402
    ActieBalk, Kaart, Knop, Pagina, Schuif, Venster, Zoekveld, label, lijn, lijn_icoon, maak_app, px, sectie, t,
    uitvoeren, vraag_ja,
)
from PySide6.QtCore import QEvent, Qt, QTimer  # noqa: E402
from PySide6.QtGui import QFontMetrics, QKeySequence, QShortcut  # noqa: E402
from PySide6.QtWidgets import (  # noqa: E402
    QApplication, QFrame, QHBoxLayout, QLabel, QVBoxLayout, QWidget,
)


# ================================================================= venster ===

class Taakbeheer(Venster):
    def __init__(self):
        super().__init__(t("Taakbeheer", "Task Manager"), maat=(1080, 720), minimum=(900, 560))
        self.setStyleSheet(stijl())
        self.processor_geschiedenis: list[float] = []
        self.rijen: dict[str, TaakRij] = {}
        self.achter_rijen: dict[str, TaakRij] = {}
        self.laatste: dict | None = None
        self.gekozen: str | None = None
        self.draden: list[Klusdraad] = []  # lopende klusjes (vasthouden, anders ruimt Python ze te vroeg op)
        self.statussen: list[Status] = []

        self.voeg_pagina("programmas", "apps", t("Programma's", "Programs"), self.maak_programmas())
        self.voeg_pagina("prestaties", "grafiek", t("Prestaties", "Performance"), self.maak_prestaties())
        self.voeg_pagina("opstarten", "aan", t("Opstarten", "Startup"), self.maak_opstarten())
        # Details: elk proces los, zoals in Windows. Daarmee is Systeemmonitor van KDE niet meer nodig.
        self.voeg_pagina("details", "document", t("Details", "Details"), self.maak_details())

        # zweeft onderin zodra je een programma kiest
        self.balk = ActieBalk(self)
        self.balk.knop("sluiten", "kruis", t("Sluiten", "Close"), self.sluit_gekozen)
        self.balk.knop("forceren", "uitroep", t("Geforceerd sluiten", "Force close"), self.forceer_gekozen)
        self.balk.klaar()
        self.balk.gesloten.connect(lambda: self.kies(None))
        self.pagina_gekozen.connect(lambda _s: self.kies(None))
        # Details: een eigen balk (de knoppen werken op één proces, niet op een programma).
        self.details_balk = ActieBalk(self)
        self.details_balk.knop("beeindigen", "kruis", t("Beëindigen", "End"), self.beeindig_gekozen)
        self.details_balk.knop("forceren", "uitroep", t("Geforceerd beëindigen", "Force end"),
                               lambda: self.beeindig_gekozen(hard=True))
        self.details_balk.klaar()
        self.details_balk.gesloten.connect(self.tabel.clearSelection)
        self.pagina_gekozen.connect(self._pagina_weg)

        sluit = QShortcut(QKeySequence("Escape"), self)
        sluit.activated.connect(self.escape)
        self.ga_naar("programmas")

        self.draad = Meetdraad()
        self.draad.meting.connect(self.nieuwe_meting)
        self.draad.start()
        QApplication.instance().aboutToQuit.connect(self.stop_meten)

    def stop_meten(self) -> None:
        self.draad.stop()
        self.draad.wait(3000)

    def changeEvent(self, e) -> None:  # noqa: N802
        super().changeEvent(e)
        if e.type() == QEvent.Type.WindowStateChange and hasattr(self, "draad"):
            self.draad.zet_zichtbaar(self.isVisible() and not self.isMinimized())   # (U311)

    def hideEvent(self, e) -> None:  # noqa: N802
        super().hideEvent(e)
        if hasattr(self, "draad"):
            self.draad.zet_zichtbaar(False)

    def showEvent(self, e) -> None:  # noqa: N802
        super().showEvent(e)
        if hasattr(self, "draad"):
            self.draad.zet_zichtbaar(not self.isMinimized())

    # ------------------------------------------------------------ pagina's
    def status_regel(self, pagina: Pagina) -> None:
        s = Status()
        self.statussen.append(s)
        pagina.lay.insertWidget(1, s)

    def maak_programmas(self) -> Pagina:
        p = Pagina(t("Programma's", "Programs"))
        self.status_regel(p)
        self.programmas = p
        # samenvatting: vier getallen op een rij
        # Vier getallen op een rij; past dat niet (150 %, grote letters), dan twee rijen van twee (R13).
        samen = Kaart(marge=20, ruimte=0, richting="h")
        self.kort: dict[str, QLabel] = {}
        blokken = []
        for sleutel, naam in (("processor", t("Processor", "Processor")), ("geheugen", t("Geheugen", "Memory")),
                              ("schijf", t("Schijf", "Disk")), ("internet", t("Internet", "Internet"))):
            blok = QWidget()
            rij = QHBoxLayout(blok)
            rij.setContentsMargins(0, 0, 0, 0)
            rij.setSpacing(0)
            streep = QFrame()
            streep.setObjectName("streep")
            rij.addWidget(streep)
            tekst = QVBoxLayout()
            tekst.setSpacing(2)
            tekst.addWidget(label(naam, "klein", wrap=False))
            self.kort[sleutel] = label("–", "kop2", wrap=False)
            tekst.addWidget(self.kort[sleutel])
            rij.addLayout(tekst, 1)
            blok.streep, blok.tekst = streep, tekst
            blokken.append(blok)

        def bij_kolom(blok: QWidget, kolom: int) -> None:
            blok.streep.setVisible(kolom > 0)   # een streep alleen tussen twee getallen, niet aan het begin
            blok.tekst.setContentsMargins(14 if kolom else 4, 0, 4, 0)

        self.samen_plooi = Plooi(blokken, 4, ruimte=0, bij_kolom=bij_kolom)
        self.samen_plooi.rooster.setVerticalSpacing(12)
        samen.lay.addWidget(self.samen_plooi)
        p.lay.addWidget(samen)
        kop = QHBoxLayout()
        kop.setContentsMargins(4 + 14, 6, 4 + 12, 0)  # dezelfde marges als de regels in de kaart
        kop.setSpacing(14)
        uitleg = sectie(t("Open programma's. Klik om te kiezen.", "Open programs. Click to choose."))
        uitleg.setWordWrap(True)          # met grote letters liever twee regels dan een pagina die opzij schuift (R13)
        uitleg.setMinimumWidth(px(120))
        kop.addWidget(uitleg, 1, Qt.AlignmentFlag.AlignBottom)
        for tekst, breedte in ((t("Processor", "Processor"), KOLOM_PROCESSOR),
                               (t("Geheugen", "Memory"), KOLOM_GEHEUGEN)):
            k = sectie(tekst)
            k.setFixedWidth(px(breedte))
            k.setAlignment(Qt.AlignmentFlag.AlignRight)
            kop.addWidget(k)
        p.lay.addLayout(kop)
        self.apps_kaart = p.kaart()
        self.apps_lay = self.apps_kaart.lay
        self.geen_apps = label(t("Er staan geen programma's open.", "No programs are open."), "sub")
        self.geen_apps.setContentsMargins(14, 10, 14, 10)
        self.apps_lay.addWidget(self.geen_apps)
        self.achter_knop = Knop(t("Achtergrond tonen (voor gevorderden)", "Show background (advanced)"), "stil",
                                "lijn:rechts")
        self.achter_knop.clicked.connect(self.wissel_achtergrond)
        p.lay.addWidget(self.achter_knop, 0, Qt.AlignmentFlag.AlignLeft)
        self.achter_kaart = p.kaart()
        self.achter_lay = self.achter_kaart.lay
        self.achter_kaart.hide()
        p.klaar()
        return p

    def maak_prestaties(self) -> Pagina:
        p = Pagina(t("Prestaties", "Performance"), breedte=1100)
        self.status_regel(p)
        self.kaart_processor = MeetKaart(t("Processor", "Processor"))
        self.kaart_geheugen = MeetKaart(t("Geheugen", "Memory"))
        self.kaart_schijf = MeetKaart(t("Schijf", "Disk"), None)
        self.kaart_internet = MeetKaart(t("Internet", "Internet"), None)
        self.kaart_video = MeetKaart(t("Videokaart", "Graphics card"))
        self.kaart_video.hide()
        # Drie kaarten op een rij; past dat niet (150 %, grote letters), dan twee (R13).
        self.meet_plooi = Plooi([self.kaart_processor, self.kaart_geheugen, self.kaart_schijf, self.kaart_internet,
                                 self.kaart_video], 3)
        p.lay.addWidget(self.meet_plooi)
        p.klaar()
        return p

    def maak_opstarten(self) -> Pagina:
        p = Pagina(t("Opstarten", "Startup"),
                   t("Deze programma's starten vanzelf als je inlogt. Zet uit wat je niet elke dag nodig hebt: "
                     "dan is je computer sneller klaar.",
                     "These programs start by themselves when you log in. Turn off what you do not need every day: "
                     "then your computer is ready sooner."))
        self.opstart_pagina = p
        self.opstart_kaart = p.kaart()
        p.klaar()
        p.ververs = self.vul_opstarten
        return p

    def maak_details(self) -> Pagina:
        p = Pagina(t("Details", "Details"),
                   t("Alles wat er nu draait, ook de onderdelen van BugOS zelf. Je kunt alleen beëindigen wat van jou is.",
                     "Everything that is running now, including the parts of BugOS itself. You can only end what is "
                     "yours."), breedte=1100)
        self.details = p
        rij = QHBoxLayout()
        rij.setSpacing(12)
        # Kort woord in het vak (past ook bij 150 %), de hele uitleg als tip (review 18).
        self.details_zoek = Zoekveld(t("Zoeken", "Search"))
        self.details_zoek.setToolTip(t("Zoek op naam of nummer", "Search by name or number"))
        self.details_zoek.setAccessibleName(t("Zoek op naam of nummer", "Search by name or number"))
        self.details_zoek.setMinimumHeight(40)
        self.details_zoek.setMaximumHeight(40)
        self.details_zoek.setMaximumWidth(px(320))
        rij.addWidget(self.details_zoek, 1)
        rij.addStretch(0)
        rij.addWidget(label(t("Alleen van jou", "Only yours"), "klein", wrap=False))
        self.alleen_eigen = Schuif(False)
        self.alleen_eigen.setAccessibleName(t("Alleen van jou", "Only yours"))
        rij.addWidget(self.alleen_eigen)
        rij.addSpacing(8)
        self.details_aantal = label("", "klein", wrap=False)
        rij.addWidget(self.details_aantal)
        p.lay.addLayout(rij)
        self.proces_model = ProcesModel()
        self.proces_filter = ProcesFilter()
        self.proces_filter.setSourceModel(self.proces_model)
        self.tabel = ProcesTabel(self.proces_filter)
        p.lay.addWidget(self.tabel, 1)
        self.details_leeg = label(t("Even kijken…", "Taking a look…"), "sub")
        self.details_leeg.setContentsMargins(4, 0, 4, 0)
        p.lay.addWidget(self.details_leeg)
        # Zolang de knoppenbalk onderin zweeft, maakt dit lege stuk de tabel korter: dan valt er geen regel onder de
        # balk. (Een QTreeView zet zijn eigen viewport-marges voor de kop, dus dat kan niet in de tabel zelf.)
        self.details_ruimte = QWidget()
        self.details_ruimte.hide()
        p.lay.addWidget(self.details_ruimte)
        self._keuze: tuple[int, int] | None = None   # (pid, starttijd) van wat je koos
        self._bijwerken = False
        self.details_zoek.textChanged.connect(lambda tekst: self._bewaak(lambda: self.proces_filter.zet_zoek(tekst)))
        self.alleen_eigen.toggled.connect(lambda aan: self._bewaak(lambda: self.proces_filter.zet_eigen(aan)))
        self.tabel.selectionModel().selectionChanged.connect(lambda *_: self.kies_regel())
        weg = QShortcut(QKeySequence(QKeySequence.StandardKey.Delete), self.tabel)
        weg.setContext(Qt.ShortcutContext.WidgetShortcut)
        weg.activated.connect(self.beeindig_gekozen)   # vraagt eerst (review 1)
        p.ververs = self.vul_details
        return p

    def vul_details(self) -> None:
        if self.laatste is not None:
            self._bewaak(lambda: self.proces_model.zet(self.laatste.get("processen", [])))
        self.details_tellen()

    def _bewaak(self, werk) -> None:
        """Bijwerken (een nieuwe meting, zoeken) zonder dat je keuze naar een ander proces springt: verdwijnt het
        gekozen proces (of valt het buiten het zoeken), dan is er niets meer gekozen, en de balk is weg."""
        voor = self._keuze
        self._bijwerken = True
        try:
            werk()
        finally:
            self._bijwerken = False
        nu = self.gekozen_regel()
        if voor is not None and (nu is None or (nu.pid, nu.start) != voor):
            self.tabel.clearSelection()
        self.kies_regel(verschuif=False)
        self.details_tellen()

    def details_tellen(self) -> None:
        n, zichtbaar = self.proces_model.rowCount(), self.proces_filter.rowCount()
        if self.proces_filter.zoek or self.proces_filter.alleen_eigen:
            self.details_aantal.setText(t("{z} van {n}", "{z} of {n}").replace("{z}", str(zichtbaar))
                                        .replace("{n}", str(n)))
        else:
            self.details_aantal.setText(t("{n} processen", "{n} processes").replace("{n}", str(n)) if n else "")
        if not n:
            self.details_leeg.setText(t("Even kijken…", "Taking a look…"))
        else:
            self.details_leeg.setText(t("Niets gevonden. Zoek op een deel van de naam, of op het nummer.",
                                        "Nothing found. Search for part of the name, or for the number."))
        self.details_leeg.setVisible(not zichtbaar)

    def gekozen_regel(self):
        sel = self.tabel.selectionModel()
        rijen = sel.selectedRows() if sel is not None else []
        return rijen[0].data(REGEL_ROL) if rijen else None

    def kies_regel(self, verschuif: bool = True) -> None:
        """Een proces gekozen: de balk met Beëindigen en Geforceerd beëindigen (grijs als het niet mag)."""
        if self._bijwerken:
            return   # na het bijwerken kijkt _bewaak zelf
        regel = self.gekozen_regel() if self.huidige() == "details" else None
        self._keuze = (regel.pid, regel.start) if regel is not None else None
        if regel is None:
            self.details_balk.hide()
            self.ruimte_onder(0)
            return
        self.details_balk.toon(1)
        self.details_balk.aantal.setText(QFontMetrics(self.details_balk.aantal.font()).elidedText(
            regel.naam, Qt.TextElideMode.ElideRight, px(140)))
        self.details_balk.aantal.setToolTip(f"{regel.naam} · {regel.pid}")
        for k in self.details_balk.knoppen.values():
            k.setEnabled(not regel.beschermd)
        self.plaats_balk()
        self.ruimte_onder(self.details_balk.height())
        if verschuif:   # alleen als je zelf iets kiest, niet bij elke meting (dan kun je nog schuiven)
            QTimer.singleShot(0, self._naar_keuze)

    def _naar_keuze(self) -> None:
        rijen = self.tabel.selectionModel().selectedRows()
        if rijen:
            self.tabel.scrollTo(rijen[0])

    def ruimte_onder(self, balk: int) -> None:
        """Ruimte onder de tabel voor de zwevende balk (die staat 14 px boven de rand; de pagina heeft 28 px marge
        en 14 px tussen de stukken): zo blijft er 8 px tussen de laatste regel en de balk."""
        hoogte = max(balk - 20, 0)
        self.details_ruimte.setFixedHeight(hoogte)
        self.details_ruimte.setVisible(bool(balk))

    def _beschermd_tip(self) -> None:
        """Waarom de knoppen grijs zijn. Na elke plaats(): die zet bij alleen-icoontjes het woord als tip."""
        regel = self.gekozen_regel() if not self.details_balk.isHidden() else None
        if regel is None or not regel.beschermd:
            return
        tip = (t("Dit hoort bij BugOS of bij de computer zelf. Dat kun je hier niet beëindigen.",
                 "This is part of BugOS or of the computer itself. You cannot end it here.") if regel.eigen
               else t("Dit is niet van jou. Dat kun je hier niet beëindigen.",
                      "This is not yours. You cannot end it here."))
        for k in self.details_balk.knoppen.values():
            k.setToolTip(tip)

    def _pagina_weg(self, sleutel: str) -> None:
        if sleutel != "details" and hasattr(self, "tabel"):
            self.tabel.clearSelection()
            self.details_balk.hide()
            self.ruimte_onder(0)

    def vul_opstarten(self) -> None:
        kaart = self.opstart_kaart
        while kaart.lay.count():
            item = kaart.lay.takeAt(0)
            if item.widget():
                item.widget().deleteLater()
        lijst = bt.opstart_lijst()
        for i, item in enumerate(lijst):
            if i:
                kaart.lay.addWidget(lijn())
            kaart.lay.addWidget(OpstartRij(item, self.zet_opstart))
        if not lijst:
            leeg = label(t("Er start niets extra mee. Mooi zo: zo is je computer snel klaar.",
                           "Nothing extra starts. Good: your computer is ready quickly."), "sub")
            leeg.setContentsMargins(14, 12, 14, 12)
            kaart.lay.addWidget(leeg)

    def zet_opstart(self, item: bt.Opstart, aan: bool) -> bool:
        try:
            bt.zet_opstart(item, aan)
        except (OSError, ValueError) as e:   # ook een eigen bestand dat geen UTF-8 is (U186)
            reden = e.strerror if isinstance(e, OSError) and e.strerror else t("het bestand is niet te lezen",
                                                                                "the file cannot be read")
            self.opstart_pagina.melding.toon(t(f"Dat lukte niet: {reden}", f"That did not work: {reden}"), "fout")
            return False
        item.aan = aan
        self.opstart_pagina.melding.toon(
            t(f"{item.naam} start voortaan mee.", f"{item.naam} will start from now on.") if aan
            else t(f"{item.naam} start voortaan niet meer mee.", f"{item.naam} will no longer start."),
            "goed", seconden=5)
        return True

    def wissel_achtergrond(self) -> None:
        zichtbaar = not self.achter_kaart.isVisible()
        self.achter_kaart.setVisible(zichtbaar)
        self.achter_knop.setIcon(lijn_icoon("onder" if zichtbaar else "rechts", "tekst", 18, gekozen=None))
        self.achter_knop.setText(t("Achtergrond verbergen", "Hide background") if zichtbaar
                                 else t("Achtergrond tonen (voor gevorderden)", "Show background (advanced)"))

    # -------------------------------------------------------------- kiezen
    def kies(self, sleutel: str | None) -> None:
        """Eén programma kiezen: de regel licht op en onderin verschijnt de knoppenbalk."""
        for rijen in (self.rijen, self.achter_rijen):
            for s, rij in rijen.items():
                rij.kies(s == sleutel)
        self.gekozen = sleutel
        taak = self.taak_van(sleutel)
        self.balk.toon(1 if taak else 0)
        if taak:
            self.balk.aantal.setText(taak.naam)
            self.balk.knoppen["sluiten"].setText(t("Sluiten", "Close") if taak.soort == "app"
                                                 else t("Beëindigen", "End"))
        self.plaats_balk()

    def taak_van(self, sleutel: str | None) -> bt.Taak | None:
        rij = self.rijen.get(sleutel) or self.achter_rijen.get(sleutel)
        return rij.taak if rij else None

    def plaats_balk(self) -> None:
        self.balk.plaats(self.inhoud.geometry())
        if hasattr(self, "details_balk"):
            self.details_balk.plaats(self.inhoud.geometry())
            self._beschermd_tip()

    def resizeEvent(self, e) -> None:  # noqa: N802
        super().resizeEvent(e)
        if hasattr(self, "balk"):
            self.plaats_balk()

    def escape(self) -> None:
        if self.huidige() == "details" and self.gekozen_regel() is not None:
            self.tabel.clearSelection()
        elif self.gekozen:
            self.kies(None)
        else:
            self.close()

    def sluit_gekozen(self) -> None:
        taak = self.taak_van(self.gekozen)
        if taak:
            self.sluiten(taak)
            self.kies(None)

    def forceer_gekozen(self) -> None:
        taak = self.taak_van(self.gekozen)
        if taak:
            self.forceren(taak)
            self.kies(None)

    # ------------------------------------------------------------ metingen
    def nieuwe_meting(self, m: dict) -> None:
        self.laatste = m
        self.processor_geschiedenis = (self.processor_geschiedenis + [m["processor"]])[-GESCHIEDENIS:]
        taken = m["taken"]
        soort, zin = bt.advies(self.processor_geschiedenis, m["geheugen_gebruikt"], m["geheugen_totaal"], taken)
        for s in self.statussen:
            s.zet(soort, zin)
        gebruikt, totaal = m["geheugen_gebruikt"], m["geheugen_totaal"]
        self.kort["processor"].setText(f"{m['processor']:.0f}%")
        self.kort["geheugen"].setText(t(f"{bt.maat(gebruikt)} van {bt.maat(totaal)}", f"{bt.maat(gebruikt)} of "
                                        f"{bt.maat(totaal)}"))
        self.kort["schijf"].setText(bt.snelheid(m["schijf"]))
        self.kort["internet"].setText(bt.snelheid(m["binnen"] + m["buiten"]))
        # prestaties
        temp = m.get("temperatuur")
        kernen = bt.aantal_kernen()
        self.kaart_processor.zet(f"{m['processor']:.0f}%",
                                 (f"{temp:.0f} °C · " if temp else "") + t(f"{kernen} kernen", f"{kernen} cores"),
                                 m["processor"])
        self.kaart_geheugen.zet(bt.maat(gebruikt), t(f"in gebruik, van de {bt.maat(totaal)}",
                                                     f"in use, of {bt.maat(totaal)}"),
                                gebruikt / totaal * 100 if totaal else 0)
        self.kaart_schijf.zet(bt.snelheid(m["schijf"]), t(f"{m['schijf_bezig']:.0f}% van de tijd bezig",
                                                          f"busy {m['schijf_bezig']:.0f}% of the time"), m["schijf"])
        self.kaart_internet.zet(f"↓ {bt.snelheid(m['binnen'])}",
                                t(f"↑ {bt.snelheid(m['buiten'])} verstuurd", f"↑ {bt.snelheid(m['buiten'])} sent")
                                if m["buiten"] >= 1000 else t("↑ niets verstuurd", "↑ nothing sent"),   # niet 'rustig verstuurd
                                m["binnen"] + m["buiten"])
        if m.get("videokaart") is not None:
            if self.kaart_video.isHidden():
                self.kaart_video.show()
                self.meet_plooi.herschik()
            self.kaart_video.zet(f"{m['videokaart']:.0f}%", t("bezig", "busy"), m["videokaart"])
        self.samen_plooi.bijwerken()
        self.meet_plooi.bijwerken()
        # programma's
        self.werk_lijst_bij(self.apps_lay, self.rijen, [x for x in taken if x.soort == "app"], self.geen_apps)
        achter = sorted([x for x in taken if x.soort != "app"],
                        key=lambda x: (x.soort == "systeem", -x.processor, -x.geheugen))[:60]
        self.werk_lijst_bij(self.achter_lay, self.achter_rijen, achter, None)
        n = len([x for x in taken if x.soort != "app"])
        if not self.achter_kaart.isVisible():
            self.achter_knop.setText(t(f"Achtergrond tonen ({n}, voor gevorderden)",
                                       f"Show background ({n}, advanced)"))
        if self.gekozen and self.taak_van(self.gekozen) is None:
            self.kies(None)  # het gekozen programma is weg
        if self.huidige() == "details":
            self._bewaak(lambda: self.proces_model.zet(m.get("processen", [])))

    def werk_lijst_bij(self, lay: QVBoxLayout, rijen: dict[str, TaakRij], taken: list[bt.Taak],
                       leeg: QLabel | None) -> None:
        """Bestaande regels bijwerken; alleen als er iets bij komt of weggaat, de lijst opnieuw opbouwen."""
        sleutels = [x.sleutel for x in taken]
        if sleutels == list(rijen):
            for x in taken:
                rijen[x.sleutel].zet(x)
            return
        oud = dict(rijen)
        rijen.clear()
        while lay.count():
            item = lay.takeAt(0)
            w = item.widget()
            if w is not None and w is not leeg:
                if isinstance(w, TaakRij):
                    w.setParent(None)
                else:
                    w.deleteLater()
        for x in taken:
            rij = oud.pop(x.sleutel, None)
            if rij is None:
                rij = TaakRij(x)
                rij.geklikt.connect(lambda s=x.sleutel: self.kies(None if self.gekozen == s else s))
            else:
                rij.zet(x)
            if rijen:
                lay.addWidget(lijn())
            lay.addWidget(rij)
            rijen[x.sleutel] = rij
        for rij in oud.values():
            rij.deleteLater()
        if leeg is not None:
            lay.addWidget(leeg)
            leeg.setVisible(not taken)

    # ------------------------------------------------------------- sluiten
    def op_achtergrond(self, werk, klaar) -> None:
        """Iets traags (KWin vragen, systemctl) op de achtergrond, zodat het venster nooit vastloopt."""
        draad = Klusdraad(werk)
        self.draden.append(draad)
        draad.klaar.connect(lambda uitkomst: (self.draden.remove(draad), klaar(uitkomst)))
        draad.start()

    def sluiten(self, taak: bt.Taak) -> None:
        """Netjes sluiten: de vensters dicht, zoals op het kruisje klikken (het programma kan nog vragen
        of je wilt opslaan). Achtergrondtaken krijgen een vriendelijk stopverzoek."""
        sleutel, naam, pids, app = taak.sleutel, taak.naam, list(taak.pids), taak.soort == "app"
        if self.draad.voorbeeld:
            # Voorbeeldstand (foto's): de nummers 101, 102 ... zijn op deze computer echte processen. Niets sturen,
            # ook KWin niets vragen; alleen laten zien hoe het eruitziet (X1, review 11).
            self.programmas.melding.toon(t(f"{naam} is gesloten.", f"{naam} is closed."), "goed", seconden=5)
            return

        def werk() -> bool:
            if app and self.sluit_vensters(pids):
                return True
            bt.stop(pids)
            return False

        def klaar(vensters) -> None:
            self.programmas.melding.toon(t(f"{naam} wordt gesloten…", f"Closing {naam}…") if vensters is True
                                         else t(f"{naam} wordt gestopt…", f"Stopping {naam}…"), seconden=6)
            QTimer.singleShot(6000, lambda: self.nog_open(sleutel, naam, pids))

        self.programmas.melding.toon(t(f"{naam} wordt gesloten…", f"Closing {naam}…"), seconden=6)
        self.op_achtergrond(werk, klaar)

    def nog_open(self, sleutel: str, naam: str, pids: list[int]) -> None:
        if not bt.leeft(pids):
            self.programmas.melding.toon(t(f"{naam} is gesloten.", f"{naam} is closed."), "goed", seconden=5)
            return
        # De knop werkt alleen een minuut: daarna kan een procesnummer al van een ander programma zijn.
        self.programmas.melding.toon(
            t(f"{naam} is nog open. Vraagt het iets, bijvoorbeeld of je wilt opslaan? Kijk dan even in dat "
              "venster. Reageert het niet? Sluit het dan geforceerd.",
              f"{naam} is still open. Is it asking something, for example whether to save? Then look at that "
              "window. Not responding? Then force it to close."),
            "let_op", knop=t("Geforceerd sluiten", "Force close"), actie=lambda: self.forceren_sleutel(sleutel, naam),
            seconden=60)

    def forceren_sleutel(self, sleutel: str, naam: str) -> None:
        """Pas op het moment van klikken kijken welke processen er nu bij dit programma horen."""
        taak = self.taak_van(sleutel)
        if taak is None:
            self.programmas.melding.toon(t(f"{naam} is al gesloten.", f"{naam} is already closed."), "goed", seconden=5)
            return
        self.forceren(taak)

    def forceren(self, taak: bt.Taak) -> None:
        if taak.beschermd:
            return
        naam, pids, eenheid = taak.naam, list(taak.pids), taak.eenheid if taak.soort == "app" else ""
        if self.draad.voorbeeld:   # (X1)
            self.programmas.melding.toon(t(f"{naam} is geforceerd gesloten.", f"{naam} was force closed."), "goed",
                                         seconden=5)
            return

        def werk() -> None:
            bt.stop(pids, hard=True)
            if eenheid and shutil.which("systemctl"):
                try:
                    subprocess.run(["systemctl", "--user", "kill", "--signal=SIGKILL", eenheid],
                                   capture_output=True, timeout=10)
                except (OSError, subprocess.SubprocessError):
                    pass

        self.op_achtergrond(werk, lambda _: self.programmas.melding.toon(
            t(f"{naam} is geforceerd gesloten.", f"{naam} was force closed."), "goed", seconden=5))

    # ------------------------------------------------- Details: beëindigen
    def beeindig_gekozen(self, hard: bool = False) -> None:
        """Eerst vragen (er kan werk verloren gaan, review 1). Een programma met vensters eerst netjes sluiten,
        zoals op het kruisje klikken; anders een stopverzoek (TERM). Geforceerd: meteen (KILL)."""
        regel = self.gekozen_regel()
        if regel is None or regel.beschermd:
            return
        naam = regel.naam
        if hard:
            vraag, uitleg, knop = (t("{naam} geforceerd beëindigen?", "Force {naam} to end?"),
                                   t("Het stopt meteen, zonder iets te vragen. Werk dat niet is opgeslagen gaat "
                                     "verloren.", "It stops at once, without asking anything. Work that is not saved "
                                     "will be lost."), t("Geforceerd beëindigen", "Force end"))
        else:
            vraag, uitleg, knop = (t("{naam} beëindigen?", "End {naam}?"),
                                   t("Werk dat niet is opgeslagen, kan verloren gaan.",
                                     "Work that is not saved may be lost."), t("Beëindigen", "End"))
        if not vraag_ja(self, vraag.replace("{naam}", naam), uitleg, knop, enter_is_nee=True):
            return
        self.beeindig_regel(regel, hard)

    def beeindig_regel(self, regel, hard: bool = False) -> None:
        naam, melding = regel.naam, self.details.melding
        if self.draad.voorbeeld:   # voorbeeldstand: niets sturen (X1)
            melding.toon((t("{naam} is geforceerd beëindigd.", "{naam} was forced to end.") if hard
                          else t("{naam} is beëindigd.", "{naam} has ended.")).replace("{naam}", naam), "goed",
                         seconden=5)
            return
        netjes = regel.app and not hard

        def werk() -> str:
            if netjes and self.sluit_vensters([regel.pid]):
                return "venster"
            return bt.beeindig(regel, hard)

        def klaar(uitkomst) -> None:
            if uitkomst in ("klaar", "venster") and hard:
                melding.toon(t("{naam} is geforceerd beëindigd.", "{naam} was forced to end.").replace("{naam}", naam),
                             "goed", seconden=5)
            elif uitkomst in ("klaar", "venster"):
                QTimer.singleShot(3000, lambda: self.nog_bezig(regel, uitkomst == "venster"))
            elif uitkomst == "weg":
                melding.toon(t("{naam} draait al niet meer.", "{naam} is no longer running.").replace("{naam}", naam),
                             "goed", seconden=5)
            elif uitkomst == "mag_niet":
                melding.toon(t("Dat mag niet: dit is niet van jou.", "Not allowed: this is not yours."), "fout")
            elif uitkomst != "beschermd":
                melding.toon(t("Beëindigen lukte niet. Probeer het opnieuw.", "Ending did not work. Try again."),
                             "fout")

        melding.toon(t("{naam} wordt beëindigd…", "Ending {naam}…").replace("{naam}", naam), seconden=6)
        self.op_achtergrond(werk, klaar)

    def nog_bezig(self, regel, venster: bool) -> None:
        naam, melding = regel.naam, self.details.melding
        if not bt.zelfde_proces(regel.pid, regel.start):
            melding.toon(t("{naam} is beëindigd.", "{naam} has ended.").replace("{naam}", naam), "goed", seconden=5)
            return
        if venster:
            tekst = t("{naam} draait nog. Vraagt het iets, bijvoorbeeld of je wilt opslaan? Kijk dan even in dat "
                      "venster. Reageert het niet? Beëindig het dan geforceerd.",
                      "{naam} is still running. Is it asking something, for example whether to save? Then look at "
                      "that window. Not responding? Then force it to end.")
        else:
            tekst = t("{naam} draait nog. Reageert het niet? Beëindig het dan geforceerd.",
                      "{naam} is still running. Not responding? Then force it to end.")
        # De knop kijkt bij het klikken opnieuw of het nog precies hetzelfde proces is (bt.beeindig doet dat).
        melding.toon(tekst.replace("{naam}", naam), "let_op", knop=t("Geforceerd beëindigen", "Force end"),
                     actie=lambda: self.beeindig_regel(regel, hard=True), seconden=60)

    @staticmethod
    def sluit_vensters(pids: list[int]) -> bool:
        """Vraag KWin (die de vensters beheert) om de vensters van deze programma's te sluiten."""
        if not shutil.which("gdbus"):
            return False
        map_ = Path(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir())
        naam = f"bugos-sluit-{os.getpid()}-{int(time.time() * 1000)}"
        script = map_ / f"{naam}.js"
        bus = ["gdbus", "call", "--session", "--dest", "org.kde.KWin"]
        try:
            script.write_text(bt.sluit_script(pids), encoding="utf-8")
            uit = subprocess.run(bus + ["--object-path", "/Scripting", "--method",
                                        "org.kde.kwin.Scripting.loadScript", str(script), naam],
                                 capture_output=True, text=True, timeout=5).stdout
            nummer = uit.strip("()\n ,").split(",")[0].strip()
            if not nummer.lstrip("-").isdigit() or int(nummer) < 0:
                return False
            subprocess.run(bus + ["--object-path", f"/Scripting/Script{nummer}", "--method", "org.kde.kwin.Script.run"],
                           capture_output=True, timeout=5)
            subprocess.run(bus + ["--object-path", "/Scripting", "--method", "org.kde.kwin.Scripting.unloadScript",
                                  naam], capture_output=True, timeout=5)
            return True
        except (OSError, subprocess.SubprocessError):
            return False
        finally:
            try:
                script.unlink()
            except OSError:
                pass

    def tweede_start(self, args: list[str]) -> None:
        """Naar de gevraagde pagina, ook als Taakbeheer al open was (U222)."""
        if "--prestaties" in args:
            self.ga_naar("prestaties")
        elif "--opstarten" in args:
            self.ga_naar("opstarten")
        elif "--details" in args:
            self.ga_naar("details")

    def closeEvent(self, e) -> None:  # noqa: N802
        self.stop_meten()
        for draad in list(self.draden):  # een lopend klusje eerst laten afmaken (hooguit een paar seconden)
            draad.wait(12000)
        super().closeEvent(e)


def main() -> int:
    app = maak_app("bugos-task-manager", "bugos-task-manager", sys.argv, een_keer=True)   # (U208)
    venster = Taakbeheer()
    venster.tweede_start(sys.argv[1:])
    return uitvoeren(app, venster)


if __name__ == "__main__":
    sys.exit(main())
