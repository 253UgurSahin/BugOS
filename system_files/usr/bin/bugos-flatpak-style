#!/usr/bin/bash
# bugos-flatpak-style - zorgt dat apps uit de Winkel (Flatpak) er ook als BugOS uitzien.
#
# Jip-en-Janneke: een Flatpak-app zit in een eigen doos en ziet de stijl van
# BugOS niet vanzelf. Voor elke "fundering" (runtime) die op de computer staat,
# zet dit script het passende stijl-stukje erbij:
#   - KDE-apps (Qt): de Kvantum-stijl (org.kde.KStyle.Kvantum, per KDE-versie);
#   - GTK-apps: het Breeze-GTK-thema (org.gtk.Gtk3theme.Breeze), waar BugOS zijn
#     kleuren en vormen bovenop zet (zie bugos-theme).
# De kleuren en vormen zelf komen uit de map van de gebruiker; bugos-theme geeft
# Flatpak-apps toegang tot die bestanden (alleen lezen).
#
# Draait als systeemdienst: na bugos-first-boot en elke dag na het bijwerken
# van de apps (bugos-update-apps.service). Lukt iets niet (geen internet, of
# geen stijl voor die KDE-versie), dan gaat de rest gewoon door.

set -u
command -v flatpak >/dev/null 2>&1 || exit 0
flatpak remotes --system --columns=name 2>/dev/null | grep -qx flathub || exit 0

WIL=()
GTK=0
while read -r id tak; do
    case "$id" in
    org.kde.Platform) WIL+=("org.kde.KStyle.Kvantum//$tak") ;;
    org.gnome.Platform | org.freedesktop.Platform) GTK=1 ;;
    esac
done < <(flatpak list --system --runtime --columns=application,branch 2>/dev/null)
[ "$GTK" = 1 ] && WIL+=("org.gtk.Gtk3theme.Breeze//3.22")

for ref in "${WIL[@]}"; do
    flatpak info --system "$ref" >/dev/null 2>&1 && continue
    flatpak install --system --noninteractive --assumeyes flathub "$ref" >/dev/null 2>&1 ||
        echo "BugOS: stijl $ref is (nog) niet te krijgen; de app gebruikt dan de standaardstijl." >&2
done
exit 0
