#!/usr/bin/python3
"""BugOS Back-up - je bestanden veilig op een USB-schijf, met één knop.

Jip-en-Janneke:
  1. Steek een USB-schijf in.
  2. Druk op "Maak back-up".
  3. Je documenten, foto's, muziek, video's, bureaublad en downloads worden
     gekopieerd naar de map "BugOS-Backup" op die schijf.
Er wordt nooit iets weggegooid: niet op je computer en niet op de schijf.
Terugzetten kan ook met één knop.

  bugos-backup                     -> het venster
  bugos-backup --maak <schijfmap>  -> zonder venster (voor wie wil automatiseren)
"""

import getpass
import json
import os
import re
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path

sys.path.insert(0, "/usr/lib/bugos/python")

from bugos_ui import CONFIG, platte_tip, t  # noqa: E402
from bugos_files_acties import dubbele_namen, kent_hoofdletters, vrije_naam  # noqa: E402

LOG = CONFIG / "backup.json"

# (xdg-naam, standaard-mapnaam) - de echte naam hangt af van de taal.
MAPPEN = [
    ("DOCUMENTS", "Documents"),
    ("PICTURES", "Pictures"),
    ("MUSIC", "Music"),
    ("VIDEOS", "Videos"),
    ("DESKTOP", "Desktop"),
    ("DOWNLOAD", "Downloads"),
]


def gebruikersmap(xdg: str, standaard: str) -> Path:
    """Vraag aan het systeem waar bijvoorbeeld 'Afbeeldingen' staat."""
    # Alleen de vaste soorten: de naam gaat naar xdg-user-dir (een sh-script), en kan uit een bestand op een
    # stick van iemand anders komen (U097).
    if xdg not in {"DOCUMENTS", "PICTURES", "MUSIC", "VIDEOS", "DESKTOP", "DOWNLOAD"}:
        return Path.home() / standaard
    try:
        uit = subprocess.run(["xdg-user-dir", xdg], capture_output=True, text=True, timeout=5).stdout.strip()
        if uit and Path(uit) != Path.home():
            return Path(uit)
    except (OSError, subprocess.SubprocessError):
        pass
    return Path.home() / standaard


def bron_mappen() -> list[Path]:
    return [p for p in (gebruikersmap(x, s) for x, s in MAPPEN) if p.is_dir()]


LIJSTJE = "bugos-mappen.json"  # in de back-up: welke map welke soort is ({"PICTURES": "Afbeeldingen", ...})


def schrijf_lijstje(doel: Path) -> None:
    """Onthoud bij de back-up dat bijv. 'Afbeeldingen' de map PICTURES is. Dan komt hij bij het
    terugzetten in de juiste map, ook als de nieuwe computer Engels is ('Pictures')."""
    lijstje = {x: m.name for x, s in MAPPEN if (m := gebruikersmap(x, s)).is_dir()}
    try:
        (doel / LIJSTJE).write_text(json.dumps(lijstje, ensure_ascii=False))
    except OSError:
        pass


def _soort_van(bron: Path) -> dict[str, str]:
    """Welke map in de back-up welke soort is ({'Afbeeldingen': 'PICTURES', ...}), uit het lijstje van de back-up."""
    try:
        lijstje = json.loads((bron / LIJSTJE).read_text())
    except (OSError, ValueError):
        lijstje = {}
    # Het lijstje staat op de stick: alleen de bekende soorten met een gewone mapnaam gebruiken (U097).
    soorten = {x for x, _s in MAPPEN}
    if not isinstance(lijstje, dict):
        lijstje = {}
    soort_van = {naam: xdg for xdg, naam in lijstje.items()
                 if xdg in soorten and isinstance(naam, str) and naam and "/" not in naam and naam not in (".", "..")}
    soort_van.update({s: x for x, s in MAPPEN if s not in soort_van})  # oude back-ups: de Engelse namen
    return soort_van


def _doelmap(mapnaam: str, soort_van: dict[str, str], thuis: Path) -> Path:
    """De echte map op deze computer voor een map uit de back-up ('Afbeeldingen' -> ~/Pictures op een Engelse pc)."""
    xdg = soort_van.get(mapnaam)
    standaard = next((s for x, s in MAPPEN if x == xdg), mapnaam)
    return gebruikersmap(xdg, standaard) if xdg else thuis / mapnaam


def terug_opdrachten(bron: Path, thuis: Path) -> list[list[str]]:
    """Per map in de back-up één rsync, naar de echte map op deze computer."""
    soort_van = _soort_van(bron)
    opdrachten = []
    try:
        mappen = sorted(p for p in bron.iterdir() if p.is_dir())
    except OSError:
        return []
    for m in mappen:
        if m.name.startswith("."):
            continue   # verborgen mappen (bijv. .config) maakt de back-up niet; die zetten we ook niet terug (U097)
        opdrachten.append(rsync_terug(m, _doelmap(m.name, soort_van, thuis)))
    return opdrachten


def een_terug_doel(bron: Path, ding: Path, thuis: Path) -> Path | None:
    """D-12: waar één bestand of map uit de back-up op deze computer komt. 'ding' ligt in de back-up 'bron'
    (bijv. <stick>/BugOS-Backup/test@bugos/Afbeeldingen/Vakantie/zee.jpg); het komt op dezelfde plek in de echte map
    (~/Afbeeldingen/Vakantie/zee.jpg). Staat daar al iets, dan 'zee (2).jpg': terugzetten overschrijft nooit iets,
    net als de rest van BugOS. None: het ligt niet in een map van de back-up (de back-up zelf, of daarbuiten, ook
    niet via een snelkoppeling die de back-up uit wijst)."""
    try:
        rel = ding.resolve().relative_to(bron.resolve())
    except (OSError, ValueError):
        return None
    if not rel.parts or rel.parts[0].startswith(".") or rel.parts[0] == LIJSTJE:
        return None
    doel = _doelmap(rel.parts[0], _soort_van(bron), thuis).joinpath(*rel.parts[1:])
    return vrije_naam(doel)


def een_terug_opdracht(ding: Path, doel: Path) -> list[str]:
    """De rsync voor één bestand of map (D-12). Een map met / erachter: de inhoud komt in de nieuwe map 'doel'.
    doel bestaat nooit (een_terug_doel koos een vrije naam), dus er wordt niets overschreven."""
    if ding.is_dir() and not ding.is_symlink():
        return ["rsync", "-rtl", "--info=progress2", "--no-inc-recursive", f"{ding}/", f"{doel}/"]
    return ["rsync", "-tl", "--info=progress2", str(ding), str(doel)]


def schijven() -> list[Path]:
    """Alle aangesloten USB-schijven en losse schijven waarop je mag schrijven."""
    if os.environ.get("BUGOS_SCHIJVEN"):  # voor tests en screenshots
        return [Path(p) for p in os.environ["BUGOS_SCHIJVEN"].split(":") if Path(p).is_dir()]
    # Een stick die er net in zit, is nog dicht (KDE opent hem niet vanzelf): eerst openzetten (U139).
    try:
        import bugos_drives
        bugos_drives.losse_openen_op_achtergrond()
    except Exception:  # noqa: BLE001  zonder udisks/lsblk gewoon kijken wat er al open is
        pass
    gebruiker = getpass.getuser()
    gevonden = schijven_in((Path("/run/media") / gebruiker, Path("/media") / gebruiker, Path("/media")))
    # Eén keer lsblk lezen voor alle vragen: welke schijven zitten ín de computer, en zit er een stick in die
    # BugOS (nog) niet kan gebruiken: leeg (B008), alleen-lezen of onleesbaar (dan kun je hem leegmaken).
    ruw = alle_ruw()
    lijst = alle_schijven(ruw)
    interne = interne_plekken(lijst)
    LAATSTE_INTERNE.clear()
    LAATSTE_INTERNE.update(interne)
    LAATSTE_RUW[:] = ruw or []
    LAATSTE_LIJST[:] = lijst or []
    LAATSTE_BIJZONDER[:] = bijzondere_sticks(ruw, lijst, in_gebruik(), ZICHT)
    return zonder_interne(gevonden, interne)


def alle_ruw() -> list | None:
    """Wat lsblk over alle schijven zegt (de ruwe lijst), of None als dat hier niet kan."""
    try:
        import bugos_drives
        return bugos_drives.lees_lsblk()
    except Exception:  # noqa: BLE001  zonder lsblk: niets weten
        return None


def alle_schijven(ruw: list | None = None) -> list | None:
    """Alle schijven volgens bugos_drives, of None als dat hier niet kan (geen lsblk, een test).
    ruw: wat lsblk al zei (dan niet nog eens lezen)."""
    try:
        import bugos_drives
        return bugos_drives.schijven(ruw) if ruw is not None else bugos_drives.schijven()
    except Exception:  # noqa: BLE001  zonder lsblk: niets weten
        return None


def in_gebruik() -> set[str]:
    """De hele schijven (sdb, ...) die het systeem zelf gebruikt (BugOS draait ervan, /etc/fstab, swap). Die
    worden nooit gewist, wat lsblk er ook over zegt. Weet het niet zeker (geen /proc)? Dan een lege set: de andere
    controles (systeemplekken in lsblk) gelden nog steeds."""
    try:
        import bugos_drives
        return bugos_drives.stations_in_gebruik()
    except Exception:  # noqa: BLE001
        return set()


LAATSTE_RUW: list = []        # wat lsblk de laatste keer zei
LAATSTE_LIJST: list = []      # de schijven van bugos_drives, van de laatste keer kijken
LAATSTE_BIJZONDER: list = []  # de sticks die BugOS nog niet kan gebruiken (zie bijzondere_sticks)
ZICHT: dict[str, int] = {}    # hoe vaak achter elkaar een stick er onbruikbaar uitzag (zie bijzondere_sticks)


def nieuwe_sticks(lijst: list | None) -> list:
    """B008: een nieuwe of gewiste stick heeft nog geen bestandssysteem. Hij gaat dan niet open, dus hij stond niet
    in de lijst, en Back-up bleef 'Steek een USB-schijf in' zeggen terwijl hij erin zat. bugos_drives ziet zo'n
    stick wel (nieuw=True, net als bij 'In gebruik nemen' in Bestanden). Alleen schijven die je eruit haalt: een
    lege schijf ín de computer hoort niet bij een back-up (U226); die maak je klaar in Bestanden."""
    return [s for s in lijst or [] if getattr(s, "nieuw", False) and getattr(s, "los", False)]


def los_station(st: dict) -> bool:
    """Is dit (een regel van lsblk voor een hele schijf) iets wat je eruit haalt: een USB-stick, een externe
    schijf of een SD-kaart? Dezelfde regels als bugos_drives.schijven, want die lijst noemt een onleesbare stick
    niet, en die willen we hier juist vinden."""
    import bugos_drives
    naam = st.get("name") or ""
    if st.get("type") != "disk" or naam.startswith(("zram", "loop", "ram", "nbd")):
        return False
    if naam.startswith("mmcblk"):
        return not re.fullmatch(r"mmcblk\d+(boot\d+|rpmb)", naam) and bugos_drives.mmc_soort(naam) != "MMC"
    return bool(st.get("rm") or st.get("hotplug") or st.get("tran") == "usb")


def station_id(st: dict) -> tuple:
    """Waaraan je dezelfde stick herkent: plek, grootte, merk en indeling. Zit er na de vraag een andere stick op
    dezelfde plek (/dev/sdb), dan klopt dit niet meer en wordt er niets gewist (zoals in Bestanden, U369)."""
    return (st.get("path"), st.get("size"), (st.get("model") or "").strip(), st.get("ptuuid"))


@dataclass
class Bijzonder:
    """Een stick die erin zit maar waar je (nog) geen back-up op kunt zetten.

    soort: 'leeg' (nooit klaargemaakt, B008), 'alleen-lezen' (open, maar je mag er niet op schrijven, bv. een oude
    installatiestick) of 'onleesbaar' (BugOS kan hem niet openen: onbekend of kapot bestandssysteem)."""
    soort: str
    station: str           # de hele stick, bv. /dev/sdb: die wordt helemaal opnieuw ingedeeld
    naam: str              # wat je ziet, bv. "USB-stick (16 GB)"
    id: tuple              # station_id, om vlak voor het wissen te controleren
    delen: list = field(default_factory=list)   # de stukken van bugos_drives op deze stick (om eerst dicht te doen)


def bijzondere_sticks(ruw: list | None, lijst: list | None, gebruikt: set[str], zicht: dict[str, int]) -> list:
    """De sticks die erin zitten maar die Back-up niet in de lijst kan zetten, met wat eraan te doen is.

    Nooit: een schijf in de computer, een stick waar BugOS zelf van draait of die het systeem gebruikt (gebruikt,
    of een systeemplek in lsblk), en een versleutelde stick die nog op slot zit (dan eerst het wachtwoord, niet
    wissen). 'alleen-lezen' en 'onleesbaar' pas als de stick er twee keer achter elkaar zo uitzag (zicht telt):
    een stick die er net in zit, is de eerste seconden nog dicht, en dan moet er niet 'onleesbaar' flitsen."""
    import bugos_drives
    lijst = lijst or []
    uit: list = []
    nu_gezien: set[str] = set()
    for s in nieuwe_sticks(lijst):
        st = next((r for r in ruw or [] if r.get("path") == s.station), {})
        uit.append(Bijzonder("leeg", s.station, s.naam, station_id(st) if st else (s.station,), [s]))
    for st in ruw or []:
        pad = st.get("path") or ""
        if not pad or not los_station(st) or any(b.station == pad for b in uit):
            continue
        if os.path.basename(pad) in gebruikt or \
                any(bugos_drives.systeem_plek(m) for a in bugos_drives._alle(st) for m in bugos_drives._plekken_van(a)):
            continue   # BugOS draait ervan, of het systeem gebruikt hem: nooit aanbieden om te wissen
        if not (bugos_drives._getal(st.get("size")) or 0):
            continue   # een kaartlezer zonder kaart: 0 bytes, niets om te doen
        delen = [s for s in lijst if s.station == pad]
        if any(s.op_slot for s in delen):
            continue   # versleuteld en op slot: eerst openen met het wachtwoord, niet wissen
        if any(s.wortel and os.access(s.wortel, os.W_OK) for s in delen):
            continue   # (een stuk van) deze stick is gewoon bruikbaar: hij staat al in de lijst
        soort = "alleen-lezen" if any(s.wortel for s in delen) else "onleesbaar"
        nu_gezien.add(pad)
        zicht[pad] = zicht.get(pad, 0) + 1
        if zicht[pad] < 2:
            continue
        maat = bugos_drives.mooie_maat(bugos_drives._getal(st.get("size")) or 0)
        naam = delen[0].naam if delen else t(f"USB-stick ({maat})", f"USB stick ({maat})")
        uit.append(Bijzonder(soort, pad, naam, station_id(st), delen))
    for pad in list(zicht):
        if pad not in nu_gezien:
            del zicht[pad]   # eruit, of nu bruikbaar: de volgende keer telt weer vanaf nul
    return uit


def gekozen_stick(schijf: Path, lijst: list) -> object | None:
    """Het stuk van bugos_drives bij de gekozen map (bv. /run/media/jij/STICK), als dat een stick, externe schijf of
    SD-kaart is. Een schijf in de computer niet: die wis je hier nooit (dat kan in Bestanden, met meer vragen)."""
    echt = _echt(schijf)
    return next((s for s in lijst if s.wortel and _echt(s.wortel) == echt and s.los and s.soort != "cd"), None)


def wis_stappen(station: str, delen: list, naam: str) -> list[list[str]]:
    """Alles op een stick wissen en hem opnieuw klaarmaken: eerst elk open stuk dicht (en een open versleuteld stuk
    weer op slot), dan de hele stick opnieuw indelen met één stuk exFAT (werkt ook op Windows en Mac), en openen.
    De hele stick, niet alleen het stuk dat je zag: een oude installatiestick heeft er meer, en die moeten ook weg,
    anders blijft hij half bruikbaar. De vraag ervoor zegt dat ook ('alles op deze stick')."""
    import bugos_drives
    stappen: list[list[str]] = []
    for s in delen:
        stappen += bugos_drives.dicht_stappen(s)
    schoon = bugos_drives.Schijf(apparaat=station, naam=naam, soort="stick", station=station)
    return stappen + bugos_drives.klaarmaak_stappen(schoon, naam)


def zelfde_stick(station: str, voor: tuple, mag_open: bool = False) -> bool:
    """De laatste controle vlak vóór het wissen (na het dichtzetten): zit precies dezelfde stick er nog, is het nog
    steeds iets wat je eruit haalt, gebruikt het systeem hem niet, en staat er niets meer open? Nee: niets wissen.
    mag_open: de eerste controle, meteen na de vraag (dan staat de stick nog open; dichtzetten komt daarna)."""
    import bugos_drives
    st = next((r for r in bugos_drives.lees_lsblk() if r.get("path") == station), None)
    if st is None or station_id(st) != voor or not los_station(st):
        return False
    if os.path.basename(station) in in_gebruik():
        return False
    return mag_open or not any(bugos_drives._plekken_van(a) for a in bugos_drives._alle(st))


# De naam die een stick krijgt na het klaarmaken of leegmaken. exFAT: hoogstens 11 tekens (zo staat het in
# bugos_drives.MAX_NAAM: udisks weigert een langere naam, en dan mislukt het formatteren).
BACKUP_NAAM = ("Back-up", "Backup")


def schijven_in(basissen, is_koppel=os.path.ismount) -> list[Path]:
    """De schijven in deze mappen (/run/media/<jij>, /media/<jij>, /media), elk één keer.
    D-11: op Fedora is /media een koppeling naar run/media. Dan stond dezelfde schijf er twee keer in, als
    /run/media/test/USBSTICK en als /media/test/USBSTICK; de ene herkende BugOS als 'zit in de computer: alleen
    terugzetten', de andere niet ('heeft al een back-up', en je kon er een back-up op maken). Het echte pad telt,
    één keer, met de eerste naam (die van /run/media, zoals KDE en lsblk hem ook noemen).
    is_koppel: voor de test (een tijdelijke map is geen koppelpunt)."""
    gevonden: list[Path] = []
    gezien: set[Path] = set()
    for basis in basissen:
        try:
            if not basis.is_dir():
                continue
            kandidaten = sorted(basis.iterdir())
        except OSError:
            continue
        for p in kandidaten:
            try:
                if not (p.is_dir() and os.access(p, os.W_OK) and is_koppel(p)):
                    continue
                echt = p.resolve()
            except OSError:   # een stick die net uitgetrokken wordt
                continue
            if echt not in gezien:
                gezien.add(echt)
                gevonden.append(p)
    return gevonden


def _echt(pad) -> str:
    """Het echte pad (zonder koppelingen zoals /media -> run/media), om plekken te vergelijken (D-11)."""
    try:
        return str(Path(pad).resolve())
    except (OSError, RuntimeError):
        return str(pad)


LAATSTE_INTERNE: set[str] = set()   # de schijven in de computer, van de laatste keer kijken


def interne_plekken(lijst: list | None = None) -> set[str]:
    """Waar de schijven ín de computer open staan (een tweede schijf, de Windows-schijf).
    lijst: de schijven die schijven() al las (dan niet nog een keer lsblk); zonder lijst leest hij ze zelf."""
    if lijst is None:
        lijst = alle_schijven()
    return {s.wortel for s in lijst or [] if s.soort == "intern" and s.wortel}


def zonder_interne(paden: list[Path], interne: set[str]) -> list[Path]:
    """Een back-up hoort op iets wat je eruit haalt: gaat de computer kapot, dan ook een schijf erin (U226).
    Staat er al een back-up op een schijf in de computer (van vroeger)? Dan blijft hij, om terug te zetten (U231)."""
    # Vergelijken op het echte pad: /media/<jij>/X is dezelfde schijf als /run/media/<jij>/X (D-11).
    echt_intern = {_echt(i) for i in interne}
    return [p for p in paden if _echt(p) not in echt_intern or backups_op(p)]


def alleen_terugzetten(schijf: Path) -> bool:
    """Een schijf in de computer: daar kun je wel een oude back-up van terugzetten, maar geen nieuwe op maken.
    Op het echte pad, zodat een andere naam voor dezelfde schijf er niet langs komt (D-11)."""
    return _echt(schijf) in {_echt(i) for i in LAATSTE_INTERNE}


HOSTNAAM = Path("/etc/hostname")


def computernaam() -> str:
    """De vaste naam van de computer. Niet de naam die het netwerk geeft (school, kantoor): die wisselt, en dan
    begon elke back-up in een nieuwe map, helemaal opnieuw (U228)."""
    try:
        naam = HOSTNAAM.read_text(encoding="utf-8").strip()
    except OSError:
        naam = ""
    return naam or "bugos"   # zonder eigen naam heet BugOS 'bugos' (DEFAULT_HOSTNAME)


def backup_doel(schijf: Path) -> Path:
    return schijf / "BugOS-Backup" / f"{getpass.getuser()}@{computernaam()}"


MAANDEN = (("januari", "January"), ("februari", "February"), ("maart", "March"), ("april", "April"), ("mei", "May"),
           ("juni", "June"), ("juli", "July"), ("augustus", "August"), ("september", "September"),
           ("oktober", "October"), ("november", "November"), ("december", "December"))


def _volle_naam(gebruiker: str) -> str:
    """De naam die je bij het installeren gaf ('Test'), uit /etc/passwd; anders de gebruikersnaam met een hoofdletter."""
    try:
        import pwd
        volle = pwd.getpwnam(gebruiker).pw_gecos.split(",")[0].strip()
    except (ImportError, KeyError, OSError):
        volle = ""
    return volle or (gebruiker[:1].upper() + gebruiker[1:])


def backup_tijd(bron: Path) -> float | None:
    """Wanneer deze back-up voor het laatst gemaakt is: het lijstje wordt bij elke back-up opnieuw geschreven."""
    for p in (bron / LIJSTJE, bron):
        try:
            return p.stat().st_mtime
        except OSError:
            continue
    return None


def mooie_naam(bron: Path) -> str:
    """D-12: een gewone naam voor een back-up: 'Back-up van Test, 16 november 13:20', niet "'test@bugos'". De map
    heet <gebruiker>@<computer>. Is de computer een andere dan deze, dan zeggen we dat erbij ('van Test op
    oude-laptop'): zo zie je welke van de back-ups op een familiestick van jou is. De delen komen van de stick: die
    tonen we letterlijk (platte_tip in de vraag), en de map is nooit '/' of iets geks (de lijst komt van iterdir)."""
    wie, _, computer = bron.name.partition("@")
    naam = _volle_naam(wie) if wie == getpass.getuser() else (wie[:1].upper() + wie[1:])
    if computer and computer != computernaam():
        kop = t("Back-up van {naam} op {computer}", "Backup of {naam} on {computer}").replace(
            "{naam}", naam).replace("{computer}", computer)
    else:
        kop = t("Back-up van {naam}", "Backup of {naam}").replace("{naam}", naam)
    tijd = backup_tijd(bron)
    if tijd is None:
        return kop
    d = time.localtime(tijd)
    maand = t(*MAANDEN[d.tm_mon - 1])
    jaar = f" {d.tm_year}" if d.tm_year != time.localtime().tm_year else ""
    return f"{kop}, {d.tm_mday} {maand}{jaar} {d.tm_hour:02d}:{d.tm_min:02d}"


def terug_vraag(bron: Path) -> str:
    """De vraag voor het terugzetten, met de naam van de back-up. Is hij van een ander account (een gedeelde
    familiestick), dan zeggen we dat erbij: anders kwamen papa's bestanden stil in jouw map (U434).
    Vaste zinnen (te vertalen) met {naam}/{wie} erin; de naam komt van de stick, dus letterlijk tonen (U442)."""
    # Met een gewone naam (D-12): 'Back-up van Test, 16 november 13:20' in plaats van 'test@bugos'.
    tekst = t("De bestanden uit '{naam}' komen terug op je computer. Een bestand dat op je computer "
              "ouder is dan in de back-up, wordt vervangen. Nieuwere bestanden op je computer blijven staan.",
              "The files from '{naam}' come back to your computer. A file that is older on your "
              "computer than in the backup is replaced. Newer files on your computer are kept.").replace(
                  "{naam}", mooie_naam(bron))
    wie = bron.name.split("@", 1)[0]
    if wie != getpass.getuser():
        tekst += "\n\n" + t("Let op: deze back-up is van '{wie}', niet van jou. Zijn of haar bestanden komen dan in "
                             "jouw map.", "Note: this backup is from '{wie}', not from you. Their files will then "
                             "end up in your folder.").replace("{wie}", wie)
    return platte_tip(tekst)


def backups_op(schijf: Path) -> list[Path]:
    """Alle back-ups op deze schijf, die van deze computer eerst. Na opnieuw installeren of op een
    nieuwe pc heet de computer (of de gebruiker) vaak anders: die back-ups moet je ook terug kunnen zetten."""
    eigen = backup_doel(schijf)
    try:
        alle = sorted(p for p in (schijf / "BugOS-Backup").iterdir() if p.is_dir())
    except OSError:
        return []
    return sorted(alle, key=lambda p: p != eigen)


def rsync_maak(bron: Path, doel: Path, overslaan: list[str] | tuple = ()) -> list[str]:
    # Geen --delete: wat ooit in de back-up staat, blijft daar staan.
    # --modify-window: USB-schijven (FAT/exFAT) onthouden tijd minder precies.
    # -l: snelkoppelingen (symlinks) gaan ook mee (op FAT/exFAT kan dat niet; dan zegt rsync 23: "deels").
    # overslaan: paden (binnen 'bron') die niet mee kunnen, zie dubbel_op_schijf.
    weg = [f"--exclude=/{_rsync_letterlijk(r)}" for r in overslaan]
    return ["rsync", "-rtl", "--modify-window=2", "--info=progress2", "--no-inc-recursive", *weg,
            f"{bron}/", f"{doel / bron.name}/"]


def _rsync_letterlijk(pad: str) -> str:
    """Een pad als rsync-patroon dat precies dat pad betekent (* ? [ en \\ niet als jokerteken)."""
    return "".join("\\" + c if c in "*?[\\" else c for c in pad)


def dubbel_op_schijf(schijf: Path, mappen: list[Path], doel: Path | None = None) -> dict[Path, list[str]]:
    """Kent de schijf geen hoofdletters (FAT/exFAT), dan zou 'IMG_1.JPG' 'img_1.jpg' overschrijven.
    Geeft per map de tweede van zo'n paar (relatief), die laten we dan buiten de back-up (en zeggen dat).
    Staat er van zo'n paar al één in de back-up (doel), dan blijft díe; de ander gaat niet mee
    (anders zou de nieuwe de oude in de back-up vervangen)."""
    if kent_hoofdletters(schijf):
        return {}
    uit = {}
    for m in mappen:
        dubbel = [os.path.relpath(p, m) for p in _dubbel_in(m, m, doel)] if m.is_dir() else []
        if dubbel:
            uit[m] = dubbel
    return uit


def _dubbel_in(basis: Path, m: Path, doel: Path | None) -> list[Path]:
    """Wat er in 'basis' (ook dieper) niet mee kan. Blijft een map staan omdat hij al in de back-up staat,
    dan kijken we ook daarbinnen (anders kan daar weer een naamgenoot de oude in de back-up vervangen)."""
    uit = []
    for p in dubbele_namen(basis):
        overslaan, behouden = p, None
        if doel is not None:
            try:
                al_daar = set(os.listdir(doel / m.name / os.path.relpath(p.parent, m)))
            except OSError:
                al_daar = set()
            broers = [n for n in os.listdir(p.parent) if n != p.name and n.casefold() == p.name.casefold()]
            if p.name in al_daar and broers and not any(b in al_daar for b in broers):
                overslaan, behouden = p.parent / broers[0], p   # deze staat al in de back-up: de andere gaat niet mee
        uit.append(overslaan)
        if behouden is not None and behouden.is_dir() and not behouden.is_symlink():
            uit += _dubbel_in(behouden, m, doel)
    return uit


def rsync_terug(doel: Path, thuis: Path) -> list[str]:
    # --update: een nieuwer bestand op de computer wordt nooit overschreven. Maar rsync vervangt een bestand altijd als
    # de back-up op die plek een map of snelkoppeling heeft (ander soort): dan het oude bewaren met een naam erachter
    # (--backup), in een map 'Vervangen bij terugzetten <datum tijd>' in die map (Documenten, Afbeeldingen…), zodat
    # terugzetten nooit iets van je computer laat verdwijnen (U371). Met de tijd erbij: een tweede keer terugzetten op
    # dezelfde dag overschrijft niet wat de eerste keer bewaarde (U381).
    stempel = time.strftime("%Y-%m-%d %H.%M.%S")
    bewaar = thuis / t(f"Vervangen bij terugzetten {stempel}", f"Replaced when restoring {stempel}")
    return ["rsync", "-rtl", "--update", "--backup", f"--backup-dir={bewaar}", "--modify-window=2",
            "--info=progress2", "--no-inc-recursive", f"{doel}/", f"{thuis}/"]


def ruimte_genoeg(schijf: Path, mappen: list[Path], doel: Path | None = None,
                  stop=None) -> tuple[bool, int, int]:
    """Past wat er nog gekopieerd moet worden? Wat al (even groot) in de back-up staat, telt niet mee:
    rsync kopieert alleen wat nieuw of veranderd is. Bij veel bestanden duurt dit even: het venster
    doet het op de achtergrond, en 'stop' (een threading.Event) breekt het tellen af."""
    nodig = 0
    for m in mappen:
        for wortel, _, bestanden in os.walk(m):
            if stop is not None and stop.is_set():
                return False, nodig, 0
            for b in bestanden:
                bron = Path(wortel) / b
                try:
                    grootte = bron.stat().st_size
                except OSError:
                    continue
                if doel is not None:
                    try:
                        oud = (doel / m.name / bron.relative_to(m)).stat().st_size
                    except (OSError, ValueError):
                        oud = None
                    if oud == grootte:
                        continue  # staat er al
                # Nieuw of veranderd: rsync schrijft eerst een volledige kopie (en gooit dan pas de oude weg).
                nodig += grootte
    vrij = shutil.disk_usage(str(schijf)).free
    return nodig < vrij, nodig, vrij


def wegschrijven(doel: Path) -> list[str]:
    """De laatste stap: alles echt naar de schijf schrijven. Tot dan zit een deel nog in het geheugen
    van de computer, en wie de schijf er dan uittrekt, mist dat stuk. Dit kan even duren."""
    return ["sync", "-f", str(doel)]


def onthoud(schijf: Path) -> None:
    """De datum van de back-up bewaren. Lukt dat niet (je computer is vol), dan is de back-up zelf toch klaar:
    geen fout naar boven, anders bleef het venster op 'Niet uittrekken' hangen (U410)."""
    try:
        CONFIG.mkdir(parents=True, exist_ok=True)
        tijdelijk = LOG.with_name(LOG.name + ".nieuw")
        tijdelijk.write_text(json.dumps({"schijf": str(schijf), "tijd": int(time.time())}))
        os.replace(tijdelijk, LOG)
    except OSError:
        pass


def laatste_backup() -> str:
    try:
        d = json.loads(LOG.read_text())
        # Kalenderdagen, niet blokken van 24 uur (maandag 22:00 is dinsdagochtend 'gisteren'); en na een klok die
        # terugsprong (dubbel opstarten met Windows) niet '-1 dagen geleden' (U444).
        import datetime as _dt
        dagen = max((_dt.date.today() - _dt.date.fromtimestamp(int(d["tijd"]))).days, 0)
        if dagen == 0:
            return t("Laatste back-up: vandaag", "Last backup: today")
        if dagen == 1:
            return t("Laatste back-up: gisteren", "Last backup: yesterday")
        return t(f"Laatste back-up: {dagen} dagen geleden", f"Last backup: {dagen} days ago")
    except (OSError, ValueError, KeyError):
        return t("Je hebt nog nooit een back-up gemaakt.", "You have never made a backup.")


# rsync: 0 = goed, 24 = een bestand verdween tijdens het kopiëren (geen probleem),
# 23 = sommige bestanden konden niet mee (bijv. een naam met : of ? of groter dan 4 GB op een
# FAT32-stick). Bij 23 gaan we gewoon door met de volgende mappen en zeggen we het erbij.
GOED, DEELS = (0, 24), (23,)


def uitslag(code: int, cmd: list[str], uitvoer: str = "") -> str:
    """'goed', 'deels', 'vol', 'alleen-lezen' of 'weg' (de schijf of map waar het vandaan komt is er niet meer) of 'fout'.
    rsync geeft ook 23 als de bronmap verdwenen is (stick eruit): dat is niet 'een paar bestanden' (U078).
    Een schijf die alleen gelezen kan worden (schuifje, of na een schijffout) geeft ook 23: dan ging er niets mee (U409)."""
    if code not in GOED and "No space left on device" in uitvoer:
        return "vol"
    if code not in GOED and "Read-only file system" in uitvoer:
        return "alleen-lezen"
    if code in GOED:
        return "goed"
    try:
        weg = not Path(cmd[-2]).exists()
    except OSError:   # een stick die eruit is, kan ook een leesfout geven
        weg = True
    if weg:
        return "weg"
    return "deels" if code in DEELS else "fout"

ALLEEN_LEZEN = t("Op deze schijf kan niets geschreven worden (hij is beveiligd tegen schrijven, of er zit een fout op). "
                 "Kies een andere schijf, of kijk hem na op een andere computer.",
                 "Nothing can be written to this drive (it is write-protected, or it has an error). "
                 "Choose another drive, or check it on another computer.")

DEELS_UITLEG = t("Een paar bestanden konden niet mee: {mappen}. Dat komt meestal door een naam met : ? * of \", "
                 "een bestand groter dan 4 GB op een FAT32-schijf, of twee namen die alleen in hoofdletters "
                 "verschillen (zo'n schijf ziet dat als hetzelfde). De rest staat er wel.",
                 "A few files could not be copied: {mappen}. Usually a name with : ? * or \", a file larger "
                 "than 4 GB on a FAT32 drive, or two names that differ only in capitals (such a drive sees "
                 "them as the same). Everything else is there.")


def zonder_venster(schijf: Path) -> int:
    doel = backup_doel(schijf)
    try:
        doel.mkdir(parents=True, exist_ok=True)
    except OSError:
        return 1
    schrijf_lijstje(doel)
    mappen = bron_mappen()
    dubbel = dubbel_op_schijf(schijf, mappen, doel)
    deels = [m.name for m in dubbel]
    for m in mappen:
        cmd = rsync_maak(m, doel, dubbel.get(m, ()))
        r = subprocess.run(cmd, stderr=subprocess.PIPE, text=True, errors="replace")
        sys.stderr.write(r.stderr)
        soort = uitslag(r.returncode, cmd, r.stderr)
        if soort == "deels":
            if m.name not in deels:
                deels.append(m.name)
        elif soort != "goed":
            if soort == "vol":
                print(t("De schijf is vol.", "The drive is full."), file=sys.stderr)
            elif soort == "alleen-lezen":
                print(ALLEEN_LEZEN, file=sys.stderr)
            return 1
    if subprocess.call(wegschrijven(doel)) != 0:
        return 1
    onthoud(schijf)
    if deels:
        print(DEELS_UITLEG.format(mappen=", ".join(deels)), file=sys.stderr)
        return 2
    return 0


# ------------------------------------------------------------------ venster ----

def kies_in_backup(ouder, bron: Path) -> Path | None:
    """D-12: kies één bestand of map in de back-up. Een eigen venstertje met de mappen van de back-up als boom (geen
    gewone 'Openen'-dialoog: die kiest óf een bestand óf een map, en laat je overal heen bladeren, ook buiten de
    back-up). Alleen de back-up zelf is te zien; het lijstje van BugOS en verborgen bestanden niet.
    Geeft het gekozen pad, of None (Annuleren)."""
    from bugos_ui import Knop, label
    from PySide6.QtCore import QDir, QSortFilterProxyModel
    from PySide6.QtWidgets import QDialog, QFileSystemModel, QHBoxLayout, QTreeView, QVBoxLayout

    dlg = QDialog(ouder)
    dlg.setObjectName("venster")
    dlg.setWindowTitle(t("Eén bestand of map terugzetten", "Restore one file or folder"))
    dlg.resize(620, 480)
    lay = QVBoxLayout(dlg)
    lay.setContentsMargins(20, 18, 20, 18)
    lay.setSpacing(12)
    lay.addWidget(label(t("Kies wat terug moet uit '{naam}'. Het komt op dezelfde plek op je computer; staat daar al "
                          "iets met die naam, dan krijgt het een (2) erachter. Er wordt niets overschreven.",
                          "Choose what to restore from '{naam}'. It goes to the same place on your computer; if "
                          "something with that name is already there, it gets a (2) after it. Nothing is "
                          "overwritten.").replace("{naam}", mooie_naam(bron)), wrap=True))
    model = QFileSystemModel(dlg)
    model.setFilter(QDir.Filter.AllEntries | QDir.Filter.NoDotAndDotDot)   # zonder verborgen bestanden
    model.setRootPath(str(bron))

    class Zonder(QSortFilterProxyModel):
        """Het lijstje van BugOS (bugos-mappen.json) hoort bij de back-up, niet bij je bestanden: niet tonen."""

        def filterAcceptsRow(self, rij, ouder_index):  # noqa: N802
            index = self.sourceModel().index(rij, 0, ouder_index)
            return not (self.sourceModel().fileName(index) == LIJSTJE
                        and Path(self.sourceModel().filePath(index)).parent == bron)

    proxy = Zonder(dlg)
    proxy.setSourceModel(model)
    boom = QTreeView()
    boom.setModel(proxy)
    boom.setRootIndex(proxy.mapFromSource(model.index(str(bron))))
    for kolom in (1, 2, 3):   # alleen de naam: grootte, soort en datum maken het druk
        boom.hideColumn(kolom)
    boom.setHeaderHidden(True)
    boom.setAccessibleName(t("Bestanden en mappen in de back-up", "Files and folders in the backup"))
    lay.addWidget(boom, 1)
    rij = QHBoxLayout()
    rij.addStretch(1)
    annuleer = Knop(t("Annuleren", "Cancel"), "rand")
    kies = Knop(t("Terugzetten", "Restore"), "hoofd", "lijn:terug")
    kies.setEnabled(False)
    rij.addWidget(annuleer)
    rij.addWidget(kies)
    lay.addLayout(rij)
    gekozen: list[Path] = []

    def keuze() -> Path | None:
        index = boom.currentIndex()
        return Path(model.filePath(proxy.mapToSource(index))) if index.isValid() else None

    boom.selectionModel().currentChanged.connect(lambda *_: kies.setEnabled(keuze() is not None))

    def klaar() -> None:
        p = keuze()
        if p is not None:
            gekozen.append(p)
            dlg.accept()

    kies.clicked.connect(klaar)
    annuleer.clicked.connect(dlg.reject)
    dlg.kies, dlg.boom, dlg.model, dlg.proxy = kies, boom, model, proxy   # voor de test
    dlg.exec()
    # Netjes opruimen: QFileSystemModel kijkt op de achtergrond naar de map; dat stopt met het venster.
    dlg.deleteLater()
    return gekozen[0] if gekozen else None


def venster() -> int:
    from bugos_ui import (
        Banner, Chip, IcoonChip, Knop, SchijfKiezer, Voortgang, kop_met_icoon, label, maak_app, pagina,
        raster, schijf_info, schuifbaar, sectie, uitvoeren,
    )
    import threading

    from PySide6.QtCore import QProcess, QThread, QTimer, Signal
    from PySide6.QtWidgets import QFrame, QHBoxLayout, QInputDialog, QMessageBox, QVBoxLayout, QWidget

    class Teller(QThread):
        """Tel op de achtergrond of alles op de schijf past: bij duizenden foto's duurt dat even,
        en dan mag het venster niet vastlopen."""

        klaar = Signal(bool, object, object)  # past, nodig, vrij (object: getallen boven de 2 GB)

        def __init__(self, schijf: Path, mappen: list[Path], doel: Path):
            super().__init__()
            self.schijf, self.mappen, self.doel = schijf, mappen, doel
            self.stop = threading.Event()

        dubbel: dict = {}  # per map: wat niet mee kan omdat de schijf geen hoofdletters kent

        def run(self) -> None:
            try:
                past, nodig, vrij = ruimte_genoeg(self.schijf, self.mappen, self.doel, self.stop)
                self.dubbel = dubbel_op_schijf(self.schijf, self.mappen, self.doel)
            except OSError:  # de schijf is er intussen uit
                past, nodig, vrij = False, 0, -1
            self.klaar.emit(past, nodig, vrij)

    def wat_mee_gaat() -> QWidget:
        """Zes kleine kaartjes: deze mappen gaan mee in de back-up."""
        namen = [("lijn:document", t("Documenten", "Documents")), ("lijn:foto", t("Afbeeldingen", "Pictures")),
                 ("lijn:muziek", t("Muziek", "Music")), ("lijn:film", t("Video's", "Videos")),
                 ("lijn:computer", t("Bureaublad", "Desktop")), ("lijn:download", t("Downloads", "Downloads"))]
        w, g = raster(3, 10)
        for i, (ic, naam) in enumerate(namen):
            kaart = QFrame()
            kaart.setProperty("kaart", True)
            r = QHBoxLayout(kaart)
            r.setContentsMargins(12, 10, 12, 10)
            r.setSpacing(10)
            r.addWidget(IcoonChip(ic, "neutraal", 32, vol=False))
            r.addWidget(label(naam, "kop3", wrap=False), 1)
            g.addWidget(kaart, i // 3, i % 3)
        for k in range(3):
            g.setColumnStretch(k, 1)
        return w

    class Backup(QWidget):
        def __init__(self):
            super().__init__()
            self.setObjectName("venster")
            self.setWindowTitle(t("BugOS Back-up", "BugOS Backup"))
            self.resize(780, 720)
            w, lay = pagina()
            buiten = QVBoxLayout(self)
            buiten.setContentsMargins(0, 0, 0, 0)
            buiten.addWidget(schuifbaar(w))
            lay.addWidget(kop_met_icoon("lijn:opslag", "neutraal", t("Back-up", "Backup"),
                                        t("Zet je documenten, foto's, muziek, video's, bureaublad en downloads veilig "
                                          "op een USB-schijf. Er wordt nooit iets weggegooid.",
                                          "Keep your documents, photos, music, videos, desktop and downloads safe on a "
                                          "USB drive. Nothing is ever deleted.")))
            self.wanneer = Chip(laatste_backup(), "grijs")
            lay.addWidget(self.wanneer)
            lay.addWidget(sectie(t("Dit gaat mee", "This is included")))
            lay.addWidget(wat_mee_gaat())
            lay.addWidget(sectie(t("Kies een schijf", "Choose a drive")))
            self.kiezer = SchijfKiezer(t("Steek een USB-schijf in…", "Plug in a USB drive…"))
            lay.addWidget(self.kiezer)
            # Leegmaken van de gekozen stick: klein en rustig onder de lijst, niet naast 'Maak back-up' (daar klik
            # je anders per ongeluk op). Alleen aan voor een stick, externe schijf of SD-kaart (gekozen_stick).
            wis_rij = QHBoxLayout()
            wis_rij.addStretch(1)
            self.wis_gekozen = Knop(t("Deze stick leegmaken…", "Erase this stick…"), "stil", "lijn:prullenbak")
            wis_rij.addWidget(self.wis_gekozen)
            lay.addLayout(wis_rij)
            # B008: een lege stick (nog nooit klaargemaakt) ging niet open en bleef dus onzichtbaar. Nu zeggen we
            # dat hij erin zit, en kun je hem hier meteen klaarmaken. Net zo voor een stick waar je niet op mag
            # schrijven (een oude installatiestick) of die BugOS niet kan lezen: die kun je hier leegmaken, als jij
            # dat goedvindt. Een eigen balk, niet self.melding: die rij wordt elke 3 seconden ververst en zou
            # anders het 'Klaar!' van een back-up wegvegen.
            self.nieuw_rij = QWidget()
            nieuw_lay = QHBoxLayout(self.nieuw_rij)
            nieuw_lay.setContentsMargins(0, 0, 0, 0)
            nieuw_lay.setSpacing(12)
            self.nieuw_uitleg = Banner("", "let_op")
            self.klaarmaak = Knop(t("Klaarmaken", "Set up"), "rand", "lijn:opslag")
            nieuw_lay.addWidget(self.nieuw_uitleg, 1)
            nieuw_lay.addWidget(self.klaarmaak)
            self.nieuw_rij.hide()
            lay.addWidget(self.nieuw_rij)
            self.bijzonder: Bijzonder | None = None   # de stick waar de balk nu over gaat
            self.klaarmaker: QProcess | None = None   # de stap van het klaar- of leegmaken die nu loopt (None: niets)
            self.klaar_stappen: list[list[str]] = []  # de stappen die daarna nog komen
            self.melding = Banner()
            lay.addWidget(self.melding)
            self.balk = Voortgang()
            self.balk.hide()
            lay.addWidget(self.balk)
            lay.addStretch(1)
            rij = QHBoxLayout()
            self.terugzetten = Knop(t("Terugzetten", "Restore"), "rand", "lijn:terug", groot=True)
            # D-12: niet alleen alles of niets: ook één bestand of map uit de back-up.
            self.een_terug = Knop(t("Eén bestand of map terugzetten", "Restore one file or folder"), "stil",
                                  "lijn:document")
            self.maak = Knop(t("Maak back-up", "Make backup"), "hoofd", "lijn:opslag", groot=True)
            rij.addWidget(self.terugzetten)
            rij.addWidget(self.een_terug)
            rij.addStretch(1)
            rij.addWidget(self.maak)
            # Onder het schuifvlak, niet erin: de knoppen blijven altijd in beeld, ook bij 150 % met een melding (R03).
            rij.setContentsMargins(40, 12, 40, 20)
            buiten.addLayout(rij)

            self.wachtrij: list[list[str]] = []
            self.nu: list[str] = []     # de opdracht die nu loopt
            self.deels: list[str] = []  # mappen waarvan een paar bestanden niet mee konden
            self.proces = QProcess(self)
            self.proces.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
            self.proces.readyReadStandardOutput.connect(self.lees)
            self.proces.finished.connect(self.klaar_met_een)
            self.stand: dict = {"klus": "", "schijf": None}
            self.sluit_na = False  # het venster ging dicht tijdens het kopiëren: sluiten zodra het klaar is
            self.gestopt = False   # de gebruiker koos 'Nu stoppen'
            self.teller: Teller | None = None  # telt of alles past
            self.maak.clicked.connect(self.maak_backup)
            self.terugzetten.clicked.connect(self.zet_terug)
            self.een_terug.clicked.connect(self.zet_een_terug)
            self.klaarmaak.clicked.connect(self.klik_bijzonder)
            self.wis_gekozen.clicked.connect(self.wis_gekozen_stick)
            self.kiezer.gewijzigd.connect(self.knoppen)
            self.timer = QTimer(self)
            self.timer.timeout.connect(self.ververs_schijven)
            self.timer.start(3000)
            self.ververs_schijven()
            self.kiezer.setFocus()

        def gekozen(self) -> Path | None:
            g = self.kiezer.gekozen()
            return Path(g) if g else None

        def druk(self) -> bool:
            """Zijn we bezig (ruimte tellen, kopiëren, of een stick klaar- of leegmaken)?"""
            return self.proces.state() != QProcess.ProcessState.NotRunning or \
                (self.teller is not None and self.teller.isRunning()) or self.klaarmaker is not None

        def knoppen(self) -> None:
            if self.druk():
                return
            s = self.gekozen()
            self.maak.setEnabled(s is not None and not alleen_terugzetten(s))
            self.terugzetten.setEnabled(s is not None and bool(backups_op(s)))
            self.een_terug.setEnabled(self.terugzetten.isEnabled())
            # Leegmaken alleen voor een stick, externe schijf of SD-kaart die het systeem niet zelf gebruikt.
            self.wis_gekozen.setVisible(s is not None and gekozen_stick(s, LAATSTE_LIJST) is not None)
            self.wis_gekozen.setEnabled(self.wis_gekozen.isVisible())

        def ververs_schijven(self) -> None:
            if self.druk():
                return
            items = []
            for s in schijven():
                extra = schijf_info(s)
                if alleen_terugzetten(s):
                    extra += t("  ·  zit in de computer: alleen terugzetten", "  ·  inside the computer: restore only")
                elif backups_op(s):
                    extra += t("  ·  heeft al een back-up", "  ·  already has a backup")
                items.append((str(s), s.name, extra))
            self.kiezer.zet(items)
            self.toon_bijzonder()
            self.knoppen()

        def toon_bijzonder(self) -> None:
            """Zit er een stick in die BugOS nog niet kan gebruiken? Zeg wat er is, met de knop om het op te lossen:
            leeg -> 'Klaarmaken' (B008); alleen-lezen of onleesbaar -> 'Leegmaken' (pas na jouw akkoord)."""
            if not LAATSTE_BIJZONDER:
                self.bijzonder = None
                self.nieuw_rij.hide()
                return
            x = self.bijzonder = LAATSTE_BIJZONDER[0]   # meer tegelijk: eerst de eerste, daarna de volgende
            if x.soort == "leeg":
                tekst = t(f"'{x.naam}' zit erin, maar is nog leeg: hij is nooit klaargemaakt. Maak hem eerst klaar, "
                          "dan kun je er een back-up op zetten.",
                          f"'{x.naam}' is plugged in, but it is still empty: it was never set up. Set it up first, "
                          "then you can put a backup on it.")
                self.klaarmaak.setText(t("Klaarmaken", "Set up"))
            elif x.soort == "alleen-lezen":
                tekst = t(f"Op '{x.naam}' mag je niet schrijven (bijvoorbeeld een oude installatiestick), dus er kan "
                          "geen back-up op. Heb je wat erop staat niet meer nodig? Dan kun je hem leegmaken.",
                          f"You cannot write to '{x.naam}' (an old installer stick, for example), so a backup cannot "
                          "go on it. If you no longer need what is on it, you can erase it.")
                self.klaarmaak.setText(t("Leegmaken…", "Erase…"))
            else:
                tekst = t(f"'{x.naam}' zit erin, maar BugOS kan hem niet lezen. Misschien is hij beschadigd, of "
                          "gemaakt voor een ander apparaat. Heb je wat erop staat niet nodig? Dan kun je hem leegmaken.",
                          f"'{x.naam}' is plugged in, but BugOS cannot read it. It may be damaged, or made for another "
                          "device. If you do not need what is on it, you can erase it.")
                self.klaarmaak.setText(t("Leegmaken…", "Erase…"))
            self.nieuw_uitleg.zet(tekst, "let_op")
            self.nieuw_rij.show()

        def vraag_wissen(self, naam: str, extra: str) -> bool:
            """De vraag vóór het wissen: wat er gebeurt, dat het niet terug kan, en 'Annuleren' als standaard (een
            Enter te veel wist dus niets). Alleen 'Alles wissen' gaat door."""
            box = QMessageBox(self)
            box.setIcon(QMessageBox.Icon.Warning)
            box.setWindowTitle(t("Alles wissen?", "Erase everything?"))
            box.setText(t(f"Alles op '{naam}' wordt gewist.", f"Everything on '{naam}' will be erased."))
            box.setInformativeText(
                (extra + "\n\n" if extra else "") +
                t(f"Dit kan niet ongedaan worden. Daarna is de stick leeg, heet hij '{t(*BACKUP_NAAM)}' en werkt hij "
                  "op elke computer (ook Windows en Mac).",
                  f"This cannot be undone. Afterwards the stick is empty, is called '{t(*BACKUP_NAAM)}' and works "
                  "on any computer (Windows and Mac too)."))
            wis = box.addButton(t("Alles wissen", "Erase everything"), QMessageBox.ButtonRole.DestructiveRole)
            nee = box.addButton(t("Annuleren", "Cancel"), QMessageBox.ButtonRole.RejectRole)
            box.setDefaultButton(nee)
            box.setEscapeButton(nee)
            box.exec()
            return box.clickedButton() is wis

        def klik_bijzonder(self) -> None:
            """De knop naast de balk: een lege stick klaarmaken (B008), of een onbruikbare stick leegmaken."""
            x = self.bijzonder
            if x is None or self.druk():
                return
            naam = t(*BACKUP_NAAM)
            if x.soort == "leeg":
                # Er staat niets op, maar we vragen het toch: formatteren is iets wat je zelf kiest.
                vraag = QMessageBox.question(
                    self, t("Stick klaarmaken?", "Set up the stick?"),
                    t(f"BugOS maakt '{x.naam}' klaar voor gebruik. Hij heet daarna '{naam}' en werkt ook op Windows "
                      "en Mac.\n\nEr staat nu niets op. Zit er toch iets op wat je nodig hebt? Kies dan Annuleren.",
                      f"BugOS gets '{x.naam}' ready to use. It will be called '{naam}' and also works on Windows and "
                      "Mac.\n\nThere is nothing on it now. If it does have something you need, choose Cancel."),
                    QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.Cancel,
                    QMessageBox.StandardButton.Cancel)
                if vraag != QMessageBox.StandardButton.Yes:
                    return
            elif not self.vraag_wissen(x.naam, t("BugOS kan niet zien wat erop staat.",
                                                 "BugOS cannot see what is on it.")):
                return
            self.start_wissen(x.station, x.id, x.delen, x.naam, leeg=x.soort == "leeg")

        def wis_gekozen_stick(self) -> None:
            """'Deze stick leegmaken…': de gekozen stick helemaal wissen, na een duidelijke vraag. De vraag zegt
            hoeveel erop staat en of er back-ups van BugOS op staan: die zijn daarna ook weg."""
            s = self.gekozen()
            if s is None or self.druk():
                return
            x = gekozen_stick(s, LAATSTE_LIJST)
            if x is None:
                return
            st = next((r for r in LAATSTE_RUW if r.get("path") == x.station), None)
            if st is None:
                return
            import bugos_drives
            delen = [d for d in LAATSTE_LIJST if d.station == x.station]
            regels = []
            if x.grootte and x.vrij is not None and x.grootte > x.vrij:
                regels.append(t(f"Er staat nu {bugos_drives.mooie_maat(x.grootte - x.vrij)} op.",
                                f"It now holds {bugos_drives.mooie_maat(x.grootte - x.vrij)}."))
            if backups_op(s):
                regels.append(t("Ook de back-ups van BugOS op deze stick zijn daarna weg.",
                                "The BugOS backups on this stick will be gone too."))
            if len(delen) > 1:
                regels.append(t(f"De stick heeft {len(delen)} delen; ze worden allemaal gewist.",
                                f"The stick has {len(delen)} parts; they will all be erased."))
            if not self.vraag_wissen(x.naam, " ".join(regels)):
                return
            self.start_wissen(x.station, station_id(st), delen, x.naam, leeg=False)

        def start_wissen(self, station: str, voor: tuple, delen: list, oude_naam: str, leeg: bool) -> None:
            """Na jouw 'ja': dichtzetten, nog één keer controleren of het precies die stick is, dan wissen en
            opnieuw klaarmaken. Elke stap op de achtergrond (zie klaar_stap)."""
            # Na de vraag (die even open kan staan) eerst kijken: zit dezelfde stick er nog, en gebruikt het systeem
            # hem niet? Daarna nog een keer vlak vóór het formatteren (na het dichtzetten): zelfde_stick.
            if not zelfde_stick(station, voor, mag_open=True):
                self.melding.zet(t(f"'{oude_naam}' zit er niet meer in. Er is niets gewist.",
                                   f"'{oude_naam}' is no longer there. Nothing was erased."), "fout")
                self.ververs_schijven()
                return
            if not shutil.which("gdbus") or not shutil.which("udisksctl"):
                self.melding.zet(t("Dat kan hier niet. Gebruik Bestanden om de stick klaar te maken.",
                                   "That is not possible here. Use Files to set up the stick."), "fout")
                return
            naam = t(*BACKUP_NAAM)
            stappen: list = wis_stappen(station, delen, naam)
            # De controle komt na het dichtzetten en vóór het eerste formatteren (de eerste gdbus-stap).
            eerste_wis = next(i for i, c in enumerate(stappen) if c[0] == "gdbus")
            stappen.insert(eerste_wis, lambda: zelfde_stick(station, voor))
            self.klaar_stappen = stappen
            self.wis_leeg = leeg
            self.melding.zet(t(f"'{naam}' klaarmaken… Haal de stick er niet uit.",
                               f"Getting '{naam}' ready… Do not unplug the stick.") if leeg else
                             t(f"'{oude_naam}' leegmaken… Haal de stick er niet uit.",
                               f"Erasing '{oude_naam}'… Do not unplug the stick."), "bezig")
            self.nieuw_rij.hide()
            for knop in (self.kiezer, self.maak, self.terugzetten, self.een_terug, self.wis_gekozen):
                knop.setEnabled(False)
            self.klaar_stap()

        def klaar_stap(self, code: int = 0, status=None) -> None:
            """Voer de stappen van het klaar- of leegmaken één voor één uit, zonder dat het venster vastloopt
            (udisks kan om een wachtwoord vragen; dat venster komt van KDE zelf). Wordt ook aangeroepen als een
            stap klaar is. Een stap kan ook een controle zijn (een functie): False betekent stoppen, niets wissen."""
            if self.klaarmaker is not None:
                self.klaarmaker.deleteLater()
                self.klaarmaker = None
                if code != 0 or status != QProcess.ExitStatus.NormalExit:
                    self.klaar_mislukt()
                    return
            # Controles meteen uitvoeren (ze duren een fractie van een seconde), opdrachten op de achtergrond.
            while self.klaar_stappen and callable(self.klaar_stappen[0]):
                controle = self.klaar_stappen.pop(0)
                try:
                    ok = bool(controle())
                except Exception:  # noqa: BLE001  gaat het controleren mis, dan zeker niet wissen
                    ok = False
                if not ok:
                    self.klaar_mislukt(t("De stick is veranderd of wordt gebruikt. Er is niets gewist.",
                                         "The stick changed or is in use. Nothing was erased."))
                    return
            if not self.klaar_stappen:
                # Alles gelukt: de stick staat open en komt nu gewoon in de lijst.
                naam = t(*BACKUP_NAAM)
                self.kiezer.setEnabled(True)
                self.ververs_schijven()
                self.melding.zet(t(f"Klaar: '{naam}' staat nu in de lijst. Druk op 'Maak back-up'.",
                                   f"Done: '{naam}' is now in the list. Press 'Make backup'."), "goed")
                if self.sluit_na:
                    QTimer.singleShot(0, self.close)
                return
            cmd = self.klaar_stappen.pop(0)
            self.klaarmaker = QProcess(self)
            self.klaarmaker.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
            self.klaarmaker.finished.connect(self.klaar_stap)
            # Kon de opdracht niet eens starten? Dan komt 'finished' nooit: zelf als mislukt afhandelen.
            self.klaarmaker.errorOccurred.connect(
                lambda fout: fout == QProcess.ProcessError.FailedToStart and self.klaar_stap(1, None))
            self.klaarmaker.start(cmd[0], cmd[1:])

        def klaar_mislukt(self, tekst: str = "") -> None:
            """Een stap mislukte (of je annuleerde het wachtwoord): stoppen, niet de volgende stap proberen."""
            self.klaar_stappen = []
            self.kiezer.setEnabled(True)
            self.ververs_schijven()
            self.melding.zet(tekst or (
                t("Klaarmaken lukte niet. Haal de stick eruit, steek hem er weer in en probeer het opnieuw. Of maak "
                  "hem klaar in Bestanden.",
                  "Setting up did not work. Unplug the stick, plug it in again and try again. Or set it up in "
                  "Files.") if getattr(self, "wis_leeg", True) else
                t("Leegmaken lukte niet. Haal de stick eruit, steek hem er weer in en probeer het opnieuw. Zit er "
                  "een schuifje op de stick (schrijfbeveiliging)? Zet dat dan eerst om.",
                  "Erasing did not work. Unplug the stick, plug it in again and try again. Does the stick have a "
                  "small switch (write protection)? Flip it first.")), "fout")
            self.sluit_na = False   # de foutmelding moet je kunnen lezen

        def volgende(self) -> None:
            if not self.wachtrij:
                self.stap_nr = 0
                self.klaar()
                return
            # Eén balk voor alle mappen samen (niet zes keer van 0 tot 100%) (U152).
            if not getattr(self, "stap_nr", 0):
                # Alleen de rsync-stappen tellen: het wegschrijven (sync) aan het eind heeft geen procenten (U167).
                self.stappen_totaal = max(sum(1 for c in self.wachtrij if c and c[0] != "sync"), 1)
            self.stap_nr = getattr(self, "stap_nr", 0) + 1
            cmd = self.nu = self.wachtrij.pop(0)
            self.uitvoer = ""
            if cmd[0] == "sync":
                self.balk.setValue(100)   # alles is gekopieerd; nu alleen nog wegschrijven
                self.melding.zet(t("Bezig met wegschrijven… Haal de schijf er nog niet uit.",
                                   "Writing to the drive… Do not unplug it yet."), "bezig")
            self.proces.start(cmd[0], cmd[1:])

        def lees(self) -> None:
            tekst = bytes(self.proces.readAllStandardOutput()).decode(errors="ignore")
            self.uitvoer = (self.uitvoer + tekst)[-8000:]   # voor 'schijf vol' (U079)
            for stuk in tekst.replace("\r", "\n").split():
                if stuk.endswith("%") and stuk[:-1].isdigit():
                    totaal = max(getattr(self, "stappen_totaal", 1), 1)
                    gedaan = max(getattr(self, "stap_nr", 1) - 1, 0)
                    self.balk.setValue(int((gedaan + int(stuk[:-1]) / 100) / totaal * 100))

        def klaar_met_een(self, code: int, _status) -> None:
            if self.gestopt:
                # Gestopt: zeg het, en de volgende keer begint gewoon opnieuw (ook als je het venster weer opende) (U241).
                self.gestopt = False
                self.wachtrij.clear()
                self.melding.zet(t("Gestopt. Wat al gekopieerd was, blijft staan.",
                                   "Stopped. What was already copied stays."), "info")
                self.balk.hide()
                self.stop(False)
                return
            soort = uitslag(code, self.nu, getattr(self, "uitvoer", ""))
            if soort == "deels":
                naam = Path(self.nu[-2].rstrip("/")).name or "~"
                if naam not in self.deels:
                    self.deels.append(naam)
            elif soort != "goed":
                maak = self.stand.get("klus") == "maak"
                self.melding.zet((t("De schijf is vol. Kies een grotere schijf, of maak er ruimte op.",
                                    "The drive is full. Choose a bigger drive, or make room on it.") if maak else
                                  t("Je computer is vol. Maak eerst ruimte (bijv. de prullenbak leegmaken in "
                                    "Bestanden) en probeer het dan opnieuw.",
                                    "Your computer is full. Make room first (for example empty the trash in Files) "
                                    "and try again.")) if soort == "vol" else
                                 ALLEEN_LEZEN if soort == "alleen-lezen" and maak else
                                 t("Het lukte niet helemaal. Zit de schijf er nog in? Probeer het opnieuw.",
                                   "It did not fully work. Is the drive still plugged in? Try again."), "fout")
                self.wachtrij.clear()
                self.sluit_na = False  # ook na 'Eerst afmaken': de foutmelding moet je kunnen zien
                self.stop(False)
                return
            self.volgende()

        def klaar(self) -> None:
            if self.deels:
                if self.stand["klus"] == "maak":
                    onthoud(self.stand["schijf"])
                    self.wanneer.setText(laatste_backup())
                # Terugzetten naar je computer: de redenen voor een stick (: ? *, 4 GB, hoofdletters) gelden dan niet (U150).
                self.melding.zet(DEELS_UITLEG.format(mappen=", ".join(self.deels)) if self.stand["klus"] == "maak" else
                                 t(f"Een paar bestanden uit {', '.join(self.deels)} konden niet terug (bijv. omdat je "
                                   "daar niet mag schrijven). De rest staat er weer.",
                                   f"A few files from {', '.join(self.deels)} could not be restored (for example "
                                   "because you may not write there). Everything else is back."), "let_op")
                self.sluit_na = False  # niet alles kon mee: dat moet je kunnen lezen, ook na 'Eerst afmaken'
                self.stop(True)
                return
            if self.stand["klus"] == "maak":
                onthoud(self.stand["schijf"])
                self.wanneer.setText(laatste_backup())
                self.melding.zet(t("Klaar! Je bestanden staan veilig op de schijf. Je mag hem er nu uithalen.",
                                   "Done! Your files are safe on the drive. You can unplug it now."), "goed")
            elif self.stand["klus"] == "een":
                # Eén ding terug (D-12): zeg waar het staat, met de naam die het kreeg (misschien 'naam (2)').
                doel = self.stand.get("doel")
                waar = str(doel).replace(str(Path.home()), "~", 1) if doel else ""
                self.melding.zet(t("Klaar! Het staat weer op je computer: {waar}",
                                   "Done! It is back on your computer: {waar}").replace("{waar}", waar), "goed")
            else:
                self.melding.zet(t("Klaar! Je bestanden staan weer op je computer. Werd er iets vervangen, dan staat het "
                                   "oude in een map 'Vervangen bij terugzetten'.",
                                   "Done! Your files are back on your computer. If something was replaced, the old one "
                                   "is in a folder 'Replaced when restoring'."), "goed")   # (U382)
            self.stop(True)

        def stop(self, gelukt: bool) -> None:
            self.stap_nr = 0
            self.balk.setValue(100 if gelukt else self.balk.value())
            self.kiezer.setEnabled(True)
            self.knoppen()
            if self.sluit_na:
                QTimer.singleShot(0, self.close)

        def vraag_stoppen(self) -> bool:
            """Het venster gaat dicht terwijl we bezig zijn: stoppen, of eerst afmaken?"""
            maak = self.stand["klus"] == "maak"
            box = QMessageBox(self)
            box.setIcon(QMessageBox.Icon.Question)
            box.setWindowTitle(t("Nog bezig", "Still busy"))
            box.setText(t("De back-up is nog bezig." if maak else "Het terugzetten is nog bezig.",
                          "The backup is still busy." if maak else "Restoring is still busy."))
            box.setInformativeText(
                t("Maak je het eerst af, dan gaat het venster daarna vanzelf dicht. Stop je nu, dan is nog niet "
                  "alles gekopieerd (wat er al staat, blijft gewoon staan).",
                  "If you let it finish, the window closes by itself afterwards. If you stop now, not everything "
                  "is copied yet (what is already there stays)."))
            door = box.addButton(t("Eerst afmaken", "Finish first"), QMessageBox.ButtonRole.AcceptRole)
            stop = box.addButton(t("Nu stoppen", "Stop now"), QMessageBox.ButtonRole.DestructiveRole)
            box.setDefaultButton(door)
            box.exec()
            return box.clickedButton() is stop

        def tweede_start(self, _args: list[str]) -> None:
            """Weer geopend terwijl het venster wachtte om dicht te gaan: dat gaat niet meer door (U233)."""
            if self.sluit_na and self.proces.state() != QProcess.ProcessState.NotRunning and not self.gestopt:
                self.melding.zet(t("Nog even bezig…", "Still busy…"), "bezig")

        def closeEvent(self, e) -> None:  # noqa: N802
            if self.klaarmaker is not None or self.klaar_stappen:
                # Een stick wordt klaar- of leeggemaakt: nooit halverwege stoppen (een half geformatteerde stick
                # werkt nergens meer). Het venster gaat vanzelf dicht als het klaar is.
                e.ignore()
                self.sluit_na = True
                self.melding.zet(t("Even wachten: de stick wordt nog klaargemaakt. Het venster gaat daarna vanzelf "
                                   "dicht.", "One moment: the stick is still being set up. The window closes by "
                                   "itself afterwards."), "bezig")
                return
            if self.teller is not None and self.teller.isRunning():
                # Nog aan het tellen (er is nog niets gekopieerd): stop het tellen, en sluit daarna.
                e.ignore()
                self.sluit_na = True
                self.teller.stop.set()
                return
            if self.proces.state() == QProcess.ProcessState.NotRunning:
                super().closeEvent(e)
                return
            # Nooit stilletjes midden in een back-up stoppen: vraag het, en sluit pas als het proces klaar is.
            e.ignore()
            if self.sluit_na:
                return  # al gevraagd; we wachten
            self.sluit_na = True
            if self.vraag_stoppen():
                self.gestopt = True
                self.wachtrij.clear()
                self.melding.zet(t("Bezig met stoppen…", "Stopping…"), "bezig")
                self.proces.terminate()  # rsync ruimt zijn halve bestand zelf op
            else:
                self.melding.zet(t("Even wachten: het venster gaat vanzelf dicht als het klaar is.",
                                   "One moment: the window closes by itself when it is done."), "bezig")

        def bezig(self, tekst: str) -> None:
            self.gestopt = False
            self.deels = []
            self.melding.zet(tekst, "bezig")
            self.balk.setValue(0)
            self.balk.show()
            self.maak.setEnabled(False)
            self.terugzetten.setEnabled(False)
            self.een_terug.setEnabled(False)
            self.kiezer.setEnabled(False)

        def maak_backup(self) -> None:
            schijf = self.gekozen()
            if schijf is None:
                return
            if self.druk():
                return
            mappen = bron_mappen()
            self.bezig(t("Even kijken of alles op de schijf past…", "Checking whether everything fits on the drive…"))
            self.teller = Teller(schijf, mappen, backup_doel(schijf))
            self.teller.klaar.connect(lambda past, nodig, vrij: self.geteld(schijf, mappen, past, nodig, vrij))
            self.teller.start()

        def geteld(self, schijf: Path, mappen: list[Path], past: bool, nodig: int, vrij: int) -> None:
            if self.teller is not None:
                self.teller.wait()  # de draad is net klaar; even netjes afsluiten
            if self.sluit_na or (self.teller is not None and self.teller.stop.is_set()):
                # Het venster ging dicht tijdens het tellen (en werd misschien weer geopend): niets doen, en zeker
                # geen 'te weinig ruimte' van een tellen dat halverwege stopte (U234).
                self.melding.zet(t("Gestopt. Er is niets gekopieerd.", "Stopped. Nothing was copied."), "info")
                self.balk.hide()
                self.stop(False)
                return
            if vrij < 0:
                self.melding.zet(t("De schijf reageert niet. Zit hij er nog in? Probeer het opnieuw.",
                                   "The drive does not respond. Is it still plugged in? Try again."), "fout")
                self.balk.hide()
                self.stop(False)
                return
            if not past:
                self.melding.zet(t(f"Te weinig ruimte op de schijf: nodig {nodig / 1024**3:.1f} GB, vrij {vrij / 1024**3:.1f} GB".replace(".", ",") + ".",
                                   f"Not enough space on the drive: need {nodig / 1024**3:.1f} GB, free {vrij / 1024**3:.1f} GB."),
                                 "fout")
                self.balk.hide()
                self.stop(False)
                return
            doel = backup_doel(schijf)
            try:
                doel.mkdir(parents=True, exist_ok=True)
            except OSError:
                # Stick eruit, alleen-lezen geworden, of de map is van een ander account: niet eeuwig 'controleren' (U211).
                self.melding.zet(t("De schijf reageert niet (of je mag er niet op schrijven). Zit hij er nog in?",
                                   "The drive does not respond (or you may not write to it). Is it still plugged in?"),
                                 "fout")
                self.balk.hide()
                self.stop(False)
                return
            schrijf_lijstje(doel)
            self.stand.update(klus="maak", schijf=schijf)
            dubbel = self.teller.dubbel if self.teller is not None else {}
            self.wachtrij[:] = [rsync_maak(m, doel, dubbel.get(m, ())) for m in mappen] + [wegschrijven(doel)]
            self.bezig(t("Bezig met kopiëren… Haal de schijf er niet uit.", "Copying… Do not unplug the drive."))
            self.deels = [m.name for m in dubbel]  # die gaan niet mee: dat zeggen we straks
            self.volgende()

        def kies_backup(self, schijf: Path) -> Path | None:
            """Welke back-up van deze schijf? Die van deze computer meteen; anders laten kiezen, met een gewone naam
            ('Back-up van Bugie op oude-laptop, 3 maart 10:12') in plaats van 'bugie@oude-laptop' (D-12)."""
            lijst = backups_op(schijf)
            if not lijst:
                return None
            bron = lijst[0]
            if lijst[0] != backup_doel(schijf):   # ook als er maar één is: dan zie je van wie hij is (U434)
                # Geen back-up van deze computer, wel van andere: laat kiezen.
                namen = [mooie_naam(p) for p in lijst]
                # Twee met dezelfde naam (zelfde voornaam, zelfde minuut)? Dan de mapnaam erachter, anders kies je blind.
                namen = [f"{n} ({p.name})" if namen.count(n) > 1 else n for n, p in zip(namen, lijst)]
                keuze, ok = QInputDialog.getItem(
                    self, t("Welke back-up?", "Which backup?"),
                    t("Er staan meer back-ups op deze schijf. Welke wil je terugzetten?",
                      "There are several backups on this drive. Which one do you want to restore?") if len(lijst) > 1 else
                    t("Op deze schijf staat deze back-up. Wil je hem terugzetten?",
                      "This drive has this backup. Do you want to restore it?"),   # (U442)
                    namen, 0, False)
                if not ok or keuze not in namen:
                    return None
                bron = lijst[namen.index(keuze)]
            return bron

        def zet_een_terug(self) -> None:
            """D-12: één bestand of map uit de back-up terugzetten, in plaats van alles. Je kiest het in de back-up;
            het komt op dezelfde plek in je eigen map, en staat daar al iets, dan als 'naam (2)'."""
            schijf = self.gekozen()
            if schijf is None or self.druk():
                return
            bron = self.kies_backup(schijf)
            if bron is None:
                return
            ding = kies_in_backup(self, bron)
            if ding is None:
                return
            doel = een_terug_doel(bron, ding, Path.home())
            if doel is None or not ding.exists():
                self.melding.zet(t("Dat kan niet terug: kies een bestand of map in de back-up. Zit de schijf er nog in?",
                                   "That cannot be restored: choose a file or folder in the backup. Is the drive "
                                   "still plugged in?"), "fout")
                return
            try:
                doel.parent.mkdir(parents=True, exist_ok=True)
            except OSError:
                self.melding.zet(t("Je computer is vol, of je mag daar niet schrijven.",
                                   "Your computer is full, or you may not write there."), "fout")
                return
            self.stand.update(klus="een", schijf=schijf, doel=doel)
            self.wachtrij[:] = [een_terug_opdracht(ding, doel)]
            self.bezig(t("Bezig met terugzetten van {naam}…", "Restoring {naam}…").replace("{naam}", ding.name))
            self.volgende()

        def zet_terug(self) -> None:
            schijf = self.gekozen()
            if schijf is None:
                return
            bron = self.kies_backup(schijf)
            if bron is None:
                return
            vraag = QMessageBox.question(
                self, t("Terugzetten?", "Restore?"),
                terug_vraag(bron),
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.Cancel, QMessageBox.StandardButton.Cancel)
            if vraag != QMessageBox.StandardButton.Yes:
                return
            opdrachten = terug_opdrachten(bron, Path.home())
            if not opdrachten:
                # De schijf is weg (eruit getrokken tijdens de vraag), of er staat niets in: niet 'Klaar!' zeggen (U140).
                self.melding.zet(t("Er is niets om terug te zetten. Zit de schijf er nog in?",
                                   "There is nothing to restore. Is the drive still plugged in?"), "fout")
                return
            self.stand.update(klus="terug", schijf=schijf)
            self.wachtrij[:] = opdrachten
            self.bezig(t("Bezig met terugzetten… Nieuwere bestanden op je computer blijven gewoon staan.",
                         "Restoring… Newer files on your computer are kept."))
            self.volgende()

    app = maak_app("bugos-backup", "bugos-backup", sys.argv, een_keer=True)   # (U208)
    return uitvoeren(app, Backup())


if __name__ == "__main__":
    if len(sys.argv) == 3 and sys.argv[1] == "--maak":
        sys.exit(zonder_venster(Path(sys.argv[2])))
    sys.exit(venster())
