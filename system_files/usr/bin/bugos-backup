#!/usr/bin/python3
"""BugOS Back-up - je bestanden veilig op een USB-schijf, met één knop.

Jip-en-Janneke:
  1. Steek een USB-schijf in.
  2. Druk op "Maak back-up".
  3. Je documenten, foto's, muziek, video's, bureaublad en downloads worden
     gekopieerd naar de map "BugOS-Backup" op die schijf.
Er wordt nooit iets weggegooid: niet op je computer en niet op de schijf.
Terugzetten kan ook met één knop.

  bugos-backup                     -> het venster
  bugos-backup --maak <schijfmap>  -> zonder venster (voor wie wil automatiseren)
"""

import getpass
import json
import os
import shutil
import socket
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, "/usr/lib/bugos/python")

from bugos_ui import CONFIG, t  # noqa: E402

LOG = CONFIG / "backup.json"

# (xdg-naam, standaard-mapnaam) - de echte naam hangt af van de taal.
MAPPEN = [
    ("DOCUMENTS", "Documents"),
    ("PICTURES", "Pictures"),
    ("MUSIC", "Music"),
    ("VIDEOS", "Videos"),
    ("DESKTOP", "Desktop"),
    ("DOWNLOAD", "Downloads"),
]


def gebruikersmap(xdg: str, standaard: str) -> Path:
    """Vraag aan het systeem waar bijvoorbeeld 'Afbeeldingen' staat."""
    try:
        uit = subprocess.run(["xdg-user-dir", xdg], capture_output=True, text=True, timeout=5).stdout.strip()
        if uit and Path(uit) != Path.home():
            return Path(uit)
    except (OSError, subprocess.SubprocessError):
        pass
    return Path.home() / standaard


def bron_mappen() -> list[Path]:
    return [p for p in (gebruikersmap(x, s) for x, s in MAPPEN) if p.is_dir()]


LIJSTJE = "bugos-mappen.json"  # in de back-up: welke map welke soort is ({"PICTURES": "Afbeeldingen", ...})


def schrijf_lijstje(doel: Path) -> None:
    """Onthoud bij de back-up dat bijv. 'Afbeeldingen' de map PICTURES is. Dan komt hij bij het
    terugzetten in de juiste map, ook als de nieuwe computer Engels is ('Pictures')."""
    lijstje = {x: m.name for x, s in MAPPEN if (m := gebruikersmap(x, s)).is_dir()}
    try:
        (doel / LIJSTJE).write_text(json.dumps(lijstje, ensure_ascii=False))
    except OSError:
        pass


def terug_opdrachten(bron: Path, thuis: Path) -> list[list[str]]:
    """Per map in de back-up één rsync, naar de echte map op deze computer."""
    try:
        lijstje = json.loads((bron / LIJSTJE).read_text())
    except (OSError, ValueError):
        lijstje = {}
    soort_van = {naam: xdg for xdg, naam in lijstje.items()}
    soort_van.update({s: x for x, s in MAPPEN if s not in soort_van})  # oude back-ups: de Engelse namen
    opdrachten = []
    try:
        mappen = sorted(p for p in bron.iterdir() if p.is_dir())
    except OSError:
        return []
    for m in mappen:
        xdg = soort_van.get(m.name)
        standaard = next((s for x, s in MAPPEN if x == xdg), m.name)
        naar = gebruikersmap(xdg, standaard) if xdg else thuis / m.name
        opdrachten.append(rsync_terug(m, naar))
    return opdrachten


def schijven() -> list[Path]:
    """Alle aangesloten USB-schijven en losse schijven waarop je mag schrijven."""
    if os.environ.get("BUGOS_SCHIJVEN"):  # voor tests en screenshots
        return [Path(p) for p in os.environ["BUGOS_SCHIJVEN"].split(":") if Path(p).is_dir()]
    gebruiker = getpass.getuser()
    gevonden = []
    for basis in (Path("/run/media") / gebruiker, Path("/media") / gebruiker, Path("/media")):
        if basis.is_dir():
            for p in sorted(basis.iterdir()):
                if p.is_dir() and os.access(p, os.W_OK) and p.is_mount():
                    gevonden.append(p)
    return gevonden


def backup_doel(schijf: Path) -> Path:
    return schijf / "BugOS-Backup" / f"{getpass.getuser()}@{socket.gethostname()}"


def backups_op(schijf: Path) -> list[Path]:
    """Alle back-ups op deze schijf, die van deze computer eerst. Na opnieuw installeren of op een
    nieuwe pc heet de computer (of de gebruiker) vaak anders: die back-ups moet je ook terug kunnen zetten."""
    eigen = backup_doel(schijf)
    try:
        alle = sorted(p for p in (schijf / "BugOS-Backup").iterdir() if p.is_dir())
    except OSError:
        return []
    return sorted(alle, key=lambda p: p != eigen)


def rsync_maak(bron: Path, doel: Path) -> list[str]:
    # Geen --delete: wat ooit in de back-up staat, blijft daar staan.
    # --modify-window: USB-schijven (FAT/exFAT) onthouden tijd minder precies.
    # -l: snelkoppelingen (symlinks) gaan ook mee (op FAT/exFAT kan dat niet; dan zegt rsync 23: "deels").
    return ["rsync", "-rtl", "--modify-window=2", "--info=progress2", "--no-inc-recursive",
            f"{bron}/", f"{doel / bron.name}/"]


def rsync_terug(doel: Path, thuis: Path) -> list[str]:
    # --update: een nieuwer bestand op de computer wordt nooit overschreven.
    return ["rsync", "-rtl", "--update", "--modify-window=2", "--info=progress2", "--no-inc-recursive",
            f"{doel}/", f"{thuis}/"]


def ruimte_genoeg(schijf: Path, mappen: list[Path], doel: Path | None = None) -> tuple[bool, int, int]:
    """Past wat er nog gekopieerd moet worden? Wat al (even groot) in de back-up staat, telt niet mee:
    rsync kopieert alleen wat nieuw of veranderd is."""
    nodig = 0
    for m in mappen:
        for wortel, _, bestanden in os.walk(m):
            for b in bestanden:
                bron = Path(wortel) / b
                try:
                    grootte = bron.stat().st_size
                except OSError:
                    continue
                if doel is not None:
                    try:
                        oud = (doel / m.name / bron.relative_to(m)).stat().st_size
                    except (OSError, ValueError):
                        oud = None
                    if oud == grootte:
                        continue  # staat er al
                # Nieuw of veranderd: rsync schrijft eerst een volledige kopie (en gooit dan pas de oude weg).
                nodig += grootte
    vrij = shutil.disk_usage(str(schijf)).free
    return nodig < vrij, nodig, vrij


def onthoud(schijf: Path) -> None:
    CONFIG.mkdir(parents=True, exist_ok=True)
    LOG.write_text(json.dumps({"schijf": str(schijf), "tijd": int(time.time())}))


def laatste_backup() -> str:
    try:
        d = json.loads(LOG.read_text())
        dagen = int((time.time() - d["tijd"]) // 86400)
        if dagen == 0:
            return t("Laatste back-up: vandaag", "Last backup: today")
        if dagen == 1:
            return t("Laatste back-up: gisteren", "Last backup: yesterday")
        return t(f"Laatste back-up: {dagen} dagen geleden", f"Last backup: {dagen} days ago")
    except (OSError, ValueError, KeyError):
        return t("Je hebt nog nooit een back-up gemaakt.", "You have never made a backup.")


# rsync: 0 = goed, 24 = een bestand verdween tijdens het kopiëren (geen probleem),
# 23 = sommige bestanden konden niet mee (bijv. een naam met : of ? of groter dan 4 GB op een
# FAT32-stick). Bij 23 gaan we gewoon door met de volgende mappen en zeggen we het erbij.
GOED, DEELS = (0, 24), (23,)

DEELS_UITLEG = t("Een paar bestanden konden niet mee: {mappen}. Dat komt meestal door een naam met : ? * of \", "
                 "of een bestand groter dan 4 GB op een FAT32-schijf. De rest staat er wel.",
                 "A few files could not be copied: {mappen}. Usually a name with : ? * or \", or a file larger "
                 "than 4 GB on a FAT32 drive. Everything else is there.")


def zonder_venster(schijf: Path) -> int:
    doel = backup_doel(schijf)
    doel.mkdir(parents=True, exist_ok=True)
    schrijf_lijstje(doel)
    deels = []
    for m in bron_mappen():
        code = subprocess.call(rsync_maak(m, doel))
        if code in DEELS:
            deels.append(m.name)
        elif code not in GOED:
            return 1
    onthoud(schijf)
    if deels:
        print(DEELS_UITLEG.format(mappen=", ".join(deels)), file=sys.stderr)
        return 2
    return 0


# ------------------------------------------------------------------ venster ----

def venster() -> int:
    from bugos_ui import (
        Banner, Chip, IcoonChip, Knop, SchijfKiezer, Voortgang, kop_met_icoon, label, maak_app, pagina,
        raster, schijf_info, sectie, uitvoeren,
    )
    from PySide6.QtCore import QProcess, QTimer
    from PySide6.QtWidgets import QFrame, QHBoxLayout, QInputDialog, QMessageBox, QVBoxLayout, QWidget

    def wat_mee_gaat() -> QWidget:
        """Zes kleine kaartjes: deze mappen gaan mee in de back-up."""
        namen = [("lijn:document", t("Documenten", "Documents")), ("lijn:foto", t("Afbeeldingen", "Pictures")),
                 ("lijn:muziek", t("Muziek", "Music")), ("lijn:film", t("Video's", "Videos")),
                 ("lijn:computer", t("Bureaublad", "Desktop")), ("lijn:download", t("Downloads", "Downloads"))]
        w, g = raster(3, 10)
        for i, (ic, naam) in enumerate(namen):
            kaart = QFrame()
            kaart.setProperty("kaart", True)
            r = QHBoxLayout(kaart)
            r.setContentsMargins(12, 10, 12, 10)
            r.setSpacing(10)
            r.addWidget(IcoonChip(ic, "neutraal", 32, vol=False))
            r.addWidget(label(naam, "kop3", wrap=False), 1)
            g.addWidget(kaart, i // 3, i % 3)
        for k in range(3):
            g.setColumnStretch(k, 1)
        return w

    class Backup(QWidget):
        def __init__(self):
            super().__init__()
            self.setObjectName("venster")
            self.setWindowTitle(t("BugOS Back-up", "BugOS Backup"))
            self.resize(780, 720)
            w, lay = pagina()
            buiten = QVBoxLayout(self)
            buiten.setContentsMargins(0, 0, 0, 0)
            buiten.addWidget(w)
            lay.addWidget(kop_met_icoon("lijn:opslag", "neutraal", t("Back-up", "Backup"),
                                        t("Zet je documenten, foto's, muziek, video's, bureaublad en downloads veilig "
                                          "op een USB-schijf. Er wordt nooit iets weggegooid.",
                                          "Keep your documents, photos, music, videos, desktop and downloads safe on a "
                                          "USB drive. Nothing is ever deleted.")))
            self.wanneer = Chip(laatste_backup(), "grijs")
            lay.addWidget(self.wanneer)
            lay.addWidget(sectie(t("Dit gaat mee", "This is included")))
            lay.addWidget(wat_mee_gaat())
            lay.addWidget(sectie(t("Kies een schijf", "Choose a drive")))
            self.kiezer = SchijfKiezer(t("Steek een USB-schijf in…", "Plug in a USB drive…"))
            lay.addWidget(self.kiezer)
            self.melding = Banner()
            lay.addWidget(self.melding)
            self.balk = Voortgang()
            self.balk.hide()
            lay.addWidget(self.balk)
            lay.addStretch(1)
            rij = QHBoxLayout()
            self.terugzetten = Knop(t("Terugzetten", "Restore"), "rand", "lijn:terug", groot=True)
            self.maak = Knop(t("Maak back-up", "Make backup"), "hoofd", "lijn:opslag", groot=True)
            rij.addWidget(self.terugzetten)
            rij.addStretch(1)
            rij.addWidget(self.maak)
            lay.addLayout(rij)

            self.wachtrij: list[list[str]] = []
            self.nu: list[str] = []     # de opdracht die nu loopt
            self.deels: list[str] = []  # mappen waarvan een paar bestanden niet mee konden
            self.proces = QProcess(self)
            self.proces.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
            self.proces.readyReadStandardOutput.connect(self.lees)
            self.proces.finished.connect(self.klaar_met_een)
            self.stand: dict = {"klus": "", "schijf": None}
            self.maak.clicked.connect(self.maak_backup)
            self.terugzetten.clicked.connect(self.zet_terug)
            self.kiezer.gewijzigd.connect(self.knoppen)
            self.timer = QTimer(self)
            self.timer.timeout.connect(self.ververs_schijven)
            self.timer.start(3000)
            self.ververs_schijven()
            self.kiezer.setFocus()

        def gekozen(self) -> Path | None:
            g = self.kiezer.gekozen()
            return Path(g) if g else None

        def knoppen(self) -> None:
            if self.proces.state() != QProcess.ProcessState.NotRunning:
                return
            s = self.gekozen()
            self.maak.setEnabled(s is not None)
            self.terugzetten.setEnabled(s is not None and bool(backups_op(s)))

        def ververs_schijven(self) -> None:
            if self.proces.state() != QProcess.ProcessState.NotRunning:
                return
            items = []
            for s in schijven():
                extra = schijf_info(s)
                if backups_op(s):
                    extra += t("  ·  heeft al een back-up", "  ·  already has a backup")
                items.append((str(s), s.name, extra))
            self.kiezer.zet(items)
            self.knoppen()

        def volgende(self) -> None:
            if not self.wachtrij:
                self.klaar()
                return
            cmd = self.nu = self.wachtrij.pop(0)
            self.proces.start(cmd[0], cmd[1:])

        def lees(self) -> None:
            tekst = bytes(self.proces.readAllStandardOutput()).decode(errors="ignore")
            for stuk in tekst.replace("\r", "\n").split():
                if stuk.endswith("%") and stuk[:-1].isdigit():
                    self.balk.setValue(int(stuk[:-1]))

        def klaar_met_een(self, code: int, _status) -> None:
            if code in DEELS:
                self.deels.append(Path(self.nu[-2].rstrip("/")).name or "~")
            elif code not in GOED:
                self.melding.zet(t("Het lukte niet helemaal. Zit de schijf er nog in? Probeer het opnieuw.",
                                   "It did not fully work. Is the drive still plugged in? Try again."), "fout")
                self.wachtrij.clear()
                self.stop(False)
                return
            self.volgende()

        def klaar(self) -> None:
            if self.deels:
                if self.stand["klus"] == "maak":
                    onthoud(self.stand["schijf"])
                    self.wanneer.setText(laatste_backup())
                self.melding.zet(DEELS_UITLEG.format(mappen=", ".join(self.deels)), "let_op")
                self.stop(True)
                return
            if self.stand["klus"] == "maak":
                onthoud(self.stand["schijf"])
                self.wanneer.setText(laatste_backup())
                self.melding.zet(t("Klaar! Je bestanden staan veilig op de schijf. Je mag hem er nu uithalen.",
                                   "Done! Your files are safe on the drive. You can unplug it now."), "goed")
            else:
                self.melding.zet(t("Klaar! Je bestanden staan weer op je computer.",
                                   "Done! Your files are back on your computer."), "goed")
            self.stop(True)

        def stop(self, gelukt: bool) -> None:
            self.balk.setValue(100 if gelukt else self.balk.value())
            self.kiezer.setEnabled(True)
            self.knoppen()

        def bezig(self, tekst: str) -> None:
            self.deels = []
            self.melding.zet(tekst, "bezig")
            self.balk.setValue(0)
            self.balk.show()
            self.maak.setEnabled(False)
            self.terugzetten.setEnabled(False)
            self.kiezer.setEnabled(False)

        def maak_backup(self) -> None:
            schijf = self.gekozen()
            if schijf is None:
                return
            mappen = bron_mappen()
            past, nodig, vrij = ruimte_genoeg(schijf, mappen, backup_doel(schijf))
            if not past:
                self.melding.zet(t(f"Te weinig ruimte op de schijf: nodig {nodig / 1024**3:.1f} GB, vrij {vrij / 1024**3:.1f} GB.",
                                   f"Not enough space on the drive: need {nodig / 1024**3:.1f} GB, free {vrij / 1024**3:.1f} GB."),
                                 "fout")
                return
            doel = backup_doel(schijf)
            doel.mkdir(parents=True, exist_ok=True)
            schrijf_lijstje(doel)
            self.stand.update(klus="maak", schijf=schijf)
            self.wachtrij[:] = [rsync_maak(m, doel) for m in mappen]
            self.bezig(t("Bezig met kopiëren… Haal de schijf er niet uit.", "Copying… Do not unplug the drive."))
            self.volgende()

        def zet_terug(self) -> None:
            schijf = self.gekozen()
            if schijf is None:
                return
            lijst = backups_op(schijf)
            if not lijst:
                return
            bron = lijst[0]
            if len(lijst) > 1 and lijst[0] != backup_doel(schijf):
                # Geen back-up van deze computer, wel van andere: laat kiezen (bijv. "bugie@oude-laptop").
                keuze, ok = QInputDialog.getItem(
                    self, t("Welke back-up?", "Which backup?"),
                    t("Er staan meer back-ups op deze schijf. Welke wil je terugzetten?",
                      "There are several backups on this drive. Which one do you want to restore?"),
                    [p.name for p in lijst], 0, False)
                if not ok:
                    return
                bron = next(p for p in lijst if p.name == keuze)
            vraag = QMessageBox.question(
                self, t("Terugzetten?", "Restore?"),
                t("Je bestanden van de back-up komen terug op je computer. Een bestand dat op je computer ouder is "
                  "dan in de back-up, wordt vervangen. Nieuwere bestanden op je computer blijven staan.",
                  "Your files from the backup come back to your computer. A file that is older on your computer "
                  "than in the backup is replaced. Newer files on your computer are kept."),
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.Cancel, QMessageBox.StandardButton.Cancel)
            if vraag != QMessageBox.StandardButton.Yes:
                return
            self.stand.update(klus="terug", schijf=schijf)
            self.wachtrij[:] = terug_opdrachten(bron, Path.home())
            self.bezig(t("Bezig met terugzetten… Nieuwere bestanden op je computer blijven gewoon staan.",
                         "Restoring… Newer files on your computer are kept."))
            self.volgende()

    app = maak_app("bugos-backup", "bugos-backup", sys.argv)
    return uitvoeren(app, Backup())


if __name__ == "__main__":
    if len(sys.argv) == 3 and sys.argv[1] == "--maak":
        sys.exit(zonder_venster(Path(sys.argv[2])))
    sys.exit(venster())
