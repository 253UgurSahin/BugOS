#!/usr/bin/python3
"""BugOS Back-up - je bestanden veilig op een USB-schijf, met één knop.

Jip-en-Janneke:
  1. Steek een USB-schijf in.
  2. Druk op "Maak back-up".
  3. Je documenten, foto's, muziek, video's, bureaublad en downloads worden
     gekopieerd naar de map "BugOS-Backup" op die schijf.
Er wordt nooit iets weggegooid: niet op je computer en niet op de schijf.
Terugzetten kan ook met één knop.

  bugos-backup                     -> het venster
  bugos-backup --maak <schijfmap>  -> zonder venster (voor wie wil automatiseren)
"""

import getpass
import json
import os
import shutil
import socket
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, "/usr/lib/bugos/python")

from bugos_ui import CONFIG, t  # noqa: E402

LOG = CONFIG / "backup.json"

# (xdg-naam, standaard-mapnaam) - de echte naam hangt af van de taal.
MAPPEN = [
    ("DOCUMENTS", "Documents"),
    ("PICTURES", "Pictures"),
    ("MUSIC", "Music"),
    ("VIDEOS", "Videos"),
    ("DESKTOP", "Desktop"),
    ("DOWNLOAD", "Downloads"),
]


def gebruikersmap(xdg: str, standaard: str) -> Path:
    """Vraag aan het systeem waar bijvoorbeeld 'Afbeeldingen' staat."""
    try:
        uit = subprocess.run(["xdg-user-dir", xdg], capture_output=True, text=True, timeout=5).stdout.strip()
        if uit and Path(uit) != Path.home():
            return Path(uit)
    except (OSError, subprocess.SubprocessError):
        pass
    return Path.home() / standaard


def bron_mappen() -> list[Path]:
    return [p for p in (gebruikersmap(x, s) for x, s in MAPPEN) if p.is_dir()]


def schijven() -> list[Path]:
    """Alle aangesloten USB-schijven en losse schijven waarop je mag schrijven."""
    gebruiker = getpass.getuser()
    gevonden = []
    for basis in (Path("/run/media") / gebruiker, Path("/media") / gebruiker, Path("/media")):
        if basis.is_dir():
            for p in sorted(basis.iterdir()):
                if p.is_dir() and os.access(p, os.W_OK) and p.is_mount():
                    gevonden.append(p)
    return gevonden


def backup_doel(schijf: Path) -> Path:
    return schijf / "BugOS-Backup" / f"{getpass.getuser()}@{socket.gethostname()}"


def rsync_maak(bron: Path, doel: Path) -> list[str]:
    # Geen --delete: wat ooit in de back-up staat, blijft daar staan.
    # --modify-window: USB-schijven (FAT/exFAT) onthouden tijd minder precies.
    return ["rsync", "-rt", "--modify-window=2", "--info=progress2", "--no-inc-recursive",
            f"{bron}/", f"{doel / bron.name}/"]


def rsync_terug(doel: Path, thuis: Path) -> list[str]:
    # --update: een nieuwer bestand op de computer wordt nooit overschreven.
    return ["rsync", "-rt", "--update", "--modify-window=2", "--info=progress2", "--no-inc-recursive",
            f"{doel}/", f"{thuis}/"]


def ruimte_genoeg(schijf: Path, mappen: list[Path]) -> tuple[bool, int, int]:
    nodig = 0
    for m in mappen:
        for wortel, _, bestanden in os.walk(m):
            for b in bestanden:
                try:
                    nodig += (Path(wortel) / b).stat().st_size
                except OSError:
                    pass
    vrij = shutil.disk_usage(str(schijf)).free
    return nodig < vrij, nodig, vrij


def onthoud(schijf: Path) -> None:
    CONFIG.mkdir(parents=True, exist_ok=True)
    LOG.write_text(json.dumps({"schijf": str(schijf), "tijd": int(time.time())}))


def laatste_backup() -> str:
    try:
        d = json.loads(LOG.read_text())
        dagen = int((time.time() - d["tijd"]) // 86400)
        if dagen == 0:
            return t("Laatste back-up: vandaag", "Last backup: today")
        if dagen == 1:
            return t("Laatste back-up: gisteren", "Last backup: yesterday")
        return t(f"Laatste back-up: {dagen} dagen geleden", f"Last backup: {dagen} days ago")
    except (OSError, ValueError, KeyError):
        return t("Je hebt nog nooit een back-up gemaakt.", "You have never made a backup.")


def zonder_venster(schijf: Path) -> int:
    doel = backup_doel(schijf)
    doel.mkdir(parents=True, exist_ok=True)
    for m in bron_mappen():
        if subprocess.call(rsync_maak(m, doel)) not in (0, 24):  # 24 = bestand verdween tijdens kopiëren
            return 1
    onthoud(schijf)
    return 0


# ------------------------------------------------------------------ venster ----

def venster() -> int:
    from bugos_ui import gewone_knop, hoofdknop, maak_app, titel, uitleg
    from PySide6.QtCore import QProcess, QTimer
    from PySide6.QtWidgets import QComboBox, QHBoxLayout, QProgressBar, QVBoxLayout, QWidget

    app = maak_app("bugos-backup", "bugos-backup", sys.argv)
    w = QWidget()
    w.setWindowTitle(t("BugOS Back-up", "BugOS Backup"))
    w.resize(680, 460)
    lay = QVBoxLayout(w)
    lay.setContentsMargins(32, 28, 32, 28)
    lay.setSpacing(14)
    lay.addWidget(titel(t("Back-up", "Backup")))
    lay.addWidget(uitleg(t(
        "Zet je documenten, foto's, muziek, video's, bureaublad en downloads veilig op een USB-schijf. "
        "Er wordt nooit iets weggegooid.",
        "Keep your documents, photos, music, videos, desktop and downloads safe on a USB drive. "
        "Nothing is ever deleted."), 12))
    wanneer = uitleg(laatste_backup(), 12)
    lay.addWidget(wanneer)

    keuze = QComboBox()
    keuze.setMinimumHeight(40)
    lay.addWidget(keuze)
    melding = uitleg("", 12)
    lay.addWidget(melding)
    balk = QProgressBar()
    balk.setRange(0, 100)
    balk.setMinimumHeight(26)
    balk.hide()
    lay.addWidget(balk)
    lay.addStretch(1)

    rij = QHBoxLayout()
    terugzetten = gewone_knop(t("Terugzetten", "Restore"))
    maak = hoofdknop(t("Maak back-up", "Make backup"))
    rij.addWidget(terugzetten)
    rij.addStretch(1)
    rij.addWidget(maak)
    lay.addLayout(rij)

    wachtrij: list[list[str]] = []
    proces = QProcess()
    stand = {"klus": "", "schijf": None}

    def ververs_schijven() -> None:
        if proces.state() != QProcess.ProcessState.NotRunning:
            return
        huidig = keuze.currentData()
        keuze.clear()
        for s in schijven():
            heeft = backup_doel(s).exists()
            keuze.addItem(f"💾  {s.name}" + (t("  (heeft al een back-up)", "  (already has a backup)") if heeft else ""), str(s))
        if keuze.count() == 0:
            keuze.addItem(t("Steek een USB-schijf in...", "Plug in a USB drive..."), None)
        elif huidig:
            i = keuze.findData(huidig)
            if i >= 0:
                keuze.setCurrentIndex(i)
        heeft_schijf = keuze.currentData() is not None
        maak.setEnabled(heeft_schijf)
        terugzetten.setEnabled(heeft_schijf and backup_doel(Path(keuze.currentData())).exists())

    keuze.currentIndexChanged.connect(lambda _: terugzetten.setEnabled(
        keuze.currentData() is not None and backup_doel(Path(keuze.currentData())).exists()))

    def volgende() -> None:
        if not wachtrij:
            klaar()
            return
        cmd = wachtrij.pop(0)
        proces.start(cmd[0], cmd[1:])

    def lees() -> None:
        tekst = bytes(proces.readAllStandardOutput()).decode(errors="ignore")
        for stuk in tekst.replace("\r", "\n").split():
            if stuk.endswith("%") and stuk[:-1].isdigit():
                balk.setValue(int(stuk[:-1]))

    def klaar_met_een(code: int, _status) -> None:
        if code not in (0, 24):
            melding.setText(t("❌ Het lukte niet helemaal. Zit de schijf er nog in? Probeer het opnieuw.",
                              "❌ It did not fully work. Is the drive still plugged in? Try again."))
            wachtrij.clear()
            stop(False)
            return
        volgende()

    def klaar() -> None:
        if stand["klus"] == "maak":
            onthoud(stand["schijf"])
            wanneer.setText(laatste_backup())
            melding.setText(t("✅ Klaar! Je bestanden staan veilig op de schijf. Je mag hem er nu uithalen.",
                              "✅ Done! Your files are safe on the drive. You can unplug it now."))
        else:
            melding.setText(t("✅ Klaar! Je bestanden staan weer op je computer.",
                              "✅ Done! Your files are back on your computer."))
        stop(True)

    def stop(gelukt: bool) -> None:
        balk.setValue(100 if gelukt else balk.value())
        maak.setEnabled(True)
        terugzetten.setEnabled(True)
        keuze.setEnabled(True)

    def bezig(tekst: str) -> None:
        melding.setText(tekst)
        balk.setValue(0)
        balk.show()
        maak.setEnabled(False)
        terugzetten.setEnabled(False)
        keuze.setEnabled(False)

    def maak_backup() -> None:
        schijf = Path(keuze.currentData())
        mappen = bron_mappen()
        past, nodig, vrij = ruimte_genoeg(schijf, mappen)
        if not past:
            melding.setText(t(f"❌ Te weinig ruimte op de schijf: nodig {nodig / 1024**3:.1f} GB, vrij {vrij / 1024**3:.1f} GB.",
                              f"❌ Not enough space on the drive: need {nodig / 1024**3:.1f} GB, free {vrij / 1024**3:.1f} GB."))
            return
        doel = backup_doel(schijf)
        doel.mkdir(parents=True, exist_ok=True)
        stand.update(klus="maak", schijf=schijf)
        wachtrij[:] = [rsync_maak(m, doel) for m in mappen]
        bezig(t("Bezig met kopiëren... Haal de schijf er niet uit.", "Copying... Do not unplug the drive."))
        volgende()

    def zet_terug() -> None:
        schijf = Path(keuze.currentData())
        stand.update(klus="terug", schijf=schijf)
        wachtrij[:] = [rsync_terug(backup_doel(schijf), Path.home())]
        bezig(t("Bezig met terugzetten... Nieuwere bestanden op je computer blijven gewoon staan.",
                "Restoring... Newer files on your computer are kept."))
        volgende()

    proces.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
    proces.readyReadStandardOutput.connect(lees)
    proces.finished.connect(klaar_met_een)
    maak.clicked.connect(maak_backup)
    terugzetten.clicked.connect(zet_terug)

    timer = QTimer()
    timer.timeout.connect(ververs_schijven)
    timer.start(3000)
    ververs_schijven()
    w.show()
    return app.exec()


if __name__ == "__main__":
    if len(sys.argv) == 3 and sys.argv[1] == "--maak":
        sys.exit(zonder_venster(Path(sys.argv[2])))
    sys.exit(venster())
