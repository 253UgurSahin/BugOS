#!/usr/bin/python3
"""BugOS Hulp - "Er werkt iets niet".

Jip-en-Janneke: BugOS loopt een lijstje af (internet, wifi, bluetooth,
geluid, printer, opslag, updates). Bij elk probleem staat een knop
"Repareer" die het voor je probeert op te lossen.

  bugos-hulp            -> het venster
  bugos-hulp --tekst    -> alleen de uitslag in de terminal (handig voor hulpgevers)
"""

import os
import shutil
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Callable, Optional

sys.path.insert(0, "/usr/lib/bugos/python")

from bugos_ui import (  # noqa: E402
    bestaat, draai, gewone_knop, hoofdknop, kde_instelling, start, t, titel, uitleg,
)

OK, LET_OP, PROBLEEM, ONBEKEND = "ok", "let_op", "probleem", "onbekend"


@dataclass
class Uitslag:
    naam: str
    stand: str
    tekst: str
    repareer: Optional[Callable[[], None]] = None
    repareer_tekst: str = ""


# ------------------------------------------------------------- controles ----

def controle_internet() -> Uitslag:
    naam = t("Internet", "Internet")
    if not bestaat("nmcli"):
        return Uitslag(naam, ONBEKEND, t("Kon het niet controleren.", "Could not check."))
    _, uit = draai("nmcli", "-t", "-f", "CONNECTIVITY", "general")
    stand = uit.strip()
    if stand == "full":
        return Uitslag(naam, OK, t("Je bent verbonden met internet.", "You are connected to the internet."))
    if stand == "portal":
        return Uitslag(naam, LET_OP,
                       t("Je moet nog inloggen op het netwerk (bijv. in een hotel of trein). Open je browser.",
                         "You still need to sign in to the network (e.g. hotel or train). Open your browser."),
                       lambda: start("xdg-open", "http://neverssl.com"), t("Browser openen", "Open browser"))
    if stand == "limited":
        return Uitslag(naam, PROBLEEM,
                       t("Je hebt wel netwerk, maar geen internet. Vaak helpt het om opnieuw te verbinden.",
                         "You have a network but no internet. Reconnecting often helps."),
                       herstart_netwerk, t("Opnieuw verbinden", "Reconnect"))
    return Uitslag(naam, PROBLEEM, t("Geen verbinding. Kies hieronder je wifi.", "Not connected. Choose your Wi-Fi."),
                   lambda: kde_instelling("kcm_networkmanagement"), t("Wifi kiezen", "Choose Wi-Fi"))


def herstart_netwerk() -> None:
    draai("nmcli", "networking", "off", timeout=10)
    draai("nmcli", "networking", "on", timeout=10)


def controle_wifi() -> Uitslag:
    naam = t("Wifi", "Wi-Fi")
    if not bestaat("nmcli"):
        return Uitslag(naam, ONBEKEND, t("Kon het niet controleren.", "Could not check."))
    _, apparaten = draai("nmcli", "-t", "-f", "TYPE", "device")
    if "wifi" not in apparaten.split():
        return Uitslag(naam, OK, t("Deze computer heeft geen wifi (of gebruikt een kabel). Dat is prima.",
                                   "This computer has no Wi-Fi (or uses a cable). That's fine."))
    _, radio = draai("nmcli", "radio", "wifi")
    if radio.strip() != "enabled":
        return Uitslag(naam, PROBLEEM, t("Wifi staat uit.", "Wi-Fi is turned off."),
                       lambda: (draai("rfkill", "unblock", "wifi"), draai("nmcli", "radio", "wifi", "on")),
                       t("Wifi aanzetten", "Turn Wi-Fi on"))
    return Uitslag(naam, OK, t("Wifi staat aan.", "Wi-Fi is on."))


def controle_bluetooth() -> Uitslag:
    naam = "Bluetooth"
    if not bestaat("bluetoothctl"):
        return Uitslag(naam, ONBEKEND, t("Kon het niet controleren.", "Could not check."))
    code, uit = draai("bluetoothctl", "show", timeout=5)
    if code != 0 or "Controller" not in uit:
        return Uitslag(naam, OK, t("Geen bluetooth gevonden op deze computer.", "No Bluetooth found on this computer."))
    if "Powered: yes" in uit:
        return Uitslag(naam, OK, t("Bluetooth staat aan.", "Bluetooth is on."))
    return Uitslag(naam, LET_OP, t("Bluetooth staat uit.", "Bluetooth is off."),
                   lambda: (draai("rfkill", "unblock", "bluetooth"), draai("bluetoothctl", "power", "on")),
                   t("Bluetooth aanzetten", "Turn Bluetooth on"))


def controle_geluid() -> Uitslag:
    naam = t("Geluid", "Sound")
    if not bestaat("wpctl"):
        return Uitslag(naam, ONBEKEND, t("Kon het niet controleren.", "Could not check."))
    code, uit = draai("wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@", timeout=5)
    if code != 0:
        return Uitslag(naam, PROBLEEM, t("Er is geen luidspreker gevonden.", "No speaker was found."),
                       herstart_geluid, t("Geluid herstarten", "Restart sound"))
    if "MUTED" in uit:
        return Uitslag(naam, PROBLEEM, t("Het geluid staat op stil.", "Sound is muted."),
                       lambda: draai("wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "0"),
                       t("Geluid aanzetten", "Unmute"))
    try:
        volume = float(uit.split()[1])
    except (IndexError, ValueError):
        volume = 1.0
    if volume < 0.1:
        return Uitslag(naam, LET_OP, t("Het geluid staat heel zacht.", "Sound is very quiet."),
                       lambda: draai("wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", "0.5"),
                       t("Harder zetten", "Turn up"))
    return Uitslag(naam, OK, t("Geluid werkt.", "Sound works."))


def herstart_geluid() -> None:
    draai("systemctl", "--user", "restart", "wireplumber", "pipewire", "pipewire-pulse", timeout=20)


def controle_printer() -> Uitslag:
    naam = t("Printer", "Printer")
    if not bestaat("lpstat"):
        return Uitslag(naam, ONBEKEND, t("Kon het niet controleren.", "Could not check."))
    code, uit = draai("lpstat", "-r", timeout=5)
    if code != 0 or "not running" in uit:
        return Uitslag(naam, LET_OP, t("De printerdienst draait niet.", "The printing service is not running."),
                       lambda: start("pkexec", "systemctl", "restart", "cups"), t("Printerdienst starten", "Start printing service"))
    _, printers = draai("lpstat", "-p", timeout=5)
    if not printers.strip():
        return Uitslag(naam, OK, t("Er is nog geen printer toegevoegd.", "No printer has been added yet."),
                       lambda: kde_instelling("kcm_printer_manager"), t("Printer toevoegen", "Add printer"))
    if "disabled" in printers:
        return Uitslag(naam, LET_OP, t("Een printer staat op pauze.", "A printer is paused."),
                       lambda: kde_instelling("kcm_printer_manager"), t("Printers bekijken", "View printers"))
    return Uitslag(naam, OK, t("Printer is klaar.", "Printer is ready."))


def controle_opslag() -> Uitslag:
    naam = t("Opslag", "Storage")
    try:
        gebruik = shutil.disk_usage(str(Path.home()))
    except OSError:
        return Uitslag(naam, ONBEKEND, t("Kon het niet controleren.", "Could not check."))
    vrij_gb = gebruik.free / 1024**3
    if vrij_gb < 2 or gebruik.free / gebruik.total < 0.03:
        return Uitslag(naam, PROBLEEM,
                       t(f"Je schijf is bijna vol (nog {vrij_gb:.1f} GB). Ruim oude downloads op.",
                         f"Your disk is almost full ({vrij_gb:.1f} GB left). Clean up old downloads."),
                       lambda: start("filelight", str(Path.home())) if bestaat("filelight") else start("dolphin", str(Path.home() / "Downloads")),
                       t("Laat zien wat ruimte inneemt", "Show what takes up space"))
    if vrij_gb < 10:
        return Uitslag(naam, LET_OP, t(f"Nog {vrij_gb:.0f} GB vrij. Dat raakt op.", f"{vrij_gb:.0f} GB free. Running low."))
    return Uitslag(naam, OK, t(f"Genoeg ruimte: {vrij_gb:.0f} GB vrij.", f"Enough space: {vrij_gb:.0f} GB free."))


def controle_updates() -> Uitslag:
    naam = t("Updates", "Updates")
    if not bestaat("rpm-ostree"):
        return Uitslag(naam, ONBEKEND, t("Kon het niet controleren.", "Could not check."))
    code, uit = draai("rpm-ostree", "status", "--json", timeout=15)
    if code != 0:
        return Uitslag(naam, ONBEKEND, t("Kon het niet controleren.", "Could not check."))
    import json
    try:
        deploys = json.loads(uit).get("deployments", [])
    except ValueError:
        deploys = []
    if deploys and not deploys[0].get("booted", True):
        return Uitslag(naam, LET_OP,
                       t("Er staat een update klaar. Start de computer opnieuw op om hem te gebruiken.",
                         "An update is ready. Restart the computer to use it."),
                       lambda: start("qdbus6", "org.kde.LogoutPrompt", "/LogoutPrompt", "promptReboot"),
                       t("Nu herstarten", "Restart now"))
    return Uitslag(naam, OK, t("Alles is bijgewerkt.", "Everything is up to date."))


CONTROLES = [controle_internet, controle_wifi, controle_bluetooth, controle_geluid,
             controle_printer, controle_opslag, controle_updates]


def alles_controleren() -> list[Uitslag]:
    uitslagen = []
    for c in CONTROLES:
        try:
            uitslagen.append(c())
        except Exception as e:  # een controle mag de app nooit laten crashen
            uitslagen.append(Uitslag(c.__name__, ONBEKEND, str(e)))
    return uitslagen


# ------------------------------------------------------------------ venster ----

TEKEN = {OK: "✅", LET_OP: "⚠️", PROBLEEM: "❌", ONBEKEND: "❔"}


def venster() -> int:
    from bugos_ui import maak_app
    from PySide6.QtCore import QTimer
    from PySide6.QtWidgets import QFrame, QHBoxLayout, QLabel, QScrollArea, QVBoxLayout, QWidget

    app = maak_app("bugos-hulp", "bugos-hulp", sys.argv)
    hoofd = QWidget()
    hoofd.setWindowTitle(t("Er werkt iets niet", "Something is not working"))
    hoofd.resize(760, 680)
    lay = QVBoxLayout(hoofd)
    lay.setContentsMargins(32, 28, 32, 24)
    lay.setSpacing(14)
    lay.addWidget(titel(t("Er werkt iets niet?", "Something not working?")))
    samenvatting = uitleg(t("Even kijken...", "Let me check..."), 13)
    lay.addWidget(samenvatting)

    lijst = QWidget()
    lijst_lay = QVBoxLayout(lijst)
    lijst_lay.setContentsMargins(0, 0, 0, 0)
    lijst_lay.setSpacing(10)
    scroll = QScrollArea()
    scroll.setWidgetResizable(True)
    scroll.setFrameShape(QScrollArea.Shape.NoFrame)
    scroll.setWidget(lijst)
    lay.addWidget(scroll, 1)

    onder = QHBoxLayout()
    opnieuw = hoofdknop(t("Opnieuw controleren", "Check again"))
    hulp = gewone_knop(t("Uitslag kopiëren", "Copy results"))
    onder.addWidget(hulp)
    onder.addStretch(1)
    onder.addWidget(opnieuw)
    lay.addLayout(onder)
    laatste: list[Uitslag] = []

    def vul() -> None:
        nonlocal laatste
        while lijst_lay.count():
            item = lijst_lay.takeAt(0)
            if item.widget():
                item.widget().deleteLater()
        laatste = alles_controleren()
        problemen = [u for u in laatste if u.stand in (PROBLEEM, LET_OP)]
        if not problemen:
            samenvatting.setText(t("Alles ziet er goed uit! 🎉 Werkt er toch iets niet? Start de computer opnieuw op; dat lost veel op.",
                                   "Everything looks good! 🎉 Still something wrong? Restart the computer; that fixes a lot."))
        else:
            n = len(problemen)
            samenvatting.setText(t(f"Ik vond {n} {'ding' if n == 1 else 'dingen'} om naar te kijken. Druk op de knop ernaast om het te repareren.",
                                   f"I found {n} {'thing' if n == 1 else 'things'} to look at. Press the button next to it to fix it."))
        volgorde = {PROBLEEM: 0, LET_OP: 1, ONBEKEND: 2, OK: 3}
        for u in sorted(laatste, key=lambda x: volgorde[x.stand]):
            kaart = QFrame()
            kaart.setObjectName("kaart")
            rij = QHBoxLayout(kaart)
            rij.setContentsMargins(16, 12, 16, 12)
            teken = QLabel(TEKEN[u.stand])
            teken.setStyleSheet("font-size: 22px;")
            rij.addWidget(teken)
            blok = QVBoxLayout()
            blok.addWidget(titel(u.naam, 13))
            blok.addWidget(uitleg(u.tekst, 11))
            rij.addLayout(blok, 1)
            if u.repareer:
                knop = gewone_knop(u.repareer_tekst or t("Repareer", "Fix"))
                knop.clicked.connect(lambda _=False, f=u.repareer: (f(), QTimer.singleShot(2500, vul)))
                rij.addWidget(knop)
            lijst_lay.addWidget(kaart)
        lijst_lay.addStretch(1)

    def kopieer() -> None:
        app.clipboard().setText(als_tekst(laatste))
        hulp.setText(t("Gekopieerd ✓", "Copied ✓"))

    opnieuw.clicked.connect(vul)
    hulp.clicked.connect(kopieer)
    hoofd.show()
    QTimer.singleShot(50, vul)
    return app.exec()


def als_tekst(uitslagen: list[Uitslag]) -> str:
    regels = ["BugOS hulp-uitslag"]
    try:
        regels.append(Path("/usr/share/bugos/image-info.json").read_text().strip())
    except OSError:
        pass
    for u in uitslagen:
        regels.append(f"{TEKEN[u.stand]} {u.naam}: {u.tekst}")
    return "\n".join(regels)


if __name__ == "__main__":
    if "--tekst" in sys.argv:
        print(als_tekst(alles_controleren()))
        sys.exit(0)
    if not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY") \
            and os.environ.get("QT_QPA_PLATFORM") != "offscreen":
        print(als_tekst(alles_controleren()))
        sys.exit(0)
    sys.exit(venster())
