#!/usr/bin/bash
# bugos-spelmodus - game-modus aan of uit.
#
#   bugos-spelmodus aan | uit | wissel | status
#
# Game-modus aan betekent:
#   • computer op volle kracht (stroomprofiel "prestaties")
#   • meldingen even stil (niet storen)
#   • FPS-teller (MangoHud) in Steam-games
# Uit zet alles terug.

# shellcheck source=system_files/usr/share/bugos/lib.sh
. /usr/share/bugos/lib.sh

MARKER="$BUGOS_CONFIG/spelmodus-aan"
ENVFILE="${XDG_CONFIG_HOME:-$HOME/.config}/environment.d/90-bugos-spelmodus.conf"

niet_storen() {
    # $1 = true/false. KDE leest dit direct uit plasmanotifyrc.
    if [ "$1" = true ]; then
        kwriteconfig6 --file plasmanotifyrc --group DoNotDisturb --key Until "2099,1,1,0,0,0.000"
    else
        kwriteconfig6 --file plasmanotifyrc --group DoNotDisturb --key Until --delete
    fi
}

aan() {
    mkdir -p "$BUGOS_CONFIG" "$(dirname "$ENVFILE")"
    powerprofilesctl get >"$BUGOS_CONFIG/stroomprofiel-voor-spelmodus" 2>/dev/null
    powerprofilesctl set performance 2>/dev/null
    niet_storen true
    printf 'MANGOHUD=1\n' >"$ENVFILE"
    systemctl --user set-environment MANGOHUD=1 2>/dev/null
    touch "$MARKER"
    melding "$(t "Game-modus staat AAN 🎮" "Game mode is ON 🎮")" \
        "$(t "Volle kracht, meldingen stil, FPS-teller in games." "Full power, notifications muted, FPS counter in games.")"
}

uit() {
    local vorig
    vorig="$(cat "$BUGOS_CONFIG/stroomprofiel-voor-spelmodus" 2>/dev/null || echo balanced)"
    powerprofilesctl set "$vorig" 2>/dev/null
    niet_storen false
    rm -f "$ENVFILE" "$MARKER"
    systemctl --user unset-environment MANGOHUD 2>/dev/null
    melding "$(t "Game-modus staat UIT" "Game mode is OFF")" ""
}

case "${1:-wissel}" in
aan) aan ;;
uit) uit ;;
wissel) if [ -f "$MARKER" ]; then uit; else aan; fi ;;
status) if [ -f "$MARKER" ]; then echo aan; else echo uit; fi ;;
*)
    echo "Gebruik: bugos-spelmodus aan|uit|wissel|status" >&2
    exit 2
    ;;
esac
