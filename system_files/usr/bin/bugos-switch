#!/usr/bin/python3
"""BugOS Overstap (BugOS-kant) - je bestanden van Windows terugzetten.

Jip-en-Janneke: met het Windows-programma "BugOS Overstap" heb je je
bestanden op een USB-schijf gezet (map "BugOS-Switch"). Steek die schijf
in, open dit programma en druk op één knop. Dan:
  - komen je documenten, foto's, muziek, video's, bureaublad en downloads
    op de goede plek;
  - worden je bladwijzers van Chrome/Edge/Brave omgezet naar een bestand
    dat je in Firefox kunt importeren;
  - wordt je oude Windows-achtergrond ook je BugOS-achtergrond.

  bugos-switch                -> het venster
  bugos-switch --zet <map>    -> zonder venster
"""

import getpass
import os
import html
import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, "/usr/lib/bugos/python")

from bugos_ui import t  # noqa: E402

# Mapnaam en infobestand van de Windows-overstap: de nieuwe en de oude (van voor de hernoeming).
MAPPEN = (("BugOS-Switch", "bugos-switch.json"), ("BugOS-Overstap", "bugos-overstap.json"))

# Windows-mapnaam -> xdg-naam van de BugOS-map
KOPPELING = {
    "Documents": "DOCUMENTS",
    "Pictures": "PICTURES",
    "Music": "MUSIC",
    "Videos": "VIDEOS",
    "Desktop": "DESKTOP",
    "Downloads": "DOWNLOAD",
}


def gebruikersmap(xdg: str, standaard: str) -> Path:
    # Alleen de vaste soorten: de naam gaat naar xdg-user-dir (een sh-script), en kan uit een bestand op een
    # stick van iemand anders komen (U097).
    if xdg not in {"DOCUMENTS", "PICTURES", "MUSIC", "VIDEOS", "DESKTOP", "DOWNLOAD"}:
        return Path.home() / standaard
    try:
        uit = subprocess.run(["xdg-user-dir", xdg], capture_output=True, text=True, timeout=5).stdout.strip()
        if uit and Path(uit) != Path.home():
            return Path(uit)
    except (OSError, subprocess.SubprocessError):
        pass
    return Path.home() / standaard


def _op_schijf(schijf: Path) -> list[Path]:
    """De overstap-map op één schijf: BugOS-Switch, of anders BugOS-Overstap van de oude versie.
    Staan ze er allebei (beide versies gebruikt), dan alleen de nieuwe: anders staat de stick er twee keer."""
    for naam, bestand in MAPPEN:
        if (schijf / naam / bestand).is_file():
            return [schijf / naam]
    return []


def zoek_overstap() -> list[Path]:
    """Zoek op alle aangesloten schijven naar de map BugOS-Switch (of de oude BugOS-Overstap)."""
    if os.environ.get("BUGOS_SCHIJVEN"):  # voor tests en screenshots
        return [m for p in os.environ["BUGOS_SCHIJVEN"].split(":") for m in _op_schijf(Path(p))]
    # Een stick die er net in zit, is nog dicht (KDE opent hem niet vanzelf): eerst openzetten (U139).
    try:
        import bugos_drives
        bugos_drives.losse_openen_op_achtergrond()
    except Exception:  # noqa: BLE001  zonder udisks/lsblk gewoon kijken wat er al open is
        pass
    gebruiker = getpass.getuser()
    gevonden = []
    for basis in (Path("/run/media") / gebruiker, Path("/media") / gebruiker, Path("/media")):
        if basis.is_dir():
            for schijf in basis.iterdir():
                gevonden.extend(_op_schijf(schijf))
    return gevonden


def info(map_: Path) -> dict:
    for _naam, bestand in MAPPEN:
        try:
            return json.loads((map_ / bestand).read_text(encoding="utf-8-sig"))
        except FileNotFoundError:
            continue
        except (OSError, ValueError):
            return {}
    return {}


# --------------------------------------------------------- bladwijzers ----

def _html_map(knoop: dict, diepte: int) -> list[str]:
    inspring = "    " * diepte
    regels = []
    for kind in knoop.get("children", []):
        naam = html.escape(kind.get("name", ""))
        if kind.get("type") == "folder":
            regels.append(f"{inspring}<DT><H3>{naam}</H3>")
            regels.append(f"{inspring}<DL><p>")
            regels.extend(_html_map(kind, diepte + 1))
            regels.append(f"{inspring}</DL><p>")
        elif kind.get("type") == "url":
            url = html.escape(kind.get("url", ""), quote=True)
            regels.append(f'{inspring}<DT><A HREF="{url}">{naam}</A>')
    return regels


def chrome_naar_html(bestanden: dict[str, Path]) -> str:
    """Zet Chrome/Edge/Brave-bladwijzers om naar het standaard HTML-formaat
    dat elke browser (Firefox, Chrome, ...) kan importeren."""
    regels = [
        "<!DOCTYPE NETSCAPE-Bookmark-file-1>",
        '<META HTTP-EQUIV="Content-Type" CONTENT="text/html; charset=UTF-8">',
        "<TITLE>Bookmarks</TITLE>",
        "<H1>Bookmarks</H1>",
        "<DL><p>",
    ]
    for browser, pad in bestanden.items():
        try:
            data = json.loads(pad.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        regels.append(f"    <DT><H3>{html.escape(browser)}</H3>")
        regels.append("    <DL><p>")
        for wortel in data.get("roots", {}).values():
            if isinstance(wortel, dict) and wortel.get("children"):
                regels.append(f"        <DT><H3>{html.escape(wortel.get('name', ''))}</H3>")
                regels.append("        <DL><p>")
                regels.extend(_html_map(wortel, 3))
                regels.append("        </DL><p>")
        regels.append("    </DL><p>")
    regels.append("</DL><p>")
    return "\n".join(regels) + "\n"


# ---------------------------------------------------------- terugzetten ----

def stappen(bron: Path) -> list[tuple[str, list[str]]]:
    """De kopieer-opdrachten, met een uitleg per stap."""
    lijst = []
    for win, xdg in KOPPELING.items():
        if (bron / win).is_dir():
            doel = gebruikersmap(xdg, win)
            # --ignore-existing: wat al op BugOS staat, wordt nooit overschreven.
            lijst.append((t(f"{win} terugzetten...", f"Restoring {win}..."),
                          ["rsync", "-rt", "--ignore-existing", "--modify-window=2", "--info=progress2",
                           "--no-inc-recursive", f"{bron / win}/", f"{doel}/"]))
    return lijst


def vrije_naam(pad: Path) -> Path:
    """Bestaat 'pad' al? Dan 'naam (2).ext', 'naam (3).ext'... We overschrijven nooit iets."""
    if not pad.exists():
        return pad
    n = 2
    while (nieuw := pad.with_name(f"{pad.stem} ({n}){pad.suffix}")).exists():
        n += 1
    return nieuw


def afronden(bron: Path) -> list[str]:
    """Bladwijzers en achtergrond. Geeft een lijstje met wat er gedaan is."""
    gedaan = []
    bw = bron / "Bladwijzers"
    jsons = {p.stem: p for p in sorted(bw.glob("*.json"))} if bw.is_dir() else {}
    if jsons:
        doel = vrije_naam(gebruikersmap("DOCUMENTS", "Documents") / "Bladwijzers-van-Windows.html")
        doel.parent.mkdir(parents=True, exist_ok=True)
        doel.write_text(chrome_naar_html(jsons), encoding="utf-8")
        gedaan.append(t(f"Je bladwijzers staan in {doel.name} (in Documenten). In Firefox: menu → Bladwijzers → "
                        "Bladwijzers beheren → Importeren → HTML.",
                        f"Your bookmarks are in {doel.name} (in Documents). In Firefox: menu → Bookmarks → "
                        "Manage bookmarks → Import → HTML."))
    if bw.is_dir() and (bw / "Firefox.jsonlz4").is_file():
        doel = vrije_naam(gebruikersmap("DOCUMENTS", "Documents") / "Firefox-bladwijzers.jsonlz4")
        doel.parent.mkdir(parents=True, exist_ok=True)
        doel.write_bytes((bw / "Firefox.jsonlz4").read_bytes())
        gedaan.append(t("Firefox-bladwijzers: Firefox → Bladwijzers beheren → Importeren → Herstellen → Bestand kiezen → "
                        f"{doel.name}.",
                        f"Firefox bookmarks: Firefox → Manage bookmarks → Import → Restore → Choose file → {doel.name}."))
    achtergrond = bron / "achtergrond.jpg"
    if achtergrond.is_file():
        doel = vrije_naam(gebruikersmap("PICTURES", "Pictures") / "Windows-achtergrond.jpg")
        doel.parent.mkdir(parents=True, exist_ok=True)
        doel.write_bytes(achtergrond.read_bytes())
        try:
            klaar = subprocess.run(["plasma-apply-wallpaperimage", str(doel)], capture_output=True, timeout=10)
            if klaar.returncode != 0:
                raise OSError(klaar.returncode)
            gedaan.append(t("Je Windows-achtergrond is nu ook je BugOS-achtergrond.",
                            "Your Windows wallpaper is now your BugOS wallpaper too."))
        except (OSError, subprocess.SubprocessError):
            pass
    return gedaan


# rsync: 0 = goed, 24 = een bestand verdween (geen probleem), 23 = een paar bestanden konden niet mee
# (bijv. een naam met : of ?, of iets dat Windows op slot had). Bij 23 gaan we door met de volgende map.
GOED, DEELS = (0, 24), (23,)


def uitslag(code: int, cmd: list[str], uitvoer: str = "") -> str:
    """'goed', 'deels', 'vol' of 'weg' (de schijf of map waar het vandaan komt is er niet meer) of 'fout'.
    rsync geeft ook 23 als de bronmap verdwenen is (stick eruit): dat is niet 'een paar bestanden' (U078)."""
    if code not in GOED and "No space left on device" in uitvoer:
        return "vol"
    if code in GOED:
        return "goed"
    try:
        weg = not Path(cmd[-2]).exists()
    except OSError:   # een stick die eruit is, kan ook een leesfout geven
        weg = True
    if weg:
        return "weg"
    return "deels" if code in DEELS else "fout"


def deels_uitleg(mappen: list[str]) -> str:
    return t(f"Een paar bestanden uit {', '.join(mappen)} konden niet mee. De rest staat er wel.",
             f"A few files from {', '.join(mappen)} could not be copied. Everything else is there.")


def zonder_venster(bron: Path) -> int:
    deels = []
    for _, cmd in stappen(bron):
        r = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True, errors="replace")
        sys.stderr.write(r.stderr)
        soort = uitslag(r.returncode, cmd, r.stderr)
        if soort == "deels":
            deels.append(Path(cmd[-2].rstrip("/")).name)
        elif soort != "goed":
            if soort == "vol":
                print(t("Je computer is vol.", "Your computer is full."), file=sys.stderr)
            return 1
    for regel in afronden(bron):
        print(regel)
    if deels:
        print(deels_uitleg(deels), file=sys.stderr)
        return 2
    return 0


# ------------------------------------------------------------------ venster ----

def venster() -> int:
    from bugos_ui import (
        Banner, Groep, IcoonChip, Knop, SchijfKiezer, Voortgang, kop_met_icoon, label, maak_app, pagina, sectie,
        uitvoeren,
    )
    from PySide6.QtCore import QProcess, QTimer
    from PySide6.QtWidgets import QHBoxLayout, QMessageBox, QVBoxLayout, QWidget

    class Overstap(QWidget):
        def __init__(self):
            super().__init__()
            self.setObjectName("venster")
            self.setWindowTitle(t("Bestanden van Windows", "Files from Windows"))
            self.resize(780, 700)
            w, lay = pagina()
            buiten = QVBoxLayout(self)
            buiten.setContentsMargins(0, 0, 0, 0)
            buiten.addWidget(w)
            lay.addWidget(kop_met_icoon("lijn:download", "neutraal", t("Je bestanden van Windows", "Your files from Windows"),
                                        t("Heb je met \"BugOS Overstap\" je bestanden op een USB-schijf gezet? "
                                          "Steek die schijf in en druk op de knop.",
                                          "Did you put your files on a USB drive with \"BugOS Overstap\"? "
                                          "Plug in that drive and press the button.")))
            wat = Groep()
            for icoon, tint, kop_t, sub_t in (
                ("lijn:download", "neutraal", t("Documenten, foto's, muziek en video's", "Documents, photos, music and videos"),
                 t("Komen op de goede plek. Wat al op BugOS staat, wordt nooit overschreven.",
                   "Go to the right place. What's already on BugOS is never overwritten.")),
                ("lijn:ster", "neutraal", t("Bladwijzers", "Bookmarks"),
                 t("Van Chrome, Edge en Brave, klaar om in Firefox te zetten.", "From Chrome, Edge and Brave, ready for Firefox.")),
                ("lijn:foto", "neutraal", t("Je achtergrond", "Your wallpaper"),
                 t("Je oude Windows-achtergrond wordt ook je BugOS-achtergrond.",
                   "Your old Windows wallpaper becomes your BugOS wallpaper too.")),
            ):
                rij = QWidget()
                r = QHBoxLayout(rij)
                r.setContentsMargins(18, 12, 18, 12)
                r.setSpacing(14)
                r.addWidget(IcoonChip(icoon, tint, 36, vol=False))
                b = QVBoxLayout()
                b.setSpacing(1)
                b.addWidget(label(kop_t, "kop3"))
                b.addWidget(label(sub_t, "klein"))
                r.addLayout(b, 1)
                wat.voeg(rij)
            lay.addWidget(wat)
            lay.addWidget(sectie(t("Kies de schijf", "Choose the drive")))
            self.kiezer = SchijfKiezer(t("Steek de USB-schijf met je Windows-bestanden in…",
                                         "Plug in the USB drive with your Windows files…"))
            lay.addWidget(self.kiezer)
            self.melding = Banner()
            lay.addWidget(self.melding)
            self.balk = Voortgang()
            self.balk.hide()
            lay.addWidget(self.balk)
            lay.addStretch(1)
            rij = QHBoxLayout()
            rij.addStretch(1)
            self.knop = Knop(t("Zet mijn bestanden terug", "Restore my files"), "hoofd", "lijn:download", groot=True)
            rij.addWidget(self.knop)
            lay.addLayout(rij)

            self.proces = QProcess(self)
            self.proces.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
            self.proces.readyReadStandardOutput.connect(self.lees)
            self.proces.finished.connect(self.klaar)
            self.wachtrij: list[tuple[str, list[str]]] = []
            self.nu: list[str] = []
            self.deels: list[str] = []
            self.bron: Path | None = None
            self.sluit_na = False  # het venster ging dicht tijdens het terugzetten: sluiten zodra het klaar is
            self.gestopt = False   # de gebruiker koos 'Nu stoppen'
            self.knop.clicked.connect(self.begin)
            self.kiezer.gewijzigd.connect(lambda: self.knop.setEnabled(self.kiezer.gekozen() is not None))
            self.timer = QTimer(self)
            self.timer.timeout.connect(self.ververs)
            self.timer.start(3000)
            self.ververs()
            self.kiezer.setFocus()

        def ververs(self) -> None:
            # Niet verversen terwijl we bezig zijn (de kiezer staat dan uit). Daarna wel weer: de balk
            # blijft na de eerste keer zichtbaar, dus daar mogen we niet op letten.
            if self.proces.state() != QProcess.ProcessState.NotRunning or not self.kiezer.isEnabled():
                return
            items = []
            for m in zoek_overstap():
                i = info(m)
                items.append((str(m), m.parent.name,
                              t(f"Van {i.get('gebruiker', '?')} op {i.get('computer', '?')}",
                                f"From {i.get('gebruiker', '?')} on {i.get('computer', '?')}")))
            self.kiezer.zet(items)
            self.knop.setEnabled(self.kiezer.gekozen() is not None)

        def volgende(self) -> None:
            if not self.wachtrij:
                try:
                    gedaan = afronden(self.bron)
                except OSError:  # schijf vol, of de stick eruit getrokken
                    self.melding.zet(t("Je bestanden staan erop, maar de bladwijzers of achtergrond lukten niet. "
                                       "Is je computer vol, of is de stick eruit? Probeer het opnieuw.",
                                       "Your files are there, but the bookmarks or wallpaper did not work. "
                                       "Is your computer full, or was the stick unplugged? Try again."), "fout")
                    self.sluit_na = False  # de foutmelding moet je kunnen zien, ook na 'Eerst afmaken'
                    self.vrij()
                    return
                self.balk.setValue(100)
                kop = (deels_uitleg(self.deels) if self.deels
                       else t("Klaar! Je bestanden staan op hun plek.", "Done! Your files are in place."))
                self.melding.zet(kop + ("\n\n• " + "\n• ".join(gedaan) if gedaan else ""),
                                 "let_op" if self.deels else "goed")
                if self.deels:
                    self.sluit_na = False  # niet alles kon mee: dat moet je kunnen lezen, ook na 'Eerst afmaken'
                self.vrij()
                return
            tekst, cmd = self.wachtrij.pop(0)
            self.nu = cmd
            self.uitvoer = ""
            self.melding.zet(tekst, "bezig")
            self.balk.setValue(0)
            self.proces.start(cmd[0], cmd[1:])

        def lees(self) -> None:
            tekst = bytes(self.proces.readAllStandardOutput()).decode(errors="ignore")
            self.uitvoer = (self.uitvoer + tekst)[-8000:]   # voor 'schijf vol' (U079)
            for stuk in tekst.replace("\r", "\n").split():
                if stuk.endswith("%") and stuk[:-1].isdigit():
                    self.balk.setValue(int(stuk[:-1]))

        def klaar(self, code: int, _s) -> None:
            if self.gestopt:
                self.wachtrij.clear()
                self.vrij()
                return
            soort = uitslag(code, self.nu, getattr(self, "uitvoer", ""))
            if soort == "deels":
                self.deels.append(Path(self.nu[-2].rstrip("/")).name)
            elif soort != "goed":
                self.melding.zet(t("Je computer is vol. Maak eerst ruimte (bijv. de prullenbak leegmaken in Bestanden) "
                                   "en probeer het dan opnieuw: wat er al staat, wordt niet opnieuw gekopieerd.",
                                   "Your computer is full. Make room first (for example empty the trash in Files) "
                                   "and try again: what is already there is not copied again.") if soort == "vol" else
                                 t("Het lukte niet helemaal. Zit de schijf er nog in? Probeer het opnieuw.",
                                   "It did not fully work. Is the drive still plugged in? Try again."), "fout")
                self.wachtrij.clear()
                self.sluit_na = False  # ook na 'Eerst afmaken': de foutmelding moet je kunnen zien
                self.vrij()
                return
            self.volgende()

        def vrij(self) -> None:
            """Klaar (of gestopt): de knoppen doen het weer, en ging het venster dicht, dan nu echt."""
            self.knop.setEnabled(True)
            self.kiezer.setEnabled(True)
            if self.sluit_na:
                QTimer.singleShot(0, self.close)

        def vraag_stoppen(self) -> bool:
            """Het venster gaat dicht terwijl we bezig zijn: stoppen, of eerst afmaken?"""
            box = QMessageBox(self)
            box.setIcon(QMessageBox.Icon.Question)
            box.setWindowTitle(t("Nog bezig", "Still busy"))
            box.setText(t("Je bestanden worden nog teruggezet.", "Your files are still being restored."))
            box.setInformativeText(
                t("Maak je het eerst af, dan gaat het venster daarna vanzelf dicht. Stop je nu, dan staat nog niet "
                  "alles op je computer (wat er al staat, blijft gewoon staan).",
                  "If you let it finish, the window closes by itself afterwards. If you stop now, not everything "
                  "is on your computer yet (what is already there stays)."))
            door = box.addButton(t("Eerst afmaken", "Finish first"), QMessageBox.ButtonRole.AcceptRole)
            stop = box.addButton(t("Nu stoppen", "Stop now"), QMessageBox.ButtonRole.DestructiveRole)
            box.setDefaultButton(door)
            box.exec()
            return box.clickedButton() is stop

        def closeEvent(self, e) -> None:  # noqa: N802
            if self.proces.state() == QProcess.ProcessState.NotRunning:
                super().closeEvent(e)
                return
            # Nooit stilletjes midden in het terugzetten stoppen: vraag het, en sluit pas als het proces klaar is.
            e.ignore()
            if self.sluit_na:
                return  # al gevraagd; we wachten
            self.sluit_na = True
            if self.vraag_stoppen():
                self.gestopt = True
                self.wachtrij.clear()
                self.melding.zet(t("Bezig met stoppen…", "Stopping…"), "bezig")
                self.proces.terminate()  # rsync ruimt zijn halve bestand zelf op
            else:
                self.melding.zet(t("Even wachten: het venster gaat vanzelf dicht als het klaar is.",
                                   "One moment: the window closes by itself when it is done."), "bezig")

        def begin(self) -> None:
            gekozen = self.kiezer.gekozen()
            if not gekozen:
                return
            self.bron = Path(gekozen)
            self.deels = []
            self.wachtrij[:] = stappen(self.bron)
            self.knop.setEnabled(False)
            self.kiezer.setEnabled(False)
            self.balk.show()
            self.volgende()

    app = maak_app("bugos-switch", "bugos-switch", sys.argv)
    return uitvoeren(app, Overstap())


if __name__ == "__main__":
    if len(sys.argv) == 3 and sys.argv[1] == "--zet":
        sys.exit(zonder_venster(Path(sys.argv[2])))
    sys.exit(venster())
