#!/usr/bin/python3
"""Haal alles van je oude pc (BugOS-kant van BugOS Switch).

Jip-en-Janneke: met het Windows-programma "BugOS Switch" heb je je spullen op een USB-schijf gezet (map
"BugOS-Switch"). Steek die schijf in en open dit programma. Je ziet wat er mee kan, alles staat aan; zet uit wat
je niet wilt en druk op "Overzetten". Dan:
  - komen je documenten, foto's, muziek, video's, bureaublad en downloads op de goede plek;
  - staan je bladwijzers van Chrome, Edge, Brave en Firefox vanzelf in Firefox (en een kopie in Documenten);
  - opent Firefox met je Firefox-profiel van Windows (als dat op de stick staat), zonder wachtwoorden;
  - wordt je oude Windows-achtergrond ook je BugOS-achtergrond;
  - krijg je je taal, notatie, tijdzone, toetsenbord, licht/donker, muis en (als het past) de grootte van Windows;
  - kent BugOS je wifi-netwerken op naam (het wachtwoord vraagt hij één keer, nooit van de stick);
  - staan je netwerkprinters erin;
  - zie je welke van je Windows-programma's er in de Winkel zijn (BugOS installeert ze nooit zelf).
  - komen de extra mappen die je koos (bijv. van D:) in je Thuismap, je eigen lettertypen erbij, en je
    Thunderbird (zonder wachtwoorden) en Outlook-mailbestanden klaar;
Daarna een samenvatting: wat gelukt is, wat niet kan (en waarom) en wat je zelf moet doen (en hoe).
Alles wat BugOS neerzet of verandert, staat in een logboek: met 'Alles terugdraaien' gaat het weer weg (bestanden
naar de prullenbak, instellingen zoals ze waren), zie bugos_overstap_logboek.

Versie 1 van de stick (alleen bestanden, bladwijzers en achtergrond) werkt gewoon. Het formaat staat in
windows-switch/FORMAT.md; het werk zelf in bugos_overstap_toepassen en bugos_overstap_firefox.

  bugos-switch                -> het venster
  bugos-switch --zet <map>    -> zonder venster (bestanden, bladwijzers en achtergrond, zoals versie 1)
"""

import subprocess
import sys
from pathlib import Path

sys.path.insert(0, "/usr/lib/bugos/python")

from bugos_ui import t  # noqa: E402
import bugos_overstap_bestanden as ob  # noqa: E402
import bugos_overstap_firefox as ff  # noqa: E402
import bugos_overstap_logboek as lb  # noqa: E402
import bugos_overstap_toepassen as ot  # noqa: E402
# Ook hier te vinden (de tests en oudere code halen ze uit bugos-switch zelf).
from bugos_overstap_toepassen import (  # noqa: E402,F401
    KOPPELING, MAP_NAAM, MAPPEN, _op_schijf, info, mapnaam, zoek_overstap,
)


def gebruikersmap(xdg: str, standaard: str) -> Path:
    # Alleen de vaste soorten: de naam gaat naar xdg-user-dir (een sh-script), en kan uit een bestand op een
    # stick van iemand anders komen (U097).
    if xdg not in {"DOCUMENTS", "PICTURES", "MUSIC", "VIDEOS", "DESKTOP", "DOWNLOAD"}:
        return Path.home() / standaard
    try:
        uit = subprocess.run(["xdg-user-dir", xdg], capture_output=True, text=True, timeout=5).stdout.strip()
        if uit and Path(uit) != Path.home():
            return Path(uit)
    except (OSError, subprocess.SubprocessError):
        pass
    return Path.home() / standaard


# --------------------------------------------------------- bladwijzers ----

def chrome_naar_html(bestanden: dict[str, Path]) -> str:
    """Zet Chrome/Edge/Brave-bladwijzers om naar het standaard HTML-formaat dat elke browser (Firefox, Chrome, ...)
    kan importeren: een map per browser. (De kopie in Documenten; Firefox krijgt ze ook vanzelf.)"""
    import json
    mappen = []
    for browser, pad in bestanden.items():
        try:
            knopen = ff.chrome_bladwijzers(json.loads(pad.read_text(encoding="utf-8-sig")))
        except (OSError, ValueError):
            continue
        mappen.append({"titel": browser, "kinderen": knopen})
    return ff.bladwijzer_html(mappen, [], [])


# ---------------------------------------------------------- terugzetten ----

def rsync_log(naam: str) -> Path:
    """Het logbestand van één rsync (welke bestanden nieuw waren), in ~/.cache/bugos/overstap."""
    import os
    cache = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "bugos" / "overstap"
    cache.mkdir(parents=True, exist_ok=True)
    pad = cache / f"rsync-{naam}.log"
    pad.unlink(missing_ok=True)   # rsync schrijft erbij: een oude ronde mag niet meetellen
    return pad


def _rsync(bron_map: Path, doel: Path, lognaam: str) -> list[str]:
    # --ignore-existing: wat al op BugOS staat, wordt nooit overschreven. --log-file: welke bestanden nieuw zijn
    # (voor 'Alles terugdraaien': alleen wat BugOS neerzette, gaat weer weg).
    return (["rsync", "-rt", "--ignore-existing", "--modify-window=2", "--info=progress2", "--no-inc-recursive"]
            + lb.rsync_opties(rsync_log(lognaam)) + [f"{bron_map}/", f"{doel}/"])


def stappen(bron: Path, met_bestanden: bool = True, met_extra: bool = False) -> list[tuple[str, list[str]]]:
    """De kopieer-opdrachten, met een uitleg per stap. met_extra: ook de extra mappen (onderdeel 'extra')."""
    lijst = []
    if met_bestanden:
        for win, xdg in KOPPELING.items():
            if (bron / win).is_dir():
                lijst.append((t(f"{mapnaam(win)} terugzetten...", f"Restoring {mapnaam(win)}..."),
                              _rsync(bron / win, gebruikersmap(xdg, win), win)))
    if met_extra:
        for nr, (naam, pad) in enumerate(ob.extra_mappen(bron, info(bron))):
            lijst.append((t(f"{naam} terugzetten...", f"Restoring {naam}..."),
                          _rsync(pad, ob.extra_doel(naam), f"extra-{nr}")))
    return lijst


def na_rsync(cmd: list[str]) -> None:
    """Na één rsync: de nieuwe bestanden en mappen in het logboek (uit zijn --log-file)."""
    log = next((c.split("=", 1)[1] for c in cmd if c.startswith("--log-file=")), None)
    if log is None or lb.ACTIEF is None:
        return
    bestanden, mappen = lb.lees_rsync_log(Path(log), Path(cmd[-1].rstrip("/")))
    lb.ACTIEF.bestanden_erbij(bestanden, mappen)


def vrije_naam(pad: Path) -> Path:
    """Bestaat 'pad' al? Dan 'naam (2).ext', 'naam (3).ext'... We overschrijven nooit iets."""
    if not pad.exists():
        return pad
    n = 2
    while (nieuw := pad.with_name(f"{pad.stem} ({n}){pad.suffix}")).exists():
        n += 1
    return nieuw


def bladwijzers_zetten(bron: Path, i: dict, zonder_firefox: bool = False) -> list[ot.Uitslag]:
    """De bladwijzers van elk browserprofiel: een kopie in Documenten (zoals altijd, voor de zekerheid), en vanzelf in
    Firefox. zonder_firefox: het Firefox-profiel van Windows is net overgenomen, daar staan die van Firefox al in."""
    bronnen = ff.bladwijzer_bronnen(bron, i)
    if not bronnen:
        return []
    mappen = [{"titel": b.naam, "kinderen": k} for b in bronnen if (k := ff.lees_bron(b))]
    kopie = ""
    if mappen:
        doel = vrije_naam(gebruikersmap("DOCUMENTS", "Documents") / "Bladwijzers-van-Windows.html")
        doel.parent.mkdir(parents=True, exist_ok=True)
        doel.write_text(ff.bladwijzer_html(mappen, [], []), encoding="utf-8")
        lb.bestand_erbij(doel)
        kopie = doel.name
    if zonder_firefox:
        bronnen = [b for b in bronnen if b.soort != "firefox"]
    if not bronnen:
        return [ot.Uitslag("bladwijzers", ot.GOED, t("Die van Firefox zitten in je Firefox-profiel van Windows.",
                                                     "The Firefox ones are in your Firefox profile from Windows."))]
    u = ff.bladwijzers_naar_firefox(bronnen, ot._tekst(i.get("computer"), 40))
    if kopie and u.soort == ot.GOED:
        u.tekst += t(f" Een kopie staat in Documenten ({kopie}).", f" A copy is in Documents ({kopie}).")
    elif kopie:
        u.tekst += t(f" (Het bestand: {kopie} in Documenten.)", f" (The file: {kopie} in Documents.)")
    return [u]


def achtergrond_zetten(bron: Path) -> list[ot.Uitslag]:
    """De Windows-achtergrond in Afbeeldingen, en als achtergrond van BugOS."""
    achtergrond = bron / "achtergrond.jpg"
    if not achtergrond.is_file():
        return []
    doel = vrije_naam(gebruikersmap("PICTURES", "Pictures") / "Windows-achtergrond.jpg")
    doel.parent.mkdir(parents=True, exist_ok=True)
    doel.write_bytes(achtergrond.read_bytes())
    lb.bestand_erbij(doel)
    # Hoe de achtergrond nu is, voor 'Alles terugdraaien'.
    lb.onthoud("achtergrond", oud=lb.lees_achtergrond())
    try:
        klaar = subprocess.run(["plasma-apply-wallpaperimage", str(doel)], capture_output=True, timeout=10)
        if klaar.returncode == 0:
            return [ot.Uitslag("achtergrond", ot.GOED, t("Je Windows-achtergrond is nu ook je BugOS-achtergrond.",
                                                         "Your Windows wallpaper is now your BugOS wallpaper too."))]
    except (OSError, subprocess.SubprocessError):
        pass
    return [ot.Uitslag("achtergrond", ot.ZELF, t(f"Hij staat in Afbeeldingen ({doel.name}). Kies hem in Instellingen > "
                                                 "Uiterlijk.", f"It is in Pictures ({doel.name}). Choose it in Settings > "
                                                 "Appearance."))]


# Wat er na de bestanden gebeurt, in deze volgorde (het Firefox-profiel vóór de bladwijzers: die gaan erin).
# 'taal' en 'notatie' zijn eigen schuifjes (D-10), maar gaan samen met 'instellingen' in één keer zet_instellingen.
NA_DE_BESTANDEN = ("achtergrond", "firefox", "bladwijzers", "instellingen", "taal", "notatie", "wifi", "printers",
                   "lettertypen", "mail")
INSTELLING_DELEN = {"instellingen", "taal", "notatie"}


def bezig_tekst(keuze: set[str]) -> str:
    """De melding terwijl de rest (na de bestanden) wordt overgezet: noemt alleen wat aan staat (D-10: er stond
    'Je instellingen, wifi en printers' ook als wifi en printers uit stonden). Vraagt alleen om je wachtwoord als
    er iets aan staat dat erom vraagt: de tijdzone (bij 'Instellingen') of een printer."""
    namen = []
    if keuze & INSTELLING_DELEN:
        namen.append(t("je instellingen", "your settings"))
    for deel, nl, en in (("achtergrond", "je achtergrond", "your wallpaper"),
                         ("firefox", "je Firefox", "your Firefox"),
                         ("bladwijzers", "je bladwijzers", "your bookmarks"),
                         ("wifi", "je wifi-netwerken", "your Wi-Fi networks"),
                         ("printers", "je printers", "your printers"),
                         ("lettertypen", "je lettertypen", "your fonts"),
                         ("mail", "je e-mail", "your e-mail")):
        if deel in keuze:
            namen.append(t(nl, en))
    if not namen:
        return ""
    if len(namen) == 1:
        lijst = namen[0]
    else:
        lijst = t("{a} en {b}", "{a} and {b}").format(a=", ".join(namen[:-1]), b=namen[-1])
    tekst = t("Bezig met {wat}…", "Transferring {wat}…").format(wat=lijst)
    waarvoor = [w for d, w in (("instellingen", t("de tijdzone", "the time zone")),
                               ("printers", t("de printers", "the printers"))) if d in keuze]
    if waarvoor:
        tekst += " " + t("Vraagt BugOS je wachtwoord, typ het dan in (voor {w}).",
                         "If BugOS asks for your password, type it (for {w}).").format(
                             w=t(" en ", " and ").join(waarvoor))
    return tekst


def rest_toepassen(bron: Path, i: dict, keuze: set[str]) -> list[ot.Uitslag]:
    """Alles behalve het kopiëren van de mappen, voor de onderdelen die aan staan. Draait op de achtergrond (een
    wachtwoordvraag voor de tijdzone of een printer mag het venster niet laten vastlopen). Elk onderdeel los: wat
    misgaat, staat in de uitslag, en de rest gaat door."""
    uit: list[ot.Uitslag] = []
    profiel_over = False
    instellingen_gedaan = False
    for deel in NA_DE_BESTANDEN:
        if deel not in keuze:
            continue
        try:
            if deel == "achtergrond":
                uit += achtergrond_zetten(bron)
            elif deel == "firefox":
                pad = ff.profiel_op_stick(bron, i)
                if pad is not None:
                    u = ff.profiel_overnemen(pad, ot._tekst(i.get("computer"), 40))
                    profiel_over = u.soort == ot.GOED
                    uit.append(u)
            elif deel == "bladwijzers":
                uit += bladwijzers_zetten(bron, i, zonder_firefox=profiel_over)
            elif deel in INSTELLING_DELEN:
                # Eén keer voor de drie schuifjes samen: de taal staat alleen aan als je 'Taal' aanzette, de notatie
                # alleen met 'Datum en tijd' (D-10), de rest (tijdzone, toetsenbord ...) met 'Instellingen'.
                if not instellingen_gedaan:
                    instellingen_gedaan = True
                    uit += ot.zet_instellingen(ot._dict(i.get("instellingen")), met_taal="taal" in keuze,
                                               met_notatie="notatie" in keuze, met_rest="instellingen" in keuze)
            elif deel == "wifi":
                uit += ot.zet_wifi(i.get("wifi"))
            elif deel == "printers":
                uit += ot.zet_printers(i.get("printers"))
            elif deel == "lettertypen":
                uit += ob.zet_lettertypen(bron, i)
            elif deel == "mail":
                uit += ob.zet_thunderbird(bron, i)
                uit += ob.zet_outlook(bron, i, gebruikersmap("DOCUMENTS", "Documents"))
        except OSError:   # schijf vol, of de stick eruit getrokken
            uit.append(ot.Uitslag(deel, ot.ZELF, t("Lukte niet: is je computer vol, of is de stick eruit? Probeer het "
                                                   "opnieuw.", "Did not work: is your computer full, or was the drive "
                                                   "unplugged? Try again.")))
        except Exception as e:  # noqa: BLE001  nooit alles laten stoppen om één onderdeel
            uit.append(ot.Uitslag(deel, ot.ZELF, t("Er ging iets mis ({e}). Probeer het opnieuw.",
                                                   "Something went wrong ({e}). Try again.").format(e=type(e).__name__)))
    return uit


def afronden(bron: Path) -> list[str]:
    """Bladwijzers en achtergrond (zoals versie 1). Geeft een lijstje met wat er gedaan is."""
    return [u.tekst for u in rest_toepassen(bron, info(bron), {"bladwijzers", "achtergrond"})]


# rsync: 0 = goed, 24 = een bestand verdween (geen probleem), 23 = een paar bestanden konden niet mee
# (bijv. een naam met : of ?, of iets dat Windows op slot had). Bij 23 gaan we door met de volgende map.
GOED, DEELS = (0, 24), (23,)


def uitslag(code: int, cmd: list[str], uitvoer: str = "") -> str:
    """'goed', 'deels', 'vol' of 'weg' (de schijf of map waar het vandaan komt is er niet meer) of 'fout'.
    rsync geeft ook 23 als de bronmap verdwenen is (stick eruit): dat is niet 'een paar bestanden' (U078)."""
    if code not in GOED and "No space left on device" in uitvoer:
        return "vol"
    if code in GOED:
        return "goed"
    try:
        weg = not Path(cmd[-2]).exists()
    except OSError:   # een stick die eruit is, kan ook een leesfout geven
        weg = True
    if weg:
        return "weg"
    return "deels" if code in DEELS else "fout"


def deels_uitleg(mappen: list[str]) -> str:
    mappen = [mapnaam(m) for m in mappen]
    return t(f"Een paar bestanden uit {', '.join(mappen)} konden niet mee. De rest staat er wel.",
             f"A few files from {', '.join(mappen)} could not be copied. Everything else is there.")


def zonder_venster(bron: Path) -> int:
    deels = []
    # Ook zonder venster een logboek: dan kan 'Alles terugdraaien' in het venster het later weer weghalen.
    i = info(bron)
    lb.ACTIEF = lb.Logboek()
    lb.ACTIEF.begin(ot._tekst(i.get("computer"), 60), ot._tekst(i.get("gebruiker"), 60))
    for _, cmd in stappen(bron):
        r = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True, errors="replace")
        na_rsync(cmd)
        sys.stderr.write(r.stderr)
        soort = uitslag(r.returncode, cmd, r.stderr)
        if soort == "deels":
            deels.append(Path(cmd[-2].rstrip("/")).name)
        elif soort != "goed":
            if soort == "vol":
                print(t("Je computer is vol.", "Your computer is full."), file=sys.stderr)
            return 1
    for regel in afronden(bron):
        print(regel)
    if deels:
        print(deels_uitleg(deels), file=sys.stderr)
        return 2
    return 0


# ------------------------------------------------------------------ venster ----

def venster() -> int:
    from bugos_ui import (
        Banner, Groep, IcoonChip, Knop, SchijfKiezer, Schuif, Voortgang, kop_met_icoon, label, leeg_groep, maak_app,
        pagina, schuifbaar, sectie, start, uitvoeren,
    )
    from PySide6.QtCore import QProcess, QThread, QTimer, Signal
    from PySide6.QtWidgets import QHBoxLayout, QMessageBox, QVBoxLayout, QWidget

    def rij(icoon: str, kop_t: str, sub_t: str, rechts: QWidget | None = None, tint: str = "neutraal",
            vol: bool = False) -> QWidget:
        """Een regel in een kaart: tegeltje, kop, uitleg en rechts eventueel een schuifje of knop."""
        w = QWidget()
        r = QHBoxLayout(w)
        r.setContentsMargins(18, 12, 18, 12)
        r.setSpacing(14)
        r.addWidget(IcoonChip(icoon, tint, 36, vol=vol))
        b = QVBoxLayout()
        b.setSpacing(1)
        b.addWidget(label(kop_t, "kop3"))
        b.addWidget(label(sub_t, "klein"))
        r.addLayout(b, 1)
        if rechts is not None:
            r.addWidget(rechts)
        return w

    class Werk(QThread):
        """Alles na het kopiëren (instellingen, wifi, printers, Firefox), zonder dat het venster vastloopt."""
        klaar = Signal(list)

        def __init__(self, ouder, bron: Path, i: dict, keuze: set[str]):
            super().__init__(ouder)
            self.bron, self.i, self.keuze = bron, i, keuze

        def run(self) -> None:  # noqa: D102
            try:
                uit = rest_toepassen(self.bron, self.i, self.keuze)
            except Exception:  # noqa: BLE001  het venster moet altijd 'klaar' horen
                uit = [ot.Uitslag("bestanden", ot.ZELF, t("Er ging iets mis. Probeer het opnieuw.",
                                                          "Something went wrong. Try again."))]
            self.klaar.emit(uit)

    class TerugWerk(QThread):
        """Alles terugdraaien, op de achtergrond (de tijdzone en printers kunnen om je wachtwoord vragen)."""
        klaar = Signal(list)

        def run(self) -> None:  # noqa: D102
            try:
                uit = lb.terugdraaien()
            except Exception:  # noqa: BLE001  het venster moet altijd 'klaar' horen
                uit = [ot.Uitslag("terug", ot.ZELF, t("Er ging iets mis. Probeer het opnieuw.",
                                                      "Something went wrong. Try again."))]
            self.klaar.emit(uit)

    class Overstap(QWidget):
        def __init__(self):
            super().__init__()
            self.setObjectName("venster")
            self.setWindowTitle(t("Haal alles van je oude pc", "Bring everything from your old PC"))
            self.resize(780, 700)
            w, lay = pagina()
            self.inhoud = lay
            buiten = QVBoxLayout(self)
            buiten.setContentsMargins(0, 0, 0, 0)
            buiten.addWidget(schuifbaar(w))
            self.vlak = buiten.itemAt(0).widget()   # het schuifvlak: om na afloop naar de samenvatting te schuiven
            lay.addWidget(kop_met_icoon("lijn:download", "neutraal",
                                        t("Haal alles van je oude pc", "Bring everything from your old PC"),
                                        t("Heb je met \"BugOS Switch\" je spullen van Windows op een USB-schijf gezet? "
                                          "Steek die schijf in: je ziet wat er mee kan.",
                                          "Did you put your things from Windows on a USB drive with \"BugOS Switch\"? "
                                          "Plug in that drive: you'll see what can come along.")))
            # Zonder schijf: wat er mee kan, in het algemeen. Met een schijf staat daar het echte overzicht.
            self.wat = Groep()
            for icoon, kop_t, sub_t in (
                ("lijn:download", t("Documenten, foto's, muziek en video's", "Documents, photos, music and videos"),
                 t("Komen op de goede plek. Wat al op BugOS staat, wordt nooit overschreven.",
                   "Go to the right place. What's already on BugOS is never overwritten.")),
                ("lijn:ster", t("Bladwijzers en Firefox", "Bookmarks and Firefox"),
                 t("Van Chrome, Edge, Brave en Firefox, vanzelf in Firefox.",
                   "From Chrome, Edge, Brave and Firefox, straight into Firefox.")),   # (U476)
                ("lijn:schakelaar", t("Instellingen, wifi en printers", "Settings, Wi-Fi and printers"),
                 t("Je taal, tijdzone, toetsenbord en muis. Wifi zonder wachtwoorden: die vraagt BugOS één keer.",
                   "Your language, time zone, keyboard and mouse. Wi-Fi without passwords: BugOS asks for them once.")),
                ("lijn:apps", t("Je programma's", "Your programs"),
                 t("Je ziet welke er in de Winkel zijn. Installeren doe je zelf, als je wilt.",
                   "You see which ones are in the Store. You install them yourself, if you want.")),
            ):
                self.wat.voeg(rij(icoon, kop_t, sub_t))
            lay.addWidget(self.wat)
            lay.addWidget(sectie(t("Kies de schijf", "Choose the drive")))
            self.kiezer = SchijfKiezer(t("Steek de USB-schijf met je Windows-spullen in…",
                                         "Plug in the USB drive with your Windows things…"))
            lay.addWidget(self.kiezer)
            # Het overzicht: per onderdeel een schuifje, alles staat aan.
            self.overzicht_kop = sectie(t("Wat gaat er mee? Zet uit wat je niet wilt.",
                                          "What comes along? Switch off what you don't want."), wrap=True)
            self.overzicht = Groep()
            lay.addWidget(self.overzicht_kop)
            lay.addWidget(self.overzicht)
            self.melding = Banner()
            lay.addWidget(self.melding)
            self.balk = Voortgang()
            self.balk.hide()
            lay.addWidget(self.balk)
            # Na afloop: per onderdeel gelukt / kan niet / zelf doen.
            self.klaar_kop = sectie(t("Zo ging het", "How it went"))
            self.samenvatting = Groep()
            lay.addWidget(self.klaar_kop)
            lay.addWidget(self.samenvatting)
            # Terugdraaien (F): zolang er een logboek is, kun je alles wat BugOS van je oude pc neerzette weer
            # weghalen. Ook als je het venster later weer opent (dan zonder stick).
            self.terug_kop = sectie(t("Toch niet? Alles terugdraaien", "Changed your mind? Undo everything"), wrap=True)
            self.terug = Groep()
            self.terug_knop = Knop(t("Alles terugdraaien", "Undo everything"), "stil", "lijn:terug")
            self.terug_knop.clicked.connect(self.vraag_terugdraaien)
            self.terug_tekst = label("", "klein")
            self.terug_tekst.setWordWrap(True)
            terug_rij = QWidget()
            tr = QHBoxLayout(terug_rij)
            tr.setContentsMargins(18, 12, 18, 12)
            tr.setSpacing(14)
            tb = QVBoxLayout()
            tb.setSpacing(1)
            tb.addWidget(label(t("Bestanden naar de prullenbak, instellingen weer zoals ze waren",
                                 "Files to the trash, settings back to how they were"), "kop3"))
            tb.addWidget(self.terug_tekst)
            tr.addLayout(tb, 1)
            tr.addWidget(self.terug_knop)
            self.terug.voeg(terug_rij)
            lay.addWidget(self.terug_kop)
            lay.addWidget(self.terug)
            self.terug_werk: QThread | None = None
            # De programma's: alleen voorstellen (de eigenaar: BugOS installeert nooit zelf).
            self.prog_kop = sectie(t("Je programma's van Windows: dit is er op BugOS",
                                     "Your programs from Windows: this is on BugOS"), wrap=True)
            self.prog_uitleg = label(t("BugOS installeert niets zelf. Klik op 'In de Winkel' om te kijken en te "
                                       "installeren wat je wilt.", "BugOS does not install anything by itself. Click "
                                       "'In the Store' to look and install what you want."), "klein")
            self.programmas = Groep()
            for x in (self.prog_kop, self.prog_uitleg, self.programmas):
                lay.addWidget(x)
            lay.addStretch(1)
            rij_ = QHBoxLayout()
            rij_.addStretch(1)
            self.knop = Knop(t("Overzetten", "Transfer"), "hoofd", "lijn:download", groot=True)
            rij_.addWidget(self.knop)
            # Onder het schuifvlak, niet erin: de knop blijft altijd in beeld, ook bij 150 % (R03).
            rij_.setContentsMargins(40, 12, 40, 20)
            buiten.addLayout(rij_)

            self.proces = QProcess(self)
            self.proces.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
            self.proces.readyReadStandardOutput.connect(self.lees)
            self.proces.finished.connect(self.klaar)
            self.wachtrij: list[tuple[str, list[str]]] = []
            self.nu: list[str] = []
            self.deels: list[str] = []
            self.bron: Path | None = None
            self.werk: QThread | None = None
            self.schakelaars: dict[str, Schuif] = {}
            self._overzicht_van = None   # (map, tijd van bugos-switch.json): niet elke 3 seconden opnieuw bouwen
            self.keuze: set[str] = set()
            self.sluit_na = False  # het venster ging dicht tijdens het terugzetten: sluiten zodra het klaar is
            self.gestopt = False   # de gebruiker koos 'Nu stoppen'
            self.knop.clicked.connect(self.begin)
            self.kiezer.gewijzigd.connect(self.gekozen_veranderd)
            for x in (self.overzicht_kop, self.overzicht, self.klaar_kop, self.samenvatting, self.prog_kop,
                      self.prog_uitleg, self.programmas):
                x.hide()
            self.toon_terug()
            self.timer = QTimer(self)
            self.timer.timeout.connect(self.ververs)
            self.timer.start(3000)
            self.ververs()
            self.kiezer.setFocus()

        # ---------------------------------------------------------------- de schijf ---

        def bezig(self) -> bool:
            return self.proces.state() != QProcess.ProcessState.NotRunning or (
                self.werk is not None and self.werk.isRunning()) or (
                getattr(self, "terug_werk", None) is not None and self.terug_werk.isRunning())

        # ------------------------------------------------------------ terugdraaien ---

        def toon_terug(self) -> None:
            """Het blok 'Alles terugdraaien': alleen als er een logboek is, met wat erin staat."""
            boek = lb.Logboek()
            heeft = not boek.leeg()
            if heeft:
                self.terug_tekst.setText(boek.samenvatting() + " " + t(
                    "Wat je daarna zelf veranderde, blijft staan.", "What you changed yourself afterwards stays."))
            self.terug_kop.setVisible(heeft)
            self.terug.setVisible(heeft)
            self.terug_knop.setEnabled(heeft and not self.bezig())

        def vraag_terugdraaien(self) -> None:
            if self.bezig():
                return
            box = QMessageBox(self)
            box.setIcon(QMessageBox.Icon.Question)
            box.setWindowTitle(t("Alles terugdraaien?", "Undo everything?"))
            box.setText(t("Alles van je oude pc weer weghalen?", "Remove everything from your old PC again?"))
            box.setInformativeText(t(
                "De bestanden die BugOS van je oude pc neerzette, gaan naar de prullenbak (daar kun je ze nog "
                "terughalen). Je instellingen worden weer zoals ze waren, en de wifi-netwerken en printers van je oude "
                "pc gaan eruit. Bestanden die je zelf hebt veranderd, blijven staan.",
                "The files BugOS put here from your old PC go to the trash (you can still get them back from there). "
                "Your settings go back to how they were, and the Wi-Fi networks and printers from your old PC are "
                "removed. Files you changed yourself stay."))
            ja = box.addButton(t("Terugdraaien", "Undo"), QMessageBox.ButtonRole.DestructiveRole)
            nee = box.addButton(t("Niet doen", "Don't"), QMessageBox.ButtonRole.RejectRole)
            box.setDefaultButton(nee)
            box.exec()
            if box.clickedButton() is not ja:
                return
            self.start_terugdraaien()

        def start_terugdraaien(self) -> None:
            """Na 'Terugdraaien' in de vraag (los, zodat een test het zonder vraagvenster kan doen)."""
            for w in (self.knop, self.kiezer, self.overzicht, self.terug_knop):
                w.setEnabled(False)
            self.melding.zet(t("Bezig met terugdraaien... Vraagt BugOS je wachtwoord, typ het dan in (voor de tijdzone "
                               "of de printers).", "Undoing... If BugOS asks for your password, type it (for the time "
                               "zone or the printers)."), "bezig")
            self.terug_werk = TerugWerk(self)
            self.terug_werk.klaar.connect(self.teruggedraaid)
            self.terug_werk.start()

        def teruggedraaid(self, uitslagen: list) -> None:
            if self.terug_werk is not None:
                self.terug_werk.wait(2000)
                self.terug_werk = None
            mis = any(u.soort != ot.GOED for u in uitslagen)
            self.melding.zet(t("Teruggedraaid. Kijk hieronder wat je nog zelf moet doen.",
                               "Undone. See below what you still need to do yourself.") if mis else
                             t("Teruggedraaid: alles staat weer zoals voor het overzetten.",
                               "Undone: everything is back to how it was before the transfer."),
                             "let_op" if mis else "goed")
            self.toon_samenvatting(uitslagen)
            self.vrij()

        def ververs(self) -> None:
            # Niet verversen terwijl we bezig zijn (de kiezer staat dan uit). Daarna wel weer: de balk
            # blijft na de eerste keer zichtbaar, dus daar mogen we niet op letten.
            if self.bezig() or not self.kiezer.isEnabled():
                return
            items = []
            for m in zoek_overstap():
                i = info(m)
                items.append((str(m), m.parent.name,
                              t(f"Van {ot._tekst(i.get('gebruiker'), 60) or '?'} op {ot._tekst(i.get('computer'), 60) or '?'}",
                                f"From {ot._tekst(i.get('gebruiker'), 60) or '?'} on {ot._tekst(i.get('computer'), 60) or '?'}")))
            self.kiezer.zet(items)
            self.gekozen_veranderd()

        def gekozen_veranderd(self) -> None:
            gekozen = self.kiezer.gekozen()
            self.knop.setEnabled(gekozen is not None)
            if self.bezig():
                return
            sleutel = None
            if gekozen:
                try:
                    sleutel = (gekozen, max((Path(gekozen) / b).stat().st_mtime for _n, b in MAPPEN
                                            if (Path(gekozen) / b).exists()))
                except (OSError, ValueError):
                    sleutel = (gekozen, 0)
            if sleutel != self._overzicht_van:
                self._overzicht_van = sleutel
                self.toon_overzicht(Path(gekozen) if gekozen else None)

        def toon_overzicht(self, bron: Path | None) -> None:
            """Het overzicht van deze schijf: een schuifje per onderdeel (alles aan), en de programma's."""
            leeg_groep(self.overzicht)
            leeg_groep(self.programmas)
            self.schakelaars = {}
            for x in (self.klaar_kop, self.samenvatting):
                x.hide()
            delen = ot.onderdelen(bron) if bron is not None else []
            for o in delen:
                # Bijna alles staat aan; taal en notatie die anders zijn dan nu niet (D-10).
                schuif = Schuif(o.aan)
                schuif.setAccessibleName(ot.deel_naam(o.sleutel))
                self.schakelaars[o.sleutel] = schuif
                self.overzicht.voeg(rij(o.icoon, ot.deel_naam(o.sleutel), o.uitleg, schuif))
            heeft = bool(delen)
            self.overzicht_kop.setVisible(heeft)
            self.overzicht.setVisible(heeft)
            self.wat.setVisible(bron is None)
            self.toon_programmas(info(bron).get("programmas") if bron is not None else None)

        def toon_programmas(self, programmas) -> None:
            # Welke Winkel-apps er al zijn (Flatpak): die krijgen 'Openen' in plaats van 'In de Winkel'.
            try:
                import bugos_apps
                al = set(bugos_apps.flatpak_lijst())
            except Exception:  # noqa: BLE001  geen flatpak: dan gewoon alles als 'In de Winkel'
                al = set()
            lijst, rest = ot.suggesties(programmas, geinstalleerd=al)
            for s in lijst:
                knop = None
                if s.id and s.soort == "al":
                    # Staat er al: meteen openen (flatpak run), niet nog eens naar de Winkel.
                    knop = Knop(t("Openen", "Open"), "stil")
                    knop.setAccessibleName(t("{n} openen", "Open {n}").format(n=s.naam))
                    knop.clicked.connect(lambda _=False, i=s.id: start("flatpak", "run", i))
                elif s.id:
                    knop = Knop(t("In de Winkel", "In the Store") if s.soort == "winkel" else
                                t("Bekijk {n}", "See {n}").format(n=s.naam), "stil")
                    knop.setAccessibleName(t("{n} in de Winkel", "{n} in the Store").format(n=s.naam))
                    knop.clicked.connect(lambda _=False, i=s.id: start(*ot.winkel_opdracht(i)))
                voor = ot._kort(s.windows, 2)
                if s.soort == "niet":
                    kop_t = voor
                    sub_t = t("Niet op BugOS. ", "Not on BugOS. ") + s.tekst
                    icoon = "uitroep"
                elif s.soort in ("ingebouwd", "al"):
                    kop_t = s.naam
                    sub_t = t("Voor {w}. ", "For {w}. ").format(w=voor) + (
                        t("Staat al op deze computer. ", "Already on this computer. ") if s.soort == "al" else "") + s.tekst
                    icoon = "vink"
                else:
                    kop_t = s.naam
                    sub_t = (t("Voor {w}. ", "For {w}. ").format(w=voor) if voor != s.naam else "") + s.tekst
                    icoon = "lijn:apps"
                # 'vink' en 'uitroep' zijn gevulde tegeltjes (zoals in de samenvatting); met vol=False bleef het
                # tegeltje van 'Zit al in BugOS' leeg (VM-test 2026-11-16).
                tint = {"uitroep": "grijs", "vink": "groen"}.get(icoon, "neutraal")
                self.programmas.voeg(rij(icoon, kop_t, sub_t, knop, tint, vol=icoon in ("uitroep", "vink")))
            if rest:
                knop = Knop(t("Winkel openen", "Open the Store"), "stil")
                knop.clicked.connect(lambda: start("bugos-store"))
                self.programmas.voeg(rij("lijn:zoek", t("Nog {n} andere programma's", "{n} other programs").format(
                    n=len(rest)), ot._kort(rest, 4) + ". " + t("Zoek ze in de Winkel. Staat er een niet in, dan doet een "
                                                              "ander programma vaak hetzelfde.", "Look for them in the "
                                                              "Store. If one is not there, another program often does "
                                                              "the same."), knop))
            heeft = bool(lijst or rest)
            for x in (self.prog_kop, self.prog_uitleg, self.programmas):
                x.setVisible(heeft)

        def toon_samenvatting(self, uitslagen: list) -> None:
            """Per ding: gelukt, kan niet (waarom) of doe dit zelf (hoe)."""
            leeg_groep(self.samenvatting)
            for u in uitslagen:
                if u.soort == ot.GOED:
                    icoon, tint, voor = "vink", "groen", ""
                elif u.soort == ot.NIET:
                    icoon, tint, voor = "kruis", "grijs", t("Kan niet: ", "Not possible: ")
                else:
                    icoon, tint, voor = "uitroep", "oranje", t("Doe dit zelf: ", "Do this yourself: ")
                self.samenvatting.voeg(rij(icoon, ot.deel_naam(u.deel), voor + u.tekst, None, tint, vol=True))
            heeft = bool(uitslagen)
            self.klaar_kop.setVisible(heeft)
            self.samenvatting.setVisible(heeft)
            if heeft:
                QTimer.singleShot(50, lambda: self.vlak.ensureWidgetVisible(self.klaar_kop, 0, 40))

        # -------------------------------------------------------------- overzetten ---

        def volgende(self) -> None:
            if not self.wachtrij:
                self.balk.setValue(100)
                rest = self.keuze & set(NA_DE_BESTANDEN)
                if not rest:
                    self.afgerond([])
                    return
                # Alleen wat aan staat (D-10).
                self.melding.zet(bezig_tekst(rest), "bezig")
                self.werk = Werk(self, self.bron, info(self.bron), rest)
                self.werk.klaar.connect(self.afgerond)
                self.werk.start()
                return
            tekst, cmd = self.wachtrij.pop(0)
            self.nu = cmd
            self.uitvoer = ""
            self.melding.zet(tekst, "bezig")
            self.balk.setValue(0)
            self.proces.start(cmd[0], cmd[1:])

        def afgerond(self, uitslagen: list) -> None:
            """Alles is gedaan: de melding bovenaan en de samenvatting eronder."""
            if self.werk is not None:
                self.werk.wait(2000)
                self.werk = None
            alles = []
            if "bestanden" in self.keuze:
                alles.append(ot.Uitslag("bestanden", ot.ZELF if self.deels else ot.GOED,
                                        deels_uitleg(self.deels) if self.deels else
                                        t("Je bestanden staan op hun plek.", "Your files are in place.")))
                # Bestanden die alleen in OneDrive stonden (en niet mee wilden): zeg welke en waar ze zijn (E).
                alles += ob.cloud_uitslag(info(self.bron))
            extra = ob.extra_mappen(self.bron, info(self.bron)) if "extra" in self.keuze else []
            if extra:
                alles.append(ot.Uitslag("extra", ot.GOED, t("Ze staan in je Thuismap: {m}.",
                                                            "They are in your Home folder: {m}.").format(
                                            m=ot._kort([n for n, _p in extra]))))
            alles += uitslagen
            # De samenvatting ook in het logboek (om later terug te lezen); deze ronde is klaar.
            if lb.ACTIEF is not None:
                lb.ACTIEF.uitslagen(alles)
                lb.ACTIEF = None
            mis = any(u.soort != ot.GOED for u in alles)
            kop = (deels_uitleg(self.deels) if self.deels else
                   t("Klaar! Kijk hieronder wat er is gebeurd.", "Done! See below what happened.") if mis else
                   t("Klaar! Alles staat op BugOS.", "Done! Everything is on BugOS."))
            self.melding.zet(kop, "let_op" if self.deels else "goed")
            self.toon_samenvatting(alles)
            if self.deels or mis:
                self.sluit_na = False  # dat moet je kunnen lezen, ook na 'Eerst afmaken'
            self.vrij()

        def lees(self) -> None:
            tekst = bytes(self.proces.readAllStandardOutput()).decode(errors="ignore")
            self.uitvoer = (self.uitvoer + tekst)[-8000:]   # voor 'schijf vol' (U079)
            for stuk in tekst.replace("\r", "\n").split():
                if stuk.endswith("%") and stuk[:-1].isdigit():
                    self.balk.setValue(int(stuk[:-1]))

        def klaar(self, code: int, _s) -> None:
            # Eerst: wat deze rsync neerzette, in het logboek (ook na stoppen of een fout: dat staat er dan wel).
            na_rsync(self.nu)
            if self.gestopt:
                # Gestopt: zeg het, en de volgende keer begint gewoon opnieuw (ook als je het venster weer opende) (U241).
                self.gestopt = False
                self.wachtrij.clear()
                self.melding.zet(t("Gestopt. Wat al teruggezet was, blijft staan.",
                                   "Stopped. What was already restored stays."), "info")
                self.balk.hide()
                self.vrij()
                return
            soort = uitslag(code, self.nu, getattr(self, "uitvoer", ""))
            if soort == "deels":
                self.deels.append(Path(self.nu[-2].rstrip("/")).name)
            elif soort != "goed":
                self.melding.zet(t("Je computer is vol. Maak eerst ruimte (bijv. de prullenbak leegmaken in Bestanden) "
                                   "en probeer het dan opnieuw: wat er al staat, wordt niet opnieuw gekopieerd.",
                                   "Your computer is full. Make room first (for example empty the trash in Files) "
                                   "and try again: what is already there is not copied again.") if soort == "vol" else
                                 t("Het lukte niet helemaal. Zit de schijf er nog in? Probeer het opnieuw.",
                                   "It did not fully work. Is the drive still plugged in? Try again."), "fout")
                self.wachtrij.clear()
                self.sluit_na = False  # ook na 'Eerst afmaken': de foutmelding moet je kunnen zien
                self.vrij()
                return
            self.volgende()

        def vrij(self) -> None:
            """Klaar (of gestopt): de knoppen doen het weer, en ging het venster dicht, dan nu echt."""
            self.knop.setEnabled(True)
            self.kiezer.setEnabled(True)
            self.overzicht.setEnabled(True)
            self.toon_terug()
            if self.sluit_na:
                QTimer.singleShot(0, self.close)

        def vraag_stoppen(self) -> bool:
            """Het venster gaat dicht terwijl we bezig zijn: stoppen, of eerst afmaken?"""
            box = QMessageBox(self)
            box.setIcon(QMessageBox.Icon.Question)
            box.setWindowTitle(t("Nog bezig", "Still busy"))
            box.setText(t("Je bestanden worden nog teruggezet.", "Your files are still being restored."))
            box.setInformativeText(
                t("Maak je het eerst af, dan gaat het venster daarna vanzelf dicht. Stop je nu, dan staat nog niet "
                  "alles op je computer (wat er al staat, blijft gewoon staan).",
                  "If you let it finish, the window closes by itself afterwards. If you stop now, not everything "
                  "is on your computer yet (what is already there stays)."))
            door = box.addButton(t("Eerst afmaken", "Finish first"), QMessageBox.ButtonRole.AcceptRole)
            stop = box.addButton(t("Nu stoppen", "Stop now"), QMessageBox.ButtonRole.DestructiveRole)
            box.setDefaultButton(door)
            box.exec()
            return box.clickedButton() is stop

        def tweede_start(self, _args: list[str]) -> None:
            """Weer geopend terwijl het venster wachtte om dicht te gaan: dat gaat niet meer door (U233)."""
            if self.sluit_na and self.bezig() and not self.gestopt:
                self.melding.zet(t("Nog even bezig…", "Still busy…"), "bezig")

        def closeEvent(self, e) -> None:  # noqa: N802
            if not self.bezig():
                super().closeEvent(e)
                return
            # Nooit stilletjes midden in het overzetten stoppen: vraag het, en sluit pas als het klaar is.
            e.ignore()
            if self.sluit_na:
                return  # al gevraagd; we wachten
            self.sluit_na = True
            if self.proces.state() == QProcess.ProcessState.NotRunning:
                # De instellingen, wifi en printers: kort, en misschien wacht er een wachtwoordvraag. Niet afbreken.
                self.melding.zet(t("Even wachten: het venster gaat vanzelf dicht als het klaar is.",
                                   "One moment: the window closes by itself when it is done."), "bezig")
            elif self.vraag_stoppen():
                self.gestopt = True
                self.wachtrij.clear()
                self.melding.zet(t("Bezig met stoppen…", "Stopping…"), "bezig")
                self.proces.terminate()  # rsync ruimt zijn halve bestand zelf op
            else:
                self.melding.zet(t("Even wachten: het venster gaat vanzelf dicht als het klaar is.",
                                   "One moment: the window closes by itself when it is done."), "bezig")

        def begin(self) -> None:
            gekozen = self.kiezer.gekozen()
            if not gekozen or self.bezig():
                return
            self.bron = Path(gekozen)
            if not self.schakelaars:
                self.toon_overzicht(self.bron)
            self.keuze = {k for k, s in self.schakelaars.items() if s.isChecked()}
            self.gestopt = False
            self.deels = []
            self.wachtrij[:] = stappen(self.bron, "bestanden" in self.keuze, "extra" in self.keuze)
            if not self.wachtrij and not (self.keuze & set(NA_DE_BESTANDEN)):
                # Stick eruit, of alleen het lijstje zonder mappen: niet 'Klaar!' zeggen (U140).
                self.melding.zet(t("Er is niets om over te zetten. Zit de schijf er nog in, en staat er iets aan?",
                                   "There is nothing to transfer. Is the drive still plugged in, and is something "
                                   "switched on?"), "fout")
                return
            # Het logboek van deze ronde (komt bij een eerdere ronde, als die er nog is): voor 'Alles terugdraaien'.
            i = info(self.bron)
            lb.ACTIEF = lb.Logboek()
            lb.ACTIEF.begin(ot._tekst(i.get("computer"), 60), ot._tekst(i.get("gebruiker"), 60))
            self.knop.setEnabled(False)
            self.kiezer.setEnabled(False)
            self.overzicht.setEnabled(False)
            self.terug_knop.setEnabled(False)
            for x in (self.klaar_kop, self.samenvatting):
                x.hide()
            self.balk.show()
            self.volgende()

    app = maak_app("bugos-switch", "bugos-switch", sys.argv, een_keer=True)   # (U208)
    return uitvoeren(app, Overstap())


if __name__ == "__main__":
    if len(sys.argv) == 3 and sys.argv[1] == "--zet":
        sys.exit(zonder_venster(Path(sys.argv[2])))
    sys.exit(venster())
