#!/usr/bin/bash
# bugos-light-mode - maakt BugOS sneller op oude of trage computers.
#
#   bugos-light-mode auto  -> kijk zelf of het nodig is (bij inloggen, één keer)
#   bugos-light-mode aan   -> zware effecten uit
#   bugos-light-mode uit   -> alle effecten weer aan
#   bugos-light-mode status
#
# "Oud of traag" = minder dan 6 GB geheugen, of 2 of minder processorkernen.

# shellcheck source=system_files/usr/share/bugos/lib.sh
. /usr/share/bugos/lib.sh

MARKER="$BUGOS_CONFIG/lichte-stand"
GEKEKEN="$BUGOS_CONFIG/lichte-stand-gecontroleerd"

is_traag() {
    local geheugen_kb kernen
    geheugen_kb="$(awk '/MemTotal/ {print $2}' /proc/meminfo)"
    kernen="$(nproc)"
    [ "$geheugen_kb" -lt 6000000 ] || [ "$kernen" -le 2 ]
}

aan() {
    mkdir -p "$BUGOS_CONFIG"
    # Animaties uit, doorzichtige/wazige effecten uit.
    kwriteconfig6 --file kdeglobals --group KDE --key AnimationDurationFactor 0
    kwriteconfig6 --file kwinrc --group Plugins --key blurEnabled false
    kwriteconfig6 --file kwinrc --group Plugins --key contrastEnabled false
    kwriteconfig6 --file kwinrc --group Plugins --key slidingpopupsEnabled false
    # Bestanden-zoeker (die steeds alles doorzoekt) op een laag pitje.
    balooctl6 disable >/dev/null 2>&1 || balooctl disable >/dev/null 2>&1
    qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1
    touch "$MARKER"
}

uit() {
    kwriteconfig6 --file kdeglobals --group KDE --key AnimationDurationFactor --delete
    kwriteconfig6 --file kwinrc --group Plugins --key blurEnabled --delete
    kwriteconfig6 --file kwinrc --group Plugins --key contrastEnabled --delete
    kwriteconfig6 --file kwinrc --group Plugins --key slidingpopupsEnabled --delete
    balooctl6 enable >/dev/null 2>&1 || balooctl enable >/dev/null 2>&1
    qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1
    rm -f "$MARKER"
}

case "${1:-auto}" in
auto)
    # Maar één keer zelf beslissen; daarna respecteren we de keuze van de gebruiker.
    [ -f "$GEKEKEN" ] && exit 0
    mkdir -p "$BUGOS_CONFIG"
    touch "$GEKEKEN"
    if is_traag; then
        aan
        melding "$(t "Lichte stand staat aan" "Light mode is on")" \
            "$(t "BugOS zag een wat oudere computer en heeft zware effecten uitgezet, zodat alles vlot blijft." \
                "BugOS noticed an older computer and turned off heavy effects to keep things fast.")"
    fi
    ;;
aan) aan ;;
uit) uit ;;
status) if [ -f "$MARKER" ]; then echo aan; else echo uit; fi ;;
*)
    echo "Gebruik: bugos-light-mode auto|aan|uit|status" >&2
    exit 2
    ;;
esac
