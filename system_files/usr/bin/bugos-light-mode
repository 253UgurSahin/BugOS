#!/usr/bin/bash
# bugos-light-mode - maakt BugOS sneller op oude of trage computers.
#
#   bugos-light-mode auto  -> kijk zelf of het nodig is (bij inloggen, één keer)
#   bugos-light-mode aan   -> zware effecten uit
#   bugos-light-mode uit   -> alle effecten weer aan
#   bugos-light-mode status
#
# "Oud of traag" = 4 GB geheugen of minder, of 2 of minder processorkernen.

# shellcheck source=system_files/usr/share/bugos/lib.sh
. /usr/share/bugos/lib.sh

MARKER="$BUGOS_CONFIG/lichte-stand"
GEKEKEN="$BUGOS_CONFIG/lichte-stand-gecontroleerd"
VOOR="$BUGOS_CONFIG/lichte-stand-voor"  # hoe het was vóór de lichte stand (zodat 'uit' precies dat terugzet)

# bestand groep sleutel: de instellingen die de lichte stand verandert.
INSTELLINGEN=(
    "kdeglobals KDE AnimationDurationFactor"
    "kwinrc Plugins blurEnabled"
    "kwinrc Plugins contrastEnabled"
    "kwinrc Plugins slidingpopupsEnabled"
)

baloo() { balooctl6 "$@" 2>/dev/null || balooctl "$@" 2>/dev/null; }

# KWin de nieuwe instellingen laten lezen. Via gdbus: dat is er altijd (qdbus6 bestaat niet op Fedora 44).
kwin_herladen() {
    gdbus call --session --dest org.kde.KWin --object-path /KWin --method org.kde.KWin.reconfigure >/dev/null 2>&1
}

is_traag() {
    local geheugen_kb kernen
    geheugen_kb="$(awk '/MemTotal/ {print $2}' /proc/meminfo)"
    kernen="$(nproc)"
    # Onder de 5 GB: een pc met 6 GB laat er vaak maar 5,6 GB van zien (de rest is voor beeld en BIOS).
    [ "$geheugen_kb" -lt 5000000 ] || [ "$kernen" -le 2 ]
}

aan() {
    [ -f "$MARKER" ] && return 0  # staat al aan: niet de lichte stand zelf als "hoe het was" onthouden
    mkdir -p "$BUGOS_CONFIG"
    # Onthoud hoe het nu is. "-" = niet ingesteld (dan geldt de standaard van KDE).
    : >"$VOOR"
    local regel bestand groep sleutel waarde
    for regel in "${INSTELLINGEN[@]}"; do
        read -r bestand groep sleutel <<<"$regel"
        waarde="$(kreadconfig6 --file "$bestand" --group "$groep" --key "$sleutel" 2>/dev/null)"
        printf '%s\t%s\n' "$regel" "${waarde:--}" >>"$VOOR"
    done
    # Stond het zoeken in bestanden al uit? Dat staat in de instelling zelf ('baloo status' meldt "uit"
    # in de taal van de gebruiker en op stderr, dus daar lezen we het niet uit).
    if [ "$(kreadconfig6 --file baloofilerc --group "Basic Settings" --key Indexing-Enabled 2>/dev/null)" = false ]; then
        printf 'baloo\tuit\n' >>"$VOOR"
    else
        printf 'baloo\taan\n' >>"$VOOR"
    fi
    # Animaties uit, doorzichtige/wazige effecten uit.
    kwriteconfig6 --file kdeglobals --group KDE --key AnimationDurationFactor --notify 0
    kwriteconfig6 --file kwinrc --group Plugins --key blurEnabled false
    kwriteconfig6 --file kwinrc --group Plugins --key contrastEnabled false
    kwriteconfig6 --file kwinrc --group Plugins --key slidingpopupsEnabled false
    # Bestanden-zoeker (die steeds alles doorzoekt) op een laag pitje.
    balooctl6 disable >/dev/null 2>&1 || balooctl disable >/dev/null 2>&1
    kwin_herladen
    touch "$MARKER"
}

uit() {
    local regel bestand groep sleutel waarde baloo_was=aan
    # Niets om terug te zetten (hij stond al uit): dan ook niets aan jouw instellingen veranderen (U127).
    [ -f "$MARKER" ] || [ -f "$VOOR" ] || return 0
    if [ -f "$VOOR" ]; then
        # Precies terug naar hoe het was vóór de lichte stand (ook wat je zelf had ingesteld).
        while IFS=$'\t' read -r regel waarde; do
            if [ "$regel" = baloo ]; then
                baloo_was="$waarde"
                continue
            fi
            read -r bestand groep sleutel <<<"$regel"
            # --notify: dan krijgen ook het paneel en open programma's de animaties meteen terug (U261).
            if [ "$waarde" = - ]; then
                kwriteconfig6 --file "$bestand" --group "$groep" --key "$sleutel" --notify --delete
            else
                kwriteconfig6 --file "$bestand" --group "$groep" --key "$sleutel" --notify "$waarde"
            fi
        done <"$VOOR"
    else
        # Lichte stand van vóór deze versie: terug naar de standaard van KDE.
        for regel in "${INSTELLINGEN[@]}"; do
            read -r bestand groep sleutel <<<"$regel"
            kwriteconfig6 --file "$bestand" --group "$groep" --key "$sleutel" --notify --delete
        done
    fi
    if [ "$baloo_was" = aan ]; then
        baloo enable >/dev/null
    fi
    kwin_herladen
    rm -f "$MARKER" "$VOOR"
}

# Eén tegelijk: snel aan en weer uit (Instellingen, Welkom) liep anders door elkaar heen (U126).
mkdir -p "$BUGOS_CONFIG"
if [ "${1:-}" != status ]; then   # 'status' hoeft niet te wachten
    exec 9>"$BUGOS_CONFIG/.lichte-stand.slot"
    flock 9 2>/dev/null || true
fi

case "${1:-auto}" in
auto)
    # Maar één keer zelf beslissen; daarna respecteren we de keuze van de gebruiker.
    [ -f "$GEKEKEN" ] && exit 0
    mkdir -p "$BUGOS_CONFIG"
    touch "$GEKEKEN"
    if is_traag; then
        aan
        melding "$(t "Lichte stand staat aan" "Light mode is on")" \
            "$(t "BugOS zag een wat oudere computer en heeft zware effecten uitgezet, zodat alles vlot blijft." \
                "BugOS noticed an older computer and turned off heavy effects to keep things fast.")"
    fi
    ;;
aan) aan ;;
uit) uit ;;
status) if [ -f "$MARKER" ]; then echo aan; else echo uit; fi ;;
*)
    echo "Gebruik: bugos-light-mode auto|aan|uit|status" >&2
    exit 2
    ;;
esac
