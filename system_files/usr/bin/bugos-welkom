#!/usr/bin/python3
"""BugOS Welkom - het eerste scherm na het installeren.

Jip-en-Janneke: een paar grote, simpele stappen.
  1. Hallo + taal
  2. Internet (wifi)
  3. Licht of donker
  4. Updates: vanzelf of zelf
  5. Wat ga je doen? (gamen / programmeren / oudere computer)
  6. Klaar!

Gestart met --eerste-keer opent hij alleen als hij nog nooit is afgemaakt.
"""

import sys
from pathlib import Path

sys.path.insert(0, "/usr/lib/bugos/python")

import bugos_ui  # noqa: E402
from bugos_ui import (  # noqa: E402
    CONFIG, Chip, Groep, IcoonChip, K, Kaart, KeuzeKaart, Knop, SchakelRij, Tegel, achtergrond_pad, bestaat, draai,
    label, maak_app, ronde_pixmap, start, t, uitvoeren,
)
from PySide6.QtCore import QLocale, QPointF, QRectF, QSize, Qt, QTimer  # noqa: E402
from PySide6.QtGui import QColor, QFont, QIcon, QLinearGradient, QPainter, QPen, QPixmap  # noqa: E402
from PySide6.QtWidgets import (  # noqa: E402
    QButtonGroup, QHBoxLayout, QLabel, QPushButton, QStackedWidget, QVBoxLayout, QWidget,
)

KLAAR = CONFIG / "welkom-klaar"
DISPLAY = bugos_ui.DISPLAY


def heeft_internet() -> bool:
    code, uit = draai("nmcli", "-t", "-f", "CONNECTIVITY", "general", timeout=5)
    return code == 0 and uit.strip() == "full"


# ============================================================ zijpaneel ===

class Zijpaneel(QWidget):
    """Links: de BugOS-achtergrond, het logo en de stappen."""

    def __init__(self, stappen: list[str]):
        super().__init__()
        self.stappen = stappen
        self.huidig = 0
        self.beeld = QPixmap(achtergrond_pad(donker=True))
        # De zijbalk is altijd donker: het logo met de lichte kop.
        self.logo = QIcon("/usr/share/bugos/logo-donker.svg")
        self.setFixedWidth(330)

    def zet(self, i: int) -> None:
        self.huidig = i
        self.update()

    def paintEvent(self, _e):  # noqa: N802
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform)
        r = QRectF(self.rect())
        p.fillRect(r, QColor("#0E0F13"))
        if not self.beeld.isNull():
            bw, bh = self.beeld.width(), self.beeld.height()
            schaal = r.height() / bh * 1.15
            dw, dh = bw * schaal, bh * schaal
            p.drawPixmap(QRectF(r.right() - dw * 0.62, r.bottom() - dh, dw, dh), self.beeld, QRectF(0, 0, bw, bh))
            donker = QLinearGradient(0, 0, 0, r.height())
            donker.setColorAt(0, QColor(14, 15, 19, 235))
            donker.setColorAt(0.55, QColor(14, 15, 19, 150))
            donker.setColorAt(1, QColor(14, 15, 19, 40))
            p.fillRect(r, donker)

        # logo + woord
        self.logo.paint(p, 32, 34, 34, 34)
        f = p.font()
        f.setFamily(DISPLAY)
        f.setPixelSize(26)
        f.setWeight(f.Weight.DemiBold)
        p.setFont(f)
        p.setPen(QColor("#FFFFFF"))
        p.drawText(QRectF(76, 32, 220, 40), Qt.AlignmentFlag.AlignVCenter, "BugOS")

        # stappen
        y = 128
        for i, naam in enumerate(self.stappen):
            klaar, nu = i < self.huidig, i == self.huidig
            cx, cy = 44, y + 14
            if klaar:
                p.setBrush(QColor(K["accent"]))
                p.setPen(Qt.PenStyle.NoPen)
                p.drawEllipse(QRectF(cx - 11, cy - 11, 22, 22))
                vink = QPen(QColor("#FFFFFF"), 2.2)
                vink.setCapStyle(Qt.PenCapStyle.RoundCap)
                vink.setJoinStyle(Qt.PenJoinStyle.RoundJoin)
                p.setPen(vink)
                p.setBrush(Qt.BrushStyle.NoBrush)
                p.drawPolyline([QPointF(cx - 5, cy + 0.5), QPointF(cx - 1.5, cy + 4), QPointF(cx + 5, cy - 3.5)])
            elif nu:
                p.setBrush(QColor("#FFFFFF"))
                p.setPen(Qt.PenStyle.NoPen)
                p.drawEllipse(QRectF(cx - 11, cy - 11, 22, 22))
                p.setBrush(QColor(K["accent"]))
                p.drawEllipse(QRectF(cx - 5, cy - 5, 10, 10))
            else:
                p.setBrush(Qt.BrushStyle.NoBrush)
                p.setPen(QPen(QColor(255, 255, 255, 90), 1.6))
                p.drawEllipse(QRectF(cx - 10, cy - 10, 20, 20))
            if i < len(self.stappen) - 1:
                p.setPen(QPen(QColor(255, 255, 255, 140 if klaar else 50), 1.6))
                p.drawLine(QPointF(cx, cy + 14), QPointF(cx, cy + 34))
            f = QFont(self.font())
            f.setPixelSize(15)
            f.setWeight(f.Weight.DemiBold if nu else f.Weight.Normal)
            p.setFont(f)
            p.setPen(QColor(255, 255, 255, 255 if nu else (200 if klaar else 130)))
            p.drawText(QRectF(70, y, 240, 28), Qt.AlignmentFlag.AlignVCenter, naam)
            y += 48

        f = p.font()
        f.setPixelSize(13)
        f.setWeight(f.Weight.Normal)
        p.setFont(f)
        p.setPen(QColor(255, 255, 255, 150))
        p.drawText(QRectF(32, r.bottom() - 52, 260, 24), Qt.AlignmentFlag.AlignVCenter,
                   t(f"Stap {self.huidig + 1} van {len(self.stappen)}", f"Step {self.huidig + 1} of {len(self.stappen)}"))


# ============================================================== pagina's ===

class Pagina(QWidget):
    def __init__(self, kop_tekst: str, sub: str):
        super().__init__()
        self.setObjectName("pagina")
        self.lay = QVBoxLayout(self)
        self.lay.setContentsMargins(48, 46, 48, 12)
        self.lay.setSpacing(18)
        self.lay.addWidget(label(kop_tekst, "titel"))
        self.lay.addWidget(label(sub, "sub"))
        self.lay.addSpacing(6)

    def klaar_met_vullen(self) -> None:
        self.lay.addStretch(1)

    def bij_volgende(self) -> None:
        """Wordt aangeroepen als de gebruiker op Volgende drukt."""


class Hallo(Pagina):
    def __init__(self):
        super().__init__(t("Hallo! Fijn dat je er bent.", "Hello! Glad you're here."),
                         t("In een paar simpele stappen zetten we alles voor je klaar. "
                           "Je kunt alles later nog veranderen.",
                           "In a few simple steps we'll set everything up for you. "
                           "You can change everything later."))
        taal = Kaart(marge=20, ruimte=16, richting="h")
        taal.lay.addWidget(IcoonChip("lijn:wereld", "neutraal", 48, vol=False))
        blok = QVBoxLayout()
        blok.setSpacing(2)
        blok.addWidget(label(t("Taal", "Language"), "klein"))
        naam = QLocale().nativeLanguageName() or "Nederlands"
        blok.addWidget(label(naam[:1].upper() + naam[1:], "kop2"))
        taal.lay.addLayout(blok, 1)
        knop = Knop(t("Andere taal", "Other language"), "rand")
        knop.clicked.connect(lambda: start("bugos-instellingen", "tijd"))
        taal.lay.addWidget(knop)
        self.lay.addWidget(taal)

        tips = Groep()
        for icoon, tint, kop_t, sub_t in (
            ("lijn:vink", "neutraal", t("Kan niet stuk", "Can't break"),
             t("Gaat er iets mis na een update? Dan kies je gewoon de vorige versie.",
               "Something wrong after an update? Just pick the previous version.")),
            ("lijn:ster", "neutraal", t("Alles in de BugOS Winkel", "Everything in the BugOS Store"),
             t("Apps installeer je met één klik, zoals op je telefoon.", "Install apps with one click, like on your phone.")),
            ("lijn:slot", "neutraal", t("Geen account, geen reclame", "No account, no ads"),
             t("BugOS verzamelt niks over jou.", "BugOS collects nothing about you.")),
        ):
            rij = QWidget()
            r = QHBoxLayout(rij)
            r.setContentsMargins(18, 14, 18, 14)
            r.setSpacing(14)
            r.addWidget(IcoonChip(icoon, tint, 38, vol=False))
            b = QVBoxLayout()
            b.setSpacing(1)
            b.addWidget(label(kop_t, "kop3"))
            b.addWidget(label(sub_t, "klein"))
            r.addLayout(b, 1)
            tips.voeg(rij)
        self.lay.addWidget(tips)
        self.klaar_met_vullen()


class Internet(Pagina):
    def __init__(self):
        super().__init__(t("Internet", "Internet"),
                         t("Voor updates en de Winkel heb je internet nodig.",
                           "You need internet for updates and the Store."))
        kaart = Kaart(marge=22, ruimte=16, richting="h")
        self.chip_icoon = IcoonChip("lijn:wifi", "neutraal", 52, vol=False)
        kaart.lay.addWidget(self.chip_icoon)
        blok = QVBoxLayout()
        blok.setSpacing(4)
        self.kop = label("", "kop2")
        self.sub = label("", "klein")
        blok.addWidget(self.kop)
        blok.addWidget(self.sub)
        kaart.lay.addLayout(blok, 1)
        self.status = Chip("", "grijs")
        kaart.lay.addWidget(self.status)
        self.lay.addWidget(kaart)
        rij = QHBoxLayout()
        kies = Knop(t("Wifi kiezen", "Choose Wi-Fi"), "hoofd", "lijn:wifi", groot=True)
        kies.clicked.connect(lambda: start("systemsettings", "kcm_networkmanagement"))
        opnieuw = Knop(t("Opnieuw kijken", "Check again"), "stil", "lijn:verversen")
        opnieuw.clicked.connect(self.ververs)
        rij.addWidget(kies)
        rij.addWidget(opnieuw)
        rij.addStretch(1)
        self.lay.addLayout(rij)
        self.klaar_met_vullen()
        self.ververs()
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.ververs)
        self.timer.start(4000)

    def ververs(self) -> None:
        online = heeft_internet()
        if online:
            self.kop.setText(t("Je bent verbonden", "You are connected"))
            self.sub.setText(t("Mooi zo. Je kunt verder.", "Great. You can continue."))
            self.status.setText(t("Online", "Online"))
            self.status.setStyleSheet(Chip("", "goed").styleSheet())
        else:
            self.kop.setText(t("Nog geen internet", "No internet yet"))
            self.sub.setText(t("Kies je wifi, of steek een netwerkkabel in. Overslaan mag ook.",
                               "Choose your Wi-Fi, or plug in a network cable. Skipping is fine too."))
            self.status.setText(t("Offline", "Offline"))
            self.status.setStyleSheet(Chip("", "let_op").styleSheet())


def voorbeeld(donker: bool, b: int = 300, h: int = 176) -> QPixmap:
    """Een klein plaatje van het bureaublad in licht of donker."""
    pm = QPixmap(QSize(b * 2, h * 2))
    pm.setDevicePixelRatio(2)
    pm.fill(QColor("#000"))
    p = QPainter(pm)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform)
    beeld = QPixmap(achtergrond_pad(donker=donker))
    if not beeld.isNull():
        p.drawPixmap(QRectF(0, 0, b, h), beeld, QRectF(0, 0, beeld.width(), beeld.height()))
    vlak = QColor("#1C1E24" if donker else "#FFFFFF")
    lijn = QColor("#3A3E48" if donker else "#E6E2E2")
    tekst = QColor("#EDEEF1" if donker else "#16171C")
    # venstertje
    p.setPen(Qt.PenStyle.NoPen)
    p.setBrush(QColor(0, 0, 0, 60))
    p.drawRoundedRect(QRectF(26, 26, 150, 98), 9, 9)
    p.setBrush(vlak)
    p.drawRoundedRect(QRectF(24, 22, 150, 98), 9, 9)
    p.setBrush(lijn)
    for i, w in enumerate((92, 120, 70)):
        p.drawRoundedRect(QRectF(38, 52 + i * 16, w, 7), 3.5, 3.5)
    p.setBrush(QColor("#DE2F3E"))
    p.drawRoundedRect(QRectF(38, 34, 46, 9), 4.5, 4.5)
    p.setBrush(tekst)
    p.drawEllipse(QRectF(150, 32, 10, 10))
    # taakbalk
    p.setBrush(QColor(28, 30, 36, 220) if donker else QColor(255, 255, 255, 220))
    p.drawRoundedRect(QRectF(8, h - 24, b - 16, 18), 7, 7)
    logo = QIcon("/usr/share/bugos/logo-donker.svg" if donker else "/usr/share/bugos/logo.svg")
    logo.paint(p, 15, h - 22, 14, 14)
    p.setBrush(lijn)
    for i in range(3):
        p.drawRoundedRect(QRectF(36 + i * 18, h - 20, 12, 10), 3, 3)
    p.end()
    return ronde_pixmap(pm, 24)


class Uiterlijk(Pagina):
    def __init__(self):
        super().__init__(t("Licht of donker?", "Light or dark?"),
                         t("Kies wat jij fijn vindt om naar te kijken.", "Choose what you like to look at."))
        rij = QHBoxLayout()
        rij.setSpacing(18)
        self.groep = QButtonGroup(self)
        self.knoppen = {}
        for donker, naam in ((False, t("Licht", "Light")), (True, t("Donker", "Dark"))):
            binnen = QWidget()
            b = QVBoxLayout(binnen)
            b.setContentsMargins(0, 0, 0, 0)
            b.setSpacing(12)
            plaat = QLabel()
            plaat.setPixmap(voorbeeld(donker))
            b.addWidget(plaat)
            b.addWidget(label(naam, "kop3"))
            k = KeuzeKaart(binnen)
            k.clicked.connect(lambda _=False, d=donker: self.kies(d))
            self.groep.addButton(k)
            self.knoppen[donker] = k
            rij.addWidget(k)
        rij.addStretch(1)
        self.lay.addLayout(rij)
        self.lay.addWidget(label(t("Tip: je kunt dit later veranderen bij Instellingen → Licht of donker.",
                                   "Tip: you can change this later in Settings → Light or dark."), "klein"))
        self.klaar_met_vullen()
        self.knoppen[bugos_ui.DONKER].setChecked(True)

    def kies(self, donker: bool) -> None:
        # Eén plek voor licht/donker: kleuren, KDE-programma's en de Plasma-stijl.
        start("bugos-thema", "donker" if donker else "licht")


class Updates(Pagina):
    def __init__(self):
        super().__init__(t("Updates", "Updates"),
                         t("Updates houden je computer veilig. Ze worden pas actief na opnieuw opstarten, "
                           "en gaat er ooit iets mis, dan kies je gewoon de vorige versie.",
                           "Updates keep your computer safe. They only take effect after a restart, "
                           "and if something ever goes wrong, just pick the previous version."))
        self.groep = QButtonGroup(self)
        self.auto = self._optie("lijn:vink", "neutraal", t("Vanzelf, stil op de achtergrond", "Automatically, quietly"),
                                t("BugOS houdt zichzelf bij. Jij merkt er niks van.",
                                  "BugOS keeps itself up to date. You won't notice a thing."), True)
        self.hand = self._optie("lijn:verversen", "neutraal", t("Ik kies zelf wanneer", "I choose when"),
                                t("Je krijgt een melding als er een update is.", "You get a notification when there is an update."),
                                False)
        huidig = "auto"
        if bestaat("bugos-updates"):
            huidig = (draai("bugos-updates", "status", timeout=5)[1].strip() or "auto")
        self.begin = huidig
        (self.hand if huidig == "hand" else self.auto).setChecked(True)
        self.klaar_met_vullen()

    def _optie(self, icoon: str, tint: str, kop_t: str, sub_t: str, aanbevolen: bool) -> QPushButton:
        binnen = QWidget()
        r = QHBoxLayout(binnen)
        r.setContentsMargins(6, 4, 6, 4)
        r.setSpacing(16)
        r.addWidget(IcoonChip(icoon, tint, 48, vol=False))
        b = QVBoxLayout()
        b.setSpacing(2)
        kop_rij = QHBoxLayout()
        kop_rij.setSpacing(10)
        kop_rij.addWidget(label(kop_t, "kop3", wrap=False))
        if aanbevolen:
            kop_rij.addWidget(Chip(t("Aangeraden", "Recommended"), "goed"))
        kop_rij.addStretch(1)
        b.addLayout(kop_rij)
        b.addWidget(label(sub_t, "klein"))
        r.addLayout(b, 1)
        k = KeuzeKaart(binnen)
        self.groep.addButton(k)
        self.lay.addWidget(k)
        return k

    def bij_volgende(self) -> None:
        gekozen = "hand" if self.hand.isChecked() else "auto"
        if gekozen != self.begin:
            start("pkexec", "/usr/bin/bugos-updates", gekozen)
            self.begin = gekozen


class Jij(Pagina):
    def __init__(self):
        super().__init__(t("Wat ga je doen?", "What will you do?"),
                         t("Zet aan wat bij jou past. Niks aanzetten mag ook.", "Turn on what fits you. Turning on nothing is fine too."))
        g = Groep()
        self.gamer = SchakelRij(t("Ik ga gamen", "I'm going to play games"),
                                t("Steam staat klaar. Met de Game-modus speel je op volle kracht.",
                                  "Steam is ready. Game mode gives you full power."), False, "lijn:spel", "neutraal")
        self.dev = SchakelRij(t("Ik ga programmeren", "I'm going to code"),
                              t("BugOS zet VS Code, containers en programmeertalen voor je klaar.",
                                "BugOS sets up VS Code, containers and programming languages."), False, "lijn:code", "neutraal")
        self.oud = SchakelRij(t("Mijn computer is wat ouder", "My computer is a bit older"),
                              t("Zware effecten uit, zodat alles vlot blijft.", "Heavy effects off, so everything stays fast."),
                              False, "lijn:ster", "neutraal")
        for w in (self.gamer, self.dev, self.oud):
            g.voeg(w)
        self.lay.addWidget(g)
        self.klaar_met_vullen()

    def bij_volgende(self) -> None:
        if self.dev.schuif.isChecked():
            start("bugos-ontwikkelaar", "aan")
        if self.oud.schuif.isChecked():
            start("bugos-lichte-stand", "aan")
        if self.gamer.schuif.isChecked():
            start("steam")


class Klaar(Pagina):
    def __init__(self):
        super().__init__(t("Klaar! Veel plezier 🎉", "All done! Have fun 🎉"),
                         t("BugOS staat voor je klaar. Klik linksonder op het lieveheersbeestje om je apps te vinden.",
                           "BugOS is ready. Click the ladybug at the bottom left to find your apps."))
        tegels = [
            Tegel("lijn:download", t("Bestanden van Windows", "Files from Windows"),
                  t("Zet je oude foto's en documenten terug", "Bring back your old photos and documents"),
                  lambda: start("bugos-overstap")),
            Tegel("lijn:ster", t("BugOS Winkel", "BugOS Store"),
                  t("Apps installeren met één klik", "Install apps with one click"),
                  lambda: start("bugos-winkel")),
            Tegel("lijn:schakelaar", t("Instellingen", "Settings"),
                  t("Wifi, geluid, scherm en meer", "Wi-Fi, sound, display and more"),
                  lambda: start("bugos-instellingen")),
        ]
        for tg in tegels:
            self.lay.addWidget(tg)
        self.lay.addWidget(label(t("Dit scherm vind je terug in het startmenu: \"BugOS Welkom\".",
                                   "You can find this screen again in the start menu: \"BugOS Welcome\"."), "klein"))
        self.klaar_met_vullen()


# ================================================================ venster ===

class Welkom(QWidget):
    def __init__(self):
        super().__init__()
        self.setObjectName("venster")
        self.setWindowTitle(t("BugOS Welkom", "BugOS Welcome"))
        self.resize(1000, 680)
        self.paginas = [Hallo(), Internet(), Uiterlijk(), Updates(), Jij(), Klaar()]
        namen = [t("Welkom", "Welcome"), t("Internet", "Internet"), t("Uiterlijk", "Appearance"),
                 t("Updates", "Updates"), t("Jouw computer", "Your computer"), t("Klaar", "Done")]
        self.zij = Zijpaneel(namen)

        hoofd = QHBoxLayout(self)
        hoofd.setContentsMargins(0, 0, 0, 0)
        hoofd.setSpacing(0)
        hoofd.addWidget(self.zij)

        rechts = QVBoxLayout()
        rechts.setContentsMargins(0, 0, 0, 0)
        rechts.setSpacing(0)
        self.stapels = QStackedWidget()
        for p in self.paginas:
            self.stapels.addWidget(p)
        rechts.addWidget(self.stapels, 1)

        onder = QHBoxLayout()
        onder.setContentsMargins(48, 12, 48, 34)
        self.terug = Knop(t("Terug", "Back"), "stil", groot=True)
        self.volgende = Knop(t("Volgende", "Next"), "hoofd", groot=True)
        self.volgende.setMinimumWidth(150)
        self.volgende.setDefault(True)
        self.terug.clicked.connect(lambda: self.ga(-1))
        self.volgende.clicked.connect(lambda: self.ga(+1))
        onder.addWidget(self.terug)
        onder.addStretch(1)
        onder.addWidget(self.volgende)
        rechts.addLayout(onder)
        hoofd.addLayout(rechts, 1)
        self.ververs()

    def ga(self, richting: int) -> None:
        nu = self.stapels.currentIndex()
        if richting > 0:
            self.paginas[nu].bij_volgende()
            if nu == len(self.paginas) - 1:
                CONFIG.mkdir(parents=True, exist_ok=True)
                KLAAR.touch()
                self.close()
                return
        self.stapels.setCurrentIndex(max(0, min(len(self.paginas) - 1, nu + richting)))
        self.ververs()

    def ververs(self) -> None:
        nu = self.stapels.currentIndex()
        laatste = nu == len(self.paginas) - 1
        self.terug.setVisible(nu > 0)
        self.volgende.setText(t("Aan de slag", "Let's go") if laatste else t("Volgende", "Next"))
        self.zij.zet(nu)


def main() -> int:
    if "--eerste-keer" in sys.argv:
        if KLAAR.exists():
            return 0
        try:
            if "rd.live.image" in Path("/proc/cmdline").read_text():
                return 0  # op de live-USB toont bugos-live het welkomstscherm
        except OSError:
            pass
    app = maak_app("bugos-welkom", "bugos-welkom", sys.argv)
    return uitvoeren(app, Welkom())


if __name__ == "__main__":
    sys.exit(main())
