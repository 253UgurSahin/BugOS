#!/usr/bin/bash
# bugos-browser - je eigen browser kiezen (in Welkom), installeren en als standaard zetten.
#
#   bugos-browser kies <app-id>   onthoud de keuze, installeer de browser (Flatpak van Flathub) en maak hem standaard
#   bugos-browser later           bij het inloggen: staat er nog een keuze open (geen internet toen), probeer het nu
#   bugos-browser status          de gekozen browser (app-id), of niets
#
# Waarom: BugOS zette vroeger altijd Firefox neer en maakte die de standaard. Nu kies je in Welkom zelf welke browser
# je wilt (wens van de eigenaar, 2026-11-24). Geen internet in Welkom? Dan onthouden we de keuze en komt de browser
# bij een volgende keer inloggen met internet (autostart bugos-browser.desktop).

# shellcheck source=system_files/usr/share/bugos/lib.sh
. /usr/share/bugos/lib.sh

WENS="$BUGOS_CONFIG/browser"
# Alleen deze browsers (ze staan ook in de Winkel). Nooit iets anders naar flatpak.
BROWSERS=(org.mozilla.firefox com.google.Chrome com.microsoft.Edge com.brave.Browser org.chromium.Chromium)

toegestaan() {
    local b
    for b in "${BROWSERS[@]}"; do
        [ "$b" = "$1" ] && return 0
    done
    return 1
}

naam() {
    case "$1" in
    org.mozilla.firefox) echo Firefox ;;
    com.google.Chrome) echo "Google Chrome" ;;
    com.microsoft.Edge) echo "Microsoft Edge" ;;
    com.brave.Browser) echo Brave ;;
    org.chromium.Chromium) echo Chromium ;;
    *) echo "$1" ;;
    esac
}

geinstalleerd() {
    flatpak info "$1" >/dev/null 2>&1
}

# De standaardbrowser van deze gebruiker. xdg-settings zet in KDE de browser in kdeglobals; xdg-mime de koppelingen
# in ~/.config/mimeapps.list (die gaan voor op /etc/xdg/kde-mimeapps.list).
standaard() {
    local bureau="$1.desktop" soort
    xdg-settings set default-web-browser "$bureau" >/dev/null 2>&1 || true
    for soort in x-scheme-handler/http x-scheme-handler/https text/html application/xhtml+xml; do
        xdg-mime default "$bureau" "$soort" >/dev/null 2>&1 || true
    done
    if command -v kwriteconfig6 >/dev/null 2>&1; then
        kwriteconfig6 --file kdeglobals --group General --key BrowserApplication "$bureau" >/dev/null 2>&1 || true
    fi
    # De taakbalk: de standaardindeling heeft Firefox vastgezet. Een andere browser gekozen? Die erop, Firefox eraf
    # (staat Firefox er niet, dan verandert losmaken niets). Het startmenu doet het zelf (bugos-start-data).
    if [ "$1" != org.mozilla.firefox ] && command -v bugos-panel >/dev/null 2>&1; then
        bugos-panel taakbalk vastmaken "$bureau" >/dev/null 2>&1 || true
        if ! geinstalleerd org.mozilla.firefox; then
            bugos-panel taakbalk losmaken org.mozilla.firefox.desktop >/dev/null 2>&1 || true
        fi
    fi
}

# installeer ID [stil]: 0 = gelukt (of stond er al), 1 = mislukt. Zonder --noninteractive: dan mag KDE om het
# wachtwoord vragen (een gezinslid dat geen beheerder is), net als de Winkel.
installeer() {
    local id="$1" log
    geinstalleerd "$id" && return 0
    # Zoals de Winkel: voor de hele computer (--system). Is flathub daar (nog) niet, dan alleen voor jou (--user).
    # Altijd één van de twee noemen: anders vraagt flatpak 'welke installatie?', en zonder terminal antwoordt niemand.
    local waar=--system
    if ! flatpak remote-list --system 2>/dev/null | grep -q '^flathub'; then
        waar=--user
        flatpak remote-add --if-not-exists --user flathub https://dl.flathub.org/repo/flathub.flatpakrepo >/dev/null 2>&1
    fi
    log="$(mktemp)"
    if LC_ALL=C.UTF-8 flatpak install "$waar" -y flathub "$id" >"$log" 2>&1; then
        rm -f "$log"
        command -v bugos-flatpak-style >/dev/null 2>&1 && bugos-flatpak-style >/dev/null 2>&1
        return 0
    fi
    if grep -qiE "no space left on device|not enough (disk |free )?space" "$log"; then
        GEEN_RUIMTE=ja
    fi
    rm -f "$log"
    return 1
}

online() {
    [ "$(LC_ALL=C nmcli -t networking connectivity check 2>/dev/null | tail -n 1)" = full ]
}

kies() {
    local id="$1" n
    if ! toegestaan "$id"; then
        echo "bugos-browser: onbekende browser '$id'" >&2
        exit 2
    fi
    mkdir -p "$BUGOS_CONFIG"
    echo "$id" >"$WENS"
    n="$(naam "$id")"
    if geinstalleerd "$id"; then
        standaard "$id"
        rm -f "$WENS.open"
        return 0
    fi
    touch "$WENS.open"
    if ! online; then
        melding "$(t "$n komt zodra je internet hebt" "$n comes as soon as you are online")" \
            "$(t "BugOS installeert $n vanzelf de volgende keer dat je inlogt met internet. Of haal hem nu uit de Winkel." \
                "BugOS installs $n by itself the next time you sign in with internet. Or get it from the Store now.")"
        return 1
    fi
    melding "$(t "$n wordt geïnstalleerd" "Installing $n")" \
        "$(t "Dit duurt een paar minuten. Daarna is $n je standaardbrowser." \
            "This takes a few minutes. After that $n is your default browser.")"
    GEEN_RUIMTE=nee
    if installeer "$id"; then
        standaard "$id"
        rm -f "$WENS.open"
        melding "$(t "$n is klaar" "$n is ready")" \
            "$(t "Je vindt hem in het startmenu. Links openen voortaan in $n." \
                "You can find it in the start menu. Links now open in $n.")"
        return 0
    fi
    if [ "$GEEN_RUIMTE" = ja ]; then
        melding "$(t "$n installeren lukte niet: je computer is vol" "Installing $n failed: your computer is full")" \
            "$(t "Maak eerst ruimte en haal $n daarna uit de Winkel." "Make room first, then get $n from the Store.")"
    else
        melding "$(t "$n installeren lukte nog niet" "Installing $n did not work yet")" \
            "$(t "BugOS probeert het de volgende keer dat je inlogt opnieuw. Of haal $n nu uit de Winkel." \
                "BugOS tries again the next time you sign in. Or get $n from the Store now.")"
    fi
    return 1
}

# Bij het inloggen: een keuze die nog niet lukte. Eerst even op internet wachten (hooguit twee minuten), en nooit
# twee keer tegelijk.
later() {
    [ -f "$WENS.open" ] || exit 0
    local id
    id="$(head -n 1 "$WENS" 2>/dev/null)"
    toegestaan "$id" || { rm -f "$WENS.open"; exit 0; }
    if geinstalleerd "$id"; then
        standaard "$id"
        rm -f "$WENS.open"
        exit 0
    fi
    nm-online -q -t 120 >/dev/null 2>&1 || true
    online || exit 0
    kies "$id"
}

slot() {
    mkdir -p "$BUGOS_CONFIG"
    exec 9>"$BUGOS_CONFIG/.browser.slot"
    flock 9 2>/dev/null || true
}

case "${1:-status}" in
kies) slot; kies "${2:-}" ;;
later) slot; later ;;
status) head -n 1 "$WENS" 2>/dev/null || true ;;
*)
    echo "Gebruik: bugos-browser kies <app-id> | later | status" >&2
    exit 2
    ;;
esac
