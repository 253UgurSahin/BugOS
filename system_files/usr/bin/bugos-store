#!/usr/bin/python3
"""BugOS Winkel - apps installeren met één klik.

Jip-en-Janneke: links kies je een onderwerp (Internet, Kantoor, Gamen...),
rechts zie je bekende, veilige apps. Druk op "Installeren" en klaar.
Staat wat je zoekt er niet bij? Typ de naam: de Winkel zoekt dan ook in alle andere apps van Flathub,
en laat elke app eerst op een eigen pagina zien (wie hem maakt, voor welke leeftijd, hoe groot).
Alles gebeurt in de Winkel zelf; er gaat geen ander programma open.

  bugos-store                       -> de winkel
  bugos-store appstream://<id>      -> meteen naar die app
  bugos-store --zoek <tekst>        -> meteen zoeken
"""

import json
import os
import re
import sys
from pathlib import Path

sys.path.insert(0, "/usr/lib/bugos/python")

from bugos_ui import (  # noqa: E402
    TAAL, ZIJBALK_BREEDTE, Banner, Chip, IcoonChip, Kaart, Knop, Venster, Zoekveld, bestaat, draai, label,
    maak_app, raster, start, t, uitvoeren, zoeksleutel,
)
from PySide6.QtCore import QProcess, QProcessEnvironment, QSize, Qt, QTimer  # noqa: E402
from PySide6.QtGui import QIcon, QKeySequence, QPixmap, QShortcut  # noqa: E402
from PySide6.QtWidgets import (  # noqa: E402
    QCheckBox, QFrame, QHBoxLayout, QLabel, QMessageBox, QScrollArea, QStackedWidget, QVBoxLayout, QWidget,
)

CATALOGUS = Path("/usr/share/bugos/store.json")
ICOON_MAPPEN = [
    Path("/var/lib/flatpak/appstream/flathub/x86_64/active/icons/128x128"),
    Path("/var/lib/flatpak/appstream/flathub/x86_64/active/icons/64x64"),
    Path.home() / ".local/share/flatpak/appstream/flathub/x86_64/active/icons/128x128",
    # Meegeleverd met BugOS (build.sh): ook op een vers systeem en zonder internet een echt pictogram.
    Path("/usr/share/bugos/store-icons"),
]
# Apps die BugOS als gewoon pakket heeft (niet als Flatpak): hun pictogram heet in het thema anders.
THEMA_NAMEN = {"org.mozilla.firefox": "firefox", "com.valvesoftware.Steam": "steam"}
if os.environ.get("BUGOS_APPICONEN"):
    ICOON_MAPPEN.insert(0, Path(os.environ["BUGOS_APPICONEN"]))
# Een geldig app-id (org.voorbeeld.App): alleen zo'n id gaat ooit naar flatpak. Nooit met '-' vooraan (geen optie).
APP_ID = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9_-]*(\.[A-Za-z0-9_-]+){2,}$")


def app_naam(app: dict) -> str:
    """De naam van een app in jouw taal (de meeste zijn merknamen; 'Rekenmachine' heet in het Engels 'Calculator') (U209)."""
    return app.get("naam_en", app["naam"]) if TAAL != "nl" else app["naam"]


def lees_catalogus(pad: Path = CATALOGUS) -> dict:
    return json.loads(pad.read_text(encoding="utf-8"))


def geinstalleerd() -> set[str]:
    if os.environ.get("BUGOS_GEINSTALLEERD") is not None:  # voor screenshots
        return set(filter(None, os.environ["BUGOS_GEINSTALLEERD"].split(",")))
    if not bestaat("flatpak"):
        return set()
    _, uit = draai("flatpak", "list", "--app", "--columns=application", timeout=20)
    return {regel.strip() for regel in uit.splitlines() if regel.strip()}


# Waar gewone programma's (geen Flatpak) hun .desktop-bestand hebben. Firefox en Steam zitten
# bijvoorbeeld al in BugOS zelf: die zijn er dus al, ook al staan ze niet in 'flatpak list'.
APP_MAPPEN = [Path("/usr/share/applications"), Path("/usr/local/share/applications"),
              Path.home() / ".local/share/applications"]
# Sommige programma's heten als systeemprogramma anders dan in Flathub.
SYSTEEM_NAMEN = {
    "org.mozilla.firefox": ("org.mozilla.firefox", "firefox"),
    "com.valvesoftware.Steam": ("steam",),
}


def systeem_apps(apps: list[dict]) -> dict[str, Path]:
    """Apps uit de winkel die er al als gewoon programma op staan: app-id -> hun .desktop-bestand."""
    if os.environ.get("BUGOS_GEINSTALLEERD") is not None:  # voor screenshots: alleen dat lijstje
        return {}
    gevonden = {}
    for app in apps:
        for naam in SYSTEEM_NAMEN.get(app["id"], (app["id"],)):
            bestand = next((m / f"{naam}.desktop" for m in APP_MAPPEN if (m / f"{naam}.desktop").is_file()), None)
            if bestand:
                gevonden[app["id"]] = bestand
                break
    return gevonden


def icoon_voor(app_id: str) -> QIcon:
    for map_ in ICOON_MAPPEN:
        for ext in (".png", ".svg"):
            bestand = map_ / f"{app_id}{ext}"
            if bestand.is_file():
                return QIcon(str(bestand)) if ext == ".svg" else QIcon(QPixmap(str(bestand)))
    if QIcon.hasThemeIcon(app_id):
        return QIcon.fromTheme(app_id)
    return QIcon.fromTheme(THEMA_NAMEN.get(app_id, app_id), QIcon.fromTheme("application-x-executable"))


def tekst(app: dict) -> str:
    return app.get("nl" if TAAL == "nl" else "en", app.get("en", ""))


def past(app: dict, zoek: str) -> bool:
    hooi = zoeksleutel(f"{app['naam']} {app.get('naam_en', '')} {app.get('nl', '')} {app.get('en', '')} {app['id']}")
    return all(w in hooi for w in zoeksleutel(zoek).split())   # (U268)


class AppKaart(Kaart):
    def __init__(self, app: dict, winkel: "Winkel"):
        super().__init__(marge=18, ruimte=14, richting="h")
        self.app = app
        self.winkel = winkel
        self.setMinimumHeight(112)
        plaatje = QLabel()
        plaatje.setPixmap(icoon_voor(app["id"]).pixmap(QSize(56, 56)))
        plaatje.setFixedSize(60, 60)
        self.lay.addWidget(plaatje, 0, Qt.AlignmentFlag.AlignTop)
        blok = QVBoxLayout()
        blok.setSpacing(4)
        kop_rij = QHBoxLayout()
        kop_rij.setSpacing(8)
        kop_rij.addWidget(label(app_naam(app), "kop3", wrap=False))   # (U175)
        self.chip = Chip(t("Geïnstalleerd", "Installed"), "goed")
        kop_rij.addWidget(self.chip)
        kop_rij.addStretch(1)
        blok.addLayout(kop_rij)
        blok.addWidget(label(tekst(app), "klein"))
        blok.addStretch(1)
        rij = QHBoxLayout()
        rij.addStretch(1)
        # Een app die je uit de Winkel haalde, kun je hier ook weer weghalen (U464). Niet voor wat in BugOS zelf zit.
        self.weg = Knop(t("Verwijderen", "Remove"), "stil")
        self.weg.clicked.connect(lambda: self.winkel.vraag_verwijderen(self.app))
        self.weg.setAccessibleDescription(app_naam(app))   # 'Verwijderen' van welke app? (U482)
        rij.addWidget(self.weg)
        self.knop = Knop("", "hoofd")
        self.knop.setMinimumWidth(124)
        self.knop.clicked.connect(self.klik)
        self.knop.setAccessibleDescription(app_naam(app))   # (U482)
        rij.addWidget(self.knop)
        blok.addLayout(rij)
        self.lay.addLayout(blok, 1)
        self.ververs()

    def ververs(self) -> None:
        bezig = self.winkel.bezig_met == self.app["id"]
        er_al = self.app["id"] in self.winkel.installed
        self.chip.setVisible(er_al and not bezig)
        self.weg.setVisible(self.app["id"] in self.winkel.flatpaks and not bezig)
        self.weg.setEnabled(self.winkel.bezig_met is None)
        if bezig:
            self.knop.setText(t("Bezig…", "Working…"))
            self.knop.setEnabled(False)
        elif er_al:
            self.knop.setText(t("Openen", "Open"))
            self.knop.setProperty("soort", "rand")
            self.knop.setEnabled(True)
        else:
            self.knop.setText(t("Installeren", "Install"))
            self.knop.setProperty("soort", "hoofd")
            self.knop.setEnabled(self.winkel.bezig_met is None)
        self.knop.style().unpolish(self.knop)
        self.knop.style().polish(self.knop)

    def klik(self) -> None:
        if self.app["id"] in self.winkel.flatpaks:
            start("flatpak", "run", self.app["id"])
        elif self.app["id"] in self.winkel.systeem:  # een gewoon programma (bijv. Firefox in BugOS zelf)
            bestand = str(self.winkel.systeem[self.app["id"]])
            if bestaat("kioclient"):
                start("kioclient", "exec", bestand)
            else:
                start("gio", "launch", bestand)
        else:
            self.winkel.installeer(self.app)


class AppPagina(QWidget):
    """De pagina van één app die niet in de BugOS-selectie staat. Bovenaan altijd 'Terug', dan de kop (pictogram,
    naam, één regel) en een melding."""

    def __init__(self, winkel: "Winkel", soort: str, app_id: str, naam: str = "", kort: str = ""):
        super().__init__()
        self.setObjectName("pagina")
        self.winkel, self.soort, self.app_id = winkel, soort, app_id
        self.lay = QVBoxLayout(self)
        self.lay.setContentsMargins(36, 26, 36, 28)   # dezelfde marges als de lijst
        self.lay.setSpacing(16)
        self.terug = Knop(t("Terug", "Back"), "stil", "lijn:terug")
        self.terug.clicked.connect(lambda _c=False: winkel.terug())
        self.lay.addWidget(self.terug, 0, Qt.AlignmentFlag.AlignLeft)
        self.kop_rij = QHBoxLayout()
        self.kop_rij.setSpacing(20)
        self.plaatje = IcoonChip("lijn:apps", "neutraal", maat=96, vol=False)
        self.kop_rij.addWidget(self.plaatje, 0, Qt.AlignmentFlag.AlignTop)
        kolom = QVBoxLayout()
        kolom.setSpacing(6)
        self.naam = label(naam or app_id.rsplit(".", 1)[-1], "titel")
        kolom.addWidget(self.naam)
        self.kort = label(kort, "sub")
        self.kort.setVisible(bool(kort))
        kolom.addWidget(self.kort)
        kolom.addStretch(1)
        self.kop_rij.addLayout(kolom, 1)
        self.knoppen = QVBoxLayout()
        self.knoppen.setSpacing(8)
        self.kop_rij.addLayout(self.knoppen)
        self.lay.addLayout(self.kop_rij)
        self.melding = Banner()
        self.lay.addWidget(self.melding)
        self.einde = QVBoxLayout()
        self.einde.setSpacing(16)
        self.lay.addLayout(self.einde)
        self.lay.addStretch(1)

    def ververs(self) -> None:
        """Na installeren of verwijderen: de knoppen opnieuw (in latere stappen)."""


class Winkel(Venster):
    def __init__(self, catalogus: dict, begin_zoek: str = "", begin_app: str = "", opdracht: list[str] | None = None):
        scroll = QScrollArea()
        # Rechts een stapel: 0 = de lijst met apps, 1 = de pagina van één app (Terug brengt je weer naar de lijst).
        stapel = QStackedWidget()
        stapel.addWidget(scroll)
        pagina_scroll = QScrollArea()
        pagina_scroll.setFrameShape(QFrame.Shape.NoFrame)
        pagina_scroll.setWidgetResizable(True)
        pagina_scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAsNeeded)
        stapel.addWidget(pagina_scroll)
        super().__init__(t("BugOS Winkel", "BugOS Store"), inhoud=stapel, maat=(1180, 800))
        self.scroll, self.stapel, self.pagina_scroll = scroll, stapel, pagina_scroll
        self.pagina: AppPagina | None = None
        self.pagina_id: str | None = None
        self._terug_naar: tuple[int, QWidget | None] = (0, None)
        self.cat = catalogus
        self.systeem = systeem_apps(self.cat["apps"])
        self.flatpaks = geinstalleerd()
        self.installed = self.flatpaks | set(self.systeem)
        self.bezig_met: str | None = None
        self.kaarten: list[AppKaart] = []
        self.kolommen = 2

        # Links: de onderwerpen (de zijbalk komt van de schil)
        self.lijst = self.nav
        for c in self.cat["categorieen"]:
            self.lijst.voeg_toe(c["icoon"], c["nl" if TAAL == "nl" else "en"], c["id"])
        if self.installed:
            self.mijn_apps_erbij()
        self.lijst.currentRowChanged.connect(lambda _: self.onderwerp_gekozen())
        self.onder_knop(t("Alle apps doorzoeken", "Search all apps"), "zoek", self.meer_apps,
                        tip=t("Zoek in alle apps van Flathub", "Search all apps from Flathub"))

        # Rechts: zoeken en de apps
        scroll.setFrameShape(QFrame.Shape.NoFrame)
        scroll.setWidgetResizable(True)
        # Past een kaart toch niet (grote letters): opzij kunnen schuiven, niets valt eraf (U482).
        scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAsNeeded)
        rechts_w = QWidget()
        rechts_w.setObjectName("pagina")
        rechts = QVBoxLayout(rechts_w)
        rechts.setContentsMargins(36, 26, 36, 28)
        rechts.setSpacing(18)
        self.zoek = Zoekveld(t("Zoek een app, bijvoorbeeld \"muziek\" of \"Zoom\"",
                               "Search for an app, for example \"music\" or \"Zoom\""))
        self.zoek.textChanged.connect(lambda _: self.toon())
        # Wat een opdracht van buiten zei (een link of bestand dat de Winkel niet opent): weg zodra je zelf typt.
        self.zoek.textEdited.connect(lambda _: self.opdracht_melding.zet(""))
        rechts.addWidget(self.zoek)

        self.held = QWidget()
        hb = QVBoxLayout(self.held)
        hb.setContentsMargins(0, 6, 0, 0)
        hb.setSpacing(6)
        hb.addWidget(label(t("Apps voor alles wat je doet", "Apps for everything you do"), "titel"))
        # 'updates gaan vanzelf' klopte niet bij 'Ik kies zelf wanneer' (U361)
        hb.addWidget(label(t("Bekende, veilige apps. Installeren met één klik, en ze worden bijgewerkt met de rest.",
                             "Well-known, safe apps. Install with one click, and they are updated with everything else."), "sub"))
        rechts.addWidget(self.held)

        self.kop = label("", "kop2")
        rechts.addWidget(self.kop)
        self.opdracht_melding = Banner()
        rechts.addWidget(self.opdracht_melding)
        self.melding = Banner()
        rechts.addWidget(self.melding)
        self.raster_widget, self.raster = raster(2, 14)
        rechts.addWidget(self.raster_widget)

        self.onder = onder = Kaart("true", marge=20, ruimte=14, richting="h")
        onder.lay.addWidget(label(t("Niet gevonden wat je zoekt? Typ de naam hierboven: de Winkel zoekt dan ook in "
                                    "duizenden andere apps van Flathub.",
                                    "Didn't find what you need? Type its name above: the Store then also searches "
                                    "thousands of other apps from Flathub."), "sub"), 1)
        self.onder_zoek = meer2 = Knop(t("Zoeken", "Search"), "rand", "lijn:zoek")
        meer2.clicked.connect(lambda _c=False: self.meer_apps())
        onder.lay.addWidget(meer2)
        rechts.addWidget(onder)
        rechts.addStretch(1)
        scroll.setWidget(rechts_w)

        self.proces = QProcess(self)
        self.proces.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.proces.finished.connect(self.klaar)

        # Terug naar de lijst: Esc of Alt+Links, zoals in een webbrowser.
        for toets in (QKeySequence(Qt.Key.Key_Escape), QKeySequence(QKeySequence.StandardKey.Back)):
            sc = QShortcut(toets, self.pagina_scroll)
            sc.setContext(Qt.ShortcutContext.WidgetWithChildrenShortcut)
            sc.activated.connect(self.terug)

        self.lijst.setCurrentRow(0)
        self.lijst.setFocus()
        if begin_zoek:
            self.zoek.setText(begin_zoek)
        if opdracht:
            self.open_opdracht(opdracht)
        elif begin_app:
            self.open_opdracht([f"appstream://{begin_app}"])

    def tweede_start(self, args: list[str]) -> None:
        """De Winkel was al open en wordt opnieuw gestart, bijv. 'Uit de Winkel halen?' na een .exe (U222)."""
        if getattr(self, "sluit_na", False) and self.proces.state() != QProcess.ProcessState.NotRunning:
            # Weer geopend tijdens het installeren: de Winkel gaat daarna niet meer vanzelf dicht (U233).
            naam = next((app_naam(a) for a in self.cat["apps"] if a["id"] == self.bezig_met), self.bezig_met)
            self.melding.zet(self.bezig_tekst(naam), "bezig")
        self.open_opdracht(args)

    def open_opdracht(self, args: list[str]) -> None:
        """Wat de Winkel bij het openen moet laten zien: zoeken, een app, of uitleg waarom hij iets niet opent.
        Alles in de Winkel zelf; er start nooit een ander programma."""
        zoek, app_id, weiger = opdracht_uit(args)
        if weiger:
            self.naar_lijst()
            if zoek:
                self.zoek.setText(zoek)
            tekst_, soort = weiger_tekst(weiger)
            self.opdracht_melding.zet(tekst_, soort)
            self.lijst.setFocus()
        elif app_id:
            self.toon_app(app_id)
        elif zoek:
            self.naar_lijst()
            self.zoek.setText(zoek)
            self.lijst.setFocus()

    # ---------------------------------------------------------------- de pagina van één app
    def toon_app(self, app_id: str) -> None:
        """De pagina van een app. Een app uit de BugOS-selectie heeft geen pagina: dan de lijst met die app (U222)."""
        pick = next((a for a in self.cat["apps"] if a["id"].lower() == app_id.lower()), None)
        if pick is not None:
            self.naar_lijst()
            self.zoek.setText(app_naam(pick))
            self.lijst.setFocus()
            return
        pagina = AppPagina(self, "niet_gevonden", app_id)
        pagina.melding.zet(t("Deze app staat niet (meer) in Flathub, of de lijst met alle apps is nog niet opgehaald.",
                             "This app is not (or no longer) on Flathub, or the list of all apps has not been "
                             "fetched yet."), "info")
        zoek_knop = Knop(t("Zoek een andere app", "Search for another app"), "hoofd", "lijn:zoek")
        zoek_knop.clicked.connect(lambda _c=False, z=app_id.rsplit(".", 1)[-1]: self.zoek_vanaf_pagina(z))
        pagina.einde.addWidget(zoek_knop, 0, Qt.AlignmentFlag.AlignLeft)
        self.zet_pagina(pagina, app_id)

    def zet_pagina(self, pagina: AppPagina, app_id: str) -> None:
        if self.stapel.currentIndex() == 0:   # onthoud waar je in de lijst was
            self._terug_naar = (self.scroll.verticalScrollBar().value(), self.focusWidget())
        oud = self.pagina_scroll.takeWidget()
        if oud is not None:
            oud.deleteLater()
        self.pagina, self.pagina_id = pagina, app_id
        self.pagina_scroll.setWidget(pagina)
        self.pagina_scroll.verticalScrollBar().setValue(0)
        self.stapel.setCurrentIndex(1)
        pagina.terug.setFocus()

    def naar_lijst(self) -> None:
        """Zonder iets te onthouden terug naar de lijst (een nieuwe opdracht, een ander onderwerp)."""
        if self.stapel.currentIndex() != 0:
            self.stapel.setCurrentIndex(0)
        self.pagina_id = None

    def terug(self) -> None:
        """Terug naar de lijst, met dezelfde zoektekst, op dezelfde plek en met de focus op dezelfde knop."""
        if self.stapel.currentIndex() == 0:
            return
        self.naar_lijst()
        waarde, focus = self._terug_naar
        QTimer.singleShot(0, lambda: self.scroll.verticalScrollBar().setValue(waarde))
        try:
            if focus is not None and focus.isVisibleTo(self):
                focus.setFocus()
                return
        except RuntimeError:   # die kaart is er niet meer
            pass
        self.zoek.setFocus()

    def zoek_vanaf_pagina(self, zoek: str) -> None:
        self.naar_lijst()
        self.zoek.setText(zoek)
        self.zoek.setFocus()
        self.zoek.selectAll()

    def onderwerp_gekozen(self) -> None:
        """Een onderwerp in de zijbalk: altijd de lijst (ook als er een app-pagina open stond)."""
        self.naar_lijst()
        self.opdracht_melding.zet("")
        self.toon()

    # ------------------------------------------------------------------
    def toon(self) -> None:
        for k in self.kaarten:
            self.raster.removeWidget(k)
            k.deleteLater()
        self.kaarten = []
        zoek = self.zoek.text().strip()
        rij = self.lijst.currentRow()
        cat_id = self.lijst.sleutel(rij) if rij >= 0 else "aanbevolen"
        self.held.setVisible(not zoek and cat_id == "aanbevolen")
        if zoek:
            apps = [a for a in self.cat["apps"] if past(a, zoek)]
            self.kop.setText(t(f"Zoeken: {zoek}", f"Search: {zoek}"))
        elif cat_id == "_mijn":
            apps = [a for a in self.cat["apps"] if a["id"] in self.installed]
            self.kop.setText(t("Mijn apps", "My apps"))
        else:
            apps = [a for a in self.cat["apps"] if cat_id in a["cat"]]
            item = self.lijst.item(rij)
            self.kop.setText(item.text() if item else "")
        for i, app in enumerate(apps):
            kaart = AppKaart(app, self)
            self.kaarten.append(kaart)
            self.raster.addWidget(kaart, i // self.kolommen, i % self.kolommen)
        for k in range(3):
            self.raster.setColumnStretch(k, 1 if k < self.kolommen else 0)
        if not apps:
            self.melding.zet(t("Niets gevonden voor \"{}\". Probeer een ander woord, bijvoorbeeld wat de app doet: "
                               "\"foto's\", \"muziek\" of \"tekenen\".",
                               "Nothing found for \"{}\". Try another word, for example what the app does: "
                               "\"photos\", \"music\" or \"drawing\".").format(zoek), "info")
        elif self.bezig_met is not None and not getattr(self, "sluit_na", False):   # 'gaat vanzelf dicht' laten staan (U344)
            # Wordt er iets geïnstalleerd? Dan die melding terug (een zoekopdracht zonder uitkomst verving hem) (U333).
            naam = next((app_naam(a) for a in self.cat["apps"] if a["id"] == self.bezig_met), self.bezig_met)
            self.melding.zet(self.bezig_tekst(naam), "bezig")
        elif not self.melding.tekst.text().startswith("✅"):
            self.melding.zet("")

    def resizeEvent(self, e):  # noqa: N802
        super().resizeEvent(e)
        # Zo breed als een kaart echt is (met 'Verwijderen' en 'Openen', grote letters), niet een vaste 330 (U482).
        breed = max([330] + [k.minimumSizeHint().width() + 16 for k in self.kaarten[:3]])
        nieuw = max(1, min(3, (self.width() - ZIJBALK_BREEDTE - 72) // breed))
        if nieuw != self.kolommen:
            self.kolommen = nieuw
            if self.kaarten:
                self.toon()

    def closeEvent(self, e) -> None:  # noqa: N802
        # Nooit midden in het installeren stoppen (dan breekt flatpak af): wachten, en daarna vanzelf dicht.
        if self.proces.state() != QProcess.ProcessState.NotRunning:
            self.sluit_na = True
            naam = next((app_naam(a) for a in self.cat["apps"] if a["id"] == self.bezig_met), self.bezig_met)
            self.melding.zet(t(f"Even wachten: {naam} wordt nog verwijderd. Daarna gaat de Winkel vanzelf dicht.",
                               f"One moment: {naam} is still being removed. The Store closes by itself afterwards.")
                             if getattr(self, "klus", "") == "verwijder" else
                             t(f"Even wachten: {naam} wordt nog geïnstalleerd. Daarna gaat de Winkel vanzelf dicht.",
                               f"One moment: {naam} is still being installed. The Store closes by itself afterwards."),
                             "bezig")
            e.ignore()
            return
        super().closeEvent(e)

    def bezig_tekst(self, naam: str) -> str:
        """Wat er nu gebeurt: installeren of verwijderen (U472)."""
        if getattr(self, "klus", "") == "verwijder":
            return t(f"{naam} wordt verwijderd…", f"Removing {naam}…")
        return t(f"{naam} wordt geïnstalleerd…", f"Installing {naam}…")

    def vraag_verwijderen(self, app: dict) -> None:
        """Eerst vragen; je bestanden van de app (inloggen, instellingen) alleen weg als je dat aanvinkt (U464)."""
        vraag = QMessageBox(QMessageBox.Icon.Question, t("Verwijderen?", "Remove?"),
                            t(f"{app_naam(app)} van deze computer verwijderen?", f"Remove {app_naam(app)} from this computer?"),
                            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.Cancel, self)
        vraag.setDefaultButton(QMessageBox.StandardButton.Cancel)
        vraag.setCheckBox(QCheckBox(t("Ook de instellingen en bestanden van deze app weggooien",
                                      "Also delete this app's settings and files")))
        if vraag.exec() == QMessageBox.StandardButton.Yes:
            self.verwijder(app, vraag.checkBox().isChecked())

    def verwijder(self, app: dict, met_gegevens: bool) -> None:
        self.bezig_met = app["id"]
        self.klus = "verwijder"
        self.melding.zet(t(f"{app_naam(app)} wordt verwijderd…", f"Removing {app_naam(app)}…"), "bezig")
        for k in self.kaarten:
            k.ververs()
        omgeving = QProcessEnvironment.systemEnvironment()
        omgeving.insert("LC_ALL", "C.UTF-8")
        self.proces.setProcessEnvironment(omgeving)
        self.proces.start("flatpak", ["uninstall", "-y", app["id"]] + (["--delete-data"] if met_gegevens else []))

    def klaar_verwijderen(self, code: int, uit: str, app_id: str, naam: str) -> None:
        self.flatpaks = geinstalleerd() - ({app_id} if code == 0 else set())
        self.installed = self.flatpaks | set(self.systeem)
        # In 'Mijn apps': de lijst opnieuw, zonder de app die weg is (U472).
        rij = self.lijst.currentRow()
        if not self.zoek.text().strip() and rij >= 0 and self.lijst.sleutel(rij) == "_mijn":
            self.toon()
            self.zoek.setFocus()   # de kaart met de focus is weg: niet de focus kwijt (U482)
        if code == 0:
            self.melding.zet(t(f"✅ {naam} is verwijderd.", f"✅ {naam} has been removed."), "goed")
        elif any(w in uit.lower() for w in ("not authorized", "not allowed", "authentication", "authoriz")):
            self.melding.zet(t(f"{naam} verwijderen mag alleen met het wachtwoord van een beheerder.",
                               f"Removing {naam} needs an administrator's password."), "fout")
        else:
            self.melding.zet(t(f"{naam} verwijderen lukte niet. Probeer het nog eens.",
                               f"Removing {naam} did not work. Please try again."), "fout")
        for k in self.kaarten:
            k.ververs()

    def installeer(self, app: dict) -> None:
        self.klus = "installeer"
        self.bezig_met = app["id"]
        self.melding.zet(t(f"{app_naam(app)} wordt geïnstalleerd. Dit kan een paar minuten duren…",
                           f"Installing {app_naam(app)}. This can take a few minutes…"), "bezig")
        for k in self.kaarten:
            k.ververs()
        # Zonder --noninteractive: dan mag KDE om een wachtwoord vragen (een gezinslid dat geen beheerder is,
        # krijgt anders nooit de vraag en het installeren mislukt stil). -y beantwoordt de rest.
        omgeving = QProcessEnvironment.systemEnvironment()
        omgeving.insert("LC_ALL", "C.UTF-8")   # we lezen flatpaks fout (bijv. "Not authorized"): in het Engels
        self.proces.setProcessEnvironment(omgeving)
        self.proces.start("flatpak", ["install", "-y", "flathub", app["id"]])

    def mijn_apps_erbij(self) -> None:
        """'Mijn apps' in de zijbalk, één keer (ook na je eerste app, zonder de Winkel opnieuw te openen) (U081)."""
        if not any(self.lijst.item(i).data(Qt.ItemDataRole.UserRole) == "_mijn" for i in range(self.lijst.count())):
            self.lijst.voeg_toe("lijn:vink", t("Mijn apps", "My apps"), "_mijn")

    def klaar(self, code: int, _status) -> None:
        uit = bytes(self.proces.readAll()).decode(errors="ignore")
        app_id = self.bezig_met
        naam = next((app_naam(a) for a in self.cat["apps"] if a["id"] == app_id), app_id)
        self.bezig_met = None
        if getattr(self, "klus", "") == "verwijder":
            self.klus = ""
            self.klaar_verwijderen(code, uit, app_id, naam)
            if getattr(self, "sluit_na", False):
                if code == 0:
                    QTimer.singleShot(0, self.close)
                else:
                    self.sluit_na = False   # mislukt: open laten, zodat je de melding ziet (U472)
            return
        self.flatpaks = geinstalleerd() | ({app_id} if code == 0 else set())
        self.installed = self.flatpaks | set(self.systeem)
        if code == 0:
            self.mijn_apps_erbij()
            self.melding.zet(t(f"✅ {naam} is geïnstalleerd. Je vindt het in het startmenu.",
                               f"✅ {naam} is installed. You can find it in the start menu."), "goed")
        elif any(w in uit.lower() for w in ("not authorized", "not allowed", "authentication", "authoriz")):
            self.melding.zet(t(f"{naam} installeren mag alleen met het wachtwoord van een beheerder. "
                               "Vraag het aan wie de computer beheert.",
                               f"Installing {naam} needs an administrator's password. "
                               "Ask the person who looks after this computer."), "fout")
        elif any(w in uit.lower() for w in ("no space left on device", "not enough disk space", "not enough free space", "not enough space")):
            # Een volle computer is geen 'heb je internet?' (U411).
            self.melding.zet(t(f"{naam} installeren lukte niet: je computer is vol. Maak eerst ruimte (bijv. de "
                               "prullenbak leegmaken in Bestanden) en probeer het dan opnieuw.",
                               f"Installing {naam} failed: your computer is full. Make room first (for example empty "
                               "the trash in Files) and try again."), "fout")
        else:
            self.melding.zet(t(f"{naam} installeren lukte niet. Heb je internet? Probeer het nog eens.",
                               f"Installing {naam} failed. Are you online? Please try again."), "fout")
        for k in self.kaarten:
            k.ververs()
        if getattr(self, "sluit_na", False):
            if code == 0:
                QTimer.singleShot(0, self.close)   # je wilde al sluiten, en het is gelukt
            else:
                self.sluit_na = False   # mislukt: open laten, zodat je de melding ziet

    def meer_apps(self) -> None:
        """'Alle apps doorzoeken': het zoekveld van de Winkel zelf doorzoekt ook alle apps van Flathub."""
        self.naar_lijst()
        self.zoek.setFocus()
        self.zoek.selectAll()
        if not self.zoek.text().strip():
            self.opdracht_melding.zet(t("Typ hierboven wat je zoekt, bijvoorbeeld \"muziek\" of \"Zoom\".",
                                        "Type above what you are looking for, for example \"music\" or \"Zoom\"."),
                                      "info")


def begin_uit(args: list[str]) -> tuple[str, str]:
    """(zoektekst, app-id) uit de opdracht: '--zoek <tekst>' of 'appstream://<id>'."""
    if len(args) >= 2 and args[0] == "--zoek":
        return " ".join(args[1:]), ""
    if args and args[0].lower().startswith("appstream:"):
        # Ook 'appstream:id' zonder // (U330).
        return "", args[0][len("appstream:"):].lstrip("/").removesuffix(".desktop")
    return "", ""


def echte_id(catalogus: dict, app_id: str) -> str:
    """Het id zoals het in onze catalogus staat. Via KDE komt een link soms in kleine letters binnen
    ('org.videolan.vlc'): dan toch de goede app (U330)."""
    return next((a["id"] for a in catalogus["apps"] if a["id"].lower() == app_id.lower()), app_id)


def opdracht_uit(args: list[str]) -> tuple[str, str, str]:
    """(zoektekst, app-id, weigering) uit de opdracht. De weigering is een code voor weiger_tekst()."""
    zoek, app_id = begin_uit(args)
    if app_id and not APP_ID.match(app_id):
        return "", "", ""
    return zoek, app_id, ""


def weiger_tekst(code: str) -> tuple[str, str]:
    """Waarom de Winkel een link of bestand niet opent, in gewone woorden, met de soort melding."""
    return {
        "andere_bron": (t("Deze app komt uit een andere appwinkel dan Flathub. BugOS installeert alleen apps van "
                          "Flathub, omdat die gecontroleerd en bijgewerkt worden. Zoek de app hier in de Winkel.",
                          "This app comes from another app shop than Flathub. BugOS only installs apps from Flathub, "
                          "because those are checked and kept up to date. Look for the app here in the Store."),
                        "let_op"),
    }.get(code, (t("De Winkel kan dit niet openen.", "The Store cannot open this."), "let_op"))


def main() -> int:
    args = sys.argv[1:]
    catalogus = lees_catalogus()
    app = maak_app("bugos-store", "bugos-store", sys.argv, een_keer=True)   # (U208)
    return uitvoeren(app, Winkel(catalogus, opdracht=args))


if __name__ == "__main__":
    sys.exit(main())
