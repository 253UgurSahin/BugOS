#!/usr/bin/python3
"""BugOS Winkel - apps installeren met één klik.

Jip-en-Janneke: links kies je een onderwerp (Internet, Kantoor, Gamen...),
rechts zie je bekende, veilige apps. Druk op "Installeren" en klaar.
Staat wat je zoekt er niet bij? Typ de naam: de Winkel zoekt dan ook in alle andere apps van Flathub,
en laat elke app eerst op een eigen pagina zien (wie hem maakt, voor welke leeftijd, hoe groot).
Alles gebeurt in de Winkel zelf; er gaat geen ander programma open.

  bugos-store                       -> de winkel
  bugos-store appstream://<id>      -> meteen naar die app
  bugos-store --zoek <tekst>        -> meteen zoeken
  bugos-store <x>.flatpakref        -> de app van dat bestand (de knop 'Install' op flathub.org), alleen van Flathub
  bugos-store flatpak+https://...   -> idem, als link
  bugos-store <x>.flatpakrepo       -> uitleg: de Winkel voegt geen andere appwinkel toe
  bugos-store <x>.flatpak           -> uitleg: geen losse app-bestanden
"""

import json
import os
import re
import sys
import time
from pathlib import Path

sys.path.insert(0, "/usr/lib/bugos/python")

from bugos_ui import (  # noqa: E402
    TAAL, ZIJBALK_BREEDTE, Banner, Chip, IcoonChip, Kaart, Knop, Venster, Zoekveld, bestaat, draai, label,
    lijn_icoon, maak_app, raster, start, t, uitvoeren, zoeksleutel,
)
from bugos_settings_onderdelen import op_achtergrond  # noqa: E402
from bugos_ui import px  # noqa: E402
from PySide6.QtCore import QEvent, QProcess, QProcessEnvironment, QSize, Qt, QTimer  # noqa: E402
from PySide6.QtGui import QIcon, QKeySequence, QPixmap, QShortcut  # noqa: E402
from PySide6.QtWidgets import (  # noqa: E402
    QCheckBox, QDialog, QFrame, QHBoxLayout, QLabel, QScrollArea, QStackedWidget, QVBoxLayout, QWidget,
)
from bugos_shell import VraagDialoog  # noqa: E402

CATALOGUS = Path("/usr/share/bugos/store.json")
ICOON_MAPPEN = [
    Path("/var/lib/flatpak/appstream/flathub/x86_64/active/icons/128x128"),
    Path("/var/lib/flatpak/appstream/flathub/x86_64/active/icons/64x64"),
    Path.home() / ".local/share/flatpak/appstream/flathub/x86_64/active/icons/128x128",
    # Meegeleverd met BugOS (build.sh): ook op een vers systeem en zonder internet een echt pictogram.
    Path("/usr/share/bugos/store-icons"),
]
# Apps die BugOS als gewoon pakket heeft (niet als Flatpak): hun pictogram heet in het thema anders.
THEMA_NAMEN = {"org.mozilla.firefox": "firefox", "com.valvesoftware.Steam": "steam"}
if os.environ.get("BUGOS_APPICONEN"):
    ICOON_MAPPEN.insert(0, Path(os.environ["BUGOS_APPICONEN"]))
# Een geldig app-id (org.voorbeeld.App): alleen zo'n id gaat ooit naar flatpak. Nooit met '-' vooraan (geen optie).
APP_ID = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9_-]*(\.[A-Za-z0-9_-]+){2,}$")


def app_naam(app: dict) -> str:
    """De naam van een app in jouw taal (de meeste zijn merknamen; 'Rekenmachine' heet in het Engels 'Calculator') (U209)."""
    return app.get("naam_en", app["naam"]) if TAAL != "nl" else app["naam"]


def lees_catalogus(pad: Path = CATALOGUS) -> dict:
    return json.loads(pad.read_text(encoding="utf-8"))


def geinstalleerd() -> set[str]:
    if os.environ.get("BUGOS_GEINSTALLEERD") is not None:  # voor screenshots
        return set(filter(None, os.environ["BUGOS_GEINSTALLEERD"].split(",")))
    if not bestaat("flatpak"):
        return set()
    _, uit = draai("flatpak", "list", "--app", "--columns=application", timeout=20)
    return {regel.strip() for regel in uit.splitlines() if regel.strip()}


def flatpak_lijst() -> dict[str, dict]:
    """Elke geïnstalleerde Flatpak-app: id -> {'naam': naam, 'bron': waar hij vandaan kwam (meestal 'flathub')}.
    Zo kan 'Mijn apps' ook apps laten zien die niet uit de BugOS-selectie komen."""
    if os.environ.get("BUGOS_GEINSTALLEERD") is not None:   # voor screenshots: de naam is het laatste stuk van het id
        return {i: {"naam": i.rsplit(".", 1)[-1], "bron": "flathub"}
                for i in filter(None, os.environ["BUGOS_GEINSTALLEERD"].split(","))}
    if not bestaat("flatpak"):
        return {}
    _, uit = draai("flatpak", "list", "--app", "--columns=application,name,origin", timeout=20)
    lijst = {}
    for regel in uit.splitlines():
        delen = [d.strip() for d in regel.split("\t")]
        if delen and APP_ID.match(delen[0]):
            lijst[delen[0]] = {"naam": delen[1] if len(delen) > 1 and delen[1] else delen[0].rsplit(".", 1)[-1],
                               "bron": delen[2] if len(delen) > 2 else ""}
    return lijst


# Waar gewone programma's (geen Flatpak) hun .desktop-bestand hebben. Firefox en Steam zitten
# bijvoorbeeld al in BugOS zelf: die zijn er dus al, ook al staan ze niet in 'flatpak list'.
APP_MAPPEN = [Path("/usr/share/applications"), Path("/usr/local/share/applications"),
              Path.home() / ".local/share/applications"]
# Sommige programma's heten als systeemprogramma anders dan in Flathub.
SYSTEEM_NAMEN = {
    "org.mozilla.firefox": ("org.mozilla.firefox", "firefox"),
    "com.valvesoftware.Steam": ("steam",),
}


def systeem_apps(apps: list[dict]) -> dict[str, Path]:
    """Apps uit de winkel die er al als gewoon programma op staan: app-id -> hun .desktop-bestand."""
    if os.environ.get("BUGOS_GEINSTALLEERD") is not None:  # voor screenshots: alleen dat lijstje
        return {}
    gevonden = {}
    for app in apps:
        for naam in SYSTEEM_NAMEN.get(app["id"], (app["id"],)):
            bestand = next((m / f"{naam}.desktop" for m in APP_MAPPEN if (m / f"{naam}.desktop").is_file()), None)
            if bestand:
                gevonden[app["id"]] = bestand
                break
    return gevonden


def icoon_voor(app_id: str) -> QIcon:
    for map_ in ICOON_MAPPEN:
        for ext in (".png", ".svg"):
            bestand = map_ / f"{app_id}{ext}"
            if bestand.is_file():
                return QIcon(str(bestand)) if ext == ".svg" else QIcon(QPixmap(str(bestand)))
    if QIcon.hasThemeIcon(app_id):
        return QIcon.fromTheme(app_id)
    return QIcon.fromTheme(THEMA_NAMEN.get(app_id, app_id), QIcon.fromTheme("application-x-executable"))


def tekst(app: dict) -> str:
    return app.get("nl" if TAAL == "nl" else "en", app.get("en", ""))


def past(app: dict, zoek: str) -> bool:
    hooi = zoeksleutel(f"{app['naam']} {app.get('naam_en', '')} {app.get('nl', '')} {app.get('en', '')} {app['id']}")
    return all(w in hooi for w in zoeksleutel(zoek).split())   # (U268)


def systeem_ids() -> dict[str, Path]:
    """Elk programma dat in BugOS zelf zit (een .desktop-bestand, geen Flatpak): id in kleine letters -> bestand.
    Die biedt de Winkel nooit nog eens aan van Flathub (Dolphin, Kate, Konsole...): dan kwam er een tweede KDE-
    programma in het startmenu, ook een dat BugOS met opzet verbergt."""
    gevonden: dict[str, Path] = {}
    for map_ in reversed(APP_MAPPEN):   # de eerste map wint, net als bij systeem_apps()
        try:
            for bestand in map_.glob("*.desktop"):
                gevonden[bestand.stem.lower()] = bestand
        except OSError:
            continue
    for app_id, namen in SYSTEEM_NAMEN.items():
        for naam in namen:
            if naam.lower() in gevonden:
                gevonden.setdefault(app_id.lower(), gevonden[naam.lower()])
                break
    return gevonden


def desktop_info(bestand: Path) -> tuple[str, str, bool]:
    """(naam in jouw taal, pictogram, verborgen) uit een .desktop-bestand. Verborgen = NoDisplay of Hidden."""
    namen: dict[str, str] = {}
    icoon_ = ""
    verborgen = False
    hoofd = False
    try:
        regels = bestand.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        regels = []
    for regel in regels:
        regel = regel.strip()
        if regel.startswith("["):
            hoofd = regel == "[Desktop Entry]"
            continue
        if not hoofd or "=" not in regel:
            continue
        sleutel, waarde = (x.strip() for x in regel.split("=", 1))
        if sleutel in ("Name", "Name[nl]"):
            namen[sleutel] = waarde
        elif sleutel == "Icon":
            icoon_ = waarde
        elif sleutel in ("NoDisplay", "Hidden") and waarde.lower() == "true":
            verborgen = True
    naam = (namen.get("Name[nl]") if TAAL == "nl" else None) or namen.get("Name") or bestand.stem
    return naam, icoon_, verborgen


# ============================================================ alle apps van Flathub ===
# Flathub's lijst van alle apps (appstream), zoals Flatpak hem op de computer bewaart (voor iedereen dezelfde).
# De Winkel maakt er één keer een kleine index van (in je eigen cache) en zoekt daarin: snel, ook zonder internet,
# en niemand buiten je computer ziet wat je typt. Te vervangen in tests.
APPSTREAM = Path(os.environ.get("BUGOS_APPSTREAM", "/var/lib/flatpak/appstream/flathub/x86_64"))
INDEX_MAP = Path(os.environ.get("XDG_CACHE_HOME") or str(Path.home() / ".cache")) / "bugos"
INDEX_VERSIE = 1
VOORBEELD = os.environ.get("BUGOS_INSTELLINGEN_VOORBEELD") == "1" or os.environ.get("BUGOS_WINKEL_VOORBEELD") == "1"
XL = "{http://www.w3.org/XML/1998/namespace}lang"
# Geen app met een venster: zo'n id (bijv. uit KRunner of een .rpm) krijgt uitleg, geen 'niet op Flathub'.
GEEN_APP = {"runtime": "onderdeel", "generic": "onderdeel", "localization": "onderdeel",
            "console-application": "terminal"}


def index_leeg() -> dict:
    return {"apps": [], "hoort_bij": {}, "geen_app": {}}


def index_bron(bron: Path = APPSTREAM) -> tuple[str, Path | None]:
    """(sleutel, map) van de lijst die nu geldt. 'active' wijst naar een map met een controlegetal als naam; die
    map lezen we, en geen andere (Flatpak kan 'active' intussen naar een nieuwe map zetten)."""
    try:
        doel = (bron / "active").resolve(strict=True)
    except (OSError, RuntimeError):
        return "", None
    if re.fullmatch(r"[0-9a-f]{16,64}", doel.name):
        return doel.name, doel
    for naam in ("appstream.xml", "appstream.xml.gz"):   # alleen voor tests: een gewone map
        try:
            st = (doel / naam).stat()
        except OSError:
            continue
        return f"{int(st.st_mtime)}-{st.st_size}", doel
    return "", None


def index_sleutel(bron: Path = APPSTREAM) -> str:
    return index_bron(bron)[0]


def _plat(tekst: str | None) -> str:
    return " ".join((tekst or "").split())


def _taal_van(el) -> str:
    return el.get(XL) or ""


def _uitleg(component, taal: str) -> str:
    """De beschrijving in één taal ('' = de gewone). Niet zomaar de eerste: bij GIMP is dat het Wit-Russisch."""
    gekozen = next((d for d in component.findall("description") if _taal_van(d) == taal), None)
    if gekozen is None:
        return ""
    regels = []
    for kind in gekozen:
        if _taal_van(kind) not in ("", taal):
            continue
        if kind.tag == "p":
            tekst_ = _plat("".join(kind.itertext()))
            if tekst_:
                regels.append(tekst_)
        elif kind.tag in ("ul", "ol"):
            for li in kind.findall("li"):
                if _taal_van(li) in ("", taal):
                    tekst_ = _plat("".join(li.itertext()))
                    if tekst_:
                        regels.append("• " + tekst_)
    uit = "\n".join(regels)
    if len(uit) > 700:
        uit = uit[:700].rsplit(" ", 1)[0].rstrip(" ,.;:") + "…"
    return uit


def _zonder_taal(component, pad: str) -> str:
    return next((_plat(e.text) for e in component.findall(pad) if not _taal_van(e)), "")


def _met_taal(component, pad: str, taal: str) -> str:
    return next((_plat(e.text) for e in component.findall(pad) if _taal_van(e) == taal), "")


def _id_van(component) -> str:
    bundel = next((b.text for b in component.findall("bundle") if b.get("type") == "flatpak" and b.text), "")
    delen = bundel.strip().split("/")
    if len(delen) >= 2 and delen[1]:
        return delen[1]
    return (component.findtext("id") or "").strip().removesuffix(".desktop")


def lees_appstream(map_: Path, extra: dict | None = None) -> list[dict]:
    """Alle apps (met een venster) uit Flathub's appstream.xml (of .xml.gz) in map_. Stukje voor stukje gelezen
    (iterparse + clear), nooit het hele bestand van 50 MB in het geheugen.
    extra: krijgt 'hoort_bij' (uitbreiding -> de app die hij uitbreidt) en 'geen_app' (id -> [naam, soort])."""
    import gzip
    import xml.etree.ElementTree as ET
    hoort_bij: dict[str, str] = {}
    geen_app: dict[str, list[str]] = {}
    apps: list[dict] = []
    gezien: set[str] = set()
    pad = map_ / "appstream.xml"
    bestand = open(pad, "rb") if pad.is_file() else gzip.open(map_ / "appstream.xml.gz", "rb")  # noqa: SIM115
    with bestand:
        for _gebeurtenis, el in ET.iterparse(bestand, events=("end",)):
            if el.tag != "component":
                continue
            soort = el.get("type") or ""
            app_id = _id_van(el)
            if not APP_ID.match(app_id):
                el.clear()
                continue
            if soort == "addon":
                ouder = (el.findtext("extends") or "").strip().removesuffix(".desktop")
                if APP_ID.match(ouder):
                    hoort_bij.setdefault(app_id, ouder)
            elif soort in GEEN_APP:
                geen_app.setdefault(app_id, [_zonder_taal(el, "name") or app_id, GEEN_APP[soort]])
            elif soort in ("desktop-application", "desktop") and app_id.lower() not in gezien:
                gezien.add(app_id.lower())
                custom = {v.get("key"): (v.text or "") for v in el.findall("custom/value")}
                beoordeling = el.find("content_rating")
                woorden = [_plat(k.text) for ks in el.findall("keywords") if _taal_van(ks) in ("", "nl")
                           for k in ks.findall("keyword") if _taal_van(k) in ("", "nl") and k.text]
                iconen = [i for i in el.findall("icon") if i.get("type") == "cached" and i.text]
                icoon_ = next((i for i in iconen if i.get("height") == "128"), iconen[0] if iconen else None)
                site = next((_plat(u.text) for u in el.findall("url") if u.get("type") == "homepage"), "")
                apps.append({
                    "id": app_id,
                    "naam": _zonder_taal(el, "name"), "naam_nl": _met_taal(el, "name", "nl"),
                    "kort": _zonder_taal(el, "summary"), "kort_nl": _met_taal(el, "summary", "nl"),
                    "uitleg": _uitleg(el, ""), "uitleg_nl": _uitleg(el, "nl"),
                    # Alleen de naam zonder taal: bij GIMP is de laatste vertaalde naam Cyrillisch.
                    "maker": _zonder_taal(el, "developer/name") or _zonder_taal(el, "developer_name"),
                    "icoon": _plat(icoon_.text) if icoon_ is not None else "",
                    "echt": custom.get("flathub::verification::verified") == "true",
                    "echt_site": _plat(custom.get("flathub::verification::website")),
                    "oars": None if beoordeling is None else
                    {a.get("id"): _plat(a.text) for a in beoordeling.findall("content_attribute") if a.get("id")},
                    "woorden": " ".join(woorden),
                    "site": site if site.startswith(("https://", "http://")) else "",
                })
            el.clear()
    if extra is not None:
        extra["hoort_bij"], extra["geen_app"] = hoort_bij, geen_app
    return apps


def _lees_cache(bestand: Path) -> dict | None:
    try:
        data = json.loads(bestand.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    if not isinstance(data, dict) or data.get("versie") != INDEX_VERSIE or not isinstance(data.get("apps"), list):
        return None
    return {"apps": data["apps"], "hoort_bij": data.get("hoort_bij") or {}, "geen_app": data.get("geen_app") or {}}


def flathub_index(bron: Path = APPSTREAM, cache: Path = INDEX_MAP, apart: bool = False) -> dict:
    """De index van alle Flathub-apps: {'apps': [...], 'hoort_bij': {...}, 'geen_app': {...}}.
    Uit de cache als Flathub's lijst niet veranderd is (0,1 s), anders opnieuw gemaakt (2 s).
    apart=True: maak hem in een eigen proces, zodat het venster ondertussen vlot blijft reageren."""
    sleutel, map_ = index_bron(bron)
    if not sleutel or map_ is None:
        return index_leeg()
    bestand = cache / f"store-flathub-{sleutel}.json"
    oud = _lees_cache(bestand)
    if oud is not None:
        return oud
    if apart and maak_index_apart(bron, cache):
        oud = _lees_cache(bestand)
        if oud is not None:
            return oud
    try:
        extra: dict = {}
        apps = lees_appstream(map_, extra)
    except Exception:  # noqa: BLE001  kapotte of halve lijst (ParseError, OSError, EOFError): dan geen index
        return index_leeg()
    data = {"versie": INDEX_VERSIE, "bron": sleutel, "apps": apps, **extra}
    try:
        cache.mkdir(parents=True, exist_ok=True)
        tijdelijk = cache / f".store-flathub-{sleutel}.{os.getpid()}.tmp"
        tijdelijk.write_text(json.dumps(data, ensure_ascii=False), encoding="utf-8")
        os.replace(tijdelijk, bestand)
        for ander in cache.glob("store-flathub-*.json"):
            if ander != bestand:
                ander.unlink(missing_ok=True)
    except OSError:   # volle schijf, alleen-lezen thuismap: dan zonder cache
        pass
    return {"apps": apps, "hoort_bij": extra.get("hoort_bij", {}), "geen_app": extra.get("geen_app", {})}


def maak_index_apart(bron: Path, cache: Path) -> bool:
    """Maak de index in een eigen Python-proces (dat schrijft de cache). Python kan maar één ding tegelijk: zo
    hapert het typen niet terwijl de grote lijst gelezen wordt."""
    import subprocess
    import bugos_ui
    code = ("import sys, importlib.machinery as m, importlib.util as u\n"
            "sys.path.insert(0, sys.argv[2])\n"
            "l = m.SourceFileLoader('bugos_winkel_index', sys.argv[1])\n"
            "w = u.module_from_spec(u.spec_from_loader(l.name, l))\n"
            "l.exec_module(w)\n"
            "sys.exit(0 if w.flathub_index(w.Path(sys.argv[3]), w.Path(sys.argv[4]))['apps'] else 1)\n")
    try:
        r = subprocess.run([sys.executable, "-I", "-c", code, str(Path(__file__).resolve()),
                            str(Path(bugos_ui.__file__).resolve().parent), str(bron), str(cache)],
                           stdin=subprocess.DEVNULL, capture_output=True, timeout=120)
    except (OSError, subprocess.SubprocessError):
        return False
    return r.returncode == 0


def naam_in_taal(e: dict) -> str:
    return (e.get("naam_nl") if TAAL == "nl" else "") or e.get("naam") or e["id"].rsplit(".", 1)[-1]


def kort_in_taal(e: dict) -> str:
    return (e.get("kort_nl") if TAAL == "nl" else "") or e.get("kort") or ""


def hooi_van(apps: list[dict]) -> list[str]:
    """Waarin gezocht wordt, per app (één keer per index: 36 ms voor 3300 apps)."""
    return [zoeksleutel(" ".join((e.get("naam", ""), e.get("naam_nl", ""), e.get("kort", ""), e.get("kort_nl", ""),
                                  e.get("woorden", ""), e["id"]))) for e in apps]


def zoek_flathub(apps: list[dict], zoek: str, uitsluiten: set[str], hooi: list[str] | None = None) -> list[dict]:
    """De apps die bij de zoektekst passen (elk woord moet erin staan, zoals past(), U268), beste eerst."""
    woorden = zoeksleutel(zoek).split()
    if len("".join(woorden)) < 2:
        return []
    hooi = hooi if hooi is not None and len(hooi) == len(apps) else hooi_van(apps)
    heel = " ".join(woorden)
    uit = []
    for e, h in zip(apps, hooi):
        if e["id"].lower() in uitsluiten or not all(w in h for w in woorden):
            continue
        naam = zoeksleutel(naam_in_taal(e))
        if naam == heel:
            score = 100
        elif naam.startswith(heel):
            score = 80
        elif any(d.startswith(woorden[0]) for d in naam.split()):
            score = 60
        elif heel in naam:
            score = 50
        else:
            score = 20
        uit.append((-(score + (5 if e.get("echt") else 0)), naam, e))
    uit.sort(key=lambda x: (x[0], x[1]))
    return [e for _s, _n, e in uit]


# ---- voor welke leeftijd (OARS, zoals libappstream 1.1 het rekent: geen, mild, matig, heftig) ----
OARS_LEEFTIJD = {
    "violence-cartoon": (0, 3, 4, 6), "violence-fantasy": (0, 3, 7, 8), "violence-realistic": (0, 4, 9, 14),
    "violence-bloodshed": (0, 9, 11, 18), "violence-sexual": (0, 18, 18, 18), "violence-desecration": (0, 13, 15, 18),
    "violence-slavery": (0, 13, 15, 18), "violence-worship": (0, 13, 15, 18), "drugs-alcohol": (0, 11, 13, 16),
    "drugs-narcotics": (0, 12, 14, 17), "drugs-tobacco": (0, 10, 13, 13), "sex-nudity": (0, 12, 14, 14),
    "sex-themes": (0, 13, 14, 15), "sex-homosexuality": (0, 13, 14, 15), "sex-prostitution": (0, 12, 14, 18),
    "sex-adultery": (0, 8, 10, 18), "sex-appearance": (0, 10, 10, 15), "language-profanity": (0, 8, 11, 14),
    "language-humor": (0, 3, 8, 14), "language-discrimination": (0, 9, 10, 11), "money-advertising": (0, 7, 8, 10),
    "money-gambling": (0, 7, 10, 18), "money-purchasing": (0, 12, 14, 15), "social-chat": (0, 4, 10, 13),
    "social-audio": (0, 15, 15, 15), "social-contacts": (0, 12, 12, 12), "social-info": (0, 0, 13, 13),
    "social-location": (0, 13, 13, 13),
}
STAND = {"none": 0, "mild": 1, "moderate": 2, "intense": 3}


def _leeftijden(oars: dict) -> list[tuple[str, int]]:
    uit = []
    for sleutel, waarde in (oars or {}).items():
        rij, stand = OARS_LEEFTIJD.get(str(sleutel)), STAND.get(str(waarde))
        if rij is not None and stand is not None:
            uit.append((str(sleutel), rij[stand]))
    return uit


def leeftijd(oars: dict | None) -> int | None:
    """Vanaf welke leeftijd: None = niet opgegeven, 0 = voor iedereen."""
    if oars is None:
        return None
    return max((n for _s, n in _leeftijden(oars)), default=0)


def leeftijd_redenen(oars: dict | None) -> list[str]:
    """Waarom die leeftijd, in gewone woorden (de groepen die de hoogste leeftijd geven)."""
    hoogste = leeftijd(oars)
    if not hoogste:
        return []
    groepen = {s.split("-", 1)[0] for s, n in _leeftijden(oars or {}) if n == hoogste}
    woorden = [("violence", t("geweld", "violence")), ("drugs", t("alcohol, drugs of roken", "alcohol, drugs or smoking")),
               ("sex", t("seks", "sex")), ("language", t("grove taal", "rude language")),
               ("money", t("geld uitgeven of gokken", "spending money or gambling")),
               ("social", t("contact met anderen online", "contact with others online"))]
    return [w for g, w in woorden if g in groepen]


# ---- hoe groot (flatpak remote-ls --cached: werkt zonder internet) ----
def grootte_bytes(tekst_: str) -> int | None:
    """'309.7 MB' (met een harde spatie, zo schrijft flatpak het) -> 309700000. GLib rekent met 1000, niet 1024."""
    m = re.fullmatch(r"([0-9]+(?:\.[0-9]+)?)\s*(bytes|kB|MB|GB)", (tekst_ or "").replace(" ", " ").strip())
    if not m:
        return None
    return int(round(float(m.group(1)) * {"bytes": 1, "kB": 1000, "MB": 1000**2, "GB": 1000**3}[m.group(2)]))


def lees_groottes(uit: str) -> dict[str, tuple[int | None, int | None, str]]:
    """ref -> (download, geïnstalleerd, runtime), uit 'remote-ls --columns=ref,download-size,installed-size,runtime'."""
    groottes = {}
    for regel in uit.splitlines():
        delen = regel.split("\t")
        if len(delen) < 3 or not delen[0].startswith(("app/", "runtime/")):
            continue
        groottes[delen[0].strip()] = (grootte_bytes(delen[1]), grootte_bytes(delen[2]),
                                      delen[3].strip() if len(delen) > 3 else "")
    return groottes


def grootte_tekst(n: int) -> str:
    if n >= 1000**3:
        uit = f"{n / 1e9:.1f} GB"
        return uit.replace(".", ",") if TAAL == "nl" else uit   # 1,2 GB, zoals Back-up (U237)
    return f"{max(1, round(n / 1e6))} MB"


def _draai_c(*cmd: str, timeout: int = 20) -> tuple[int, str]:
    """Zoals draai(), maar met Engelse uitvoer en punten (zo leest de Winkel flatpak)."""
    import subprocess
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL,
                           env={**os.environ, "LC_ALL": "C"})
        return r.returncode, r.stdout or ""
    except (OSError, subprocess.SubprocessError):
        return 127, ""


def alle_groottes() -> tuple[dict, set[str]]:
    """De groottes van alles op Flathub, en welke gedeelde onderdelen (runtimes) er al zijn.

    Eerst uit de cache van flatpak (--cached: geen internet, ongeveer 2 s). Die cache is per gebruiker: haalde
    alleen de computer zelf Flathub's samenvatting op (de dagelijkse update draait als root), dan heb jij hem nog
    niet en zegt flatpak 'No cached summary' (nagegaan op Kinoite 44). Zonder iets erbij zou de grootte dan bijna
    nooit verschijnen. Dus dan één keer zonder --cached: flatpak haalt de samenvatting van dl.flathub.org (ongeveer
    1,7 MB, 3 s) en bewaart hem in ~/.cache/flatpak, zodat het daarna ook zonder internet werkt. Niet op een
    verbinding die per MB kost, net als het verversen van de lijst. Zonder internet faalt dat meteen (flatpak:
    'Could not resolve hostname'): dan geen grootte, en geen melding. De 30 s is de grens voor een trage of
    haperende verbinding; dit draait altijd in een werkdraad, het venster wacht er nooit op."""
    kolommen = "--columns=ref,download-size,installed-size,runtime"
    code, uit = _draai_c("flatpak", "remote-ls", "--cached", kolommen, "flathub")
    if code != 0 and not gemeten():
        code, uit = _draai_c("flatpak", "remote-ls", kolommen, "flathub", timeout=30)
    groottes = lees_groottes(uit) if code == 0 else {}
    code, uit = _draai_c("flatpak", "list", "--runtime", "--columns=ref")
    runtimes = {r.strip() for r in uit.splitlines() if r.strip()} if code == 0 else set()
    return groottes, runtimes


# ---- de lijst van Flathub vers houden (ook bij 'Ik kies zelf wanneer') ----
DAG = 24 * 3600


def lijst_oud(bron: Path = APPSTREAM, nu: float | None = None) -> bool:
    """True als Flathub's lijst er niet is, of al meer dan een dag niet ververst."""
    nu = time.time() if nu is None else nu
    actief = bron / "active"
    if not ((actief / "appstream.xml").is_file() or (actief / "appstream.xml.gz").is_file()):
        return True
    try:
        return nu - (bron / ".timestamp").stat().st_mtime > DAG
    except OSError:
        return True


def gemeten() -> bool:
    """Een verbinding die per MB kost (telefoon-hotspot)? Zelfde regel als bugos-update-apps.service: 1 of 3 (U089).
    Weet NetworkManager het niet, dan niet gemeten."""
    code, uit = draai("busctl", "get-property", "org.freedesktop.NetworkManager", "/org/freedesktop/NetworkManager",
                      "org.freedesktop.NetworkManager", "Metered", timeout=5)
    # (draai() geeft ook wat op stderr komt, bijv. een waarschuwing van de shell: kijk alleen naar de regel 'u N')
    return code == 0 and any(r.split() in (["u", "1"], ["u", "3"]) for r in uit.splitlines())


def sessie_actief() -> bool:
    """Zit je nu echt achter deze computer (de actieve sessie)? Alleen dan mag Flatpak zonder wachtwoord de lijst
    verversen; anders zou er een wachtwoordvraag kunnen komen. Bij twijfel: nee."""
    code, uit = draai("busctl", "get-property", "org.freedesktop.login1", "/org/freedesktop/login1/session/auto",
                      "org.freedesktop.login1.Session", "Active", timeout=5)
    return code == 0 and any(r.split() == ["b", "true"] for r in uit.splitlines())


def automatisch_verversen() -> bool:
    """Mag de Winkel zelf de lijst verversen? Niet in de voorbeeldstand, niet voor foto's of tests, niet zonder flatpak."""
    if VOORBEELD or os.environ.get("BUGOS_GEINSTALLEERD") is not None or os.environ.get("BUGOS_WINKEL_GEEN_VERVERS"):
        return False
    return bestaat("flatpak")


def moet_verversen(bron: Path | None = None) -> bool:
    """Oud, en je zit achter de computer, en de verbinding kost niets per MB (in een werkdraad: busctl kan even duren)."""
    return lijst_oud(bron or APPSTREAM) and sessie_actief() and not gemeten()


def entry_naar_app(e: dict) -> dict:
    """Een Flathub-app als 'app' zoals de Winkel die kent (naam, uitleg), zodat installeren en verwijderen
    hetzelfde werken als voor de BugOS-selectie."""
    return {"id": e["id"], "naam": e.get("naam_nl") or e.get("naam") or e["id"], "naam_en": e.get("naam") or e["id"],
            "nl": e.get("kort_nl") or e.get("kort", ""), "en": e.get("kort", ""), "flathub": True}


def flathub_icoon(e: dict, maat: int) -> QPixmap:
    """Het pictogram uit Flathub's lijst (al op de computer), anders het gewone; leeg als er geen is."""
    if e.get("icoon") and "/" not in e["icoon"]:
        for sub in ("128x128", "64x64"):
            bestand = APPSTREAM / "active" / "icons" / sub / e["icoon"]
            if bestand.is_file():
                pm = QPixmap(str(bestand))
                if not pm.isNull():
                    return pm.scaled(maat, maat, Qt.AspectRatioMode.KeepAspectRatio,
                                     Qt.TransformationMode.SmoothTransformation)
    for map_ in ICOON_MAPPEN:
        for ext in (".png", ".svg"):
            bestand = map_ / f"{e['id']}{ext}"
            if bestand.is_file():
                return QIcon(str(bestand)).pixmap(QSize(maat, maat))
    if QIcon.hasThemeIcon(e["id"]):
        return QIcon.fromTheme(e["id"]).pixmap(QSize(maat, maat))
    return QPixmap()


def plaatje_voor(e: dict, maat: int) -> QWidget:
    """Een QLabel met het pictogram, of een rustig tegeltje als er geen pictogram is (geen leeg vierkant)."""
    pm = flathub_icoon(e, maat)
    if pm.isNull():
        return IcoonChip("lijn:apps", "neutraal", maat=maat, vol=False)
    w = QLabel()
    w.setPixmap(pm)
    w.setFixedSize(maat + 4, maat + 4)
    return w


