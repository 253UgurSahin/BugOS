#!/usr/bin/bash
# bugos-theme - licht of donker voor het hele systeem, op één plek.
#
#   bugos-theme licht|donker   kleuren, KDE-programma's (Kvantum) en de Plasma-stijl omzetten
#   bugos-theme status         print licht of donker
#   bugos-theme inloggen       (bij elk inloggen) de BugOS-laag voor GTK- en Flatpak-apps en de
#                              Terminal bijwerken, en de eerste keer ook "eerste-keer"
#   bugos-theme eerste-keer    (één keer) de BugOS-ontwerptaal aanzetten voor wie nog de oude
#                              instellingen had (Breeze-stijl en -pictogrammen)
#
# Jip-en-Janneke: BugOS heeft één ontwerptaal. De eigen apps (Instellingen,
# Bestanden...) tekenen zichzelf; al het andere krijgt dezelfde stijl van:
#   - het kleurenschema BugOSLight / BugOSDark (kleuren van alles)
#   - de programmastijl Kvantum "BugOS" / "BugOSDark" (knoppen, velden, lijsten in KDE-programma's)
#   - de Plasma-stijl "bugos" (taakbalk, pop-ups) en het pictogramthema "BugOS" (volgen licht/donker vanzelf)
#   - GTK-programma's (Firefox, GNOME-apps): Breeze-GTK met de kleuren van KDE, plus de
#     BugOS-laag bugos.css (alleen vormen en het rood) uit /usr/share/bugos/gtk
#   - Flatpak-apps: dezelfde bestanden, alleen lezen (en bugos-flatpak-style zet de stijl erbij)
#   - de Terminal: het profiel "BugOS" of "BugOSDark"
# Wat iemand zelf anders koos, laten we staan.
# Snelmenu, BugOS Welkom en Instellingen gebruiken allemaal dit script.

# shellcheck source=system_files/usr/share/bugos/lib.sh
. /usr/share/bugos/lib.sh

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
KVANTUM="$CONFIG/Kvantum/kvantum.kvconfig"

kvantum_zet() {
    mkdir -p "$CONFIG/Kvantum"
    kwriteconfig6 --file "$KVANTUM" --group General --key theme "$1"
}

huidig() {
    local schema achter r g b
    schema="$(kreadconfig6 --file kdeglobals --group General --key ColorScheme 2>/dev/null)"
    case "$schema" in
    BugOSDark) echo donker; return ;;
    BugOSLight | "") echo licht; return ;;
    esac
    # Een ander kleurenschema (bijv. Breeze Dark in de KDE-instellingen): donker als de vensters donker zijn (U325).
    achter="$(kreadconfig6 --file kdeglobals --group Colors:Window --key BackgroundNormal 2>/dev/null)"
    IFS=, read -r r g b _ <<<"$achter"   # ook met een doorzichtigheid erachter (r,g,b,a) (U331)
    if [[ "$r$g$b" =~ ^[0-9]+$ ]] && [ $((r * 299 + g * 587 + b * 114)) -lt 128000 ]; then
        echo donker
    else
        echo licht
    fi
}

# Van vóór de Engelse namen (U302): BugOSDonker/BugOSLicht heten nu BugOSDark/BugOSLight. Zonder dit vielen
# KDE-programma's terug op een vreemde stijl en zei Instellingen 'licht' terwijl je donker had gekozen.
oude_namen() {
    local schema
    schema="$(kreadconfig6 --file kdeglobals --group General --key ColorScheme 2>/dev/null)"
    case "$schema" in
    BugOSDonker) plasma-apply-colorscheme BugOSDark >/dev/null 2>&1 ||
        kwriteconfig6 --file kdeglobals --group General --key ColorScheme --notify BugOSDark ;;
    BugOSLicht) plasma-apply-colorscheme BugOSLight >/dev/null 2>&1 ||
        kwriteconfig6 --file kdeglobals --group General --key ColorScheme --notify BugOSLight ;;
    esac
    if [ -f "$KVANTUM" ] && [ "$(kreadconfig6 --file "$KVANTUM" --group General --key theme 2>/dev/null)" = BugOSDonker ]; then
        kvantum_zet BugOSDark
    fi
    # Het oude game-modusbestand (MANGOHUD=1): anders bleef de FPS-teller voor altijd aan.
    rm -f "$CONFIG/environment.d/90-bugos-spelmodus.conf"
}

# Een eigen KDE-accentkleur maakt de zachte BugOS-selectie fel (oude BugOS zette die). Alleen bij de eerste keer:
# een accentkleur die je daarna zelf in KDE kiest, blijft staan, ook als je licht/donker omzet (U373).
geen_accent() {
    kwriteconfig6 --file kdeglobals --group General --key AccentColor --delete 2>/dev/null
    kwriteconfig6 --file kdeglobals --group General --key LastUsedCustomAccentColor --delete 2>/dev/null
}

# GTK: de BugOS-laag (vormen en het rood) bovenop Breeze-GTK. KDE schrijft zelf de
# kleuren (colors.css) en laat de rest van gtk.css staan. Haalt iemand onze regel
# weg, dan zetten we hem niet terug (dat onthoudt het merkje gtk-<versie>).
gtk_laag() {
    local v bron map css regel="@import 'bugos.css';"
    for v in 3.0 4.0; do
        bron="/usr/share/bugos/gtk/gtk-$v.css"
        [ -f "$bron" ] || continue
        map="$CONFIG/gtk-$v"
        css="$map/gtk.css"
        mkdir -p "$map"
        cmp -s "$bron" "$map/bugos.css" || cp -f "$bron" "$map/bugos.css"
        if ! grep -qxF "$regel" "$css" 2>/dev/null && [ ! -f "$BUGOS_CONFIG/gtk-$v" ]; then
            # Vooraan: @import moet in CSS boven de rest staan.
            # Alleen vervangen als het nieuwe bestand er helemaal is: bij een volle schijf bleef er anders een leeg
            # gtk.css over, en waren je eigen regels weg (U372).
            if { echo "$regel" && { [ ! -f "$css" ] || cat "$css"; }; } >"$css.bugos" 2>/dev/null &&
                [ "$(wc -c <"$css.bugos")" -gt "$(wc -c <"$css" 2>/dev/null || echo 0)" ]; then
                mv -f "$css.bugos" "$css"
            else
                rm -f "$css.bugos"
            fi
        fi
        # Merkje alleen als de regel er echt in staat (lukte schrijven niet, dan de volgende keer opnieuw).
        if grep -qxF "$regel" "$css" 2>/dev/null; then
            mkdir -p "$BUGOS_CONFIG" && touch "$BUGOS_CONFIG/gtk-$v"
        fi
    done
}

# Flatpak-apps zien /usr/share niet: zet de Kvantum-stijl ook in ~/.config/Kvantum
# (Kvantum kijkt daar eerst) en geef apps leestoegang tot de stijlbestanden.
flatpak_toegang() {
    local t
    for t in BugOS BugOSDark; do
        [ -d "/usr/share/Kvantum/$t" ] || continue
        if ! diff -rq "/usr/share/Kvantum/$t" "$CONFIG/Kvantum/$t" >/dev/null 2>&1; then
            mkdir -p "$CONFIG/Kvantum" && rm -rf "$CONFIG/Kvantum/$t" &&
                cp -r "/usr/share/Kvantum/$t" "$CONFIG/Kvantum/$t"
        fi
    done
    command -v flatpak >/dev/null 2>&1 || return 0
    [ -f "$BUGOS_CONFIG/flatpak-1" ] && return 0
    flatpak override --user \
        --filesystem=xdg-config/gtk-3.0:ro --filesystem=xdg-config/gtk-4.0:ro \
        --filesystem=xdg-config/Kvantum:ro --filesystem=xdg-config/kdeglobals:ro 2>/dev/null &&
        mkdir -p "$BUGOS_CONFIG" && touch "$BUGOS_CONFIG/flatpak-1"
}

# Terminal (Konsole): het BugOS-profiel dat bij licht/donker past, behalve als
# iemand zelf een ander profiel koos.
terminal_zet() {
    local nu profiel=BugOS.profile
    [ "$1" = donker ] && profiel=BugOSDark.profile
    [ -f "/usr/share/konsole/$profiel" ] || return 0
    nu="$(kreadconfig6 --file konsolerc --group "Desktop Entry" --key DefaultProfile 2>/dev/null)"
    case "$nu" in
    "" | BugOS.profile | BugOSDark.profile)
        kwriteconfig6 --file konsolerc --group "Desktop Entry" --key DefaultProfile "$profiel" ;;
    esac
}

# Windows-programma's (Wine) krijgen de nieuwe kleuren ook, niet pas als je een .exe via BugOS opent (U132).
# Op de achtergrond: Wine opstarten duurt even. Zelfde stempel als bugos-exe, dan doet die het niet nog eens.
windows_kleuren() {
    local prefix="${WINEPREFIX:-$HOME/.local/share/bugos/windows}" kleuren="/usr/share/bugos/wine/$1.reg"
    [ -d "$prefix" ] && [ -f "$kleuren" ] && command -v wine >/dev/null 2>&1 || return 0
    # Nieuwe Wine-versie (na een BugOS-update)? Dan zou Wine eerst een venster 'bijwerken' tonen: dat laten we aan
    # het openen van een Windows-programma over (bugos-exe zet de kleuren dan ook) (U148).
    local wine_tijd
    wine_tijd="$(stat -c %Y /usr/share/wine/wine.inf 2>/dev/null)"   # Wine vergelijkt zelf met wine.inf
    if [ -f "$prefix/.update-timestamp" ] && [ -n "$wine_tijd" ] &&
        [ "$(head -c 20 "$prefix/.update-timestamp" | tr -dc 0-9)" != "$wine_tijd" ] &&
        [ "$(head -c 7 "$prefix/.update-timestamp")" != disable ]; then
        return 0
    fi
    (
        # Eén tegelijk: snel licht-donker-licht, dan wint de laatste (U148).
        exec 8>"$prefix/.bugos-kleuren.slot"
        flock -w 120 8 2>/dev/null || exit 0
        # Intussen weer omgezet (snel licht-donker-licht)? Dan is deze niet meer de goede: niets doen (U169).
        [ "$(huidig)" = "$1" ] || exit 0
        export WINEPREFIX="$prefix" WINEDEBUG=-all
        wine regedit /S "$(winepath -w "$kleuren")" >/dev/null 2>&1 &&
            echo "$1 $(cksum <"$kleuren")" >"$prefix/.bugos-kleuren"
    ) </dev/null >/dev/null 2>&1 &
    disown 2>/dev/null || true
}

case "${1:-status}" in
licht | donker)
    if [ "$1" = donker ]; then
        schema=BugOSDark kv=BugOSDark
    else
        schema=BugOSLight kv=BugOS
    fi
    plasma-apply-colorscheme "$schema" >/dev/null 2>&1
    kvantum_zet "$kv"
    terminal_zet "$1"
    # De Plasma-stijl "bugos" volgt het kleurenschema; zet hem alleen terug als er
    # nog een Breeze-stijl van vroeger stond (BugOS zette toen default/breeze-dark).
    stijl="$(kreadconfig6 --file plasmarc --group Theme --key name 2>/dev/null)"
    case "$stijl" in
    "" | default | breeze-dark | breeze-light) plasma-apply-desktoptheme bugos >/dev/null 2>&1 ;;
    esac
    windows_kleuren "$1"
    # Zeg eerlijk of het lukte: Instellingen toont dan 'Dat lukte niet' in plaats van 'Klaar' (U342).
    [ "$(huidig)" = "$1" ] || exit 1
    ;;
status)
    huidig
    ;;
inloggen)
    oude_namen
    gtk_laag
    flatpak_toegang
    terminal_zet "$(huidig)"
    exec "$0" eerste-keer
    ;;
eerste-keer)
    MARKER="$BUGOS_CONFIG/thema-1"
    [ -f "$MARKER" ] && exit 0
    gelukt=1  # merkteken alleen als alles lukte; anders bij de volgende keer inloggen opnieuw
    geen_accent
    # Kvantum: zonder eigen instelling kiest hij zijn eigen standaard (niet BugOS).
    if [ ! -f "$KVANTUM" ] || ! grep -q '^theme=' "$KVANTUM"; then
        if [ "$(huidig)" = donker ]; then kvantum_zet BugOSDark; else kvantum_zet BugOS; fi
    fi
    # Alleen wat BugOS zelf vroeger instelde, zetten we om. Wie zelf iets anders
    # koos (bijv. Oxygen of Papirus), houdt dat.
    stijl="$(kreadconfig6 --file kdeglobals --group KDE --key widgetStyle 2>/dev/null)"
    case "$stijl" in
    "" | Breeze | breeze) kwriteconfig6 --file kdeglobals --group KDE --key widgetStyle kvantum || gelukt=0 ;;
    esac
    iconen="$(kreadconfig6 --file kdeglobals --group Icons --key Theme 2>/dev/null)"
    case "$iconen" in
    "" | breeze | breeze-dark) kwriteconfig6 --file kdeglobals --group Icons --key Theme BugOS || gelukt=0 ;;
    esac
    plasma="$(kreadconfig6 --file plasmarc --group Theme --key name 2>/dev/null)"
    case "$plasma" in
    "" | default | breeze-dark | breeze-light) plasma-apply-desktoptheme bugos >/dev/null 2>&1 || gelukt=0 ;;
    esac
    if [ "$gelukt" = 1 ]; then
        mkdir -p "$BUGOS_CONFIG" && touch "$MARKER"
    fi
    ;;
*)
    echo "Gebruik: bugos-theme licht|donker|status|inloggen|eerste-keer" >&2
    exit 2
    ;;
esac
