#!/usr/bin/bash
# bugos-package - een .rpm of .deb van een website installeren met dubbelklik.
#
# Jip-en-Janneke: BugOS is van "onbreekbaar glas". Losse installatiebestanden
# mogen daar niet zomaar in. Daarom:
#   1. BugOS kijkt eerst of het programma in de BugOS Winkel staat.
#   2. Zo niet, dan zet BugOS het in een eigen "doosje" (container), zodat het
#      werkt zonder het systeem te kunnen breken. Het verschijnt gewoon in je
#      startmenu. Let op: het doosje beschermt het systeem, niet je eigen bestanden.
#      Het programma kan bij je bestanden zoals elk programma (U245).

# shellcheck source=system_files/usr/share/bugos/lib.sh
. /usr/share/bugos/lib.sh

BESTAND="${1:-}"
if [ -z "$BESTAND" ] || [ ! -f "$BESTAND" ]; then
    fout "$(t "Ik kan dit bestand niet vinden." "I cannot find this file.")"
    exit 1
fi
BESTAND="$(realpath "$BESTAND")"

# Naam van het programma uitzoeken.
case "$BESTAND" in
*.rpm)
    SOORT=rpm
    NAAM="$(rpm -qp --qf '%{NAME}' "$BESTAND" 2>/dev/null)"
    DOOS=bugos-fedora
    DOOS_BEELD=registry.fedoraproject.org/fedora-toolbox:latest
    ;;
*.deb)
    SOORT=deb
    NAAM="$(basename "$BESTAND" .deb | cut -d_ -f1)"
    DOOS=bugos-ubuntu
    DOOS_BEELD=quay.io/toolbx/ubuntu-toolbox:latest
    ;;
*)
    fout "$(t "Dit soort bestand ken ik niet." "I don't know this kind of file.")"
    exit 1
    ;;
esac
[ -z "$NAAM" ] && NAAM="$(basename "$BESTAND")"
# De meldingen lezen \n als nieuwe regel (printf %b): een \ in de naam moet dus dubbel.
TOON="${NAAM//\\/\\\\}"
# Een naam als "<b>…</b>" mag de tekst van de vraag niet opmaken of verbergen (kdialog leest < > als opmaak) (U251).
TOON="${TOON//</‹}"
TOON="${TOON//>/›}"

# Stap 1: staat het in de Winkel?
# LC_ALL=C: anders zegt flatpak "Geen overeenkomsten gevonden" (in je eigen taal) en zouden we dat voor een app aanzien.
# En alleen iets dat op een app-naam lijkt (org.voorbeeld.App) telt.
GEVONDEN="$(LC_ALL=C flatpak search --columns=application "$NAAM" 2>/dev/null | head -n1)"
if [[ "$GEVONDEN" =~ ^[A-Za-z0-9_-]+(\.[A-Za-z0-9_-]+)+$ ]]; then
    if vraag "$(t \
        "\"$TOON\" staat ook in de BugOS Winkel. Dat is veiliger en krijgt vanzelf updates.\n\nWil je het uit de Winkel halen?" \
        "\"$TOON\" is also in the BugOS Store. That is safer and updates automatically.\n\nDo you want to get it from the Store?")"; then
        exec bugos-store "appstream://$GEVONDEN"
    fi
fi

# Stap 2: in een doosje installeren.
vraag "$(t \
    "Wil je \"$TOON\" installeren?\n\nBugOS zet het in een apart doosje, zodat het BugOS zelf niet kapot kan maken. Het kan wel bij je eigen bestanden, zoals elk programma: installeer het alleen als je de website vertrouwt.\n\nDaarna staat het gewoon in je startmenu." \
    "Do you want to install \"$TOON\"?\n\nBugOS puts it in a separate box, so it cannot break BugOS itself. It can still use your own files, like any program: only install it if you trust the website.\n\nAfterwards it is in your start menu.")" || exit 0

melding "$(t "Bezig met installeren..." "Installing...")" \
    "$(t "Dit kan een paar minuten duren. Je mag gewoon doorwerken." "This can take a few minutes. You can keep working.")"

if ! distrobox list 2>/dev/null | grep -q " $DOOS "; then
    distrobox create --yes --name "$DOOS" --image "$DOOS_BEELD" >/dev/null 2>&1 || {
        fout "$(t "Het doosje kon niet gemaakt worden. Heb je internet?" "The box could not be created. Are you online?")"
        exit 1
    }
fi

# De bestandsnaam gaat als los argument ($1) mee, nooit in de opdrachttekst zelf: een naam als
# 'app$(…).rpm' of met een " erin kan dan niets uitvoeren of de installatie breken.
if [ "$SOORT" = rpm ]; then
    # shellcheck disable=SC2016  # $1 is voor de bash in het doosje
    INSTALL='sudo dnf install -y "$1"'
else
    # shellcheck disable=SC2016
    INSTALL='sudo apt-get update && sudo apt-get install -y "$1"'
fi

# Programma's van dit pakket naar het startmenu brengen.
# shellcheck disable=SC2016
# Tellen hoeveel er naar het startmenu gingen: een pakket zonder programma met een venster heeft er geen (U195).
EXPORT='n=0; f=0; for d in $( (rpm -qlp "$1" 2>/dev/null || dpkg-deb -c "$1" 2>/dev/null | awk '\''{print $6}'\'') | grep -E '\''share/applications/.*\.desktop$'\''); do if distrobox-export --app "$(basename "$d" .desktop)" >/dev/null 2>&1; then n=$((n+1)); else f=1; fi; done; echo "bugos-startmenu=$n"; [ "$n" -gt 0 ] || exit $f'

# 'INSTALL || exit 1': EXPORT bestaat uit meer opdrachten; met && zou alleen de eerste van een gelukte installatie
# afhangen, en meldde BugOS 'Klaar' na een mislukte installatie (U198).
if uit="$(distrobox enter "$DOOS" -- bash -c "$INSTALL || exit 1; $EXPORT" bugos-package "$BESTAND" 2>/dev/null)"; then
    if [ "$(echo "$uit" | sed -n 's/^bugos-startmenu=//p' | tail -1)" = 0 ]; then
        melding "$(t "Klaar!" "Done!")" "$(t "\"$TOON\" is geïnstalleerd. Het heeft geen plek in het startmenu; je gebruikt het in de Terminal met: distrobox enter $DOOS" \
            "\"$TOON\" is installed. It has no place in the start menu; you use it in the Terminal with: distrobox enter $DOOS")"
    else
        melding "$(t "Klaar!" "Done!")" "$(t "\"$TOON\" staat nu in je startmenu." "\"$TOON\" is now in your start menu.")"
    fi
else
    fout "$(t "Het installeren van \"$TOON\" is niet gelukt. Je computer is niet veranderd." \
        "Installing \"$TOON\" did not work. Your computer has not changed.")"
    exit 1
fi
